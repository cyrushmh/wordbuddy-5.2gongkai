/** 并发安全：@Concurrent 函数须为顶层函数，且只能访问可序列化/线程安全的引用。 */
@Concurrent
function s2tConcurrent(text: string): string {
  if (!text) {
    return text;
  }
  let out = '';
  for (const ch of text) {
    out += S2T[ch] ?? ch;
  }
  return out;
}

/** 主线程调用入口：经由 taskpool 把长章简繁转换搬离 UI 线程。 */
export function s2tAsync(text: string): Promise<string> {
  if (!text) {
    return Promise.resolve(text);
  }
  const task: taskpool.Task = new taskpool.Task(s2tConcurrent, text);
  return taskpool.execute(task) as Promise<string>;
}
