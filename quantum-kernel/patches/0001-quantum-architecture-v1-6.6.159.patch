+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * include/asm/processor.h — minimal CPU description for the emulated arch.
+ */
+#ifndef _ASM_QUANTUM_PROCESSOR_H
+#define _ASM_QUANTUM_PROCESSOR_H
+
+#ifdef __KERNEL__
