+#
+# GRUB2 配置样例 —— Linux/quantum 架构内核（arch/quantum）
+#
+# 说明（诚实口径）：quantum 是「宿主模拟」架构，没有真实的引导镜像
+# 格式（无 bzImage/Image 引导协议），本文件是**内核命令行契约的
+# 参考样例**：bootloader 通过内核命令行把参数传给内核，
+# `idle=mwait` 即由此进入 arch/quantum 的空闲路径。
+#
+# idle= 参数（x86 兼容口径子集，详见 Documentation/arch/quantum/energy-model.rst）：
+#   idle=mwait  基态等待观测（默认）——宿主承载的 monitor/wait 语义；
+#   idle=poll   强制轮询（忙等）；
+#   idle=halt   最深停机态（模拟语义同 mwait）。
+# 注意：x86 官方文档已删除 idle=mwait 取值（deprecated），但参数在
+# 6.18.57 仍然可用，quantum 架构显式保留该语义。
+
+set default=0
+set timeout=5
+
+menuentry 'Linux/quantum 6.18.57 (host-emulated, idle=mwait)' {
+	insmod part_msdos
+	insmod ext2
+	set root='hd0,msdos1'
+	echo 'Loading Linux/quantum ...'
+	linux /boot/vmlinux-6.18.57-quantum root=/dev/sda1 ro idle=mwait
+}
+
+menuentry 'Linux/quantum 6.18.57 (host-emulated, idle=poll)' {
+	insmod part_msdos
+	insmod ext2
+	set root='hd0,msdos1'
+	echo 'Loading Linux/quantum ...'
+	linux /boot/vmlinux-6.18.57-quantum root=/dev/sda1 ro idle=poll
+}
