msgstr "  popcount  : %d（1 的個數）"

msgid "  前导零    : %d    尾随零: %d"
msgstr "  前導零    : %d    尾隨零: %d"

msgid "  偶校验位  : %d    奇校验位: %d"
msgstr "  偶校驗位  : %d    奇校驗位: %d"

