msgstr "預警評估（只評估，不自動報警）"

msgid "预警应急系统"
msgstr "預警應急系統"

msgid "—— 手动开关 ——"
msgstr "—— 手動開關 ——"

msgid "改法：set_switch('开关名', True/False)；例如关掉联网订阅 set_switch('feed_enabled', False)。"
msgstr "改法：set_switch('開關名', True/False)；例如關掉聯網訂閱 set_switch('feed_enabled', False)。"

msgid "预警应急能力自检"
msgstr "預警應急能力自檢"

msgid "· Android：adb shell dumpsys location（只读，取 fused/gps/network 最后已知位置）"
msgstr "· Android：adb shell dumpsys location（只讀，取 fused/gps/network 最後已知位置）"

msgid "· Linux：mmcli / geoclue 只读探测（**没有基站经纬度库就拿不到坐标，绝不凭 IP 编造**）"
msgstr "· Linux：mmcli / geoclue 只讀探測（**沒有基站經緯度庫就拿不到座標，絕不憑 IP 編造**）"

msgid "· 兜底：手动录入坐标（set_manual_position）"
msgstr "· 兜底：手動錄入座標（set_manual_position）"

msgid "本层**不做**的事（红线）：自动报警 / 拨号 / 发短信 / 自动发送任何内容；SOS 只生成文本。"
msgstr "本層**不做**的事（紅線）：自動報警 / 撥號 / 發短信 / 自動發送任何內容；SOS 只生成文本。"

msgid "未命名事件"
msgstr "未命名事件"

msgid "按%s的典型速度粗估，仅供量级参考，不是预报"
msgstr "按%s的典型速度粗估，僅供量級參考，不是預報"

msgid "你已在影响范围内，按指引行动，不要等下一次更新"
msgstr "你已在影響範圍內，按指引行動，不要等下一次更新"

msgid "我的位置：未能确定（请在安全处手动录入坐标，或说明周边标志物）"
msgstr "我的位置：未能確定（請在安全處手動錄入座標，或說明周邊標誌物）"

msgid "订阅源开关是关的（默认关闭）；先打开 feed_enabled 再拉。"
msgstr "訂閱源開關是關的（默認關閉）；先打開 feed_enabled 再拉。"

msgid "未配置订阅源地址"
msgstr "未配置訂閱源地址"

msgid "只接受 http(s) 地址，拒绝其他协议（防止本地文件被当源读）"
msgstr "只接受 http(s) 地址，拒絕其他協議（防止本地文件被當源讀）"

msgid "已获取并登记 %d 条预警"
msgstr "已獲取並登記 %d 條預警"

msgid "本机未取得任何定位源。"
msgstr "本機未取得任何定位源。"

msgid "可以做：在有导航的设备上开启定位后重探；或用手动录入坐标兜底。"
msgstr "可以做：在有導航的設備上開啓定位後重探；或用手動錄入座標兜底。"

msgid "首选基线（网络 + 基站）：无（未取到网络/基站坐标）"
msgstr "首選基線（網絡 + 基站）：無（未取到網絡/基站座標）"

msgid "导航定位（GNSS）：%s"
msgstr "導航定位（GNSS）：%s"

msgid "最终采用：无法确定（没有可用坐标）"
msgstr "最終採用：無法確定（沒有可用座標）"

msgid "预警评估已关闭（手动开关 alert_enabled=关）"
msgstr "預警評估已關閉（手動開關 alert_enabled=關）"

msgid "当前没有登记的预警。"
msgstr "當前沒有登記的預警。"

msgid "没有预警就是没有预警——本层不会凭空生成，也不会在未取到数据时猜测。"
msgstr "沒有預警就是沒有預警——本層不會憑空生成，也不會在未取到數據時猜測。"

msgid "定位源探测：%s"
msgstr "定位源探測：%s"

msgid "已登记预警：%d 条（上限 %d）"
msgstr "已登記預警：%d 條（上限 %d）"

msgid "联网订阅：默认关闭（开关 feed_enabled=%s）"
msgstr "聯網訂閱：默認關閉（開關 feed_enabled=%s）"

msgid "GeoClue 服务运行中（需授权应用才有坐标）"
msgstr "GeoClue 服務運行中（需授權應用纔有座標）"

msgid "我的位置：纬度 %.6f，经度 %.6f（精度约 %.0f 米，解算方式 %s）"
msgstr "我的位置：緯度 %.6f，經度 %.6f（精度約 %.0f 米，解算方式 %s）"

msgid "情况：%s"
msgstr "情況：%s"

msgid "已通知：%s"
msgstr "已通知：%s"

msgid "当前预警：%s"
msgstr "當前預警：%s"

msgid "（可见但无坐标）"
msgstr "（可見但無座標）"

msgid "首选基线（网络 + 基站）：%.5f,%.5f ±%.0f m（源 %d 个，权重 %s）"
msgstr "首選基線（網絡 + 基站）：%.5f,%.5f ±%.0f m（源 %d 個，權重 %s）"

msgid "未检测到"
msgstr "未檢測到"

msgid "最终采用：%.5f,%.5f ±%.0f m（%s）"
msgstr "最終採用：%.5f,%.5f ±%.0f m（%s）"

msgid "未取到（只读命令不可用或不匹配）"
msgstr "未取到（只讀命令不可用或不匹配）"

msgid "开"
msgstr "開"

msgid "关"
msgstr "關"

msgid "手动录入（已保存）"
msgstr "手動錄入（已保存）"

msgid "最近避险点：%s（约 %s）"
msgstr "最近避險點：%s（約 %s）"

msgid "最近避险点：%s（距离未知）"
msgstr "最近避險點：%s（距離未知）"

msgid "未能获取订阅源：%s（没有预警就是没有预警，不编造）"
msgstr "未能獲取訂閱源：%s（沒有預警就是沒有預警，不編造）"

msgid "%.5f,%.5f ±%.0f m"
msgstr "%.5f,%.5f ±%.0f m"

msgid "导航 + 首选基线共同综合"
msgstr "導航 + 首選基線共同綜合"

msgid "仅导航"
msgstr "僅導航"

msgid "仅网络 + 基站基线"
msgstr "僅網絡 + 基站基線"

msgid "两源偏差 %.0f m：%s"
msgstr "兩源偏差 %.0f m：%s"

msgid "取到 %d 个"
msgstr "取到 %d 個"

msgid "基站可见（LAC=%s CID=%s），缺基站经纬度库，无坐标"
msgstr "基站可見（LAC=%s CID=%s），缺基站經緯度庫，無座標"

msgid "避险点 %d"
msgstr "避險點 %d"

msgid "距你约 %s（事件未给影响半径，只给距离）"
msgstr "距你約 %s（事件未給影響半徑，只給距離）"

msgid "（你的位置精度约 %.0f m，距离值同量级误差）"
msgstr "（你的位置精度約 %.0f m，距離值同量級誤差）"

msgid "两源一致"
msgstr "兩源一致"

msgid "距中心约 %s：在影响范围内。%s"
msgstr "距中心約 %s：在影響範圍內。%s"

msgid "，粗估还有约 %.0f 秒到达边界"
msgstr "，粗估還有約 %.0f 秒到達邊界"

msgid "距中心约 %s，影响半径外 %s%s"
msgstr "距中心約 %s，影響半徑外 %s%s"

msgid "偏差超过 %.0f m，位置存疑——两套结果都在上面，请你判断"
msgstr "偏差超過 %.0f m，位置存疑——兩套結果都在上面，請你判斷"

msgid "组网通信协议核对（IPMsg / 飞鸽传书 / iptux 兼容）"
msgstr "組網通信協議覈對（IPMsg / 飛鴿傳書 / iptux 兼容）"

msgid "核对本机对 IPMsg（飞鸽传书）协议的编解码能力：命令字、选项位、附件属性串、UDP 2425 消息 / TCP 2425 文件。只读核对，不发包。"
msgstr "覈對本機對 IPMsg（飛鴿傳書）協議的編解碼能力：命令字、選項位、附件屬性串、UDP 2425 消息 / TCP 2425 文件。只讀覈對，不發包。"

msgid "只读任务：只核对编解码与常量表，不发包、不监听。"
msgstr "只讀任務：只覈對編解碼與常量表，不發包、不監聽。"

msgid "IPMsg 是明文协议且默认无认证，只适合可信局域网；跨公网请走加密通道。"
msgstr "IPMsg 是明文協議且默認無認證，只適合可信局域網；跨公網請走加密通道。"

msgid "包格式是六个字段：`版本:序号:用户:主机:命令字:附加`，命令字 = 基本命令 | 选项位，全部十进制。端口 2425（0x0979），消息走 UDP，文件走 TCP。"
msgstr "包格式是六個字段：`版本:序號:用戶:主機:命令字:附加`，命令字 = 基本命令 | 選項位，全部十進制。端口 2425（0x0979），消息走 UDP，文件走 TCP。"

msgid "为什么要兼容现成协议而不是自创：网里已有的飞鸽 / iptux 客户端能直接收到消息，**不用说服所有人装新软件**——自创协议在真实环境里等于没人可用。"
msgstr "爲什麼要兼容現成協議而不是自創：網裏已有的飛鴿 / iptux 客戶端能直接收到消息，**不用說服所有人裝新軟件**——自創協議在真實環境裏等於沒人可用。"

msgid "字段里的冒号用转义（`:` 在文件属性串里很常见），解析按转义切分，不按裸 split(':')——后者遇到 `a:photo.png` 这种名字就会解析错。"
msgstr "字段裏的冒號用轉義（`:` 在文件屬性串裏很常見），解析按轉義切分，不按裸 split(':')——後者遇到 `a:photo.png` 這種名字就會解析錯。"

msgid "表情与颜文字支持核对（emoji / kaomoji）"
msgstr "表情與顏文字支持覈對（emoji / kaomoji）"

msgid "核对 emoji（Unicode Emoji，UTS #51）与颜文字（全角符号拼组）的分类与显示支持，确认哪些能在对端正常显示。"
msgstr "覈對 emoji（Unicode Emoji，UTS #51）與顏文字（全角符號拼組）的分類與顯示支持，確認哪些能在對端正常顯示。"

msgid "只读任务：只核对，不发送。"
msgstr "只讀任務：只覈對，不發送。"

msgid "emoji 显示依赖对端字库；颜文字依赖等宽字体，否则可能错位。"
msgstr "emoji 顯示依賴對端字庫；顏文字依賴等寬字體，否則可能錯位。"

msgid "emoji 走 Unicode 标准码位（UTS #51），只要两端字库有就能显示；颜文字是**普通字符拼组**（＾▽＾ 之类），零依赖、任何终端都能显示——在老设备和纯文本环境里比 emoji 更可靠。"
msgstr "emoji 走 Unicode 標準碼位（UTS #51），只要兩端字庫有就能顯示；顏文字是**普通字符拼組**（＾▽＾ 之類），零依賴、任何終端都能顯示——在老設備和純文本環境裏比 emoji 更可靠。"

msgid "消息类型（文字/图片/视频/文件/emoji/颜文字）**只是载荷类型不同**，通道是同一条，不需要为每种类型各造一套协议。"
msgstr "消息類型（文字/圖片/視頻/文件/emoji/顏文字）**只是載荷類型不同**，通道是同一條，不需要爲每種類型各造一套協議。"

msgid "收件箱与待收文件核对（收到的东西不自动落盘）"
msgstr "收件箱與待收文件覈對（收到的東西不自動落盤）"

msgid "列出已收消息与**待收文件清单**。收到的图片/视频/文件一律不自动落盘，需你显式接受——自动接收等于别人能往你机器里塞东西。"
msgstr "列出已收消息與**待收文件清單**。收到的圖片/視頻/文件一律不自動落盤，需你顯式接受——自動接收等於別人能往你機器裏塞東西。"

msgid "只读任务：只列清单，不接收、不落盘、不打开任何文件。"
msgstr "只讀任務：只列清單，不接收、不落盤、不打開任何文件。"

msgid "来源只显示 IP:端口，不做主机名反解（避免 DNS 侧信道与伪造 PTR）。"
msgstr "來源只顯示 IP:端口，不做主機名反解（避免 DNS 側信道與僞造 PTR）。"

msgid "处置纪律：文件类载荷进**待收清单**并给出大小与来源，接受才落盘——这是本层最重要的一条安全边界。"
msgstr "處置紀律：文件類載荷進**待收清單**並給出大小與來源，接受才落盤——這是本層最重要的一條安全邊界。"

msgid "对超大载荷设上限，超限直接拒绝并在清单里标注，不硬扛（防止内存被吃光）。"
msgstr "對超大載荷設上限，超限直接拒絕並在清單裏標註，不硬扛（防止內存被喫光）。"

msgid "组网通信发送（单播 / 全体广播 / 带附件，需 --apply）"
msgstr "組網通信發送（單播 / 全體廣播 / 帶附件，需 --apply）"

msgid "向同网段设备发送文字、图片、视频、文件，或用 wall 式全体广播通知所有终端。**这是会发包的实际动作，需 --apply 且 --yes 才执行。**"
msgstr "向同網段設備發送文字、圖片、視頻、文件，或用 wall 式全體廣播通知所有終端。**這是會發包的實際動作，需 --apply 且 --yes 才執行。**"

msgid "**会实际发包**：需 --apply 且 --yes 才执行，默认只打印计划。"
msgstr "**會實際發包**：需 --apply 且 --yes 才執行，默認只打印計劃。"

msgid "广播会影响网段内所有设备；公共网络慎用，勿用于打扰他人。"
msgstr "廣播會影響網段內所有設備；公共網絡慎用，勿用於打擾他人。"

msgid "附件是对端来取，你这边要保持在线直到对端取完。"
msgstr "附件是對端來取，你這邊要保持在線直到對端取完。"

msgid "全体广播（wall 语义）用受限广播地址，同网段的终端都能收到——断网时这是**最可靠的通知方式**，不依赖任何外部服务器。"
msgstr "全體廣播（wall 語義）用受限廣播地址，同網段的終端都能收到——斷網時這是**最可靠的通知方式**，不依賴任何外部服務器。"

msgid "要回执就带 SENDCHECK 选项位（0x0100）：对端收到会回 RECVMSG，你才知道消息到了；不要回执就不带，省一次往返。"
msgstr "要回執就帶 SENDCHECK 選項位（0x0100）：對端收到會回 RECVMSG，你才知道消息到了；不要回執就不帶，省一次往返。"

msgid "带附件时先发消息包（含 FILEATTACHOPT 与文件属性串），对端主动来 TCP 2425 取——**是对方拉，不是我们推**，这样对端可以拒绝。"
msgstr "帶附件時先發消息包（含 FILEATTACHOPT 與文件屬性串），對端主動來 TCP 2425 取——**是對方拉，不是我們推**，這樣對端可以拒絕。"

msgid "IPMsg 明文且无认证，只适合可信局域网；跨公网请另走加密通道。"
msgstr "IPMsg 明文且無認證，只適合可信局域網；跨公網請另走加密通道。"

msgid "本机算力画像与图形能力登记（只读探测）"
msgstr "本機算力畫像與圖形能力登記（只讀探測）"

msgid "只读探测本机可捐献的算力：核心数、每核负载、可用内存、供电状态、是否计量网络，并登记 GPU/NPU 型号（只登记，不跑负载）。"
msgstr "只讀探測本機可捐獻的算力：核心數、每核負載、可用內存、供電狀態、是否計量網絡，並登記 GPU/NPU 型號（只登記，不跑負載）。"

msgid "只读任务：只探测，不改任何系统设置。"
msgstr "只讀任務：只探測，不改任何系統設置。"

msgid "无 lspci 或虚拟化环境下可能探测不到 GPU，此时如实写「未探测到」。"
msgstr "無 lspci 或虛擬化環境下可能探測不到 GPU，此時如實寫「未探測到」。"

msgid "可捐献评分 = 核心数归一化 × 空闲度 × 供电系数 × 网络计费系数。**电池低于 20% 直接不派活**（返回 0），用电池时系数降到 0.6。"
msgstr "可捐獻評分 = 核心數歸一化 × 空閒度 × 供電係數 × 網絡計費係數。**電池低於 20% 直接不派活**（返回 0），用電池時係數降到 0.6。"

msgid "计量网络（手机热点 / 按量计费）降权到 30%：不是安全考量，是**别让人替你交流量费**。"
msgstr "計量網絡（手機熱點 / 按量計費）降權到 30%：不是安全考量，是**別讓人替你交流量費**。"

msgid "GPU 只登记型号（lspci 的 VGA / 3D controller / Display controller），**不跑任何负载、不改驱动、不超频**。"
msgstr "GPU 只登記型號（lspci 的 VGA / 3D controller / Display controller），**不跑任何負載、不改驅動、不超頻**。"

msgid "内置可验证算子清单（为什么不执行任意代码）"
msgstr "內置可驗證算子清單（爲什麼不執行任意代碼）"

msgid "列出白名单内的三个可验证算子与各自的校验方式，并说明与 BOINC 「下发可执行程序」模式的根本差异。"
msgstr "列出白名單內的三個可驗證算子與各自的校驗方式，並說明與 BOINC 「下發可執行程序」模式的根本差異。"

msgid "只读任务：只列算子与校验口径，不执行计算。"
msgstr "只讀任務：只列算子與校驗口徑，不執行計算。"

msgid "白名单外的算子一律拒绝执行（有测试守着），这是设计不是缺陷。"
msgstr "白名單外的算子一律拒絕執行（有測試守着），這是設計不是缺陷。"

msgid "BOINC 让项目方下发可执行程序，信任链是「我信任这个项目方」；本层砍掉这条链——**绝不下载、绝不执行任何外部代码**。"
msgstr "BOINC 讓項目方下發可執行程序，信任鏈是「我信任這個項目方」；本層砍掉這條鏈——**絕不下載、絕不執行任何外部代碼**。"

msgid "代价：算不了真实的科学项目。收益：**任何机器入网都不会获得在你机器上执行代码的能力**。"
msgstr "代價：算不了真實的科學項目。收益：**任何機器入網都不會獲得在你機器上執行代碼的能力**。"

msgid "校验必须比计算便宜，否则冗余双投没有意义：哈希 O(1) 校验 vs N 次搜索；矩阵抽一行一列 O(n) vs O(n²)；蒙特卡洛固定种子可原样复算。"
msgstr "校驗必須比計算便宜，否則冗餘雙投沒有意義：哈希 O(1) 校驗 vs N 次搜索；矩陣抽一行一列 O(n) vs O(n²)；蒙特卡洛固定種子可原樣復算。"

msgid "分布式调度计划（按能力派活 + 冗余双投，只出计划）"
msgstr "分佈式調度計劃（按能力派活 + 冗餘雙投，只出計劃）"

msgid "把算子切成工作单元，按节点可捐献评分排序派活，每个单元冗余 k 份独立计算，结果一致才接受。**只出计划，不真跑。**"
msgstr "把算子切成工作單元，按節點可捐獻評分排序派活，每個單元冗餘 k 份獨立計算，結果一致才接受。**只出計劃，不真跑。**"

msgid "只读任务：只出计划，不派活、不联网、不执行计算。"
msgstr "只讀任務：只出計劃，不派活、不聯網、不執行計算。"

msgid "本层不含真实集群通信：跨机派活需要你已有的组网通道（IPMsg/iptux 通道或 SSH）。"
msgstr "本層不含真實集羣通信：跨機派活需要你已有的組網通道（IPMsg/iptux 通道或 SSH）。"

msgid "工作单元（WU）切分：哈希按 nonce 区间、矩阵按行块、蒙特卡洛按样本量与种子——**每个单元可独立复算**，这是冗余校验的前提。"
msgstr "工作單元（WU）切分：哈希按 nonce 區間、矩陣按行塊、蒙特卡洛按樣本量與種子——**每個單元可獨立復算**，這是冗餘校驗的前提。"

msgid "冗余双投：同一单元派给 k 个节点各自算，结果一致才接受；不一致标**存疑并重投**——不信任任何单个节点的自述。"
msgstr "冗餘雙投：同一單元派給 k 個節點各自算，結果一致才接受；不一致標**存疑並重投**——不信任任何單個節點的自述。"

msgid "评分低的节点排在后面但不会被排除（只要不是 0），因为弱节点算慢一点也比闲着强。"
msgstr "評分低的節點排在後面但不會被排除（只要不是 0），因爲弱節點算慢一點也比閒着強。"

msgid "分布式链路自测（本地试跑 + 复算校验，有 CPU 预算）"
msgstr "分佈式鏈路自測（本地試跑 + 復算校驗，有 CPU 預算）"

msgid "在**时间预算内**本地跑一批工作单元并复算校验，验证「切分 → 计算 → 校验 → 记账」整条链路可用。跑满预算立即停，绝不拖慢机器。"
msgstr "在**時間預算內**本地跑一批工作單元並復算校驗，驗證「切分 → 計算 → 校驗 → 記賬」整條鏈路可用。跑滿預算立即停，絕不拖慢機器。"

msgid "**会占用 CPU**（受预算约束）：需 --apply 才执行，默认只打印计划。"
msgstr "**會佔用 CPU**（受預算約束）：需 --apply 才執行，默認只打印計劃。"

msgid "非实时系统上的耗时可能超预算（调度抖动），这是预期行为不是故障。"
msgstr "非實時系統上的耗時可能超預算（調度抖動），這是預期行爲不是故障。"

msgid "默认预算 2 秒：够验证链路，不够拖慢机器。**跑满即停**，不会为了跑完而超时。"
msgstr "默認預算 2 秒：夠驗證鏈路，不夠拖慢機器。**跑滿即停**，不會爲了跑完而超時。"

msgid "自测的意义：先确认「本地这条链是通的」，再谈跨机——在没验证过的链路上派活，等于把问题放大 N 倍。"
msgstr "自測的意義：先確認「本地這條鏈是通的」，再談跨機——在沒驗證過的鏈路上派活，等於把問題放大 N 倍。"

msgid "credit 只在本地记一笔（谁干了多少活），**不换任何东西、不上链、不结算**。"
msgstr "credit 只在本地記一筆（誰幹了多少活），**不換任何東西、不上鍊、不結算**。"

msgid "入网能力优化策略（计算 / 图形 / 网络，只出策略不改设置）"
msgstr "入網能力優化策略（計算 / 圖形 / 網絡，只出策略不改設置）"

msgid "参与组网后，本机怎么既捐出闲余能力、又借到网内强机的能力：计算派活、图形重活找有卡的机器、网络避开计量链路。只出策略报告。"
msgstr "參與組網後，本機怎麼既捐出閒餘能力、又借到網內強機的能力：計算派活、圖形重活找有卡的機器、網絡避開計量鏈路。只出策略報告。"

msgid "策略类任务：只给策略与命令文本，不替你改系统设置（电源/调度/网络配置）。"
msgstr "策略類任務：只給策略與命令文本，不替你改系統設置（電源/調度/網絡配置）。"

msgid "跨机派活依赖你已有的组网通道；本层不自带集群通信。"
msgstr "跨機派活依賴你已有的組網通道；本層不自帶集羣通信。"

msgid "捐与借是同一件事的两面：你捐出闲着的核，也在别的机器上借到核。关键是**两边都有硬上限**——本层用电量与空闲度做上限，不用「信任」做上限。"
msgstr "捐與借是同一件事的兩面：你捐出閒着的核，也在別的機器上借到核。關鍵是**兩邊都有硬上限**——本層用電量與空閒度做上限，不用「信任」做上限。"

msgid "图形能力只登记型号：**不自动调用网内 GPU 跑任务**（那等于远程执行），要跑也得是你显式发起的具体任务。"
msgstr "圖形能力只登記型號：**不自動調用網內 GPU 跑任務**（那等於遠程執行），要跑也得是你顯式發起的具體任務。"

msgid "网络侧最容易被忽略的是计费：计量网络降权到 30%，不是因为它不安全，而是因为它**花钱**。"
msgstr "網絡側最容易被忽略的是計費：計量網絡降權到 30%，不是因爲它不安全，而是因爲它**花錢**。"

msgid "哈希原像搜索"
msgstr "哈希原像搜索"

msgid "给定盐与难度，搜索使哈希前 N 位为零的 nonce"
msgstr "給定鹽與難度，搜索使哈希前 N 位爲零的 nonce"

msgid "一次哈希（O(1)），远便宜于搜索"
msgstr "一次哈希（O(1)），遠便宜於搜索"

msgid "分块矩阵乘法"
msgstr "分塊矩陣乘法"

msgid "把大矩阵乘法切成小块并行，结果确定性可校验"
msgstr "把大矩陣乘法切成小塊並行，結果確定性可校驗"

msgid "抽一行一列重算（O(n) 而非 O(n²)）"
msgstr "抽一行一列重算（O(n) 而非 O(n²)）"

msgid "蒙特卡洛求 π"
msgstr "蒙特卡洛求 π"

msgid "固定种子的随机投点估算 π，同种子必得同结果"
msgstr "固定種子的隨機投點估算 π，同種子必得同結果"

msgid "同种子原样复算一遍"
msgstr "同種子原樣復算一遍"

msgid "未知"
msgstr "未知"

msgid "分布式计算能力（本机画像，只读探测）"
msgstr "分佈式計算能力（本機畫像，只讀探測）"

msgid "内置可验证算子（白名单，仅此三个）"
msgstr "內置可驗證算子（白名單，僅此三個）"

msgid "为什么只有内置算子：BOINC 让项目方下发可执行程序，信任链是「我信任这个项目方」；本层砍掉这条链——**绝不下载、绝不执行任何外部代码**。"
msgstr "爲什麼只有內置算子：BOINC 讓項目方下發可執行程序，信任鏈是「我信任這個項目方」；本層砍掉這條鏈——**絕不下載、絕不執行任何外部代碼**。"

msgid "调度计划（只出计划，不真跑）"
msgstr "調度計劃（只出計劃，不真跑）"

msgid "节点（按可捐献评分排序）："
msgstr "節點（按可捐獻評分排序）："

msgid "分布式计算共享"
msgstr "分佈式計算共享"

msgid "红线：不执行任意代码 / 不下载可执行程序 / 不主动连外部服务器 / 有 CPU 与时间预算，跑满即停。"
msgstr "紅線：不執行任意代碼 / 不下載可執行程序 / 不主動連外部服務器 / 有 CPU 與時間預算，跑滿即停。"

msgid "没有可用节点（电量过低或能力为零）"
msgstr "沒有可用節點（電量過低或能力爲零）"

msgid "未知算子，无法校验"
msgstr "未知算子，無法校驗"

msgid "复算一致，接受该结果"
msgstr "復算一致，接受該結果"

msgid "复算不一致，结果存疑——需重投该单元"
msgstr "復算不一致，結果存疑——需重投該單元"

msgid "未知算子，拒绝执行（只跑内置白名单）"
msgstr "未知算子，拒絕執行（只跑內置白名單）"

msgid "CPU 核心：%d；每核负载：%s"
msgstr "CPU 核心：%d；每核負載：%s"

msgid "内存：可用 %s / 共 %s"
msgstr "內存：可用 %s / 共 %s"

msgid "供电：未检测到电池（台式机/服务器或读取受限）"
msgstr "供電：未檢測到電池（臺式機/服務器或讀取受限）"

msgid "网络计费：%s"
msgstr "網絡計費：%s"

msgid "可捐献评分：%.2f（0 = 不派活）"
msgstr "可捐獻評分：%.2f（0 = 不派活）"

msgid "图形能力（只登记型号，不跑负载）："
msgstr "圖形能力（只登記型號，不跑負載）："

msgid "图形能力：未探测到独立 GPU（无 lspci 或无 VGA/3D 设备）"
msgstr "圖形能力：未探測到獨立 GPU（無 lspci 或無 VGA/3D 設備）"

msgid "算子 %s；工作单元 %d 个；冗余双投 k=%d"
msgstr "算子 %s；工作單元 %d 個；冗餘雙投 k=%d"

msgid "credit 记账（本地记录，不换任何东西）："
msgstr "credit 記賬（本地記錄，不換任何東西）："

msgid "credit 记账：暂无记录"
msgstr "credit 記賬：暫無記錄"

msgid "未知算子：%s（白名单内才有）"
msgstr "未知算子：%s（白名單內纔有）"

msgid "电池：%d%%（%s）"
msgstr "電池：%d%%（%s）"

msgid "非计量网络或未知"
msgstr "非計量網絡或未知"

msgid "校验成本：%s"
msgstr "校驗成本：%s"

msgid "节点 %d：评分 %.2f，%d 核"
msgstr "節點 %d：評分 %.2f，%d 核"

msgid "首个单元派给节点 %s（冗余 %d 份，各自独立算，结果一致才接受）"
msgstr "首個單元派給節點 %s（冗餘 %d 份，各自獨立算，結果一致才接受）"

msgid "计量网络（按量计费，派活降权 %.0f%%）"
msgstr "計量網絡（按量計費，派活降權 %.0f%%）"

msgid "%s：完成 %d 个单元"
msgstr "%s：完成 %d 個單元"

msgid "充电中"
msgstr "充電中"

msgid "使用电池"
msgstr "使用電池"

msgid "其他"
msgstr "其他"

msgid "跨机派活（经组网通道派工作单元，默认只出计划）"
msgstr "跨機派活（經組網通道派工作單元，默認只出計劃）"

msgid "把工作单元**经组网通信通道**（IPMsg/飞鸽传书/iptux 兼容的文本通道）派给网内节点，冗余 k 份各自独立算，结果回来复算校验一致才接受。默认 dry_run 只出计划不出网。"
msgstr "把工作單元**經組網通信通道**（IPMsg/飛鴿傳書/iptux 兼容的文本通道）派給網內節點，冗餘 k 份各自獨立算，結果回來復算校驗一致才接受。默認 dry_run 只出計劃不出網。"

msgid "**会实际发包**：dry_run=False 时需 --apply 且 --yes 才执行。"
msgstr "**會實際發包**：dry_run=False 時需 --apply 且 --yes 才執行。"

msgid "全体广播会影响网段内所有设备；公共网络慎用。"
msgstr "全體廣播會影響網段內所有設備；公共網絡慎用。"

msgid "本层不含节点发现：目标地址由你指定，或用广播让网内节点自己接。"
msgstr "本層不含節點發現：目標地址由你指定，或用廣播讓網內節點自己接。"

msgid "为什么不新建协议：组网通道已经有了（UDP 2425），WU 描述与结果都是短文本，塞进一条普通消息即可。网里已有的飞鸽/iptux 客户端会把它显示成一条普通消息，**不会干扰它们**，只是看不懂而已。"
msgstr "爲什麼不新建協議：組網通道已經有了（UDP 2425），WU 描述與結果都是短文本，塞進一條普通消息即可。網裏已有的飛鴿/iptux 客戶端會把它顯示成一條普通消息，**不會干擾它們**，只是看不懂而已。"

msgid "载荷：`SW-WU1:{...}` 派活、`SW-RES1:{...}` 回结果，前缀 + 紧凑 JSON。"
msgstr "載荷：`SW-WU1:{...}` 派活、`SW-RES1:{...}` 回結果，前綴 + 緊湊 JSON。"

msgid "**默认 dry_run=True**：只编码不出网——真派活得你显式传 dry_run=False。"
msgstr "**默認 dry_run=True**：只編碼不出網——真派活得你顯式傳 dry_run=False。"

msgid "派出去的活**只有参数没有代码**：白名单外的算子连解析都不认，别人发一句「请执行 xxx」是发不进来的。"
msgstr "派出去的活**只有參數沒有代碼**：白名單外的算子連解析都不認，別人發一句「請執行 xxx」是發不進來的。"

msgid "接活并回传结果（本机作为算力节点，受预算约束）"
msgstr "接活並回傳結果（本機作爲算力節點，受預算約束）"

msgid "本机作为算力节点：听网内派来的工作单元 → 本地算（受时间预算约束）→ 回传结果。只跑白名单算子，跑满预算即停。"
msgstr "本機作爲算力節點：聽網內派來的工作單元 → 本地算（受時間預算約束）→ 回傳結果。只跑白名單算子，跑滿預算即停。"

msgid "**会实际发包并占用 CPU**：需 --apply 且 --yes 才执行。"
msgstr "**會實際發包並佔用 CPU**：需 --apply 且 --yes 才執行。"

msgid "UDP 2425 需可绑定；被占用或无权限时会明确报错，不静默失败。"
msgstr "UDP 2425 需可綁定；被佔用或無權限時會明確報錯，不靜默失敗。"

msgid "接活方只跑 `distcompute.OPS` 白名单里的算子：**通道里传的是参数不是代码**，所以别人没法借这条通道让你执行任何东西。"
msgstr "接活方只跑 `distcompute.OPS` 白名單裏的算子：**通道里傳的是參數不是代碼**，所以別人沒法借這條通道讓你執行任何東西。"

msgid "预算取「派活方给的 budget」与「本机上限」的较小值——对端要你跑 10 秒，你本机上限 2 秒，就只跑 2 秒。"
msgstr "預算取「派活方給的 budget」與「本機上限」的較小值——對端要你跑 10 秒，你本機上限 2 秒，就只跑 2 秒。"

msgid "serve_once 只听一个包，适合验证；长期驻守应走 netlink 的 mesh 服务。"
msgstr "serve_once 只聽一個包，適合驗證；長期駐守應走 netlink 的 mesh 服務。"

msgid "已收一份，等待冗余第二份"
msgstr "已收一份，等待冗餘第二份"

msgid "跨机派活（经组网文本通道）"
msgstr "跨機派活（經組網文本通道）"

msgid "信任模型：只跑白名单算子；结果必须复算校验，不信任任何节点的自述。"
msgstr "信任模型：只跑白名單算子；結果必須復算校驗，不信任任何節點的自述。"

msgid "接活：serve_once() 听一个包，是工作单元就本地算并回发结果（受预算约束）。"
msgstr "接活：serve_once() 聽一個包，是工作單元就本地算並回髮結果（受預算約束）。"

msgid "跨机派活链路自检（本地回环，不通网）"
msgstr "跨機派活鏈路自檢（本地迴環，不通網）"

msgid "只编码不出网（dry_run）"
msgstr "只編碼不出網（dry_run）"

msgid "已发出"
msgstr "已發出"

msgid "收到的不是工作单元，已忽略"
msgstr "收到的不是工作單元，已忽略"

msgid "（无回发地址）"
msgstr "（無回發地址）"

msgid "结果格式不对"
msgstr "結果格式不對"

msgid "无对应任务"
msgstr "無對應任務"

msgid "单元号不存在"
msgstr "單元號不存在"

msgid "收到的不是结果消息，已忽略"
msgstr "收到的不是結果消息，已忽略"

msgid "载荷格式：%s 与 %s，走同一条组网消息通道（UDP 2425）"
msgstr "載荷格式：%s 與 %s，走同一條組網消息通道（UDP 2425）"

msgid "当前没有派出的任务。"
msgstr "當前沒有派出的任務。"

msgid "派法：dispatch('mc_pi', {'samples': 200000}, dry_run=True) 先看计划，确认后再 dry_run=False 真发。"
msgstr "派法：dispatch('mc_pi', {'samples': 200000}, dry_run=True) 先看計劃，確認後再 dry_run=False 真發。"

msgid "累计：接受 %d 个单元，存疑 %d 个"
msgstr "累計：接受 %d 個單元，存疑 %d 個"

msgid "存疑明细（前 5 条）："
msgstr "存疑明細（前 5 條）："

msgid "① 编码：%s…"
msgstr "① 編碼：%s…"

msgid "② 解码失败"
msgstr "② 解碼失敗"

msgid "③ 本地计算：耗时 %.3f 秒，自检校验 %s"
msgstr "③ 本地計算：耗時 %.3f 秒，自檢校驗 %s"

msgid "④ 结果回传并复算校验：%s"
msgstr "④ 結果回傳並復算校驗：%s"

msgid "⑤ 伪造结果能否混过校验：%s"
msgstr "⑤ 僞造結果能否混過校驗：%s"

msgid "⑥ 坏包处理：%s"
msgstr "⑥ 壞包處理：%s"

msgid "⑦ 白名单外的算子：%s"
msgstr "⑦ 白名單外的算子：%s"

msgid "未知算子 %s：只派白名单内的活"
msgstr "未知算子 %s：只派白名單內的活"

msgid "无对应任务（可能是别人的任务），已忽略"
msgstr "無對應任務（可能是別人的任務），已忽略"

msgid "未知节点"
msgstr "未知節點"

msgid "② 解码：op=%s，单元号 %s"
msgstr "② 解碼：op=%s，單元號 %s"

msgid "一致，接受"
msgstr "一致，接受"

msgid "不一致，存疑"
msgstr "不一致，存疑"

msgid "能（这是漏洞！）"
msgstr "能（這是漏洞！）"

msgid "不能，被打回"
msgstr "不能，被打回"

msgid "忽略，不抛异常"
msgstr "忽略，不拋異常"

msgid "异常"
msgstr "異常"

msgid "被拒（通道里传的是参数不是代码）"
msgstr "被拒（通道里傳的是參數不是代碼）"

msgid "被接受（漏洞！）"
msgstr "被接受（漏洞！）"

msgid "载荷超长，已跳过"
msgstr "載荷超長，已跳過"

msgid "任务 %s：算子 %s，%d 个单元（已完成 %d，存疑 %d，冗余 k=%d）"
msgstr "任務 %s：算子 %s，%d 個單元（已完成 %d，存疑 %d，冗餘 k=%d）"

msgid "通过"
msgstr "通過"

msgid "不通过"
msgstr "不通過"

msgid "节点发现（广播我能接活 + 登记网内在线节点）"
msgstr "節點發現（廣播我能接活 + 登記網內在線節點）"

msgid "广播本机能力通告（SW-OFFER1:，让派活方知道该不该派给我），并查看当前网内已登记的在线节点（带 TTL 过期）。只读、不自动派活。"
msgstr "廣播本機能力通告（SW-OFFER1:，讓派活方知道該不該派給我），並查看當前網內已登記的在線節點（帶 TTL 過期）。只讀、不自動派活。"

msgid "只读/广播类任务：广播通告本身会出网（UDP 广播），但不发任何写请求、不读任何文件内容。"
msgstr "只讀/廣播類任務：廣播通告本身會出網（UDP 廣播），但不發任何寫請求、不讀任何文件內容。"

msgid "节点表只在内存，不持久化——这是有意的（避免误把临时邻居当常驻）。"
msgstr "節點表只在內存，不持久化——這是有意的（避免誤把臨時鄰居當常駐）。"

msgid "能力通告是 SW-OFFER1: 前缀 + 本机 cores/score/gpu 的短文本，走 meshchat 的 UDP 广播通道，与文字聊天共用一条线。"
msgstr "能力通告是 SW-OFFER1: 前綴 + 本機 cores/score/gpu 的短文本，走 meshchat 的 UDP 廣播通道，與文字聊天共用一條線。"

msgid "收到邻居通告会自动登记进内存表，TTL 10 分钟——超过 10 分钟没再广播就视为离线剔除。节点表重启即清空，不落盘。"
msgstr "收到鄰居通告會自動登記進內存表，TTL 10 分鐘——超過 10 分鐘沒再廣播就視爲離線剔除。節點表重啓即清空，不落盤。"

msgid "本任务只「广播 + 看」，**不自动派活**：要真派活走 distjob_dispatch（默认 dry_run，显式 dry_run=False 才出网）。"
msgstr "本任務只「廣播 + 看」，**不自動派活**：要真派活走 distjob_dispatch（默認 dry_run，顯式 dry_run=False 纔出網）。"

msgid "优化资讯抓取（抓你配置的新闻/网站，抽知识点入缓存）"
msgstr "優化資訊抓取（抓你配置的新聞/網站，抽知識點入緩存）"

msgid "从你配置的来源（http/https RSS 或网页）抓取内容、解析条目、按平台/分类抽取可落地的优化知识点，写入本地缓存。只读、可联网。"
msgstr "從你配置的來源（http/https RSS 或網頁）抓取內容、解析條目、按平臺/分類抽取可落地的優化知識點，寫入本地緩存。只讀、可聯網。"

msgid "可联网任务：只拉你自己填的 http(s) 地址；拉不到就报「未能获取」，绝不编造。"
msgstr "可聯網任務：只拉你自己填的 http(s) 地址；拉不到就報「未能獲取」，絕不編造。"

msgid "风险 medium 仅因「会联网」，不因为任何写操作——本任务零写入。"
msgstr "風險 medium 僅因「會聯網」，不因爲任何寫操作——本任務零寫入。"

msgid "默认来源为空（设计如此：不默认联网）。在 native/webnews.py 的 DEFAULT_SOURCES 里加入你信任的 http(s) 地址，再运行本任务才会去抓。"
msgstr "默認來源爲空（設計如此：不默認聯網）。在 native/webnews.py 的 DEFAULT_SOURCES 里加入你信任的 http(s) 地址，再運行本任務纔會去抓。"

msgid "抓取带 8 秒超时与 2 MiB 体积上限；单源失败不影响其它源，失败源进错误列表。"
msgstr "抓取帶 8 秒超時與 2 MiB 體積上限；單源失敗不影響其它源，失敗源進錯誤列表。"

msgid "抓来的永远是文本：本层没有任何执行路径，不 eval、不 subprocess、不自动改系统——知识点只是「关注方向」，不是现成操作步骤。"
msgstr "抓來的永遠是文本：本層沒有任何執行路徑，不 eval、不 subprocess、不自動改系統——知識點只是「關注方向」，不是現成操作步驟。"

msgid "缓存落在 XDG ~/.config/sysweeper/webnews.json，只存 URL/标题/摘要/知识点文字，损坏就回退默认，不拖垮界面。"
msgstr "緩存落在 XDG ~/.config/sysweeper/webnews.json，只存 URL/標題/摘要/知識點文字，損壞就回退默認，不拖垮界面。"

msgid "优化资讯知识点（读缓存，按分类摆出来，只读建议）"
msgstr "優化資訊知識點（讀緩存，按分類擺出來，只讀建議）"

msgid "读上一次抓取的缓存，把其中与系统优化相关的知识点按平台/分类整理成可读建议。不带网、不重抓。"
msgstr "讀上一次抓取的緩存，把其中與系統優化相關的知識點按平臺/分類整理成可讀建議。不帶網、不重抓。"

msgid "只读任务：不联网、不写盘、不改任何设置。"
msgstr "只讀任務：不聯網、不寫盤、不改任何設置。"

msgid "缓存为空时会明确说「还没有资讯」，不会把空数据包装成「已是最优」。"
msgstr "緩存爲空時會明確說「還沒有資訊」，不會把空數據包裝成「已是最優」。"

msgid "看点开来源自行核对具体做法——关键词命中只代表「这条信息可能与该分类优化有关」，不代表源里一定给了操作步骤。"
msgstr "看點開來源自行覈對具體做法——關鍵詞命中只代表「這條信息可能與該分類優化有關」，不代表源裏一定給了操作步驟。"

msgid "缓存 6 小时有效；想看最新就先跑 webnews_fetch。"
msgstr "緩存 6 小時有效；想看最新就先跑 webnews_fetch。"

msgid "单板机优化建议（板型/温度/降频/启动盘，只读）"
msgstr "單板機優化建議（板型/溫度/降頻/啓動盤，只讀）"

msgid "只读探测单板机：设备树板型、thermal 温度、Broadcom 平台降频/欠压位、启动盘类型（SD/eMMC/NVMe），并给出带因果的优化建议。"
msgstr "只讀探測單板機：設備樹板型、thermal 溫度、Broadcom 平臺降頻/欠壓位、啓動盤類型（SD/eMMC/NVMe），並給出帶因果的優化建議。"

msgid "只读任务：不写 sysfs、不调 vcgencmd 改频率/电压、不装散热服务。"
msgstr "只讀任務：不寫 sysfs、不調 vcgencmd 改頻率/電壓、不裝散熱服務。"

msgid "建议带「为什么」——SBC 用户需要懂因果，不是被按头改。"
msgstr "建議帶「爲什麼」——SBC 用戶需要懂因果，不是被按頭改。"

msgid "板型读 /proc/device-tree/model 或 /sys/firmware/devicetree/base/model——几乎所有 ARM/RISC-V SBC 都有，是最稳的「这是什么板」来源。"
msgstr "板型讀 /proc/device-tree/model 或 /sys/firmware/devicetree/base/model——幾乎所有 ARM/RISC-V SBC 都有，是最穩的「這是什麼板」來源。"

msgid "温度读 /sys/class/thermal/*；降频/欠压读 Broadcom throttled 位掩码，其它平台退化到「看温度」判断，不硬猜。"
msgstr "溫度讀 /sys/class/thermal/*；降頻/欠壓讀 Broadcom throttled 位掩碼，其它平臺退化到「看溫度」判斷，不硬猜。"

msgid "启动盘类型由 /proc/self/mountinfo 回溯根设备判定：SD / eMMC / NVMe / SATA。"
msgstr "啓動盤類型由 /proc/self/mountinfo 回溯根設備判定：SD / eMMC / NVMe / SATA。"

msgid "非 SBC 上 detect_board 返回 None，本任务会明确说「未识别为单板机」，不走桌面/服务器的硬件优化任务。"
msgstr "非 SBC 上 detect_board 返回 None，本任務會明確說「未識別爲單板機」，不走桌面/服務器的硬件優化任務。"

msgid "为出站连接使用临时、轮换的 IPv6 地址，降低跨站点追踪（RFC 8981）。"
msgstr "爲出站連接使用臨時、輪換的 IPv6 地址，降低跨站點追蹤（RFC 8981）。"

msgid "参考：IETF RFC 8981（2021-02 取代 RFC 4941）。仅影响地址生成策略，不改变连通性。"
msgstr "參考：IETF RFC 8981（2021-02 取代 RFC 4941）。僅影響地址生成策略，不改變連通性。"

msgid "KaihongOS 发行版识别（深开鸿 / 基于 OpenHarmony）"
msgstr "KaihongOS 發行版識別（深開鴻 / 基於 OpenHarmony）"

msgid "只读识别本机是否为 KaihongOS（深开鸿基于 OpenHarmony 的发行版）：版本、variant（Stan/Small/Lite/桌面）、安全基座（SELinux/可信应用）、调试工具（hdc/HiLog）。非 KaihongOS 主机降级为指引。"
msgstr "只讀識別本機是否爲 KaihongOS（深開鴻基於 OpenHarmony 的發行版）：版本、variant（Stan/Small/Lite/桌面）、安全基座（SELinux/可信應用）、調試工具（hdc/HiLog）。非 KaihongOS 主機降級爲指引。"

msgid "绝不连设备、绝不改配置；hdc 仅在设备侧调试时使用，本机识别无需 hdc。"
msgstr "絕不連設備、絕不改配置；hdc 僅在設備側調試時使用，本機識別無需 hdc。"

msgid "KaihongOS 是 OpenHarmony 的具体发行版；鸿蒙通用探测（hdc/HiLog/Stage/SysCap/HAP/分布式）为其上层能力，本任务只做实锤「是不是 KaihongOS、哪一档」。"
msgstr "KaihongOS 是 OpenHarmony 的具體發行版；鴻蒙通用探測（hdc/HiLog/Stage/SysCap/HAP/分佈式）爲其上層能力，本任務只做實錘「是不是 KaihongOS、哪一檔」。"

msgid "安全基座含 SELinux 策略配置 + 仅可信应用可安装 + 端到端加密；只读核验 SELinux挂载态，不读业务数据。"
msgstr "安全基座含 SELinux 策略配置 + 僅可信應用可安裝 + 端到端加密；只讀覈驗 SELinux掛載態，不讀業務數據。"

msgid "OSI 七层网络诊断（L1 物理→L7 应用，整体只读）"
msgstr "OSI 七層網絡診斷（L1 物理→L7 應用，整體只讀）"

msgid "以 OSI 参考模型为骨架，把本机网络栈按 L1 物理层到 L7 应用层结构化、只读地摸一遍：接口/载波/速率、MAC/MTU/卸载、IP/路由/防火墙、监听/拥塞/连接跟踪、会话保活/隧道、TLS/DoT·DoH、DNS/可达性。"
msgstr "以 OSI 參考模型爲骨架，把本機網絡棧按 L1 物理層到 L7 應用層結構化、只讀地摸一遍：接口/載波/速率、MAC/MTU/卸載、IP/路由/防火牆、監聽/擁塞/連接跟蹤、會話保活/隧道、TLS/DoT·DoH、DNS/可達性。"

msgid "只读任务：不增删地址、不改路由、不 reload 防火墙、不连校外网做写操作。"
msgstr "只讀任務：不增刪地址、不改路由、不 reload 防火牆、不連校外網做寫操作。"

msgid "报告里的「参照」是文档来源，不是命令；照着优化是 opt-in 的下游动作。"
msgstr "報告裏的「參照」是文檔來源，不是命令；照着優化是 opt-in 的下游動作。"

msgid "L1 物理层读 /sys/class/net 的 carrier/operstate/speed/duplex/device 软链，据此判断总线后端是 PCIe/USB/虚拟——不依赖任何外部命令。"
msgstr "L1 物理層讀 /sys/class/net 的 carrier/operstate/speed/duplex/device 軟鏈，據此判斷總線後端是 PCIe/USB/虛擬——不依賴任何外部命令。"

msgid "L2–L4 复用 ip/ss/ethtool/conntrack 的只读项；写操作（ethtool -K、tc qdisc add）一律留在 network 模块的 opt-in 任务里，本任务不碰。"
msgstr "L2–L4 複用 ip/ss/ethtool/conntrack 的只讀項；寫操作（ethtool -K、tc qdisc add）一律留在 network 模塊的 opt-in 任務裏，本任務不碰。"

msgid "L5–L6 读 sysctl 保活、WireGuard/VTI 隧道特征、openssl 密码套件与解析器配置（/etc/resolv.conf、systemd-resolved）。"
msgstr "L5–L6 讀 sysctl 保活、WireGuard/VTI 隧道特徵、openssl 密碼套件與解析器配置（/etc/resolv.conf、systemd-resolved）。"

msgid "L7 默认只做 DNS 解析与本地回环监听自检，绝不默认连校外网；要探外网用 probe_http（仅 http/https + 短超时）。"
msgstr "L7 默認只做 DNS 解析與本地迴環監聽自檢，絕不默認連校外網；要探外網用 probe_http（僅 http/https + 短超時）。"

msgid "发行版与发行注记（识别 + 读本地 NEWS/changelog，只读）"
msgstr "發行版與發行註記（識別 + 讀本地 NEWS/changelog，只讀）"

msgid "识别本机发行版（LSB /etc/os-release），并读本机已安装的发行注记与包变更日志（NEWS.Debian、changelog.Debian.gz 等），把「这版改了什么」摆出来。"
msgstr "識別本機發行版（LSB /etc/os-release），並讀本機已安裝的發行註記與包變更日誌（NEWS.Debian、changelog.Debian.gz 等），把「這版改了什麼」擺出來。"

msgid "只读任务：不 apt-get changelog（联网）、不改源、不写文件。"
msgstr "只讀任務：不 apt-get changelog（聯網）、不改源、不寫文件。"

msgid "本机没装某包的本地注记时，会明确说「未安装该包本地注记」，并提示 apt-get changelog 会联网——本工具不替你联网。"
msgstr "本機沒裝某包的本地註記時，會明確說「未安裝該包本地註記」，並提示 apt-get changelog 會聯網——本工具不替你聯網。"

msgid "识别复用 linux.detect_distro（/etc/os-release 优先，lsb_release 兜底）。"
msgstr "識別複用 linux.detect_distro（/etc/os-release 優先，lsb_release 兜底）。"

msgid "注记读取只读本地 /usr/share/doc/* 下的 NEWS.Debian* / changelog.Debian* / changelog*（含 .gz，自动解压前若干字符）。"
msgstr "註記讀取只讀本地 /usr/share/doc/* 下的 NEWS.Debian* / changelog.Debian* / changelog*（含 .gz，自動解壓前若干字符）。"

msgid "包管理操作史（/var/log/apt/history.log、dnf.log、pacman.log）仅列存在性，不读全量、不联网。"
msgstr "包管理操作史（/var/log/apt/history.log、dnf.log、pacman.log）僅列存在性，不讀全量、不聯網。"

msgid "VERSION_CODENAME 等字段也一并读出，方便对照发行说明。"
msgstr "VERSION_CODENAME 等字段也一併讀出，方便對照發行說明。"

msgid "游戏/应用兼容层诊断（Proton/Wine 前提核验，整体只读）"
msgstr "遊戲/應用兼容層診斷（Proton/Wine 前提覈驗，整體只讀）"

msgid "以 Proton 为坐标系，把「机器能否跑 Windows 游戏/程序」只读结构化地摸一遍：Vulkan 支撑栈(loader+ICD)、32 位 i386 运行时、NT 同步原语(esync/fsync/NTSync)、Steam Runtime 与 Proton/Wine 安装现状。"
msgstr "以 Proton 爲座標系，把「機器能否跑 Windows 遊戲/程序」只讀結構化地摸一遍：Vulkan 支撐棧(loader+ICD)、32 位 i386 運行時、NT 同步原語(esync/fsync/NTSync)、Steam Runtime 與 Proton/Wine 安裝現狀。"

msgid "只读任务：不装包、不写 Wine prefix、不改内核参数、不连校外网。"
msgstr "只讀任務：不裝包、不寫 Wine prefix、不改內核參數、不連校外網。"

msgid "报告里的特性开关（PROTON_*）是运行时环境变量，不落盘；照着优化是 opt-in 下游动作。"
msgstr "報告裏的特性開關（PROTON_*）是運行時環境變量，不落盤；照着優化是 opt-in 下游動作。"

msgid "Vulkan 看 /usr/share/vulkan/icd.d/*.json（驱动 ICD）+ vulkan-loader；这是 DXVK/VKD3D 运行的硬前提，无则 Proton 起不来。"
msgstr "Vulkan 看 /usr/share/vulkan/icd.d/*.json（驅動 ICD）+ vulkan-loader；這是 DXVK/VKD3D 運行的硬前提，無則 Proton 起不來。"

msgid "32 位 i386：Wine/Proton 大量依赖 32 位，用 dpkg --print-foreign-architectures 与 dpkg -l ':i386' 判定，缺失关键库（libc6/i386、libstdc++6:i386…）会列明。"
msgstr "32 位 i386：Wine/Proton 大量依賴 32 位，用 dpkg --print-foreign-architectures 與 dpkg -l ':i386' 判定，缺失關鍵庫（libc6/i386、libstdc++6:i386…）會列明。"

msgid "同步原语三档：esync(eventfd, 老内核有) / fsync(futex, 需 FUTEX_WAIT_MULTIPLE≈5.16+) / NTSync(/dev/ntsync, 6.11+)；Proton 自动选最佳路径，缺则回退。"
msgstr "同步原語三檔：esync(eventfd, 老內核有) / fsync(futex, 需 FUTEX_WAIT_MULTIPLE≈5.16+) / NTSync(/dev/ntsync, 6.11+)；Proton 自動選最佳路徑，缺則回退。"

msgid "Steam Runtime 看 steam 进程、steam-runtime-system-info、steamapps/common/Proton*、wine --version、compatdata 前缀数量——只读，不启动任何游戏。"
msgstr "Steam Runtime 看 steam 進程、steam-runtime-system-info、steamapps/common/Proton*、wine --version、compatdata 前綴數量——只讀，不啓動任何遊戲。"

msgid "运行原则（参照 litebox）：兼容层应在最小权限、可审计、可接管环境中运行；本工具只诊断不修改。"
msgstr "運行原則（參照 litebox）：兼容層應在最小權限、可審計、可接管環境中運行；本工具只診斷不修改。"

msgid "WSL 环境只读诊断（Microsoft wsl2-linux-kernel 坐标系）"
msgstr "WSL 環境只讀診斷（Microsoft wsl2-linux-kernel 座標系）"

msgid "只读核验本机是否处于 WSL、版本 1/2、内核版本、根文件系统驱动、systemd 与 interop 配置——判断这台 WSL 与微软主线内核差多远、哪些能力可用。"
msgstr "只讀覈驗本機是否處於 WSL、版本 1/2、內核版本、根文件系統驅動、systemd 與 interop 配置——判斷這臺 WSL 與微軟主線內核差多遠、哪些能力可用。"

msgid "只读任务：不写 wsl.conf/.wslconfig、不 wsl --shutdown、不连校外网。"
msgstr "只讀任務：不寫 wsl.conf/.wslconfig、不 wsl --shutdown、不連校外網。"

msgid ".wslconfig 位于 Windows 侧 %USERPROFILE%，本模块无法读取，属已知边界。"
msgstr ".wslconfig 位於 Windows 側 %USERPROFILE%，本模塊無法讀取，屬已知邊界。"

msgid "是否 WSL：看 /proc/version 是否含 Microsoft；WSL2 内核 release 含 -microsoft-standard-WSL2，WSL1 含 -Microsoft 但无 standard。"
msgstr "是否 WSL：看 /proc/version 是否含 Microsoft；WSL2 內核 release 含 -microsoft-standard-WSL2，WSL1 含 -Microsoft 但無 standard。"

msgid "根文件系统：WSL2 新版默认 virtiofs、旧版 9p(drvfs)，用 findmnt 看 / 的 FSTYPE。"
msgstr "根文件系統：WSL2 新版默認 virtiofs、舊版 9p(drvfs)，用 findmnt 看 / 的 FSTYPE。"

msgid "systemd：wsl.conf [boot] systemd=true 才启用；否则是旧 init 行为。"
msgstr "systemd：wsl.conf [boot] systemd=true 才啓用；否則是舊 init 行爲。"

msgid "interop：/etc/resolv.conf 由 systemd-resolved 生成，nameserver 即 Windows 主机 IP，是 Linux↔Windows 网络互通的关键。"
msgstr "interop：/etc/resolv.conf 由 systemd-resolved 生成，nameserver 即 Windows 主機 IP，是 Linux↔Windows 網絡互通的關鍵。"

msgid "内核版本对照 wsl2-linux-kernel 标签（最新已到 6.18）；落后多说明没更新 WSL。"
msgstr "內核版本對照 wsl2-linux-kernel 標籤（最新已到 6.18）；落後多說明沒更新 WSL。"

msgid "虚拟化与 GPU 虚拟化只读诊断（VirtIO-GPU / Venus 坐标系）"
msgstr "虛擬化與 GPU 虛擬化只讀診斷（VirtIO-GPU / Venus 座標系）"

msgid "只读核验本机是否虚拟化（hypervisor 标志）、有无 virtio 设备、是否挂着 virtio-gpu（Venus 协议后端，可免直通加速）、以及 DRM 显示卡后端。"
msgstr "只讀覈驗本機是否虛擬化（hypervisor 標誌）、有無 virtio 設備、是否掛着 virtio-gpu（Venus 協議後端，可免直通加速）、以及 DRM 顯示卡後端。"

msgid "只读任务：不加载/卸载内核模块、不装驱动、不改 QEMU/crosvm 配置、不连校外网。"
msgstr "只讀任務：不加載/卸載內核模塊、不裝驅動、不改 QEMU/crosvm 配置、不連校外網。"

msgid "虚拟化判定：/proc/cpuinfo 的 hypervisor 标志 + vmx/svm；细分 KVM/QEMU、VMware、Xen、Hyper-V/WSL。"
msgstr "虛擬化判定：/proc/cpuinfo 的 hypervisor 標誌 + vmx/svm；細分 KVM/QEMU、VMware、Xen、Hyper-V/WSL。"

msgid "virtio 设备：枚举 /sys/bus/virtio/devices；virtio-gpu 看设备 modalias 是否含 virtio:...gpu，由 Venus 协议后端驱动。"
msgstr "virtio 設備：枚舉 /sys/bus/virtio/devices；virtio-gpu 看設備 modalias 是否含 virtio:...gpu，由 Venus 協議後端驅動。"

msgid "显示卡：/sys/class/drm/card*；物理机直出还是虚拟 GPU 一眼可分。"
msgstr "顯示卡：/sys/class/drm/card*；物理機直出還是虛擬 GPU 一眼可分。"

msgid "Venus 协议让 guest 内 Vulkan 命令旁路到宿主驱动，是云游戏/虚拟机 GPU 加速主路径。"
msgstr "Venus 協議讓 guest 內 Vulkan 命令旁路到宿主驅動，是雲遊戲/虛擬機 GPU 加速主路徑。"

msgid "浏览器与引擎检测 + Web 兼容知识参考（mdn/bcd 坐标系，只读）"
msgstr "瀏覽器與引擎檢測 + Web 兼容知識參考（mdn/bcd 座標系，只讀）"

msgid "只读探测本机已装浏览器与渲染引擎（Blink/Gecko）及版本，并给出一份小型 Web 平台特性兼容知识参考（结构性子集，演示 mdn/bcd 的数据组织方式）。"
msgstr "只讀探測本機已裝瀏覽器與渲染引擎（Blink/Gecko）及版本，並給出一份小型 Web 平臺特性兼容知識參考（結構性子集，演示 mdn/bcd 的數據組織方式）。"

msgid "只读任务：不下载 BCD 全量 JSON、不连校外网、不自动改浏览器配置。"
msgstr "只讀任務：不下載 BCD 全量 JSON、不連校外網、不自動改瀏覽器配置。"

msgid "兼容知识为结构性子集，非实时数据库；精确支持度以 @mdn/browser-compat-data 为准。"
msgstr "兼容知識爲結構性子集，非實時數據庫；精確支持度以 @mdn/browser-compat-data 爲準。"

msgid "浏览器探测：which chromium/chrome/firefox + --version；引擎 Blink(Chromium 系) / Gecko(Firefox)。"
msgstr "瀏覽器探測：which chromium/chrome/firefox + --version；引擎 Blink(Chromium 系) / Gecko(Firefox)。"

msgid "兼容知识参考：演示 mdn/bcd 的「特性→支持等级」结构（WebGPU / Container queries / :has() / Top-level await / SharedArrayBuffer 等），为极简静态子集。"
msgstr "兼容知識參考：演示 mdn/bcd 的「特性→支持等級」結構（WebGPU / Container queries / :has() / Top-level await / SharedArrayBuffer 等），爲極簡靜態子集。"

msgid "完整数据：@mdn/browser-compat-data 是权威跨浏览器支持度数据源，按需引用。"
msgstr "完整數據：@mdn/browser-compat-data 是權威跨瀏覽器支持度數據源，按需引用。"

msgid "DNS 解析健康度只读诊断（聚焦解析链路，与 nm_resolved 互补）"
msgstr "DNS 解析健康度只讀診斷（聚焦解析鏈路，與 nm_resolved 互補）"

msgid "只读核验 DNS 解析链路是否健康：/etc/resolv.conf 的 nameserver 来源、systemd-resolved stub 监听、一次良性解析的延迟。与 network.nm_resolved （连接管理）互补，专看「名字能不能解析出来」。"
msgstr "只讀覈驗 DNS 解析鏈路是否健康：/etc/resolv.conf 的 nameserver 來源、systemd-resolved stub 監聽、一次良性解析的延遲。與 network.nm_resolved （連接管理）互補，專看「名字能不能解析出來」。"

msgid "只读任务：不写 /etc/resolv.conf、不重启 resolved、不改 DNS。"
msgstr "只讀任務：不寫 /etc/resolv.conf、不重啓 resolved、不改 DNS。"

msgid "解析探测只发一次良性查询、不修改任何状态；不连校外网做写操作。"
msgstr "解析探測只發一次良性查詢、不修改任何狀態；不連校外網做寫操作。"

msgid "nameserver 来源：/etc/resolv.conf 是否由 systemd-resolved 生成（Generated by / resolvectl 字样）。"
msgstr "nameserver 來源：/etc/resolv.conf 是否由 systemd-resolved 生成（Generated by / resolvectl 字樣）。"

msgid "resolved stub：systemd-resolved 监听 127.0.0.53:53；stub 与 resolv.conf 不一致是「能 ping IP 不能开网页」的常见根因。"
msgstr "resolved stub：systemd-resolved 監聽 127.0.0.53:53；stub 與 resolv.conf 不一致是「能 ping IP 不能開網頁」的常見根因。"

msgid "解析探测：默认做一次良性 A 查询（getaddrinfo example.com）测延迟，只读不改状态；可用 --no-query 关闭。"
msgstr "解析探測：默認做一次良性 A 查詢（getaddrinfo example.com）測延遲，只讀不改狀態；可用 --no-query 關閉。"

msgid "DNS 是网络诊断第一跳：任何「连不上」先卡在名字解析，本任务专看这一跳。"
msgstr "DNS 是網絡診斷第一跳：任何「連不上」先卡在名字解析，本任務專看這一跳。"

msgid "Tor（洋葱路由）匿名/隐私网络只读诊断"
msgstr "Tor（洋蔥路由）匿名/隱私網絡只讀診斷"

msgid "只读核验 Tor 是否安装、版本、守护进程状态、torrc 关键配置（SOCKS/控制端口、桥接、可插拔传输、中继/出口角色）、可插拔传输二进制（obfs4/snowflake/meek/lyrebird）就位情况。与 OSI/DNS/ZeroTier 共同构成网络模块的覆盖层/隐私层视图。"
msgstr "只讀覈驗 Tor 是否安裝、版本、守護進程狀態、torrc 關鍵配置（SOCKS/控制端口、橋接、可插拔傳輸、中繼/出口角色）、可插拔傳輸二進制（obfs4/snowflake/meek/lyrebird）就位情況。與 OSI/DNS/ZeroTier 共同構成網絡模塊的覆蓋層/隱私層視圖。"

msgid "只读任务：不启动/停止 tor、不改 torrc、不连控制端口、不连校外网做写操作。"
msgstr "只讀任務：不啓動/停止 tor、不改 torrc、不連控制端口、不連校外網做寫操作。"

msgid "torrc 敏感配置（HashedControlPassword/HiddenServiceDir 等）只报存在，绝不回显。"
msgstr "torrc 敏感配置（HashedControlPassword/HiddenServiceDir 等）只報存在，絕不回顯。"

msgid "SOCKS 端口：客户端默认 9050，Tor 浏览器默认 9150；是本地代理入口。"
msgstr "SOCKS 端口：客戶端默認 9050，Tor 瀏覽器默認 9150；是本地代理入口。"

msgid "控制端口：默认 9051（浏览器 9151），可下发写命令——本工具只读、不连。"
msgstr "控制端口：默認 9051（瀏覽器 9151），可下發寫命令——本工具只讀、不連。"

msgid "桥接 + 可插拔传输（obfs4/snowflake/meek/lyrebird）：受审查网络靠它绕过封锁。"
msgstr "橋接 + 可插拔傳輸（obfs4/snowflake/meek/lyrebird）：受審查網絡靠它繞過封鎖。"

msgid "中继/出口角色：做出口节点能看明文目的、有带宽与法务责任，需读懂 Relay 文档再定。"
msgstr "中繼/出口角色：做出口節點能看明文目的、有帶寬與法務責任，需讀懂 Relay 文檔再定。"

msgid "torrc 中密钥/密码类敏感项只报存在、不打印明文。"
msgstr "torrc 中密鑰/密碼類敏感項只報存在、不打印明文。"

msgid "ZeroTier 虚拟网络（SD-WAN / 零信任组网）只读诊断"
msgstr "ZeroTier 虛擬網絡（SD-WAN / 零信任組網）只讀診斷"

msgid "只读核验 ZeroTier 是否安装、版本、运行态、identity.public（公钥）、已加入网络（networks.d/*.conf，文件名即网络 ID）、是否控制器（controller.d）、moon（moons.d/*.moon）。与 Tor/OSI/DNS 共同构成网络模块的虚拟组网层视图。"
msgstr "只讀覈驗 ZeroTier 是否安裝、版本、運行態、identity.public（公鑰）、已加入網絡（networks.d/*.conf，文件名即網絡 ID）、是否控制器（controller.d）、moon（moons.d/*.moon）。與 Tor/OSI/DNS 共同構成網絡模塊的虛擬組網層視圖。"

msgid "只读任务：不启动/停止 zerotier-one、不 join/leave 网络、不改 networks.d、不连控制端口。"
msgstr "只讀任務：不啓動/停止 zerotier-one、不 join/leave 網絡、不改 networks.d、不連控制端口。"

msgid "identity.secret 属私钥，本工具绝不读取，仅 os.path.exists 判定存在性。"
msgstr "identity.secret 屬私鑰，本工具絕不讀取，僅 os.path.exists 判定存在性。"

msgid "identity.public 是公钥（可对外）；identity.secret 是私钥，本工具只报存在、绝不读。"
msgstr "identity.public 是公鑰（可對外）；identity.secret 是私鑰，本工具只報存在、絕不讀。"

msgid "networks.d/*.conf 文件名即网络 ID，等于「已加入哪些虚拟网」。"
msgstr "networks.d/*.conf 文件名即網絡 ID，等於「已加入哪些虛擬網」。"

msgid "controller.d 存在＝本机可托管/签发网络；moons.d 存在＝部署了私有根（moon）。"
msgstr "controller.d 存在＝本機可託管/簽發網絡；moons.d 存在＝部署了私有根（moon）。"

msgid "虚拟网默认端到端加密；信任边界在控制器（谁能进网）与 moon（根在哪）。"
msgstr "虛擬網默認端到端加密；信任邊界在控制器（誰能進網）與 moon（根在哪）。"

msgid "系统统筹总览（你中有我，我中有你 · 统筹系统与局部）"
msgstr "系統統籌總覽（你中有我，我中有你 · 統籌系統與局部）"

msgid "按统一清单只读编排**已开启**的子系统诊断（v0.6.22 起全量登记、可用选项开/关），输出「开关状态 + 整体健康汇总 + 局部本征状态 + 关联关系图（你中有我） + 有序深入建议」，全面健康有序地看待一切。"
msgstr "按統一清單隻讀編排**已開啓**的子系統診斷（v0.6.22 起全量登記、可用選項開/關），輸出「開關狀態 + 整體健康彙總 + 局部本徵狀態 + 關聯關係圖（你中有我） + 有序深入建議」，全面健康有序地看待一切。"

msgid "只读总览：不启停服务、不改配置、不连控制端口、不写任何系统状态。"
msgstr "只讀總覽：不啓停服務、不改配置、不連控制端口、不寫任何系統狀態。"

msgid "某子系统诊断异常时只标「异常」并跳过，不影响整体总览。"
msgstr "某子系統診斷異常時只標「異常」並跳過，不影響整體總覽。"

msgid "整体健康汇总：全部已登记子系统（默认全开）按 正常/提示/不适用/异常 四档收敛，先看清全局。"
msgstr "整體健康彙總：全部已登記子系統（默認全開）按 正常/提示/不適用/異常 四檔收斂，先看清全局。"

msgid "选项开关：每个子系统可用 `sysweeper subsystems --disable <key>` 单独关闭，关闭后不诊断、不展示，关联图也不再画它那一端（配置落点 ~/.config/sysweeper/subsystems.json）。"
msgstr "選項開關：每個子系統可用 `sysweeper subsystems --disable <key>` 單獨關閉，關閉後不診斷、不展示，關聯圖也不再畫它那一端（配置落點 ~/.config/sysweeper/subsystems.json）。"

msgid "局部本征状态：每个子系统只看状态，深入请用对应子命令钻取（tor/zerotier/dnshealth/proton/wsl/virtgpu/browser/...）。"
msgstr "局部本徵狀態：每個子系統只看狀態，深入請用對應子命令鑽取（tor/zerotier/dnshealth/proton/wsl/virtgpu/browser/...）。"

msgid "你中有我，我中有你：网络↔DNS、DNS↔Tor、Tor↔ZeroTier、Proton↔GPU/内核/发行版、浏览器↔DNS/字符标准 等耦合关系显式画出。"
msgstr "你中有我，我中有你：網絡↔DNS、DNS↔Tor、Tor↔ZeroTier、Proton↔GPU/內核/發行版、瀏覽器↔DNS/字符標準 等耦合關係顯式畫出。"

msgid "有序深入：网络异常按 硬件→发行版→OSI→网络→DNS→覆盖层→虚拟组网→自组网 排序；兼容异常按 内核→GPU→发行版→Proton 排序。"
msgstr "有序深入：網絡異常按 硬件→發行版→OSI→網絡→DNS→覆蓋層→虛擬組網→自組網 排序；兼容異常按 內核→GPU→發行版→Proton 排序。"

msgid "图像/媒体编解码与色彩能力诊断"
msgstr "圖像/媒體編解碼與色彩能力診斷"

msgid "只读核验本机图像编解码工具链、格式支持矩阵、ICC 色彩管理与 Rust 创意套件就位情况，作为图像优化（缩略图/转码/EXIF 清理）的前提核对。"
msgstr "只讀覈驗本機圖像編解碼工具鏈、格式支持矩陣、ICC 色彩管理與 Rust 創意套件就位情況，作爲圖像優化（縮略圖/轉碼/EXIF 清理）的前提覈對。"

msgid "仅读工具存在性与 ICC 目录；不实际解码/转码任何文件，不改配置、不连网。"
msgstr "僅讀工具存在性與 ICC 目錄；不實際解碼/轉碼任何文件，不改配置、不連網。"

msgid "缺失读取能力的格式（如 HEIC/AVIF/JXL 未装对应工具）会导致图像优化链路无法处理这些文件，应优先补装。"
msgstr "缺失讀取能力的格式（如 HEIC/AVIF/JXL 未裝對應工具）會導致圖像優化鏈路無法處理這些文件，應優先補裝。"

msgid "ImageMagick 或 ffmpeg 是批量图像优化的通用引擎；两者皆无时优化任务应降级为指引。"
msgstr "ImageMagick 或 ffmpeg 是批量圖像優化的通用引擎；兩者皆無時優化任務應降級爲指引。"

msgid "可启动介质制作能力诊断"
msgstr "可啓動介質製作能力診斷"

msgid "只读核验本机制作 livecd/dvd/bd/usb 的能力：ISO 构建工具链(xorriso/mkisofs/genisoimage/grub-mkrescue/mtools/isohybrid)、BIOS·UEFI 引导加载器、El Torito·混合镜像、压缩根系统(squashfs/overlayfs/casper)、U 盘写入工具、本机固件启动模式；可选传入 ISO 路径做只读可启动性校验。"
msgstr "只讀覈驗本機制作 livecd/dvd/bd/usb 的能力：ISO 構建工具鏈(xorriso/mkisofs/genisoimage/grub-mkrescue/mtools/isohybrid)、BIOS·UEFI 引導加載器、El Torito·混合鏡像、壓縮根系統(squashfs/overlayfs/casper)、U 盤寫入工具、本機固件啓動模式；可選傳入 ISO 路徑做只讀可啓動性校驗。"

msgid "仅读工具存在性/目录与 /sys 状态/给定 ISO 的只读元数据；绝不 mkisofs/xorriso 构建、绝不 dd 到设备、绝不挂载/解包 ISO、绝不 modprobe。"
msgstr "僅讀工具存在性/目錄與 /sys 狀態/給定 ISO 的只讀元數據；絕不 mkisofs/xorriso 構建、絕不 dd 到設備、絕不掛載/解包 ISO、絕不 modprobe。"

msgid "制作双启 Live USB：用 xorriso 或 grub-mkrescue 产出 isohybrid 镜像后 dd 到 U 盘。"
msgstr "製作雙啓 Live USB：用 xorriso 或 grub-mkrescue 產出 isohybrid 鏡像後 dd 到 U 盤。"

msgid "本机为 UEFI 固件时，回启动介质必须含 EFI 引导入口（GRUB-EFI 或 systemd-boot）。"
msgstr "本機爲 UEFI 固件時，回啓動介質必須含 EFI 引導入口（GRUB-EFI 或 systemd-boot）。"

msgid "Live 系统只读压缩根用 squashfs，写时叠加/持久化靠 overlayfs + casper。"
msgstr "Live 系統只讀壓縮根用 squashfs，寫時疊加/持久化靠 overlayfs + casper。"

msgid "遗留 DOS 环境只读诊断（DOS 3.1 等 · FreeDOS · DOSEMU2）"
msgstr "遺留 DOS 環境只讀診斷（DOS 3.1 等 · FreeDOS · DOSEMU2）"

msgid "只读核验本机是否有 FreeDOS/DOSEMU2 路径，以及能否制作 DOS 启动盘（mtools/syslinux）；DOS 3.1 仅作知识坐标，不运行任何 DOS 程序。"
msgstr "只讀覈驗本機是否有 FreeDOS/DOSEMU2 路徑，以及能否製作 DOS 啓動盤（mtools/syslinux）；DOS 3.1 僅作知識座標，不運行任何 DOS 程序。"

msgid "本工具只诊断不运行：绝不写 DOS 镜像、不 dd、不启动 DOS/DOSEMU、不挂载/解包镜像。"
msgstr "本工具只診斷不運行：絕不寫 DOS 鏡像、不 dd、不啓動 DOS/DOSEMU、不掛載/解包鏡像。"

msgid "MS-DOS 3.1：x86 实模式、FAT12 软盘 360KB/1.2MB、COM/EXE、CONFIG.SYS/AUTOEXEC.BAT、HIMEM/EMM386、INT 21h/10h/13h/16h。"
msgstr "MS-DOS 3.1：x86 實模式、FAT12 軟盤 360KB/1.2MB、COM/EXE、CONFIG.SYS/AUTOEXEC.BAT、HIMEM/EMM386、INT 21h/10h/13h/16h。"

msgid "FreeDOS 1.4 兼容 MS-DOS；DOSEMU2 在 Linux 近原生运行实模式 DOS。"
msgstr "FreeDOS 1.4 兼容 MS-DOS；DOSEMU2 在 Linux 近原生運行實模式 DOS。"

msgid "制作 DOS 启动软盘复用 livemedia 的 mtools/syslinux 工具链（你中有我）。"
msgstr "製作 DOS 啓動軟盤複用 livemedia 的 mtools/syslinux 工具鏈（你中有我）。"

msgid "合法 DOS 镜像如需取回，可走第三方 CDN·P2P 开关 aria2（见 thirdparty 引用）。"
msgstr "合法 DOS 鏡像如需取回，可走第三方 CDN·P2P 開關 aria2（見 thirdparty 引用）。"

msgid "busybox 嵌入式用户态只读诊断（单二进制「瑞士军刀」）"
msgstr "busybox 嵌入式用戶態只讀診斷（單二進制「瑞士軍刀」）"

msgid "只读核验 busybox 版本、内置 applet 数，并判定其嵌入式上下文（OpenWrt 路由器 / Docker 极简镜像 / initramfs）；不触碰二进制本体。"
msgstr "只讀覈驗 busybox 版本、內置 applet 數，並判定其嵌入式上下文（OpenWrt 路由器 / Docker 極簡鏡像 / initramfs）；不觸碰二進制本體。"

msgid "本工具只诊断不运行：不执行 busybox、不读/写其 applet、不连校外网做写。"
msgstr "本工具只診斷不運行：不執行 busybox、不讀/寫其 applet、不連校外網做寫。"

msgid "busybox 把数十个 Unix 命令浓缩进一个可执行，广泛用于嵌入式路由器、安装器 initrd、容器。"
msgstr "busybox 把數十個 Unix 命令濃縮進一個可執行，廣泛用於嵌入式路由器、安裝器 initrd、容器。"

msgid "嵌入式上下文判定：OpenWrt 标记 / Docker(.dockerenv) / /bin·/sbin 软链到 busybox。"
msgstr "嵌入式上下文判定：OpenWrt 標記 / Docker(.dockerenv) / /bin·/sbin 軟鏈到 busybox。"

msgid "与 OpenWrt 模块共生：路由器系统的根用户态即 busybox；与 livemedia 的 initramfs 同源思路。"
msgstr "與 OpenWrt 模塊共生：路由器系統的根用戶態即 busybox；與 livemedia 的 initramfs 同源思路。"

msgid "dosbox DOS 模拟兼容层只读诊断（在现系统跑老 DOS 软件）"
msgstr "dosbox DOS 模擬兼容層只讀診斷（在現系統跑老 DOS 軟件）"

msgid "只读核验 dosbox 版本与配置，给出核心概念（core/cycles/mount）与衍生生态；与 proton（兼容层）、wsl（旧环境迁移桥）关联。不启动 dosbox。"
msgstr "只讀覈驗 dosbox 版本與配置，給出核心概念（core/cycles/mount）與衍生生態；與 proton（兼容層）、wsl（舊環境遷移橋）關聯。不啓動 dosbox。"

msgid "本工具只诊断不运行：绝不启动 dosbox、不挂任何目录、不跑任何 DOS 程序。"
msgstr "本工具只診斷不運行：絕不啓動 dosbox、不掛任何目錄、不跑任何 DOS 程序。"

msgid "dosbox 用 SDL 把 8086/286/386 动态重编译，在现 OS 跑老 DOS 游戏/程序。"
msgstr "dosbox 用 SDL 把 8086/286/386 動態重編譯，在現 OS 跑老 DOS 遊戲/程序。"

msgid "CPU core（simple/normal/dynamic/auto）、cycles（fixed/max 调速）、mount C <dir> 是核心。"
msgstr "CPU core（simple/normal/dynamic/auto）、cycles（fixed/max 調速）、mount C <dir> 是核心。"

msgid "与 proton 同属兼容层、与 wsl 同属旧环境迁移桥；合法镜像取回可走 aria2 CDN·P2P 开关。"
msgstr "與 proton 同屬兼容層、與 wsl 同屬舊環境遷移橋；合法鏡像取回可走 aria2 CDN·P2P 開關。"

msgid "设备传感器采集报告（只读）"
msgstr "設備傳感器採集報告（只讀）"

msgid "跨平台只读采集电池/温度/存储/运行时长/环境传感器，标出本机未提供的项（不伪造）。"
msgstr "跨平臺只讀採集電池/溫度/存儲/運行時長/環境傳感器，標出本機未提供的項（不僞造）。"

msgid "任一项读不到即标记「本机未提供」并降级，绝不补造数据。"
msgstr "任一項讀不到即標記「本機未提供」並降級，絕不補造數據。"

msgid "设备健康评分与保护报告"
msgstr "設備健康評分與保護報告"

msgid "依据传感器读数做分项健康评分（电池/存储/温湿/运行时长），回链知识库给风险与依据。"
msgstr "依據傳感器讀數做分項健康評分（電池/存儲/溫溼/運行時長），回鏈知識庫給風險與依據。"

msgid "使用量/期望年限/环境标签可在 GUI 选择后即时重算；默认 moderate/4年/无标签。"
msgstr "使用量/期望年限/環境標籤可在 GUI 選擇後即時重算；默認 moderate/4年/無標籤。"

msgid "充电策略优化（指引）"
msgstr "充電策略優化（指引）"

msgid "长期插电/期望长用的设备建议 80% 充电上限或启用优化/自适应充电，减缓满电应力。"
msgstr "長期插電/期望長用的設備建議 80% 充電上限或啓用優化/自適應充電，減緩滿電應力。"

msgid "充电阈值是 OEM 固件/驱动职责，本工具只读电量温度判断风险，不越权写寄存器。"
msgstr "充電閾值是 OEM 固件/驅動職責，本工具只讀電量溫度判斷風險，不越權寫寄存器。"

msgid "浅充浅放（20%-80%）比 0%-100% 循环寿命更长；边快充边高负载最伤电池。"
msgstr "淺充淺放（20%-80%）比 0%-100% 循環壽命更長；邊快充邊高負載最傷電池。"

msgid "散热与热节流优化（指引）"
msgstr "散熱與熱節流優化（指引）"

msgid "避免封口散热与风道堵塞，长期贴温度上限会加速焊点疲劳与化学衰减。"
msgstr "避免封口散熱與風道堵塞，長期貼溫度上限會加速焊點疲勞與化學衰減。"

msgid "热管理是保护机制，温度越高降频越狠；封口散热（被褥/包内）最伤整机寿命。"
msgstr "熱管理是保護機制，溫度越高降頻越狠；封口散熱（被褥/包內）最傷整機壽命。"

msgid "存储保养与 TRIM（指引）"
msgstr "存儲保養與 TRIM（指引）"

msgid "保留 ≥10-15% 空闲利于磨损均衡；确认 TRIM 已启用让 SSD 回收无效块。"
msgstr "保留 ≥10-15% 空閒利於磨損均衡；確認 TRIM 已啓用讓 SSD 回收無效塊。"

msgid "满盘（<10% 余量）恶化写放大与磨损均衡；重要数据多重备份而非依赖 SMART。"
msgstr "滿盤（<10% 餘量）惡化寫放大與磨損均衡；重要數據多重備份而非依賴 SMART。"

msgid "备份与例行维护（指引）"
msgstr "備份與例行維護（指引）"

msgid "把保养当日历事项：月度看更新、季度核备份、半年查电池与清灰、年度深度清灰。"
msgstr "把保養當日歷事項：月度看更新、季度核備份、半年查電池與清灰、年度深度清灰。"

msgid "SMART 显示磨损时优先备份再考虑更换；本工具只读 SMART/健康计数器并提示阈值。"
msgstr "SMART 顯示磨損時優先備份再考慮更換；本工具只讀 SMART/健康計數器並提示閾值。"

msgid "进水/受潮安全处理（指引）"
msgstr "進水/受潮安全處理（指引）"

msgid "落水/泼液/高湿环境下正确处理，避免通电短路与氯/酸迟发腐蚀。"
msgstr "落水/潑液/高溼環境下正確處理，避免通電短路與氯/酸遲發腐蝕。"

msgid "最隐蔽的是温度循环冷凝——内部结露发生在密闭腔，表面看不出；高湿环境配防潮箱。"
msgstr "最隱蔽的是溫度循環冷凝——內部結露發生在密閉腔，表面看不出；高溼環境配防潮箱。"

msgid "供电与环境安全评估（只读 + 自适应）"
msgstr "供電與環境安全評估（只讀 + 自適應）"

msgid "由供电环境标签（旧线/铜铝/无接地/木座/松动插座/高发热负载）+ 本机可读温度，识别电气火灾事故前兆链条与风险级，给自适应运行建议；每条回链知识库。"
msgstr "由供電環境標籤（舊線/銅鋁/無接地/木座/鬆動插座/高發熱負載）+ 本機可讀溫度，識別電氣火災事故前兆鏈條與風險級，給自適應運行建議；每條回鏈知識庫。"

msgid "软件不可测插座接触电阻、绝不碰配电箱；环境标签由用户据实声明（目检/电工排查）。"
msgstr "軟件不可測插座接觸電阻、絕不碰配電箱；環境標籤由用戶據實聲明（目檢/電工排查）。"

msgid "重拉全程阻燃铜芯线（规范指引）"
msgstr "重拉全程阻燃銅芯線（規範指引）"

msgid "铜铝直接混接属建筑电气火灾主因：指引从配电箱重拉全程贯通阻燃铜芯线，接头用铜铝过渡端子+抗氧化膏；绝不在含铝回路接高发热连续负载。"
msgstr "銅鋁直接混接屬建築電氣火災主因：指引從配電箱重拉全程貫通阻燃銅芯線，接頭用銅鋁過渡端子+抗氧化膏；絕不在含鋁迴路接高發熱連續負載。"

msgid "电气改造必须由持证电工按规范执行；本工具绝不测量接触电阻、绝不下发任何电气写命令。"
msgstr "電氣改造必須由持證電工按規範執行；本工具絕不測量接觸電阻、絕不下發任何電氣寫命令。"

msgid "墙内暗埋『麻花拧+胶布』接头是定时炸弹；本工具只读风险提示，施工由持证电工完成。"
msgstr "牆內暗埋『麻花擰+膠布』接頭是定時炸彈；本工具只讀風險提示，施工由持證電工完成。"

msgid "装设接地 + ≤30mA RCD/RCBO（规范指引）"
msgstr "裝設接地 + ≤30mA RCD/RCBO（規範指引）"

msgid "无可靠接地缺失 RCD 配合时，设备碰壳即触电；指引检查 PE 有效性并装设额定动作电流≤30mA 的 RCD/RCBO，定期验证动作。"
msgstr "無可靠接地缺失 RCD 配合時，設備碰殼即觸電；指引檢查 PE 有效性並裝設額定動作電流≤30mA 的 RCD/RCBO，定期驗證動作。"

msgid "RCD 是防触电最后一道闸，须在心室颤动前（≤30mA）切断；老式无接地布线缺此配合。"
msgstr "RCD 是防觸電最後一道閘，須在心室顫動前（≤30mA）切斷；老式無接地佈線缺此配合。"

msgid "更换老化插座 + 加装 AFDD（规范指引）"
msgstr "更換老化插座 + 加裝 AFDD（規範指引）"

msgid "松动/老化插座弹片疲劳、接触电阻倍增且易激发串联电弧（需 AFDD 检测）；指引更换GB/T 2099 阻燃 PC 插座+标准底盒，并在配电箱加装 AFDD。"
msgstr "鬆動/老化插座彈片疲勞、接觸電阻倍增且易激發串聯電弧（需 AFDD 檢測）；指引更換GB/T 2099 阻燃 PC 插座+標準底盒，並在配電箱加裝 AFDD。"

msgid "普通保险丝/空开对串联电弧完全失明，只有 AFDD 能识别；消除松动接头即除电弧源。"
msgstr "普通保險絲/空開對串聯電弧完全失明，只有 AFDD 能識別；消除鬆動接頭即除電弧源。"

msgid "远程接入与传输客户端 只读安全审计"
msgstr "遠程接入與傳輸客戶端 只讀安全審計"

msgid "跨平台只读审计 ssh/telnet/filezilla/putty 可用性与安全配置，标出明文风险项（不读解密口令、不改配置）。"
msgstr "跨平臺只讀審計 ssh/telnet/filezilla/putty 可用性與安全配置，標出明文風險項（不讀解密口令、不改配置）。"

msgid "telnet 明文、明文 FTP、口令登录均会被标出；本机无相关客户端即降级为文档指引。"
msgstr "telnet 明文、明文 FTP、口令登錄均會被標出；本機無相關客戶端即降級爲文檔指引。"

msgid "SSH 服务端加固（指引）"
msgstr "SSH 服務端加固（指引）"

msgid "建议 sshd 禁用口令登录改公钥、限制 root 直登、仅留 SSH-2，降低凭据与暴力风险。"
msgstr "建議 sshd 禁用口令登錄改公鑰、限制 root 直登、僅留 SSH-2，降低憑據與暴力風險。"

msgid "sshd_config 是服务端关键文件，本工具只给指引；是否改、何时改由你确认并自行备份。"
msgstr "sshd_config 是服務端關鍵文件，本工具只給指引；是否改、何時改由你確認並自行備份。"

msgid "改配置前先确保有另一可用登录方式（控制台/现有密钥），避免锁死自己。"
msgstr "改配置前先確保有另一可用登錄方式（控制檯/現有密鑰），避免鎖死自己。"

msgid "停用 telnet 明文（指引）"
msgstr "停用 telnet 明文（指引）"

msgid "telnet 全程明文，口令与数据可被嗅探；建议停用 telnetd 并改用 SSH。"
msgstr "telnet 全程明文，口令與數據可被嗅探；建議停用 telnetd 並改用 SSH。"

msgid "仅本地串行控制台/老网管设备调试才用 telnet 客户端，勿上不可信网。"
msgstr "僅本地串行控制檯/老網管設備調試才用 telnet 客戶端，勿上不可信網。"

msgid "FileZilla 站点安全（指引）"
msgstr "FileZilla 站點安全（指引）"

msgid "避免明文 FTP、给站点口令设主密码二次加密，降低凭据泄露风险。"
msgstr "避免明文 FTP、給站點口令設主密碼二次加密，降低憑據泄露風險。"

msgid "本工具只读 sitemanager.xml 的协议取值与主密码提示，绝不读取或解密任何口令。"
msgstr "本工具只讀 sitemanager.xml 的協議取值與主密碼提示，絕不讀取或解密任何口令。"

msgid "PuTTY 安全（指引，Windows）"
msgstr "PuTTY 安全（指引，Windows）"

msgid "PuTTY 默认 SSH + ED25519 公钥，避免用其 Telnet 模式上不可信网。"
msgstr "PuTTY 默認 SSH + ED25519 公鑰，避免用其 Telnet 模式上不可信網。"

msgid "PuTTY 的 Telnet 模式仅本地串行调试用；私钥放 pageant 而非明文落盘口令。"
msgstr "PuTTY 的 Telnet 模式僅本地串行調試用；私鑰放 pageant 而非明文落盤口令。"

msgid "连接保活与重连（只读观测 + 指引）"
msgstr "連接保活與重連（只讀觀測 + 指引）"

msgid "只读检查 SSH 客户端 ServerAliveInterval 保活心跳，给 TCP keepalive / autossh / VPN 自动重连的通用指引（D10 借鉴自 docker-easyconnect 自动保活实践）；绝不改连接配置、绝不注入重连进程。"
msgstr "只讀檢查 SSH 客戶端 ServerAliveInterval 保活心跳，給 TCP keepalive / autossh / VPN 自動重連的通用指引（D10 借鑑自 docker-easyconnect 自動保活實踐）；絕不改連接配置、絕不注入重連進程。"

msgid "对外服务暴露面遵循「默认拒绝入站、端口只绑 localhost」的基线（见安全基线）——保活只管本端连接韧性，不扩大对外暴露面。"
msgstr "對外服務暴露面遵循「默認拒絕入站、端口只綁 localhost」的基線（見安全基線）——保活只管本端連接韌性，不擴大對外暴露面。"

msgid "证书与加密 只读安全审计"
msgstr "證書與加密 只讀安全審計"

msgid "整合 OpenSSL/LibreSSL/BoringSSL/GnuTLS 等开源加密栈与硬件信任根，做只读审计；标出 EOL 加密库、未启用 TPM、临近过期证书等风险。绝不读私钥、绝不解密、绝不改配置。"
msgstr "整合 OpenSSL/LibreSSL/BoringSSL/GnuTLS 等開源加密棧與硬件信任根，做只讀審計；標出 EOL 加密庫、未啓用 TPM、臨近過期證書等風險。絕不讀私鑰、絕不解密、絕不改配置。"

msgid "审计结果含无障碍纯文本(a11y_cert_summary)，屏幕阅读器可直接朗读"
msgstr "審計結果含無障礙純文本(a11y_cert_summary)，屏幕閱讀器可直接朗讀"

msgid "升级 EOL 开源加密库（指引）"
msgstr "升級 EOL 開源加密庫（指引）"

msgid "OpenSSL 1.0.2/1.1.0/1.1.1 等已 EOL，存在未修漏洞；提示升级到受支持分支或接入开源替代。"
msgstr "OpenSSL 1.0.2/1.1.0/1.1.1 等已 EOL，存在未修漏洞；提示升級到受支持分支或接入開源替代。"

msgid "中危指引，需用户在 GUI 确认后自行执行"
msgstr "中危指引，需用戶在 GUI 確認後自行執行"

msgid "启用硬件信任根（TPM/Secure Enclave，指引）"
msgstr "啓用硬件信任根（TPM/Secure Enclave，指引）"

msgid "以 TPM 2.0 / 设备身份证书(802.1AR IDevID) 为硬件信任根，把高价值私钥锁在芯片/Enclave 内。"
msgstr "以 TPM 2.0 / 設備身份證書(802.1AR IDevID) 爲硬件信任根，把高價值私鑰鎖在芯片/Enclave 內。"

msgid "中危指引，涉及固件/加密设置，需用户确认"
msgstr "中危指引，涉及固件/加密設置，需用戶確認"

msgid "密钥锁平台硬件密钥库（指引）"
msgstr "密鑰鎖平臺硬件密鑰庫（指引）"

msgid "引导高价值私钥进入平台硬件支持密钥库（Keychain/Secure Enclave/CNG/Android Keystore）。"
msgstr "引導高價值私鑰進入平臺硬件支持密鑰庫（Keychain/Secure Enclave/CNG/Android Keystore）。"

msgid "低风险指引，纯建议"
msgstr "低風險指引，純建議"

msgid "证书到期只读预警"
msgstr "證書到期只讀預警"

msgid "只读核查常见证书位置到期日，临近过期给出续期提醒（优先 ACME 自动续期），避免通信中断。"
msgstr "只讀覈查常見證書位置到期日，臨近過期給出續期提醒（優先 ACME 自動續期），避免通信中斷。"

msgid "只读预警；续期由用户/ACME 客户端执行"
msgstr "只讀預警；續期由用戶/ACME 客戶端執行"

msgid "兼容层串联盘点（四层依赖 + 场景结论，只读）"
msgstr "兼容層串聯盤點（四層依賴 + 場景結論，只讀）"

msgid "把 proton/dosbox/wsl/virtgpu/legacy 串成一条四层依赖链：宿主底座 → 设备与图形 → 兼容运行时 → 供给。按场景给结论（跑 Windows 程序 / 跑 DOS 程序 / 在 Windows 上跑 Linux / 跑遗留嵌入式），缺任一层即判「缺层」，本机不适用不判「已通」。"
msgstr "把 proton/dosbox/wsl/virtgpu/legacy 串成一條四層依賴鏈：宿主底座 → 設備與圖形 → 兼容運行時 → 供給。按場景給結論（跑 Windows 程序 / 跑 DOS 程序 / 在 Windows 上跑 Linux / 跑遺留嵌入式），缺任一層即判「缺層」，本機不適用不判「已通」。"

msgid "只读任务：不安装任何运行时、不启用任何服务、不改任何配置。"
msgstr "只讀任務：不安裝任何運行時、不啓用任何服務、不改任何配置。"

msgid "盘点结果来自各模块既有的零参只读报告，与同名 CLI `compat` 完全一致。"
msgstr "盤點結果來自各模塊既有的零參只讀報告，與同名 CLI `compat` 完全一致。"

msgid "上层能不能用取决于下层给不给得了：Proton 要 Vulkan（设备层）与 32 位运行时（供给层），缺任何一层，运行时这一层就是空转。"
msgstr "上層能不能用取決於下層給不給得了：Proton 要 Vulkan（設備層）與 32 位運行時（供給層），缺任何一層，運行時這一層就是空轉。"

msgid "**不适用 ≠ 已就绪**：本机 Linux 时 WSL 探测会跑通但正文是「未识别为 WSL 环境」，报告判「本机不适用」而不是「链路已通」。"
msgstr "**不適用 ≠ 已就緒**：本機 Linux 時 WSL 探測會跑通但正文是「未識別爲 WSL 環境」，報告判「本機不適用」而不是「鏈路已通」。"

msgid "跑 Windows 程序/游戏的官方路径（只给命令，不代装）"
msgstr "跑 Windows 程序/遊戲的官方路徑（只給命令，不代裝）"

msgid "给出在 Linux 上跑 Windows 程序的两条官方路径与选型：办公老程序用 Wine（独立前缀），游戏用 Proton（自带依赖与图形转译层）。只输出命令文本，是否安装由你决定。"
msgstr "給出在 Linux 上跑 Windows 程序的兩條官方路徑與選型：辦公老程序用 Wine（獨立前綴），遊戲用 Proton（自帶依賴與圖形轉譯層）。只輸出命令文本，是否安裝由你決定。"

msgid "指引类任务：只打印命令文本，不自动安装、不启用任何东西。"
msgstr "指引類任務：只打印命令文本，不自動安裝、不啓用任何東西。"

msgid "装 Wine/Proton 会占用磁盘与依赖；游戏前缀动辄数 GB，留好空间。"
msgstr "裝 Wine/Proton 會佔用磁盤與依賴；遊戲前綴動輒數 GB，留好空間。"

msgid "选型：要「能跑起来」用 Proton；要「干净可控」用 Wine + 独立 WINEPREFIX，别混用默认前缀。"
msgstr "選型：要「能跑起來」用 Proton；要「乾淨可控」用 Wine + 獨立 WINEPREFIX，別混用默認前綴。"

msgid "同步原语优先 NTSync（新内核）→ fsync → esync 逐档降级；内核太老就退到 esync。"
msgstr "同步原語優先 NTSync（新內核）→ fsync → esync 逐檔降級；內核太老就退到 esync。"

msgid "32 位程序要装对应的 32 位运行时（i386），发行版不给就装不上——这是供给层的事。"
msgstr "32 位程序要裝對應的 32 位運行時（i386），發行版不給就裝不上——這是供給層的事。"

msgid "跑 DOS 与遗留嵌入式的官方路径（只给命令，不代装）"
msgstr "跑 DOS 與遺留嵌入式的官方路徑（只給命令，不代裝）"

msgid "给出跑老 DOS 程序（DOSBox 模拟）与遗留/嵌入式用户态（busybox）的官方路径与命令文本。"
msgstr "給出跑老 DOS 程序（DOSBox 模擬）與遺留/嵌入式用戶態（busybox）的官方路徑與命令文本。"

msgid "指引类任务：只打印命令文本，不代装、不启用。"
msgstr "指引類任務：只打印命令文本，不代裝、不啓用。"

msgid "DOSBox 的 cycles 调太高会让老程序跑飞；从低档往上试。"
msgstr "DOSBox 的 cycles 調太高會讓老程序跑飛；從低檔往上試。"

msgid "DOSBox 是**模拟**（连 CPU 都模拟），Wine 是**重实现**（翻译 API）——两者思路不同，前者兼容性高、后者性能好。"
msgstr "DOSBox 是**模擬**（連 CPU 都模擬），Wine 是**重實現**（翻譯 API）——兩者思路不同，前者兼容性高、後者性能好。"

msgid "WSL 是反向桥：别人在 Windows 上跑 Linux，与 Wine/Proton 方向相反、思路同源。"
msgstr "WSL 是反向橋：別人在 Windows 上跑 Linux，與 Wine/Proton 方向相反、思路同源。"

msgid "外部设备连接与兼容评估（只读 + 标准引入）"
msgstr "外部設備連接與兼容評估（只讀 + 標準引入）"

msgid "整体引入星闪(NearLink)标准，并据设备标签（触控/USB-C PD/HID/星闪）只读识别触控设备与多点触控协议、USB 版本与 PD 能力、HID 即插即用状态，给兼容与选型建议；每条回链知识库。"
msgstr "整體引入星閃(NearLink)標準，並據設備標籤（觸控/USB-C PD/HID/星閃）只讀識別觸控設備與多點觸控協議、USB 版本與 PD 能力、HID 即插即用狀態，給兼容與選型建議；每條回鏈知識庫。"

msgid "软件只读能力面：不刷固件、不装私有驱动、不挂钩输入流、不改写 PD 协商。"
msgstr "軟件只讀能力面：不刷固件、不裝私有驅動、不掛鉤輸入流、不改寫 PD 協商。"

msgid "按星闪(NearLink)选型无线外设（规范指引）"
msgstr "按星閃(NearLink)選型無線外設（規範指引）"

msgid "把星闪作为外部设备连接与兼容的推荐国产短距无线标准整体引入：无线鼠标/键盘/手写笔/耳机优先按星闪选型，微秒时延+一拖上千并发，接入须配对与身份校验。"
msgstr "把星閃作爲外部設備連接與兼容的推薦國產短距無線標準整體引入：無線鼠標/鍵盤/手寫筆/耳機優先按星閃選型，微秒時延+一拖上千併發，接入須配對與身份校驗。"

msgid "星闪固件写入/刷写属不可逆高风险，本工具绝不执行；由用户在厂商工具确认。"
msgstr "星閃固件寫入/刷寫屬不可逆高風險，本工具絕不執行；由用戶在廠商工具確認。"

msgid "星闪经 SoC/复合 dongle 接入，软件只能力面识别，不探测私有固件。"
msgstr "星閃經 SoC/複合 dongle 接入，軟件只能力面識別，不探測私有固件。"

msgid "触控设备驱动与兼容（规范指引）"
msgstr "觸控設備驅動與兼容（規範指引）"

msgid "只读识别触控屏/精确触控板与多点触控协议（MT-A/MT-B）；缺 hid-multitouch/I2C-HID 即给官方指引，绝不采集按键/触控内容。"
msgstr "只讀識別觸控屏/精確觸控板與多點觸控協議（MT-A/MT-B）；缺 hid-multitouch/I2C-HID 即給官方指引，絕不採集按鍵/觸控內容。"

msgid "本工具只读识别触控设备与协议类型，绝不挂钩输入流（契合键盘/输入内容刻意不采集的红线）。"
msgstr "本工具只讀識別觸控設備與協議類型，絕不掛鉤輸入流（契合鍵盤/輸入內容刻意不採集的紅線）。"

msgid "USB-C/USB4 与 PD 供电兼容（规范指引）"
msgstr "USB-C/USB4 與 PD 供電兼容（規範指引）"

msgid "只读识别 USB 版本（2.0/3.2/4）与 PD 能力（是否 EPR/双向）；提示带 e-Marker 线缆才支持 100W/视频，标注欧盟 IEC 62680 强制 USB-C；绝不改写 PD 协商、不刷接口固件。"
msgstr "只讀識別 USB 版本（2.0/3.2/4）與 PD 能力（是否 EPR/雙向）；提示帶 e-Marker 線纜才支持 100W/視頻，標註歐盟 IEC 62680 強制 USB-C；絕不改寫 PD 協商、不刷接口固件。"

msgid "PD 由端口与设备经 CC 线私有协商，软件只能读已协商结果，不能改写功率档。"
msgstr "PD 由端口與設備經 CC 線私有協商，軟件只能讀已協商結果，不能改寫功率檔。"

msgid "时空与全维度报告（只读观测 + 循环往复管理器）"
msgstr "時空與全維度報告（只讀觀測 + 循環往復管理器）"

msgid "以量子/计算机原理为透镜，只读观测时间维（时钟/时区/生命周期）、空间维（存储/地址空间/NUMA）、施时空组合维（事件-资源因果链）、未来兼容维（标准 EOL/后量子），并跑全时空全维度循环往复管理器（round-robin 周而复始、每维一视同仁），每条回链知识库。"
msgstr "以量子/計算機原理爲透鏡，只讀觀測時間維（時鐘/時區/生命週期）、空間維（存儲/地址空間/NUMA）、施時空組合維（事件-資源因果鏈）、未來兼容維（標準 EOL/後量子），並跑全時空全維度循環往復管理器（round-robin 週而復始、每維一視同仁），每條回鏈知識庫。"

msgid "软件只读能力面：不改时钟/时区、不分区/格式化、不升级替换组件、不执行量子写操作。"
msgstr "軟件只讀能力面：不改時鐘/時區、不分區/格式化、不升級替換組件、不執行量子寫操作。"

msgid "时钟同步与时区校准（规范指引）"
msgstr "時鐘同步與時區校準（規範指引）"

msgid "只读观测时间维（时钟同步偏差、时区一致性、生命周期阶段）；给出 NTP/PTP 同步与时区校准的规范指引，绝不自动改时钟/时区。"
msgstr "只讀觀測時間維（時鐘同步偏差、時區一致性、生命週期階段）；給出 NTP/PTP 同步與時區校準的規範指引，絕不自動改時鐘/時區。"

msgid "时间维只观测不改正；任何改时钟/时区由用户在系统设置或厂商工具确认。"
msgstr "時間維只觀測不改正；任何改時鐘/時區由用戶在系統設置或廠商工具確認。"

msgid "空间维盘点与扩容（规范指引）"
msgstr "空間維盤點與擴容（規範指引）"

msgid "只读盘点空间维（磁盘分区占用、内存容量、挂载点、NUMA 拓扑）；给出扩容/迁移的规范指引，绝不自动分区/格式化/清理。"
msgstr "只讀盤點空間維（磁盤分區佔用、內存容量、掛載點、NUMA 拓撲）；給出擴容/遷移的規範指引，絕不自動分區/格式化/清理。"

msgid "空间维只盘点不整理；任何分区/格式化/清理由用户在图形界面或厂商工具确认。"
msgstr "空間維只盤點不整理；任何分區/格式化/清理由用戶在圖形界面或廠商工具確認。"

msgid "未来兼容迁移（EOL / 后量子，规范指引）"
msgstr "未來兼容遷移（EOL / 後量子，規範指引）"

msgid "只读评估未来兼容维（标准/组件 EOL、后量子迁移、前向兼容原则）；给出迁移方向，绝不自动升级/替换组件。"
msgstr "只讀評估未來兼容維（標準/組件 EOL、後量子遷移、前向兼容原則）；給出遷移方向，絕不自動升級/替換組件。"

msgid "未来兼容维只评估给迁移方向；任何升级/替换由用户/厂商工具执行。"
msgstr "未來兼容維只評估給遷移方向；任何升級/替換由用戶/廠商工具執行。"

msgid "软件包规范审计（按系统/硬件/相关软件包检测包管理器 + 四类操作层级应对）"
msgstr "軟件包規範審計（按系統/硬件/相關軟件包檢測包管理器 + 四類操作層級應對）"

msgid "只读检测当前系统的包管理器（apt/dnf/pacman/brew/winget/choco/apk/scoop/zypper），审计安装/卸载/配置/设置优化四类操作是否符合包规范，并给出层级应对（一律指引不代执行）。"
msgstr "只讀檢測當前系統的包管理器（apt/dnf/pacman/brew/winget/choco/apk/scoop/zypper），審計安裝/卸載/配置/設置優化四類操作是否符合包規範，並給出層級應對（一律指引不代執行）。"

msgid "软件只读能力面：只审计、只出层级应对，不 install/uninstall/configure/optimize 任何包。"
msgstr "軟件只讀能力面：只審計、只出層級應對，不 install/uninstall/configure/optimize 任何包。"

msgid "包安装规范（层级应对指引）"
msgstr "包安裝規範（層級應對指引）"

msgid "给出在当前包管理器下安装软件包的规范与层级应对：走官方接口、禁止手工改包数据库、签名/GPG 校验失败即停。绝不自动安装。"
msgstr "給出在當前包管理器下安裝軟件包的規範與層級應對：走官方接口、禁止手工改包數據庫、簽名/GPG 校驗失敗即停。絕不自動安裝。"

msgid "安装属写操作，一律只给层级应对指引；是否施工由用户在系统包管理器确认。"
msgstr "安裝屬寫操作，一律只給層級應對指引；是否施工由用戶在系統包管理器確認。"

msgid "包卸载规范（层级应对指引）"
msgstr "包卸載規範（層級應對指引）"

msgid "给出在当前包管理器下卸载软件包的规范与层级应对：走官方接口回收依赖、不手工删库。绝不自动卸载。"
msgstr "給出在當前包管理器下卸載軟件包的規範與層級應對：走官方接口回收依賴、不手工刪庫。絕不自動卸載。"

msgid "卸载属写操作，一律只给层级应对指引；是否施工由用户确认。"
msgstr "卸載屬寫操作，一律只給層級應對指引；是否施工由用戶確認。"

msgid "包配置规范（层级应对指引）"
msgstr "包配置規範（層級應對指引）"

msgid "给出在当前包管理器下配置软件包/源的规范与层级应对：源与钉版走 drop-in 片段、不内联改主文件。绝不自动改写。"
msgstr "給出在當前包管理器下配置軟件包/源的規範與層級應對：源與釘版走 drop-in 片段、不內聯改主文件。絕不自動改寫。"

msgid "配置属写操作，一律只给层级应对指引；是否施工由用户确认。"
msgstr "配置屬寫操作，一律只給層級應對指引；是否施工由用戶確認。"

msgid "包设置优化规范（层级应对指引）"
msgstr "包設置優化規範（層級應對指引）"

msgid "给出在当前包管理器下设置优化（缓存清理/升级）的规范与层级应对：缓存回收走官方 clean、升级逐包确认。绝不自动大版本跨跳。"
msgstr "給出在當前包管理器下設置優化（緩存清理/升級）的規範與層級應對：緩存回收走官方 clean、升級逐包確認。絕不自動大版本跨跳。"

msgid "优化属写操作，一律只给层级应对指引；是否施工由用户确认。"
msgstr "優化屬寫操作，一律只給層級應對指引；是否施工由用戶確認。"

msgid "虚拟机环境识别与优雅降级（只读报告）"
msgstr "虛擬機環境識別與優雅降級（只讀報告）"

msgid "只读识别本工具自身运行在裸金属/KVM/VMware/VirtualBox/Hyper-V/Xen/WSL/容器哪一层，并给出该环境下各只读探针的「可用/退化」结论，确保整体在不同虚拟机内都能正常运行（只降级不崩溃）。绝不装增强工具/改配置/加载模块。"
msgstr "只讀識別本工具自身運行在裸金屬/KVM/VMware/VirtualBox/Hyper-V/Xen/WSL/容器哪一層，並給出該環境下各只讀探針的「可用/退化」結論，確保整體在不同虛擬機內都能正常運行（只降級不崩潰）。絕不裝增強工具/改配置/加載模塊。"

msgid "软件只读能力面：只探测、只降级、只给指引，不装驱动/不改配置/不加载内核模块。"
msgstr "軟件只讀能力面：只探測、只降級、只給指引，不裝驅動/不改配置/不加載內核模塊。"

msgid "guest 内增强工具安装（规范指引）"
msgstr "guest 內增強工具安裝（規範指引）"

msgid "给出在 KVM/QEMU、VMware、VirtualBox、Hyper-V、WSL 内安装增强工具（open-vm-tools/Guest Additions/virtio 驱动/Linux 集成服务）的规范指引，绝不自动安装。"
msgstr "給出在 KVM/QEMU、VMware、VirtualBox、Hyper-V、WSL 內安裝增強工具（open-vm-tools/Guest Additions/virtio 驅動/Linux 集成服務）的規範指引，絕不自動安裝。"

msgid "增强工具安装属于写操作，一律只给规范指引；是否施工由用户在 guest 内或厂商工具确认。"
msgstr "增強工具安裝屬於寫操作，一律只給規範指引；是否施工由用戶在 guest 內或廠商工具確認。"

msgid "虚拟机完整运行支持（只读探测 + 模板生成）"
msgstr "虛擬機完整運行支持（只讀探測 + 模板生成）"

msgid "只读探测本机能否完整跑起一层虚拟化（/dev/kvm 可读性、CPU VT-x/AMD-V 标志、嵌套开关 kvm_intel.nested/kvm_amd.nested），列出可嵌入 initramfs 的半虚拟化驱动模块（virtio/9p/vhost/DRM/Hyper-V/Xen 前端）并给 dracut/mkinitcpio/update-initramfs 嵌入指引，生成各 Hypervisor 只读运行配置模板（libvirt XML / QEMU 命令行 / VBoxManage / VMware .vmx / WSL .wslconfig）。绝不加载内核模块/启动 VM/装驱动/改配置——只探测、只生成模板、只给指引。"
msgstr "只讀探測本機能否完整跑起一層虛擬化（/dev/kvm 可讀性、CPU VT-x/AMD-V 標誌、嵌套開關 kvm_intel.nested/kvm_amd.nested），列出可嵌入 initramfs 的半虛擬化驅動模塊（virtio/9p/vhost/DRM/Hyper-V/Xen 前端）並給 dracut/mkinitcpio/update-initramfs 嵌入指引，生成各 Hypervisor 只讀運行配置模板（libvirt XML / QEMU 命令行 / VBoxManage / VMware .vmx / WSL .wslconfig）。絕不加載內核模塊/啓動 VM/裝驅動/改配置——只探測、只生成模板、只給指引。"

msgid "完整运行支持严守只读红线：只探测/模板/指引，不加载内核模块、不启动 VM、不装驱动、不改配置；是否施工始终由用户在 guest 内或厂商工具确认。"
msgstr "完整運行支持嚴守只讀紅線：只探測/模板/指引，不加載內核模塊、不啓動 VM、不裝驅動、不改配置；是否施工始終由用戶在 guest 內或廠商工具確認。"

msgid "AP 集中控制器只读审计（hostapd/NetworkManager/dnsmasq/apcontroller）"
msgstr "AP 集中控制器只讀審計（hostapd/NetworkManager/dnsmasq/apcontroller）"

msgid "只读审计本机/网内有哪些 AP 栈与集中管理痕迹：hostapd 配置（不回显口令）、NetworkManager 共享热点、dnsmasq DHCP/DNS、apcontroller 思路的脚本/配置目录；给出集中下发 WiFi 配置的合规指引。绝不读解密口令、绝不改任何 AP 配置。"
msgstr "只讀審計本機/網內有哪些 AP 棧與集中管理痕跡：hostapd 配置（不回顯口令）、NetworkManager 共享熱點、dnsmasq DHCP/DNS、apcontroller 思路的腳本/配置目錄；給出集中下發 WiFi 配置的合規指引。絕不讀解密口令、絕不改任何 AP 配置。"

msgid "AP 只读审计：只探测、只给指引、绝不下发配置、绝不读解密口令。"
msgstr "AP 只讀審計：只探測、只給指引、絕不下發配置、絕不讀解密口令。"

msgid "AP Group 下发 WiFi 配置（规范指引）"
msgstr "AP Group 下發 WiFi 配置（規範指引）"

msgid "给出按 AP Group 集中下发 WiFi 配置的规范指引（obsy/apcontroller 思路），绝不自动下发。"
msgstr "給出按 AP Group 集中下發 WiFi 配置的規範指引（obsy/apcontroller 思路），絕不自動下發。"

msgid "下发属于写操作，一律只给规范指引；是否施工由用户在控制器或厂商工具确认。"
msgstr "下發屬於寫操作，一律只給規範指引；是否施工由用戶在控制器或廠商工具確認。"

msgid "LLVM 工具链与交叉编译目标矩阵（只读）"
msgstr "LLVM 工具鏈與交叉編譯目標矩陣（只讀）"

msgid "只读探测 LLVM 工具链（clang/lld/mlir），并给出按时间序列逐步扩充的交叉编译目标矩阵（aarch64/armv7/riscv64/x86_64-mingw/wasm32…），含 sysroot 指引与 CHANGELOG。绝不编译、绝不下载 sysroot、绝不改写工具链配置。"
msgstr "只讀探測 LLVM 工具鏈（clang/lld/mlir），並給出按時間序列逐步擴充的交叉編譯目標矩陣（aarch64/armv7/riscv64/x86_64-mingw/wasm32…），含 sysroot 指引與 CHANGELOG。絕不編譯、絕不下載 sysroot、絕不改寫工具鏈配置。"

msgid "LLVM 只读探测：只探测、只出矩阵、只给 sysroot 指引。"
msgstr "LLVM 只讀探測：只探測、只出矩陣、只給 sysroot 指引。"

msgid "LLVM 交叉编译（规范指引）"
msgstr "LLVM 交叉編譯（規範指引）"

msgid "给出用 clang --target=<triple> 做交叉编译的规范指引，绝不自动编译。"
msgstr "給出用 clang --target=<triple> 做交叉編譯的規範指引，絕不自動編譯。"

msgid "编译属于写操作，一律只给规范指引；是否施工由用户在构建脚本确认。"
msgstr "編譯屬於寫操作，一律只給規範指引；是否施工由用戶在構建腳本確認。"

msgid "组网优化与设备协同只读报告（WireGuard P2P + 设备能力适配）"
msgstr "組網優化與設備協同只讀報告（WireGuard P2P + 設備能力適配）"

msgid "只读观测组网：WireGuard 拓扑（wg show）、设备能力适配（算力/GPU/存储缓存）、负载均衡与协同共享。来源缺口：Mullvad 官方页未抓取，基于已知 Meshnet 模型。绝不新增 peer、绝不改 wg 配置、绝不动设备权限。"
msgstr "只讀觀測組網：WireGuard 拓撲（wg show）、設備能力適配（算力/GPU/存儲緩存）、負載均衡與協同共享。來源缺口：Mullvad 官方頁未抓取，基於已知 Meshnet 模型。絕不新增 peer、絕不改 wg 配置、絕不動設備權限。"

msgid "Meshnet 只读观测：只观测、只给指引、绝不写 wg 配置、绝不共享个人数据。"
msgstr "Meshnet 只讀觀測：只觀測、只給指引、絕不寫 wg 配置、絕不共享個人數據。"

msgid "WireGuard 新增 Meshnet 设备（规范指引）"
msgstr "WireGuard 新增 Meshnet 設備（規範指引）"

msgid "给出用 wg set 新增 Meshnet 设备的规范指引（双端密钥、allowed-ips、权限），绝不自动执行。"
msgstr "給出用 wg set 新增 Meshnet 設備的規範指引（雙端密鑰、allowed-ips、權限），絕不自動執行。"

msgid "加 peer 属于写操作，一律只给规范指引；是否施工由用户在设备/厂商工具确认。"
msgstr "加 peer 屬於寫操作，一律只給規範指引；是否施工由用戶在設備/廠商工具確認。"

msgid "虚拟根 DNS 与多 CDN 只读报告"
msgstr "虛擬根 DNS 與多 CDN 只讀報告"

msgid "只读观测虚拟根 DNS（/etc/resolv.conf nameserver、DoH/DoT 是否可用）、多 CDN 选择（/etc/hosts 与常见 CDN 域名）与一次良性解析健康。绝不改 DNS、绝不切 DoH/DoT。"
msgstr "只讀觀測虛擬根 DNS（/etc/resolv.conf nameserver、DoH/DoT 是否可用）、多 CDN 選擇（/etc/hosts 與常見 CDN 域名）與一次良性解析健康。絕不改 DNS、絕不切 DoH/DoT。"

msgid "vdns 只读观测：只观测、只给指引、绝不写 DNS 配置。"
msgstr "vdns 只讀觀測：只觀測、只給指引、絕不寫 DNS 配置。"

msgid "启用 DoT/DoH（规范指引）"
msgstr "啓用 DoT/DoH（規範指引）"

msgid "给出启用 DoT/DoH 的规范指引（systemd-resolved / stubby / cloudflared），绝不自动改 DNS。"
msgstr "給出啓用 DoT/DoH 的規範指引（systemd-resolved / stubby / cloudflared），絕不自動改 DNS。"

msgid "改 DNS 属于写操作，一律只给规范指引；是否施工由用户在网络管理或厂商工具确认。"
msgstr "改 DNS 屬於寫操作，一律只給規範指引；是否施工由用戶在網絡管理或廠商工具確認。"

msgid "IPP 打印协议发现只读报告（CUPS / mDNS / 本地管理页）"
msgstr "IPP 打印協議發現只讀報告（CUPS / mDNS / 本地管理頁）"

msgid "只读发现 IPP 打印设备：CUPS 队列（lpstat -v）、网内 mDNS（avahi-browse _ipp._tcp）、CUPS 管理页 localhost:631 可达性、协议标准（RFC 8010/8011/IPP Everywhere）。绝不改打印队列、绝不连控制端口写。"
msgstr "只讀發現 IPP 打印設備：CUPS 隊列（lpstat -v）、網內 mDNS（avahi-browse _ipp._tcp）、CUPS 管理頁 localhost:631 可達性、協議標準（RFC 8010/8011/IPP Everywhere）。絕不改打印隊列、絕不連控制端口寫。"

msgid "IPP 只读发现：只发现、只给指引、绝不写打印配置。"
msgstr "IPP 只讀發現：只發現、只給指引、絕不寫打印配置。"

msgid "添加 IPP 打印机（规范指引）"
msgstr "添加 IPP 打印機（規範指引）"

msgid "给出用 lpadmin 添加 IPP 打印机的规范指引（IPP Everywhere 驱动无关），绝不自动加打印机。"
msgstr "給出用 lpadmin 添加 IPP 打印機的規範指引（IPP Everywhere 驅動無關），絕不自動加打印機。"

msgid "加打印机属于写操作，一律只给规范指引；是否施工由用户在系统设置或 CUPS 管理页确认。"
msgstr "加打印機屬於寫操作，一律只給規範指引；是否施工由用戶在系統設置或 CUPS 管理頁確認。"

msgid "现代设备显示与 GPU 只读报告（保留控制台/终端/远程终端）"
msgstr "現代設備顯示與 GPU 只讀報告（保留控制檯/終端/遠程終端）"

msgid "只读观测显示服务器（XDG_SESSION_TYPE 判 X11/Wayland/Tty）、GPU 与渲染后端（lspci/glxinfo/vulkaninfo）、当前分辨率（xrandr）；显式确认控制台/终端/远程终端入口始终保留。推进图形化不移除这些入口。绝不装驱动、绝不切 Wayland。"
msgstr "只讀觀測顯示服務器（XDG_SESSION_TYPE 判 X11/Wayland/Tty）、GPU 與渲染後端（lspci/glxinfo/vulkaninfo）、當前分辨率（xrandr）；顯式確認控制檯/終端/遠程終端入口始終保留。推進圖形化不移除這些入口。絕不裝驅動、絕不切 Wayland。"

msgid "display 只读观测：只观测、只给指引、绝不写显示配置；控制台/终端/远程终端始终保留。"
msgstr "display 只讀觀測：只觀測、只給指引、絕不寫顯示配置；控制檯/終端/遠程終端始終保留。"

msgid "GPU 驱动安装（规范指引）"
msgstr "GPU 驅動安裝（規範指引）"

msgid "给出 GPU 驱动安装的规范指引（开源栈优先：Mesa + 对应内核驱动），绝不自动装驱动。"
msgstr "給出 GPU 驅動安裝的規範指引（開源棧優先：Mesa + 對應內核驅動），絕不自動裝驅動。"

msgid "装驱动属于写操作，一律只给规范指引；是否施工由用户在系统设置或厂商工具确认。"
msgstr "裝驅動屬於寫操作，一律只給規範指引；是否施工由用戶在系統設置或廠商工具確認。"

msgid "常态化回头看、久久为功（维护节奏表 + 长期保障要点 + 易漂移维度复盘）"
msgstr "常態化回頭看、久久爲功（維護節奏表 + 長期保障要點 + 易漂移維度覆盤）"

msgid "只读汇总「该定期回头看什么」：维护节奏表（各维按什么周期回头看）、长期保障要点（从 durability/electrical 只读汇总）、易漂移维度复盘提示（标准 EOL/后量子/驱动）。与 novel-framework「每卷末/每 20 章体检」同源思路——常态化的回头看。"
msgstr "只讀彙總「該定期回頭看什麼」：維護節奏表（各維按什麼週期回頭看）、長期保障要點（從 durability/electrical 只讀彙總）、易漂移維度覆盤提示（標準 EOL/後量子/驅動）。與 novel-framework「每卷末/每 20 章體檢」同源思路——常態化的回頭看。"

msgid "retro 只读汇总提醒：不替你做任何操作，只把「该回头看什么」说清楚。"
msgstr "retro 只讀彙總提醒：不替你做任何操作，只把「該回頭看什麼」說清楚。"

msgid "人类文明重启计划场景透镜（维度清单 + 保命优先级 + 知识库沉淀）"
msgstr "人類文明重啓計劃場景透鏡（維度清單 + 保命優先級 + 知識庫沉澱）"

msgid "只读场景透镜：文明重启维度清单（计算/网络/供电/存储与知识库/制造与供应链/人才与训练）、保命优先级（不可再生优先——知识库>制造>人才>供电>计算网络）、知识库离线沉淀指引（与 sysweeper 知识库同口径，优先开放许可）。绝不替你做任何施工/搬运。"
msgstr "只讀場景透鏡：文明重啓維度清單（計算/網絡/供電/存儲與知識庫/製造與供應鏈/人才與訓練）、保命優先級（不可再生優先——知識庫>製造>人才>供電>計算網絡）、知識庫離線沉澱指引（與 sysweeper 知識庫同口徑，優先開放許可）。絕不替你做任何施工/搬運。"

msgid "restart 只读场景透镜：只帮你想清楚「重启要保什么、按什么序」，不做任何施工。"
msgstr "restart 只讀場景透鏡：只幫你想清楚「重啓要保什麼、按什麼序」，不做任何施工。"

msgid "TLS 1.3 配置态势 只读审计"
msgstr "TLS 1.3 配置態勢 只讀審計"

msgid "以 RFC 9846（TLS 1.3, 2026-07）为基准，只读核查系统 TLS 配置并分级：淘汰 SSL 2.0/3.0、TLS 1.0/1.1，为老旧设备保留并硬化 TLS 1.2，把 TLS 1.3 作主力。输出为纯文本，屏幕阅读器可朗读、适老人话。绝不读私钥、绝不改配置。"
msgstr "以 RFC 9846（TLS 1.3, 2026-07）爲基準，只讀覈查系統 TLS 配置並分級：淘汰 SSL 2.0/3.0、TLS 1.0/1.1，爲老舊設備保留並硬化 TLS 1.2，把 TLS 1.3 作主力。輸出爲純文本，屏幕閱讀器可朗讀、適老人話。絕不讀私鑰、絕不改配置。"

msgid "无障碍：纯文本输出，含『人话简述』，屏幕阅读器可直接朗读，无图形依赖"
msgstr "無障礙：純文本輸出，含『人話簡述』，屏幕閱讀器可直接朗讀，無圖形依賴"

msgid "『KEM 就绪度』仅检测加密栈是否提供 KEM 组，不实现 ML-KEM"
msgstr "『KEM 就緒度』僅檢測加密棧是否提供 KEM 組，不實現 ML-KEM"

msgid "老旧设备兼容：不会一刀切要求关停 TLS 1.2，而是保留为兼容桥并提示加固"
msgstr "老舊設備兼容：不會一刀切要求關停 TLS 1.2，而是保留爲兼容橋並提示加固"

msgid "禁用真正淘汰的旧 TLS 版本（指引）"
msgstr "禁用真正淘汰的舊 TLS 版本（指引）"

msgid "按 RFC 8996/9846 淘汰 SSL 2.0/3.0、TLS 1.0/1.1；明确保留 TLS 1.2 以免老旧设备/设施失联。"
msgstr "按 RFC 8996/9846 淘汰 SSL 2.0/3.0、TLS 1.0/1.1；明確保留 TLS 1.2 以免老舊設備/設施失聯。"

msgid "中危指引，需用户在 GUI 确认后自行执行；本工具不代改任何设置"
msgstr "中危指引，需用戶在 GUI 確認後自行執行；本工具不代改任何設置"

msgid "关键：保留 TLS 1.2 作老旧设备兼容桥，不做一刀切"
msgstr "關鍵：保留 TLS 1.2 作老舊設備兼容橋，不做一刀切"

msgid "老旧设备/设施 TLS 兼容共存（指引）"
msgstr "老舊設備/設施 TLS 兼容共存（指引）"

msgid "为仍依赖 TLS 1.2 的老旧设备/设施提供兼容共存方案：保留并硬化 TLS 1.2、渐进迁移、隔离或替换收尾。"
msgstr "爲仍依賴 TLS 1.2 的老舊設備/設施提供兼容共存方案：保留並硬化 TLS 1.2、漸進遷移、隔離或替換收尾。"

msgid "低风险指引，纯建议；『保留并硬化』而非一刀切是关键"
msgstr "低風險指引，純建議；『保留並硬化』而非一刀切是關鍵"

msgid "后量子(KEM/ML-KEM)就绪评估（指引）"
msgstr "後量子(KEM/ML-KEM)就緒評估（指引）"

msgid "基于 RFC 9846 的 KEM 密钥交换能力，给后量子 TLS 就绪度评估与迁移指引（纯建议）。"
msgstr "基於 RFC 9846 的 KEM 密鑰交換能力，給後量子 TLS 就緒度評估與遷移指引（純建議）。"

msgid "低风险前瞻指引，纯建议；与老旧设备兼容桥并行不冲突"
msgstr "低風險前瞻指引，純建議；與老舊設備兼容橋並行不衝突"

msgid "汇编语言优化（只读报告）"
msgstr "彙編語言優化（只讀報告）"

msgid "只读探测汇编器（nasm/yasm/gas/llvm-mc/gcc -S），并给出优化要点（SIMD：SSE/AVX/NEON/SVE/RVV；对齐/寄存器/缓存/分支/指令/内联约束）与 LLVM 交叉编译汇编指引（clang -target=<triple> -S）。绝不编译、绝不改源码、绝不写汇编文件。"
msgstr "只讀探測彙編器（nasm/yasm/gas/llvm-mc/gcc -S），並給出優化要點（SIMD：SSE/AVX/NEON/SVE/RVV；對齊/寄存器/緩存/分支/指令/內聯約束）與 LLVM 交叉編譯彙編指引（clang -target=<triple> -S）。絕不編譯、絕不改源碼、絕不寫彙編文件。"

msgid "软件只读能力面：只探测、只给优化要点与指引，不编译/不改源码/不写汇编文件。"
msgstr "軟件只讀能力面：只探測、只給優化要點與指引，不編譯/不改源碼/不寫彙編文件。"

msgid "LLVM 交叉编译汇编指引（规范指引）"
msgstr "LLVM 交叉編譯彙編指引（規範指引）"

msgid "给出用 clang -target=<triple> -S 为各架构生成汇编（只读观察自动向量化与指令选择）的规范指引，绝不自动交叉汇编。"
msgstr "給出用 clang -target=<triple> -S 爲各架構生成彙編（只讀觀察自動向量化與指令選擇）的規範指引，絕不自動交叉彙編。"

msgid "交叉汇编属于写操作，一律只给规范指引；是否施工由用户在构建脚本确认。"
msgstr "交叉彙編屬於寫操作，一律只給規範指引；是否施工由用戶在構建腳本確認。"

msgid "分布式计算看门狗（模式说明，不执行）"
msgstr "分佈式計算看門狗（模式說明，不執行）"

msgid "模式来源：mihomo-kubernetes 用「健康检查 + 定时重启」清掉常驻代理里可能泄漏的敏感上游状态，而非去 patch 上游。"
msgstr "模式來源：mihomo-kubernetes 用「健康檢查 + 定時重啓」清掉常駐代理裏可能泄漏的敏感上游狀態，而非去 patch 上游。"

msgid "本层映射：distcompute 的本地采集进程若常驻，会在内存里攒结果 / 对端句柄；看门狗周期性重启它，把这些易失状态清零，降低长期驻留风险。"
msgstr "本層映射：distcompute 的本地採集進程若常駐，會在內存裏攢結果 / 對端句柄；看門狗週期性重啓它，把這些易失狀態清零，降低長期駐留風險。"

msgid "触发口径：健康检查（进程在 / 心跳新鲜 / 内存占用 / 距上次重启时长）超阈值 → 重启。"
msgstr "觸發口徑：健康檢查（進程在 / 心跳新鮮 / 內存佔用 / 距上次重啓時長）超閾值 → 重啓。"

msgid "红线：sysweeper 绝不自动重启任何进程。只出重启计划（命令文本），由你显式执行。"
msgstr "紅線：sysweeper 絕不自動重啓任何進程。只出重啓計劃（命令文本），由你顯式執行。"

msgid "健康检查超阈值（进程僵死 / 心跳陈旧 / 内存超基线 / 距上次重启超时）"
msgstr "健康檢查超閾值（進程僵死 / 心跳陳舊 / 內存超基線 / 距上次重啓超時）"

msgid "sysweeper 不执行此命令；仅给出计划。确认无误后由你手动运行。"
msgstr "sysweeper 不執行此命令；僅給出計劃。確認無誤後由你手動運行。"

