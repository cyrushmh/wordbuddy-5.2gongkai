msgstr "清空後文件不可恢復，請確認無需要保留的內容。"

msgid "清理浏览器缓存（Chrome/Edge/Firefox）"
msgstr "清理瀏覽器緩存（Chrome/Edge/Firefox）"

msgid "删除常见浏览器的缓存与临时文件。"
msgstr "刪除常見瀏覽器的緩存與臨時文件。"

msgid "仅清理缓存，不删除书签/密码/历史记录。"
msgstr "僅清理緩存，不刪除書籤/密碼/歷史記錄。"

msgid "清理传递优化缓存（Delivery Optimization）"
msgstr "清理傳遞優化緩存（Delivery Optimization）"

msgid "删除 Windows 更新分发用的 P2P 缓存。"
msgstr "刪除 Windows 更新分發用的 P2P 緩存。"

msgid "不影响已安装更新；下次更新会重新生成。"
msgstr "不影響已安裝更新；下次更新會重新生成。"

msgid "清理 Prefetch（预读取）"
msgstr "清理 Prefetch（預讀取）"

msgid "清空 Prefetch 以释放空间；下次开机略慢。"
msgstr "清空 Prefetch 以釋放空間；下次開機略慢。"

msgid "清空后首次启动常用程序会变慢，属正常现象。"
msgstr "清空後首次啓動常用程序會變慢，屬正常現象。"

msgid "清理 Windows 更新组件（DISM）"
msgstr "清理 Windows 更新組件（DISM）"

msgid "用 DISM 清理 WinSxS 组件存储，可释放数 GB。"
msgstr "用 DISM 清理 WinSxS 組件存儲，可釋放數 GB。"

msgid "若加 /ResetBase 将不可卸载已装更新；此处保守不加。"
msgstr "若加 /ResetBase 將不可卸載已裝更新；此處保守不加。"

msgid "耗时较长，建议在插电状态下执行。"
msgstr "耗時較長，建議在插電狀態下執行。"

msgid "降低诊断与体验数据收集"
msgstr "降低診斷與體驗數據收集"

msgid "关闭个性化体验/诊断数据上传。"
msgstr "關閉個性化體驗/診斷數據上傳。"

msgid "仅影响当前用户；企业域策略可能覆盖此设置。"
msgstr "僅影響當前用戶；企業域策略可能覆蓋此設置。"

msgid "切换至高性能电源计划"
msgstr "切換至高性能電源計劃"

msgid "笔记本可提升性能但缩短续航。"
msgstr "筆記本可提升性能但縮短續航。"

msgid "笔记本使用电池时续航明显下降。"
msgstr "筆記本使用電池時續航明顯下降。"

msgid "Windows 10 终止支持提醒"
msgstr "Windows 10 終止支持提醒"

msgid "本机为 Windows 10，已无安全更新。"
msgstr "本機爲 Windows 10，已無安全更新。"

msgid "Windows 10 已于 2025-10-14 结束支持，微软不再提供安全补丁。"
msgstr "Windows 10 已於 2025-10-14 結束支持，微軟不再提供安全補丁。"

msgid "强烈建议升级到 Windows 11（24H2 及以上）；若硬件不支持，请尽快规划替换并加强第三方防护。"
msgstr "強烈建議升級到 Windows 11（24H2 及以上）；若硬件不支持，請儘快規劃替換並加強第三方防護。"

msgid "关闭休眠以释放 hiberfil.sys"
msgstr "關閉休眠以釋放 hiberfil.sys"

msgid "关闭休眠可删除与内存等大的 hiberfil.sys，释放数 GB（笔记本会失去休眠，但保留睡眠）。"
msgstr "關閉休眠可刪除與內存等大的 hiberfil.sys，釋放數 GB（筆記本會失去休眠，但保留睡眠）。"

msgid "关闭后将无法休眠（hibernate）；睡眠（sleep）不受影响。需要睡眠请保留。"
msgstr "關閉後將無法休眠（hibernate）；睡眠（sleep）不受影響。需要睡眠請保留。"

msgid "SSD/大内存机器常关闭休眠以回收空间；无休眠需求时安全。"
msgstr "SSD/大內存機器常關閉休眠以回收空間；無休眠需求時安全。"

msgid "启用存储感知（Storage Sense）"
msgstr "啓用存儲感知（Storage Sense）"

msgid "开启系统自带存储感知，自动清理临时文件与回收站（按策略周期执行）。"
msgstr "開啓系統自帶存儲感知，自動清理臨時文件與回收站（按策略週期執行）。"

msgid "仅当前用户生效；企业域策略可能覆盖。"
msgstr "僅當前用戶生效；企業域策略可能覆蓋。"

msgid "存储感知是 Windows 原生机制，定期清理临时文件/回收站，无需第三方工具。"
msgstr "存儲感知是 Windows 原生機制，定期清理臨時文件/回收站，無需第三方工具。"

msgid "系统文件校验（SFC）"
msgstr "系統文件校驗（SFC）"

msgid "用系统文件检查器扫描并修复受损的系统文件（sfc /scannow）。"
msgstr "用系統文件檢查器掃描並修復受損的系統文件（sfc /scannow）。"

msgid "全程需管理员权限；耗时较长，建议在插电状态执行。"
msgstr "全程需管理員權限；耗時較長，建議在插電狀態執行。"

msgid "发现损坏文件时 SFC 会尝试从组件存储还原；若失败可先跑 DISM 修复。"
msgstr "發現損壞文件時 SFC 會嘗試從組件存儲還原；若失敗可先跑 DISM 修復。"

msgid "视觉效果调整为最佳性能"
msgstr "視覺效果調整爲最佳性能"

msgid "关闭动画/阴影/透明等视觉效果，换取更流畅的界面响应（尤其老机器）。"
msgstr "關閉動畫/陰影/透明等視覺效果，換取更流暢的界面響應（尤其老機器）。"

msgid "仅影响界面观感、不影响功能；注销或重启资源管理器后生效。"
msgstr "僅影響界面觀感、不影響功能；註銷或重啓資源管理器後生效。"

msgid "仅当前用户生效，可逆：改回 0 即恢复系统默认；图形入口在 系统 → 高级系统设置 → 性能 → 视觉效果。"
msgstr "僅當前用戶生效，可逆：改回 0 即恢復系統默認；圖形入口在 系統 → 高級系統設置 → 性能 → 視覺效果。"

msgid "电源计划设为高性能 / 均衡"
msgstr "電源計劃設爲高性能 / 均衡"

msgid "切换电源计划：插电用高性能（更高 CPU 频率、更跟手），笔记本续航用均衡 / 节能。"
msgstr "切換電源計劃：插電用高性能（更高 CPU 頻率、更跟手），筆記本續航用均衡 / 節能。"

msgid "笔记本用电池时高性能会缩短续航；服务器 / 台式机推荐。"
msgstr "筆記本用電池時高性能會縮短續航；服務器 / 臺式機推薦。"

msgid "可逆：powercfg /setactive <均衡 GUID> 即切回；高性能更耗电。"
msgstr "可逆：powercfg /setactive <均衡 GUID> 即切回；高性能更耗電。"

msgid "组件存储清理（DISM StartComponentCleanup）"
msgstr "組件存儲清理（DISM StartComponentCleanup）"

msgid "用 DISM 清理 WinSxS 组件存储中被取代的版本，回收系统盘空间。"
msgstr "用 DISM 清理 WinSxS 組件存儲中被取代的版本，回收系統盤空間。"

msgid "需管理员权限；执行时间较长，勿中断。"
msgstr "需管理員權限；執行時間較長，勿中斷。"

msgid "清理后无法卸载已安装的 Windows 更新（属正常取舍）。"
msgstr "清理後無法卸載已安裝的 Windows 更新（屬正常取捨）。"

msgid "可加 /ResetBase 进一步压缩，但会移除所有被取代版本且不可逆。"
msgstr "可加 /ResetBase 進一步壓縮，但會移除所有被取代版本且不可逆。"

msgid "NTFS 关闭最后访问时间更新（fsutil）"
msgstr "NTFS 關閉最後訪問時間更新（fsutil）"

msgid "关闭 NTFS「最后访问时间」回写，每次读文件不再写元数据，减少 SSD 写放大、提升 IO 效率。"
msgstr "關閉 NTFS「最後訪問時間」回寫，每次讀文件不再寫元數據，減少 SSD 寫放大、提升 IO 效率。"

msgid "需管理员权限且重启后生效；依赖最后访问时间戳做审计/归档的软件需先确认。"
msgstr "需管理員權限且重啓後生效；依賴最後訪問時間戳做審計/歸檔的軟件需先確認。"

msgid "参考：fsutil behavior 文档。只读核对：fsutil behavior query DisableLastAccess。"
msgstr "參考：fsutil behavior 文檔。只讀覈對：fsutil behavior query DisableLastAccess。"

msgid "关闭 NTFS 8.3 短名生成（fsutil）"
msgstr "關閉 NTFS 8.3 短名生成（fsutil）"

msgid "新建文件不再生成 8.3 短名（PROGRA~1 这类），减少目录元数据写入、加快大目录枚举。"
msgstr "新建文件不再生成 8.3 短名（PROGRA~1 這類），減少目錄元數據寫入、加快大目錄枚舉。"

msgid "极老的 16 位程序或写死 8.3 路径的脚本可能受影响，企业环境请先评估。"
msgstr "極老的 16 位程序或寫死 8.3 路徑的腳本可能受影響，企業環境請先評估。"

msgid "参考：fsutil 8dot3name 文档。只影响新建文件的短名，已有短名保留。"
msgstr "參考：fsutil 8dot3name 文檔。隻影響新建文件的短名，已有短名保留。"

msgid "TCP 接收窗口自动调优（netsh，RFC 7323）"
msgstr "TCP 接收窗口自動調優（netsh，RFC 7323）"

msgid "把接收窗口自动调优设为 normal，让 Windows 按带宽时延积自动缩放窗口——长肥管道下的推荐值。"
msgstr "把接收窗口自動調優設爲 normal，讓 Windows 按帶寬時延積自動縮放窗口——長肥管道下的推薦值。"

msgid "只调到 normal，**绝不禁用**自动调优（禁用会显著拖慢高延迟链路）；老旧中间设备异常时可改回。"
msgstr "只調到 normal，**絕不禁用**自動調優（禁用會顯著拖慢高延遲鏈路）；老舊中間設備異常時可改回。"

msgid "参考：RFC 7323 / netsh 文档。只读核对：netsh int tcp show global。"
msgstr "參考：RFC 7323 / netsh 文檔。只讀覈對：netsh int tcp show global。"

msgid "开启接收侧缩放 RSS（netsh）"
msgstr "開啓接收側縮放 RSS（netsh）"

msgid "开启 RSS 把收包处理散到多 CPU（与 Linux RPS 同一思路），高包率场景下降低单核瓶颈。"
msgstr "開啓 RSS 把收包處理散到多 CPU（與 Linux RPS 同一思路），高包率場景下降低單核瓶頸。"

msgid "需网卡驱动支持 RSS；少数老驱动开启后反而不稳，可关回 disabled。"
msgstr "需網卡驅動支持 RSS；少數老驅動開啓後反而不穩，可關回 disabled。"

msgid "参考：netsh 文档。只读核对：netsh int tcp show global（看 Receive-Side Scaling State）。"
msgstr "參考：netsh 文檔。只讀覈對：netsh int tcp show global（看 Receive-Side Scaling State）。"

msgid "开启 ECN 显式拥塞通知（netsh，RFC 3168）"
msgstr "開啓 ECN 顯式擁塞通知（netsh，RFC 3168）"

msgid "在 IP 报头标记拥塞而非靠丢包降速（RFC 3168），拥塞链路下吞吐更稳、延迟更低。"
msgstr "在 IP 報頭標記擁塞而非靠丟包降速（RFC 3168），擁塞鏈路下吞吐更穩、延遲更低。"

msgid "个别老旧/错误配置的中间设备会丢弃带 ECN 标记的报文，遇连通性异常请关回 disabled。"
msgstr "個別老舊/錯誤配置的中間設備會丟棄帶 ECN 標記的報文，遇連通性異常請關回 disabled。"

msgid "参考：RFC 3168 / netsh 文档。"
msgstr "參考：RFC 3168 / netsh 文檔。"

msgid "开启 Windows 防火墙全部配置档（netsh）"
msgstr "開啓 Windows 防火牆全部配置檔（netsh）"

msgid "用官方接口把域、专用、公用三个配置档的防火墙全部开启——**只开不关**，恢复被关掉的防护。"
msgstr "用官方接口把域、專用、公用三個配置檔的防火牆全部開啓——**只開不關**，恢復被關掉的防護。"

msgid "开启后未放行规则的入站连接会被拦（如自建服务需先放行端口）；本工具绝不做 allprofiles state off（关防火墙会把机器直接暴露在网络上）。"
msgstr "開啓後未放行規則的入站連接會被攔（如自建服務需先放行端口）；本工具絕不做 allprofiles state off（關防火牆會把機器直接暴露在網絡上）。"

msgid "参考：netsh advfirewall 文档。只读核对：netsh advfirewall show allprofiles state。"
msgstr "參考：netsh advfirewall 文檔。只讀覈對：netsh advfirewall show allprofiles state。"

msgid "设显示器关闭超时（powercfg /change）"
msgstr "設顯示器關閉超時（powercfg /change）"

msgid "按官方接口设显示器关闭超时（插电 15 分钟 / 电池 10 分钟），省电且不打断正在跑的任务。"
msgstr "按官方接口設顯示器關閉超時（插電 15 分鐘 / 電池 10 分鐘），省電且不打斷正在跑的任務。"

msgid "只改显示器超时，**不动睡眠/休眠**；做演示或下载时想保持亮屏请设 0。"
msgstr "只改顯示器超時，**不動睡眠/休眠**；做演示或下載時想保持亮屏請設 0。"

msgid "参考：powercfg 命令行选项。0 表示「从不」；只读核对：powercfg /query。"
msgstr "參考：powercfg 命令行選項。0 表示「從不」；只讀覈對：powercfg /query。"

msgid "缩减休眠文件 hiberfil.sys（powercfg /h /type reduced）"
msgstr "縮減休眠文件 hiberfil.sys（powercfg /h /type reduced）"

msgid "把休眠文件从 full 缩为 reduced：回收系统盘空间的同时**保留快速启动**，比彻底关休眠温和。"
msgstr "把休眠文件從 full 縮爲 reduced：回收系統盤空間的同時**保留快速啓動**，比徹底關休眠溫和。"

msgid "reduced 模式下「休眠」仍可用但部分场景受限；磁盘极紧张且不用休眠时再考虑彻底关闭。"
msgstr "reduced 模式下「休眠」仍可用但部分場景受限；磁盤極緊張且不用休眠時再考慮徹底關閉。"

msgid "参考：powercfg 命令行选项。彻底关闭休眠（会丢快速启动）请用 powercfg /hibernate off。"
msgstr "參考：powercfg 命令行選項。徹底關閉休眠（會丟快速啓動）請用 powercfg /hibernate off。"

msgid "清理用户级缓存"
msgstr "清理用戶級緩存"

msgid "删除 ~/Library/Caches 下各应用缓存。"
msgstr "刪除 ~/Library/Caches 下各應用緩存。"

msgid "不会删除应用本身，仅缓存；个别 App 下次启动稍慢。"
msgstr "不會刪除應用本身，僅緩存；個別 App 下次啓動稍慢。"

msgid "清空废纸篓"
msgstr "清空廢紙簍"

msgid "永久删除废纸篓内容。"
msgstr "永久刪除廢紙簍內容。"

msgid "清空后不可恢复。"
msgstr "清空後不可恢復。"

msgid "清理系统日志归档"
msgstr "清理系統日誌歸檔"

msgid "删除 /private/var/log 下的旧日志与 .asl 归档（需 sudo）。"
msgstr "刪除 /private/var/log 下的舊日誌與 .asl 歸檔（需 sudo）。"

msgid "需管理员密码；不要删除正在写入的当前日志文件。"
msgstr "需管理員密碼；不要刪除正在寫入的當前日誌文件。"

msgid "释放非活跃内存"
msgstr "釋放非活躍內存"

msgid "将非活跃内存写回磁盘并回收（需 sudo）。"
msgstr "將非活躍內存寫回磁盤並回收（需 sudo）。"

msgid "等效于重启的部分效果；不会影响正在运行的程序。"
msgstr "等效於重啓的部分效果；不會影響正在運行的程序。"

msgid "清理 Xcode 派生数据与模拟器"
msgstr "清理 Xcode 派生數據與模擬器"

msgid "删除 ~/Library/Developer/Xcode/DerivedData 与旧模拟器（仅开发机适用）。"
msgstr "刪除 ~/Library/Developer/Xcode/DerivedData 與舊模擬器（僅開發機適用）。"

msgid "非开发者无需执行；会触发下次构建重新索引。"
msgstr "非開發者無需執行；會觸發下次構建重新索引。"

msgid "审查开机启动项（手动）"
msgstr "審查開機啓動項（手動）"

msgid "列出登录项与 launchd 代理，按需禁用。"
msgstr "列出登錄項與 launchd 代理，按需禁用。"

msgid "不要禁用不清楚来源的代理，可能影响硬件驱动。"
msgstr "不要禁用不清楚來源的代理，可能影響硬件驅動。"

msgid "系统完整性保护（SIP）提示"
msgstr "系統完整性保護（SIP）提示"

msgid "macOS 受 SIP 保护，系统目录不可随意改动。"
msgstr "macOS 受 SIP 保護，系統目錄不可隨意改動。"

msgid "切勿手动删除 /System、/usr/lib 等受保护路径文件，否则系统可能无法启动。"
msgstr "切勿手動刪除 /System、/usr/lib 等受保護路徑文件，否則系統可能無法啓動。"

msgid "清理只针对用户目录与 /Library/Caches 等可写位置。"
msgstr "清理只針對用戶目錄與 /Library/Caches 等可寫位置。"

msgid "清理休眠镜像（sleepimage）"
msgstr "清理休眠鏡像（sleepimage）"

msgid "删除 /private/var/vm/sleepimage，回收与内存等大的休眠文件（需 sudo）。"
msgstr "刪除 /private/var/vm/sleepimage，回收與內存等大的休眠文件（需 sudo）。"

msgid "删除后下次休眠会重建；笔记本若依赖休眠请保留。"
msgstr "刪除後下次休眠會重建；筆記本若依賴休眠請保留。"

msgid "内存较大且不用休眠的机器可回收数 GB；重建由系统自动完成。"
msgstr "內存較大且不用休眠的機器可回收數 GB；重建由系統自動完成。"

msgid "可用软件更新报告"
msgstr "可用軟件更新報告"

msgid "用 softwareupdate -l 列出可用更新，供优化前确认是否需升级（不改系统）。"
msgstr "用 softwareupdate -l 列出可用更新，供優化前確認是否需升級（不改系統）。"

msgid "保持系统为最新正式版（macOS 26+）即可获得最佳性能与安全补丁。"
msgstr "保持系統爲最新正式版（macOS 26+）即可獲得最佳性能與安全補丁。"

msgid "重建 Spotlight 索引"
msgstr "重建 Spotlight 索引"

msgid "对系统宗卷重建 Spotlight 索引（mdutil -E），搜索异常/卡顿时用（需 sudo）。"
msgstr "對系統宗卷重建 Spotlight 索引（mdutil -E），搜索異常/卡頓時用（需 sudo）。"

msgid "重建期间搜索暂时不可用，CPU/磁盘占用短暂升高；会自动完成。"
msgstr "重建期間搜索暫時不可用，CPU/磁盤佔用短暫升高；會自動完成。"

msgid "仅当搜索结果异常或缺失时执行；日常无需操作。"
msgstr "僅當搜索結果異常或缺失時執行；日常無需操作。"

msgid "减弱动态效果 / 透明（视觉效果优化）"
msgstr "減弱動態效果 / 透明（視覺效果優化）"

msgid "减弱窗口透明与最小化动画，降低合成开销、更跟手（老 Mac / 集显更明显）。"
msgstr "減弱窗口透明與最小化動畫，降低合成開銷、更跟手（老 Mac / 集顯更明顯）。"

msgid "减弱透明后菜单栏等不再毛玻璃；部分用户偏好关闭。"
msgstr "減弱透明後菜單欄等不再毛玻璃；部分用戶偏好關閉。"

msgid "仅影响观感，可逆：改回 false / genie 并 killall Dock 即恢复。"
msgstr "僅影響觀感，可逆：改回 false / genie 並 killall Dock 即恢復。"

msgid "清理 Time Machine 本地快照"
msgstr "清理 Time Machine 本地快照"

msgid "列出并按需清理 APFS 本地 Time Machine 快照，回收被占用的本地空间。"
msgstr "列出並按需清理 APFS 本地 Time Machine 快照，回收被佔用的本地空間。"

msgid "仅清理本地快照，不影响 Time Machine 备份磁盘上的历史备份。"
msgstr "僅清理本地快照，不影響 Time Machine 備份磁盤上的歷史備份。"

msgid "清理命令：tmutil deletelocalsnapshots <快照名>；系统空间紧张时会自动回收。"
msgstr "清理命令：tmutil deletelocalsnapshots <快照名>；系統空間緊張時會自動回收。"

msgid "按机型设休眠模式（pmset -a hibernatemode）"
msgstr "按機型設休眠模式（pmset -a hibernatemode）"

msgid "按机型设休眠模式：笔记本 3（安全休眠：内存供电 + 落盘镜像）；台式机 0（不写休眠镜像，省出与内存等大的 /private/var/vm/sleepimage）。"
msgstr "按機型設休眠模式：筆記本 3（安全休眠：內存供電 + 落盤鏡像）；臺式機 0（不寫休眠鏡像，省出與內存等大的 /private/var/vm/sleepimage）。"

msgid "改休眠模式后首次睡眠会重建/删除 sleepimage；依赖休眠唤醒的笔记本请保持 3。"
msgstr "改休眠模式後首次睡眠會重建/刪除 sleepimage；依賴休眠喚醒的筆記本請保持 3。"

msgid "参考：pmset(1)。机型由 sysctl hw.model 自动探测（含 Book 视为笔记本）。"
msgstr "參考：pmset(1)。機型由 sysctl hw.model 自動探測（含 Book 視爲筆記本）。"

msgid "延后进入待机（pmset -a standbydelay）"
msgstr "延後進入待機（pmset -a standbydelay）"

msgid "把进入待机（内存落盘后断电）的等待延长到 24 小时，减少频繁落盘写入、延长 SSD 寿命。"
msgstr "把進入待機（內存落盤後斷電）的等待延長到 24 小時，減少頻繁落盤寫入、延長 SSD 壽命。"

msgid "待机前内存保持供电，合盖待机期间会稍耗电；追求极致续航者请保守设置。"
msgstr "待機前內存保持供電，合蓋待機期間會稍耗電；追求極致續航者請保守設置。"

msgid "参考：pmset(1)。旧版 macOS 只有 standbydelay，函数自动回退。"
msgstr "參考：pmset(1)。舊版 macOS 只有 standbydelay，函數自動回退。"

msgid "提高文件描述符上限（sysctl -w kern.maxfiles）"
msgstr "提高文件描述符上限（sysctl -w kern.maxfiles）"

msgid "把 kern.maxfiles / kern.maxfilesperproc 提到 65536 / 32768，避免开发/高并发场景出现「Too many open files」。"
msgstr "把 kern.maxfiles / kern.maxfilesperproc 提到 65536 / 32768，避免開發/高併發場景出現「Too many open files」。"

msgid "上限过高会略增内核内存占用；一般 65536 足够。"
msgstr "上限過高會略增內核內存佔用；一般 65536 足夠。"

msgid "参考：sysctl(8)。重启失效，持久化写入 /etc/sysctl.conf。"
msgstr "參考：sysctl(8)。重啓失效，持久化寫入 /etc/sysctl.conf。"

msgid "DNS 交回 DHCP（networksetup -setdnsservers empty）"
msgstr "DNS 交回 DHCP（networksetup -setdnsservers empty）"

msgid "用官方取值 empty 清空手工 DNS，改由 DHCP/路由器下发——自愈被软件改写或被劫持的 DNS，不引入第三方解析器。"
msgstr "用官方取值 empty 清空手工 DNS，改由 DHCP/路由器下發——自愈被軟件改寫或被劫持的 DNS，不引入第三方解析器。"

msgid "企业内网若依赖指定 DNS（内网域名解析），清空后可能解析不到，请先确认。"
msgstr "企業內網若依賴指定 DNS（內網域名解析），清空後可能解析不到，請先確認。"

msgid "参考：networksetup(8)。主网络服务由 -listallnetworkservices 自动探测。"
msgstr "參考：networksetup(8)。主網絡服務由 -listallnetworkservices 自動探測。"

msgid "APFS 本地快照瘦身（tmutil thinlocalsnapshots）"
msgstr "APFS 本地快照瘦身（tmutil thinlocalsnapshots）"

msgid "按 APFS 官方接口瘦身本地快照、目标回收 1GB；由系统按自身策略回收，不误删备份磁盘上的历史备份。"
msgstr "按 APFS 官方接口瘦身本地快照、目標回收 1GB；由系統按自身策略回收，不誤刪備份磁盤上的歷史備份。"

msgid "系统空间紧张时本就会自动回收；无本地快照时命令返回失败属正常。"
msgstr "系統空間緊張時本就會自動回收；無本地快照時命令返回失敗屬正常。"

msgid "参考：tmutil(8)。只读核对用 tmutil listlocalsnapshots /。"
msgstr "參考：tmutil(8)。只讀覈對用 tmutil listlocalsnapshots /。"

msgid "Dock 自动隐藏（defaults write com.apple.dock）"
msgstr "Dock 自動隱藏（defaults write com.apple.dock）"

msgid "Dock 自动隐藏并去掉弹出延迟，释放屏幕空间、减少常驻合成开销。"
msgstr "Dock 自動隱藏並去掉彈出延遲，釋放屏幕空間、減少常駐合成開銷。"

msgid "会重启 Dock（瞬间闪烁，不影响正在运行的应用）；可逆：改回 false 再 killall Dock。"
msgstr "會重啓 Dock（瞬間閃爍，不影響正在運行的應用）；可逆：改回 false 再 killall Dock。"

msgid "参考：defaults(1)。改的是用户偏好 plist，仅当前用户生效。"
msgstr "參考：defaults(1)。改的是用戶偏好 plist，僅當前用戶生效。"

msgid "开启软件更新自动排程（softwareupdate --schedule）"
msgstr "開啓軟件更新自動排程（softwareupdate --schedule）"

msgid "开启官方更新自动检查排程，让系统在空闲时按 SUS catalog 提示更新（只开排程，不自动安装）。"
msgstr "開啓官方更新自動檢查排程，讓系統在空閒時按 SUS catalog 提示更新（只開排程，不自動安裝）。"

msgid "仅开启检查排程，不会在未经确认的情况下安装系统更新。"
msgstr "僅開啓檢查排程，不會在未經確認的情況下安裝系統更新。"

msgid "参考：softwareupdate(8)。只读列出用 softwareupdate -l；安装仍需用户确认或加 -i。"
msgstr "參考：softwareupdate(8)。只讀列出用 softwareupdate -l；安裝仍需用戶確認或加 -i。"

msgid "启用 Gatekeeper（spctl --master-enable）"
msgstr "啓用 Gatekeeper（spctl --master-enable）"

msgid "按官方接口启用 Gatekeeper 准入评估（只开不关），恢复被关闭的应用来源校验。"
msgstr "按官方接口啓用 Gatekeeper 准入評估（只開不關），恢復被關閉的應用來源校驗。"

msgid "启用后未签名/未公证的应用会被拦在门外（可用右键「打开」逐例放行）；本工具绝不做 spctl --master-disable 这类关闭安全校验的操作。"
msgstr "啓用後未簽名/未公證的應用會被攔在門外（可用右鍵「打開」逐例放行）；本工具絕不做 spctl --master-disable 這類關閉安全校驗的操作。"

msgid "参考：spctl(8)。只读核对用 spctl --status / --assess。"
msgstr "參考：spctl(8)。只讀覈對用 spctl --status / --assess。"

msgid "APFS 宗卷一致性校验（diskutil verifyVolume）"
msgstr "APFS 宗卷一致性校驗（diskutil verifyVolume）"

msgid "对根宗卷跑官方一致性校验（只校验、不修复、不改动任何数据），排查文件系统异常。"
msgstr "對根宗卷跑官方一致性校驗（只校驗、不修復、不改動任何數據），排查文件系統異常。"

msgid "校验若报告错误，请用 diskutil repairVolume 或进入恢复模式处理；本任务不会自动修复。"
msgstr "校驗若報告錯誤，請用 diskutil repairVolume 或進入恢復模式處理；本任務不會自動修復。"

msgid "参考：diskutil(8)。只读核对用 diskutil apfs list / listSnapshots。"
msgstr "參考：diskutil(8)。只讀覈對用 diskutil apfs list / listSnapshots。"

msgid "清理包管理器缓存"
msgstr "清理包管理器緩存"

msgid "清除 apt / dnf / pacman 的下载缓存。"
msgstr "清除 apt / dnf / pacman 的下載緩存。"

msgid "仅删除已下载的安装包，不影响已装软件。"
msgstr "僅刪除已下載的安裝包，不影響已裝軟件。"

msgid "移除孤立/无用依赖"
msgstr "移除孤立/無用依賴"

msgid "卸载不再被需要的依赖包（autoremove / 孤包）。"
msgstr "卸載不再被需要的依賴包（autoremove / 孤包）。"

msgid "可能顺带移除你手动装但无其他依赖的软件，执行前会列出。"
msgstr "可能順帶移除你手動裝但無其他依賴的軟件，執行前會列出。"

msgid "压缩/清理 systemd 日志"
msgstr "壓縮/清理 systemd 日誌"

msgid "将日志体积限制到 200MB。用 journalctl 原生接口。"
msgstr "將日誌體積限制到 200MB。用 journalctl 原生接口。"

msgid "journalctl 不存在的发行版（如非 systemd）该任务自动跳过。"
msgstr "journalctl 不存在的發行版（如非 systemd）該任務自動跳過。"

msgid "清理缩略图缓存"
msgstr "清理縮略圖緩存"

msgid "删除 ~/.cache/thumbnails。"
msgstr "刪除 ~/.cache/thumbnails。"

msgid "下次打开文件管理器会重新生成。"
msgstr "下次打開文件管理器會重新生成。"

msgid "清理用户缓存目录"
msgstr "清理用戶緩存目錄"

msgid "清理 ~/.cache 下可安全删除的缓存。"
msgstr "清理 ~/.cache 下可安全刪除的緩存。"

msgid "仅删旧文件，不影响正在使用的缓存。"
msgstr "僅刪舊文件，不影響正在使用的緩存。"

msgid "优化交换倾向（swappiness）"
msgstr "優化交換傾向（swappiness）"

msgid "桌面/大内存机器可降低 swappiness 减少不必要换页。"
msgstr "桌面/大內存機器可降低 swappiness 減少不必要換頁。"

msgid "服务器/低内存机器不建议过低；修改前请了解 swap 策略。"
msgstr "服務器/低內存機器不建議過低；修改前請了解 swap 策略。"

msgid "重启后由 sysctl.d 文件持久化。"
msgstr "重啓後由 sysctl.d 文件持久化。"

msgid "内核清理注意事项"
msgstr "內核清理注意事項"

msgid "保留正在运行的内核，不要删除当前启动内核。"
msgstr "保留正在運行的內核，不要刪除當前啓動內核。"

msgid "apt autoremove 默认会保留当前及上一个内核；切勿手动 rm /boot/vmlinuz-* 当前内核。"
msgstr "apt autoremove 默認會保留當前及上一個內核；切勿手動 rm /boot/vmlinuz-* 當前內核。"

msgid "可用 `uname -r` 确认当前内核，再决定清理哪些旧内核。"
msgstr "可用 `uname -r` 確認當前內核，再決定清理哪些舊內核。"

msgid "发行版信息报告（LSB）"
msgstr "發行版信息報告（LSB）"

msgid "用 LSB 规范文件 /etc/os-release 读取发行版与版本，供优化前确认环境。"
msgstr "用 LSB 規範文件 /etc/os-release 讀取發行版與版本，供優化前確認環境。"

msgid "LSB 是 Linux 标准基线的发行版信息规范；解析失败会自动降级到 lsb_release 命令与 uname。"
msgstr "LSB 是 Linux 標準基線的發行版信息規範；解析失敗會自動降級到 lsb_release 命令與 uname。"

msgid "清理 Docker 闲置资源"
msgstr "清理 Docker 閒置資源"

msgid "用 docker system prune 清理已停止容器、未用网络与悬空镜像（需 docker 守护进程）。"
msgstr "用 docker system prune 清理已停止容器、未用網絡與懸空鏡像（需 docker 守護進程）。"

msgid "会移除未打标签的悬空镜像；运行中的容器不受影响。docker 未运行则自动跳过。"
msgstr "會移除未打標籤的懸空鏡像；運行中的容器不受影響。docker 未運行則自動跳過。"

msgid "仅删除「悬空（dangling）」镜像与已停止容器；不含命名卷，避免误删数据。"
msgstr "僅刪除「懸空（dangling）」鏡像與已停止容器；不含命名卷，避免誤刪數據。"

msgid "清理 Flatpak 未用运行时"
msgstr "清理 Flatpak 未用運行時"

msgid "用 flatpak uninstall --unused 移除不再被任何应用引用的运行时（需 flatpak）。"
msgstr "用 flatpak uninstall --unused 移除不再被任何應用引用的運行時（需 flatpak）。"

msgid "无 flatpak 时自动跳过——不强求安装。"
msgstr "無 flatpak 時自動跳過——不強求安裝。"

msgid "仅移除「无应用引用」的运行时；当前已装应用不受影响。"
msgstr "僅移除「無應用引用」的運行時；當前已裝應用不受影響。"

msgid "清理 Snap 旧版本修订"
msgstr "清理 Snap 舊版本修訂"

msgid "移除 Snap 已禁用（被新版取代）的旧修订，回收空间（需 snap）。"
msgstr "移除 Snap 已禁用（被新版取代）的舊修訂，回收空間（需 snap）。"

msgid "无 snap 时自动跳过；误删当前版本会由 snap 自动保护（awk 只选 disabled）。"
msgstr "無 snap 時自動跳過；誤刪當前版本會由 snap 自動保護（awk 只選 disabled）。"

msgid "仅删除标记为 disabled 的旧修订（升级后产生），当前版本不受影响。"
msgstr "僅刪除標記爲 disabled 的舊修訂（升級後產生），當前版本不受影響。"

msgid "SSD / NVMe IO 调度器调优"
msgstr "SSD / NVMe IO 調度器調優"

msgid "为 SSD/NVMe 设置 none 或 mq-deadline 调度器，降低延迟、延长寿命（需 root）。"
msgstr "爲 SSD/NVMe 設置 none 或 mq-deadline 調度器，降低延遲、延長壽命（需 root）。"

msgid "需 root；高负载磁盘改错调度可能影响吞吐，建议先测再固化。"
msgstr "需 root；高負載磁盤改錯調度可能影響吞吐，建議先測再固化。"

msgid "NVMe 默认即为 none，无需改动；SATA SSD 建议 none 或 mq-deadline。此修改重启后失效，需写 udev 规则或内核参数才能持久化。"
msgstr "NVMe 默認即爲 none，無需改動；SATA SSD 建議 none 或 mq-deadline。此修改重啓後失效，需寫 udev 規則或內核參數才能持久化。"

msgid "swappiness / 缓存回收调优"
msgstr "swappiness / 緩存回收調優"

msgid "下调 vm.swappiness 减少过早换出、提升交互响应（内存充足时）；可临时或写 sysctl 持久。"
msgstr "下調 vm.swappiness 減少過早換出、提升交互響應（內存充足時）；可臨時或寫 sysctl 持久。"

msgid "内存紧张时过低 swappiness 可能触发 OOM；按实际内存调整。"
msgstr "內存緊張時過低 swappiness 可能觸發 OOM；按實際內存調整。"

msgid "默认多为 60；大内存桌面可降到 10；仅影响换出倾向，不影响功能。"
msgstr "默認多爲 60；大內存桌面可降到 10；僅影響換出傾向，不影響功能。"

msgid "ZFS 存储池 TRIM / autotrim"
msgstr "ZFS 存儲池 TRIM / autotrim"

msgid "按 OpenZFS 规范对 zpool 执行 trim（或开启 autotrim），维持 SSD 上的空间回收。"
msgstr "按 OpenZFS 規範對 zpool 執行 trim（或開啓 autotrim），維持 SSD 上的空間回收。"

msgid "大规模 TRIM 期间 IO 有开销；生产环境建议低峰执行。"
msgstr "大規模 TRIM 期間 IO 有開銷；生產環境建議低峯執行。"

msgid "也可 `zpool set autotrim=on <pool>` 让 ZFS 自动回收；机械盘无需 TRIM。"
msgstr "也可 `zpool set autotrim=on <pool>` 讓 ZFS 自動回收；機械盤無需 TRIM。"

msgid "固件更新检查（fwupd / LVFS）"
msgstr "固件更新檢查（fwupd / LVFS）"

msgid "用 fwupd 查询可用固件更新（LVFS 源），列出待更新的固件版本。"
msgstr "用 fwupd 查詢可用固件更新（LVFS 源），列出待更新的固件版本。"

msgid "固件更新有风险，务必在供电稳定的情况下进行。"
msgstr "固件更新有風險，務必在供電穩定的情況下進行。"

msgid "只读查询；实际刷新需 `fwupdmgr update` 且常需重启。"
msgstr "只讀查詢；實際刷新需 `fwupdmgr update` 且常需重啓。"

msgid "龙芯平台（LoongArch）源与包管理核对"
msgstr "龍芯平臺（LoongArch）源與包管理覈對"

msgid "在龙芯 Linux 上核对发行版源与包架构（loong64/loongarch64），避免装错架构包。"
msgstr "在龍芯 Linux 上覈對發行版源與包架構（loong64/loongarch64），避免裝錯架構包。"

msgid "仅做模拟/查询，不实际升级。"
msgstr "僅做模擬/查詢，不實際升級。"

msgid "龙芯平台应使用对应架构的源（如 loongnix/Loong 源）；x86 包不可用（除非经 LBT 翻译）。"
msgstr "龍芯平臺應使用對應架構的源（如 loongnix/Loong 源）；x86 包不可用（除非經 LBT 翻譯）。"

msgid "MIPS / 嵌入式设备精简清理"
msgstr "MIPS / 嵌入式設備精簡清理"

msgid "MIPS 路由器与嵌入式设备上按端序与 ABI 核对后清理缓存与日志，释放有限存储。"
msgstr "MIPS 路由器與嵌入式設備上按端序與 ABI 覈對後清理緩存與日誌，釋放有限存儲。"

msgid "嵌入式固件常为只读文件系统，清理前确认可写分区。"
msgstr "嵌入式固件常爲只讀文件系統，清理前確認可寫分區。"

msgid "端序（mips 大端 / mipsel 小端）与 ABI（o32/n32/n64）需与已装软件一致。"
msgstr "端序（mips 大端 / mipsel 小端）與 ABI（o32/n32/n64）需與已裝軟件一致。"

msgid "嵌入式设备存储小，先清缓存与轮转日志收益最直接。"
msgstr "嵌入式設備存儲小，先清緩存與輪轉日誌收益最直接。"

msgid "CFS 调度器参数核对"
msgstr "CFS 調度器參數覈對"

msgid "按内核文档 scheduler/sched-design-CFS.rst 核对 CFS 关键 sysctl（sched_latency_ns / min_granularity_ns / migration_cost_ns），给响应/吞吐建议。"
msgstr "按內核文檔 scheduler/sched-design-CFS.rst 覈對 CFS 關鍵 sysctl（sched_latency_ns / min_granularity_ns / migration_cost_ns），給響應/吞吐建議。"

msgid "改调度 sysctl 影响全局公平性与延迟；生产环境先评估再固化。"
msgstr "改調度 sysctl 影響全局公平性與延遲；生產環境先評估再固化。"

msgid "CFS 以 vruntime 公平分配 CPU；桌面可略降 sched_latency_ns 提升响应，服务器保持默认。"
msgstr "CFS 以 vruntime 公平分配 CPU；桌面可略降 sched_latency_ns 提升響應，服務器保持默認。"

msgid "cgroups v2 层级核对"
msgstr "cgroups v2 層級覈對"

msgid "按内核文档 admin-guide/cgroup-v2.rst 核对 cgroups v2 统一层级与已委托控制器，给出资源隔离（cpu.weight/memory.max）建议。"
msgstr "按內核文檔 admin-guide/cgroup-v2.rst 覈對 cgroups v2 統一層級與已委託控制器，給出資源隔離（cpu.weight/memory.max）建議。"

msgid "误配 subtree_control 可能使子组收不到控制器；改前确认层级结构。"
msgstr "誤配 subtree_control 可能使子組收不到控制器；改前確認層級結構。"

msgid "桌面发行版默认由 systemd 挂载 v2；为关键服务设 cpu.weight/memory.max 可防单进程拖垮整机。"
msgstr "桌面發行版默認由 systemd 掛載 v2；爲關鍵服務設 cpu.weight/memory.max 可防單進程拖垮整機。"

msgid "OOM 防护核对"
msgstr "OOM 防護覈對"

msgid "按内核文档 mm/oom_kill.rst 核对 OOM 防护 sysctl 与当前进程 oom_score_adj，给出关键守护进程保护建议。"
msgstr "按內核文檔 mm/oom_kill.rst 覈對 OOM 防護 sysctl 與當前進程 oom_score_adj，給出關鍵守護進程保護建議。"

msgid "oom_score_adj 误设为 -1000 会令该进程永不回收，可能拖垮系统；谨慎保护。"
msgstr "oom_score_adj 誤設爲 -1000 會令該進程永不回收，可能拖垮系統；謹慎保護。"

msgid "用 oom_score_adj(-1000~1000) 保护关键守护进程（如设为 -500）；-1000 使其永不成为牺牲品。"
msgstr "用 oom_score_adj(-1000~1000) 保護關鍵守護進程（如設爲 -500）；-1000 使其永不成爲犧牲品。"

msgid "资源压力失忆（PSI）核对"
msgstr "資源壓力失憶（PSI）覈對"

msgid "按内核文档 accounting/psi.rst 读取 CPU/内存/IO 压力占比，预警资源争用瓶颈。"
msgstr "按內核文檔 accounting/psi.rst 讀取 CPU/內存/IO 壓力佔比，預警資源爭用瓶頸。"

msgid "未启用 PSI 的内核无 /proc/pressure（自动降级为说明）。"
msgstr "未啓用 PSI 的內核無 /proc/pressure（自動降級爲說明）。"

msgid "监控 memory/io 的 full 占比可提前发现瓶颈；容器与桌面守护进程常用 PSI 做自适应限流。"
msgstr "監控 memory/io 的 full 佔比可提前發現瓶頸；容器與桌面守護進程常用 PSI 做自適應限流。"

msgid "THP 规整策略核对"
msgstr "THP 規整策略覈對"

msgid "按内核文档 admin-guide/mm/transhuge.rst 核对 transparent_hugepage/defrag 与 compaction 策略，给延迟敏感负载建议。"
msgstr "按內核文檔 admin-guide/mm/transhuge.rst 覈對 transparent_hugepage/defrag 與 compaction 策略，給延遲敏感負載建議。"

msgid "改 defrag 策略需 root；never 可消除抖动但增加 TLB 压力。"
msgstr "改 defrag 策略需 root；never 可消除抖動但增加 TLB 壓力。"

msgid "延迟敏感负载用 defrag=madvise 避免分配时同步规整抖动；compact_memory 可手动触发全系统规整。"
msgstr "延遲敏感負載用 defrag=madvise 避免分配時同步規整抖動；compact_memory 可手動觸發全系統規整。"

msgid "脏页回写/缓存回收核对"
msgstr "髒頁回寫/緩存回收覈對"

msgid "按内核文档 admin-guide/sysctl/vm.rst 核对 dirty_* 与 vfs_cache_pressure，给写缓冲与目录缓存回收建议。"
msgstr "按內核文檔 admin-guide/sysctl/vm.rst 覈對 dirty_* 與 vfs_cache_pressure，給寫緩衝與目錄緩存回收建議。"

msgid "极端值可能引发写阻塞或目录缓存频繁回收；按实际负载调整。"
msgstr "極端值可能引發寫阻塞或目錄緩存頻繁回收；按實際負載調整。"

msgid "大内存/数据库可调高 dirty_* 平滑写峰；频繁列目录负载可降 vfs_cache_pressure 保目录缓存。"
msgstr "大內存/數據庫可調高 dirty_* 平滑寫峯；頻繁列目錄負載可降 vfs_cache_pressure 保目錄緩存。"

msgid "TCP 协议栈参数核对"
msgstr "TCP 協議棧參數覈對"

msgid "按内核文档 networking/ip-sysctl.rst 核对 TCP 缓冲(tcp_rmem/wmem)与特性开关（SACK/时间戳/窗口缩放），给吞吐建议。"
msgstr "按內核文檔 networking/ip-sysctl.rst 覈對 TCP 緩衝(tcp_rmem/wmem)與特性開關（SACK/時間戳/窗口縮放），給吞吐建議。"

msgid "改 tcp_* 影响全机网络；跨境/高延迟链路调优前先测基线。"
msgstr "改 tcp_* 影響全機網絡；跨境/高延遲鏈路調優前先測基線。"

msgid "长肥管道可调高 tcp_rmem 上限提升吞吐；时间戳/SACK 一般保持开启，仅老旧链路异常才关。"
msgstr "長肥管道可調高 tcp_rmem 上限提升吞吐；時間戳/SACK 一般保持開啓，僅老舊鏈路異常才關。"

msgid "TCP 拥塞控制核对（BBR）"
msgstr "TCP 擁塞控制覈對（BBR）"

msgid "按内核文档 networking/ip-sysctl.rst 核对当前拥塞控制算法与可用项，给长肥管道改用 BBR 的建议。"
msgstr "按內核文檔 networking/ip-sysctl.rst 覈對當前擁塞控制算法與可用項，給長肥管道改用 BBR 的建議。"

msgid "误选未编译算法会回退到默认；改拥塞控制需 root。"
msgstr "誤選未編譯算法會回退到默認；改擁塞控制需 root。"

msgid "长肥管道与跨境链路用 BBR 更稳定高效（需内核编译 tcp_bbr）；普通内网 Cubic 足够。"
msgstr "長肥管道與跨境鏈路用 BBR 更穩定高效（需內核編譯 tcp_bbr）；普通內網 Cubic 足夠。"

msgid "网络核心参数核对（net.core）"
msgstr "網絡核心參數覈對（net.core）"

msgid "按内核文档 networking/ip-sysctl.rst 核对 net.core（netdev_max_backlog/budget/rmem_max/wmem_max/somaxconn），给高 PPS 服务器建议。"
msgstr "按內核文檔 networking/ip-sysctl.rst 覈對 net.core（netdev_max_backlog/budget/rmem_max/wmem_max/somaxconn），給高 PPS 服務器建議。"

msgid "盲目调大缓冲可能增大延迟与内存占用；按实测吞吐调整。"
msgstr "盲目調大緩衝可能增大延遲與內存佔用；按實測吞吐調整。"

msgid "高 PPS 服务器可调高 netdev_max_backlog/netdev_budget 与 rmem_max/wmem_max；somaxconn 影响并发 accept。"
msgstr "高 PPS 服務器可調高 netdev_max_backlog/netdev_budget 與 rmem_max/wmem_max；somaxconn 影響併發 accept。"

msgid "接收侧缩放（RPS/RFS）核对"
msgstr "接收側縮放（RPS/RFS）覈對"

msgid "按内核文档 networking/scaling.rst 核对网卡 RPS/RFS 配置，给单队列网卡多核利用建议。"
msgstr "按內核文檔 networking/scaling.rst 覈對網卡 RPS/RFS 配置，給單隊列網卡多核利用建議。"

msgid "rps_cpus 填错 CPU 位可能把软中断集中到少数核，需按拓扑设置。"
msgstr "rps_cpus 填錯 CPU 位可能把軟中斷集中到少數核，需按拓撲設置。"

msgid "单队列/多队列不足网卡用 RPS/RFS 提升多核利用率；多队列智能网卡通常无需开启。"
msgstr "單隊列/多隊列不足網卡用 RPS/RFS 提升多核利用率；多隊列智能網卡通常無需開啓。"

msgid "清除 pkg / pkgin / pkg_add 的下载缓存。"
msgstr "清除 pkg / pkgin / pkg_add 的下載緩存。"

msgid "卸载不再被需要的依赖包。"
msgstr "卸載不再被需要的依賴包。"

msgid "优化交换倾向（vm.swappiness）"
msgstr "優化交換傾向（vm.swappiness）"

msgid "桌面/大内存机器可降低换页倾向。"
msgstr "桌面/大內存機器可降低換頁傾向。"

msgid "FreeBSD 用 vm.swappiness（近年版本）；OpenBSD/NetBSD 无此参数，会自动跳过。"
msgstr "FreeBSD 用 vm.swappiness（近年版本）；OpenBSD/NetBSD 無此參數，會自動跳過。"

msgid "FreeBSD 可加进 /etc/sysctl.conf 持久化。"
msgstr "FreeBSD 可加進 /etc/sysctl.conf 持久化。"

msgid "发行版信息报告（sysctlbyname）"
msgstr "發行版信息報告（sysctlbyname）"

msgid "用 libc sysctlbyname 读取内核状态，供优化前确认环境。"
msgstr "用 libc sysctlbyname 讀取內核狀態，供優化前確認環境。"

msgid "BSD 用 sysctlbyname 内核接口获取系统信息，比解析文件更权威。"
msgstr "BSD 用 sysctlbyname 內核接口獲取系統信息，比解析文件更權威。"

msgid "开机服务审查（rc 服务）"
msgstr "開機服務審查（rc 服務）"

msgid "列出当前启用的 rc 服务（FreeBSD service -e），按需禁用不需要的服务以减负。"
msgstr "列出當前啓用的 rc 服務（FreeBSD service -e），按需禁用不需要的服務以減負。"

msgid "改动 rc.conf 后需重启或 `service <name> stop` 生效；谨慎操作。"
msgstr "改動 rc.conf 後需重啓或 `service <name> stop` 生效；謹慎操作。"

msgid "不要禁用不清楚来源的底层服务（如网络/ssh 守护），可能影响远程访问。"
msgstr "不要禁用不清楚來源的底層服務（如網絡/ssh 守護），可能影響遠程訪問。"

msgid "清理孤立软件包依赖（pkg autoremove）"
msgstr "清理孤立軟件包依賴（pkg autoremove）"

msgid "用 pkg autoremove 删除不再被任何软件依赖的孤立包，回收空间（FreeBSD）。"
msgstr "用 pkg autoremove 刪除不再被任何軟件依賴的孤立包，回收空間（FreeBSD）。"

msgid "极少数情况 A 依赖 B 但元数据缺失，autoremove 可能误删；预演确认更稳妥。"
msgstr "極少數情況 A 依賴 B 但元數據缺失，autoremove 可能誤刪；預演確認更穩妥。"

msgid "只删“无人依赖”的包，不碰仍在用的软件；建议先 `pkg autoremove -n` 预演。"
msgstr "只刪“無人依賴”的包，不碰仍在用的軟件；建議先 `pkg autoremove -n` 預演。"

msgid "ZFS 存储池 TRIM（FreeBSD/OpenBSD）"
msgstr "ZFS 存儲池 TRIM（FreeBSD/OpenBSD）"

msgid "按 OpenZFS 规范对 zpool 执行 trim，或开启 autotrim 自动回收 SSD 空间。"
msgstr "按 OpenZFS 規範對 zpool 執行 trim，或開啓 autotrim 自動回收 SSD 空間。"

msgid "TRIM 期间有 IO 开销，建议低峰执行。"
msgstr "TRIM 期間有 IO 開銷，建議低峯執行。"

msgid "也可 `zpool set autotrim=on <pool>`；机械盘无需 TRIM。"
msgstr "也可 `zpool set autotrim=on <pool>`；機械盤無需 TRIM。"

msgid "清理 Ports 下载缓存（distfiles）"
msgstr "清理 Ports 下載緩存（distfiles）"

msgid "清理 /usr/ports/distfiles 中已下载的软件源码包缓存，可重新下载。"
msgstr "清理 /usr/ports/distfiles 中已下載的軟件源碼包緩存，可重新下載。"

msgid "删除后重新编译该 port 需再次下载源码。"
msgstr "刪除後重新編譯該 port 需再次下載源碼。"

msgid "删除命令：make distclean（在 port 目录内）或直接删 distfiles 下文件。"
msgstr "刪除命令：make distclean（在 port 目錄內）或直接刪 distfiles 下文件。"

msgid "启用 TCP 高性能扩展（sysctl net.inet.tcp.rfc1323）"
msgstr "啓用 TCP 高性能擴展（sysctl net.inet.tcp.rfc1323）"

msgid "开启 RFC 7323 的窗口缩放与时间戳，长肥管道（高带宽时延积）下显著提升吞吐。"
msgstr "開啓 RFC 7323 的窗口縮放與時間戳，長肥管道（高帶寬時延積）下顯著提升吞吐。"

msgid "个别老旧中间设备对时间戳/窗口缩放处理异常，遇问题可关回 0。"
msgstr "個別老舊中間設備對時間戳/窗口縮放處理異常，遇問題可關回 0。"

msgid "参考：RFC 7323 / tcp(4)。FreeBSD 默认即为 1，已是目标值时不动。"
msgstr "參考：RFC 7323 / tcp(4)。FreeBSD 默認即爲 1，已是目標值時不動。"

msgid "调大 TCP 收发缓冲（recvspace / sendspace）"
msgstr "調大 TCP 收發緩衝（recvspace / sendspace）"

msgid "把 TCP 收发缓冲上调到 64 KiB（仅当当前值更小才动），提升高带宽链路吞吐。"
msgstr "把 TCP 收發緩衝上調到 64 KiB（僅噹噹前值更小才動），提升高帶寬鏈路吞吐。"

msgid "只上调不降低，避免覆盖内核自动调优的结果；缓冲过大会多占内核内存。"
msgstr "只上調不降低，避免覆蓋內核自動調優的結果；緩衝過大會多佔內核內存。"

msgid "参考：tcp(4)。持久化写 /etc/sysctl.conf。"
msgstr "參考：tcp(4)。持久化寫 /etc/sysctl.conf。"

msgid "提高文件描述符上限（kern.maxfiles）"
msgstr "提高文件描述符上限（kern.maxfiles）"

msgid "把 kern.maxfiles / kern.maxfilesperproc 提到 65536 / 32768，避免高并发/构建场景撞到描述符上限。"
msgstr "把 kern.maxfiles / kern.maxfilesperproc 提到 65536 / 32768，避免高併發/構建場景撞到描述符上限。"

msgid "上限过高会略增内核内存占用；root 权限下才写成功。"
msgstr "上限過高會略增內核內存佔用；root 權限下才寫成功。"

msgid "参考：sysctl(8)。当前值已达标时不动；持久化写 /etc/sysctl.conf。"
msgstr "參考：sysctl(8)。當前值已達標時不動；持久化寫 /etc/sysctl.conf。"

msgid "ZFS 池开启自动 TRIM（zpool set autotrim=on）"
msgstr "ZFS 池開啓自動 TRIM（zpool set autotrim=on）"

msgid "按 OpenZFS 官方接口给每个存储池开 autotrim，让 SSD 空闲块在后台持续回收，无需定期手动 trim。"
msgstr "按 OpenZFS 官方接口給每個存儲池開 autotrim，讓 SSD 空閒塊在後臺持續回收，無需定期手動 trim。"

msgid "后台 TRIM 有轻微 IO 开销；极老 SSD 固件慎用。"
msgstr "後臺 TRIM 有輕微 IO 開銷；極老 SSD 固件慎用。"

msgid "参考：zpool(8)。池名由 zpool list -H -o name 自动探测；机械盘无需 TRIM。"
msgstr "參考：zpool(8)。池名由 zpool list -H -o name 自動探測；機械盤無需 TRIM。"

msgid "ZFS 池校验（zpool scrub）"
msgstr "ZFS 池校驗（zpool scrub）"

msgid "对每个存储池启动官方 scrub 校验，遍历校验所有数据块、在有冗余时自动修复静默损坏。"
msgstr "對每個存儲池啓動官方 scrub 校驗，遍歷校驗所有數據塊、在有冗餘時自動修復靜默損壞。"

msgid "scrub 会遍历全部数据、IO 开销明显；本任务只启动校验，绝不 destroy 池或数据集。"
msgstr "scrub 會遍歷全部數據、IO 開銷明顯；本任務只啓動校驗，絕不 destroy 池或數據集。"

msgid "参考：zpool(8)。进度用 zpool status 查看；建议低峰期跑。"
msgstr "參考：zpool(8)。進度用 zpool status 查看；建議低峯期跑。"

msgid "限制 ZFS ARC 上限（vfs.zfs.arc_max）"
msgstr "限制 ZFS ARC 上限（vfs.zfs.arc_max）"

msgid "把 ZFS ARC 上限压到物理内存的 50%，把内存让给应用与页缓存（数据库/编译机常见诉求）。"
msgstr "把 ZFS ARC 上限壓到物理內存的 50%，把內存讓給應用與頁緩存（數據庫/編譯機常見訴求）。"

msgid "ARC 变小会增加磁盘读放大；纯文件服务器不宜压太狠。"
msgstr "ARC 變小會增加磁盤讀放大；純文件服務器不宜壓太狠。"

msgid "参考：zfs(4)。物理内存由 sysctl hw.physmem 自动探测；未加载 ZFS 则跳过。"
msgstr "參考：zfs(4)。物理內存由 sysctl hw.physmem 自動探測；未加載 ZFS 則跳過。"

msgid "启用 pf 防火墙并加载规则集（pfctl -e -f）"
msgstr "啓用 pf 防火牆並加載規則集（pfctl -e -f）"

msgid "按官方接口启用 pf 并加载 /etc/pf.conf 规则集（只启用不停用），恢复未开启的防火墙。"
msgstr "按官方接口啓用 pf 並加載 /etc/pf.conf 規則集（只啓用不停用），恢復未開啓的防火牆。"

msgid "规则集不存在时拒绝启用（不盲目开防火墙把自己锁在外面）；本工具绝不做 pfctl -d（停用）或 -F all（冲刷全部状态/规则）。"
msgstr "規則集不存在時拒絕啓用（不盲目開防火牆把自己鎖在外面）；本工具絕不做 pfctl -d（停用）或 -F all（沖刷全部狀態/規則）。"

msgid "参考：pfctl(8)。只读核对用 pfctl -s rules/info/state。"
msgstr "參考：pfctl(8)。只讀覈對用 pfctl -s rules/info/state。"

msgid "手动跑一遍 periodic 维护脚本"
msgstr "手動跑一遍 periodic 維護腳本"

msgid "按官方入口手动跑一遍 daily 周期脚本（清临时文件、轮转日志、安全报告等），补齐被跳过的例行维护。"
msgstr "按官方入口手動跑一遍 daily 週期腳本（清臨時文件、輪轉日誌、安全報告等），補齊被跳過的例行維護。"

msgid "脚本内容由系统自带，不改任何脚本；个别脚本会轮转日志，属预期行为。"
msgstr "腳本內容由系統自帶，不改任何腳本；個別腳本會輪轉日誌，屬預期行爲。"

msgid "参考：periodic(8)。只读核对用 ls /etc/periodic/*；输出进系统日志/邮件。"
msgstr "參考：periodic(8)。只讀覈對用 ls /etc/periodic/*；輸出進系統日誌/郵件。"

msgid "清理 IPS 包历史"
msgstr "清理 IPS 包歷史"

msgid "清理 Solaris/illumos IPS 的包操作历史（pkg purge-history）。"
msgstr "清理 Solaris/illumos IPS 的包操作歷史（pkg purge-history）。"

msgid "历史清理不影响已装软件，仅释放元数据空间。"
msgstr "歷史清理不影響已裝軟件，僅釋放元數據空間。"

msgid "发行版信息报告（/etc/release）"
msgstr "發行版信息報告（/etc/release）"

msgid "读 Solaris /etc/release 与 uname，供优化前确认环境。"
msgstr "讀 Solaris /etc/release 與 uname，供優化前確認環境。"

msgid "System V 系列用 /etc/release 而非 /etc/os-release 记录发行信息。"
msgstr "System V 系列用 /etc/release 而非 /etc/os-release 記錄發行信息。"

msgid "归档旧系统日志"
msgstr "歸檔舊系統日誌"

msgid "压缩 30 天前的已轮转日志（/var/log、/var/adm），回收空间（需 root，仅压缩不改内容）。"
msgstr "壓縮 30 天前的已輪轉日誌（/var/log、/var/adm），回收空間（需 root，僅壓縮不改內容）。"

msgid "勿压缩正在写入的当前日志（*.log 本身）；本任务已用后缀/轮转名过滤规避。"
msgstr "勿壓縮正在寫入的當前日誌（*.log 本身）；本任務已用後綴/輪轉名過濾規避。"

msgid "仅处理已轮转、非当前写入的日志；压缩即归档，不影响日志可读性（gunzip 还原）。"
msgstr "僅處理已輪轉、非當前寫入的日誌；壓縮即歸檔，不影響日誌可讀性（gunzip 還原）。"

msgid "更稳妥做法是用系统 logadm / logrotate 统一轮转与压缩。"
msgstr "更穩妥做法是用系統 logadm / logrotate 統一輪轉與壓縮。"

msgid "ZFS 存储池校验（zpool scrub）"
msgstr "ZFS 存儲池校驗（zpool scrub）"

msgid "按 OpenZFS 规范对 zpool 发起 scrub 校验，检测并修复数据校验和错误。"
msgstr "按 OpenZFS 規範對 zpool 發起 scrub 校驗，檢測並修復數據校驗和錯誤。"

msgid "大容量池 scrub 耗时长且占 IO，建议维护窗口执行。"
msgstr "大容量池 scrub 耗時長且佔 IO，建議維護窗口執行。"

msgid "scrub 在后台进行，可用 zpool status 查看进度。"
msgstr "scrub 在後臺進行，可用 zpool status 查看進度。"

msgid "刷新 IPS 软件源目录（pkg refresh）"
msgstr "刷新 IPS 軟件源目錄（pkg refresh）"

msgid "用 IPS 官方接口刷新 publisher 目录与本地元数据，让后续 pkg list/verify 基于最新清单。"
msgstr "用 IPS 官方接口刷新 publisher 目錄與本地元數據，讓後續 pkg list/verify 基於最新清單。"

msgid "需 root 且要能连到软件源；只更新元数据，不安装也不卸载任何包。"
msgstr "需 root 且要能連到軟件源；只更新元數據，不安裝也不卸載任何包。"

msgid "只读核对：pkg publisher、pkg list -u（列可更新包）。"
msgstr "只讀覈對：pkg publisher、pkg list -u（列可更新包）。"

msgid "按 IPS 清单校验修复不一致（pkg fix）"
msgstr "按 IPS 清單校驗修復不一致（pkg fix）"

msgid "先用 pkg verify 比对已装文件与 IPS 清单，再用官方 pkg fix 还原被改动/缺失的文件。"
msgstr "先用 pkg verify 比對已裝文件與 IPS 清單，再用官方 pkg fix 還原被改動/缺失的文件。"

msgid "需 root；会按官方清单覆盖被改动的系统文件（本地手工改过的文件可能被还原），属『恢复一致性』方向，不动用户数据。"
msgstr "需 root；會按官方清單覆蓋被改動的系統文件（本地手工改過的文件可能被還原），屬『恢復一致性』方向，不動用戶數據。"

msgid "只读核对：pkg verify（列出不一致文件，不改任何东西）。"
msgstr "只讀覈對：pkg verify（列出不一致文件，不改任何東西）。"

msgid "开启 FMA 故障管理守护（svcadm enable）"
msgstr "開啓 FMA 故障管理守護（svcadm enable）"

msgid "启用 svc:/system/fmd:default，让 FMA 收集故障遥测并在硬件出问题时自动隔离（只开不关）。"
msgstr "啓用 svc:/system/fmd:default，讓 FMA 收集故障遙測並在硬件出問題時自動隔離（只開不關）。"

msgid "本工具只做 enable——绝不对 fmd/ssh/svc.startd 等关键服务做 disable。"
msgstr "本工具只做 enable——絕不對 fmd/ssh/svc.startd 等關鍵服務做 disable。"

msgid "只读核对：svcs -a | grep fmd；故障看 fmadm faulty / fmdump -v。"
msgstr "只讀覈對：svcs -a | grep fmd；故障看 fmadm faulty / fmdump -v。"

msgid "清除服务 maintenance 状态（svcadm clear）"
msgstr "清除服務 maintenance 狀態（svcadm clear）"

msgid "自动探测处于 maintenance 的服务 FMRI，用官方 svcadm clear 清状态，让服务重新受管。"
msgstr "自動探測處於 maintenance 的服務 FMRI，用官方 svcadm clear 清狀態，讓服務重新受管。"

msgid "只清状态、不做启停；真正的故障原因请先按 svcs -x 输出处理。"
msgstr "只清狀態、不做啓停；真正的故障原因請先按 svcs -x 輸出處理。"

msgid "只读核对：svcs -x（看故障原因）；原因未除前清状态可能再次进入 maintenance。"
msgstr "只讀覈對：svcs -x（看故障原因）；原因未除前清狀態可能再次進入 maintenance。"

msgid "ZFS 关闭访问时间更新（zfs set atime=off）"
msgstr "ZFS 關閉訪問時間更新（zfs set atime=off）"

msgid "关掉 ZFS 的 atime 回写：读文件不再写元数据，减少写放大，与 NTFS 关最后访问时间同思路。"
msgstr "關掉 ZFS 的 atime 回寫：讀文件不再寫元數據，減少寫放大，與 NTFS 關最後訪問時間同思路。"

msgid "依赖 atime 做审计/归档判断的软件需先确认；可随时 zfs set atime=on 改回。"
msgstr "依賴 atime 做審計/歸檔判斷的軟件需先確認；可隨時 zfs set atime=on 改回。"

msgid "只读核对：zfs get atime <pool>；只作用于设置后的新访问，不重写已有数据。"
msgstr "只讀覈對：zfs get atime <pool>；只作用於設置後的新訪問，不重寫已有數據。"

msgid "ZFS 开启 LZ4 压缩（zfs set compression=lz4）"
msgstr "ZFS 開啓 LZ4 壓縮（zfs set compression=lz4）"

msgid "给池开 LZ4 压缩：CPU 开销极低、压缩解压快，通常能用很小的代价换明显空间。"
msgstr "給池開 LZ4 壓縮：CPU 開銷極低、壓縮解壓快，通常能用很小的代價換明顯空間。"

msgid "只压缩设置后新写入的块，已有数据不会被重写（想重写需 zfs send/recv 或 rewrite）；已压缩数据改回 off 不会展开。"
msgstr "只壓縮設置後新寫入的塊，已有數據不會被重寫（想重寫需 zfs send/recv 或 rewrite）；已壓縮數據改回 off 不會展開。"

msgid "只读核对：zfs get compression <pool>；LZ4 在多数负载下接近零成本。"
msgstr "只讀覈對：zfs get compression <pool>；LZ4 在多數負載下接近零成本。"

msgid "按官方配置轮转日志（logadm -r）"
msgstr "按官方配置輪轉日誌（logadm -r）"

msgid "用官方 logadm 按 /etc/logadm.conf 立即轮转一次：归档改名、按保留份数淘汰最旧档。"
msgstr "用官方 logadm 按 /etc/logadm.conf 立即輪轉一次：歸檔改名、按保留份數淘汰最舊檔。"

msgid "需 root；轮转不删正在写入的日志，历史档按 -C 份数淘汰。"
msgstr "需 root；輪轉不刪正在寫入的日誌，歷史檔按 -C 份數淘汰。"

msgid "只读核对：logadm -V（校验配置语法）、logadm -v（预演）。"
msgstr "只讀覈對：logadm -V（校驗配置語法）、logadm -v（預演）。"

msgid "TCP 开启 ECN（ipadm set-prop，RFC 3168）"
msgstr "TCP 開啓 ECN（ipadm set-prop，RFC 3168）"

msgid "用官方 ipadm 把 TCP 的 ecn 设为 active：拥塞时用报头标记代替丢包降速，吞吐更稳、延迟更低。"
msgstr "用官方 ipadm 把 TCP 的 ecn 設爲 active：擁塞時用報頭標記代替丟包降速，吞吐更穩、延遲更低。"

msgid "个别老旧或错误配置的中间设备会丢弃带 ECN 标记的报文，遇连通性异常请用 ipadm set-prop -p ecn=passive tcp 退回（本工具只开不关）。"
msgstr "個別老舊或錯誤配置的中間設備會丟棄帶 ECN 標記的報文，遇連通性異常請用 ipadm set-prop -p ecn=passive tcp 退回（本工具只開不關）。"

msgid "参考：RFC 3168 / ipadm(8) man。只读核对：ipadm show-prop tcp。"
msgstr "參考：RFC 3168 / ipadm(8) man。只讀覈對：ipadm show-prop tcp。"

msgid "清理应用缓存（adb）"
msgstr "清理應用緩存（adb）"

msgid "对第三方应用执行 trim（释放缓存），而非清空数据。"
msgstr "對第三方應用執行 trim（釋放緩存），而非清空數據。"

msgid "pm trim 仅释放缓存、不删账号数据；需设备已连接并授权。"
msgstr "pm trim 僅釋放緩存、不刪賬號數據；需設備已連接並授權。"

msgid "删除下载目录与缩略图垃圾"
msgstr "刪除下載目錄與縮略圖垃圾"

msgid "删除 /sdcard/Download 的临时文件与 DCIM/.thumbnails。"
msgstr "刪除 /sdcard/Download 的臨時文件與 DCIM/.thumbnails。"

msgid "不要误删 /sdcard/Download 下有用文件；建议先手动查看。"
msgstr "不要誤刪 /sdcard/Download 下有用文件；建議先手動查看。"

msgid "清理 Dalvik/ART 缓存（恢复模式向）"
msgstr "清理 Dalvik/ART 緩存（恢復模式向）"

msgid "通常无需手动清；系统更新后会自动重建。"
msgstr "通常無需手動清；系統更新後會自動重建。"

msgid "错误操作可能需重刷系统；普通用户不建议。"
msgstr "錯誤操作可能需重刷系統；普通用戶不建議。"

msgid "Android 手动优化指引"
msgstr "Android 手動優化指引"

msgid "无需 adb 的日常优化项。"
msgstr "無需 adb 的日常優化項。"

msgid "未 Root 的安卓无法深度清理系统分区，依赖厂商自带工具更稳妥。"
msgstr "未 Root 的安卓無法深度清理系統分區，依賴廠商自帶工具更穩妥。"

msgid "存储分区 fstrim（原生 adb 接口）"
msgstr "存儲分區 fstrim（原生 adb 接口）"

msgid "用 adb 原生接口对内部存储执行 fstrim，回收已删除块、提升读写效率。"
msgstr "用 adb 原生接口對內部存儲執行 fstrim，回收已刪除塊、提升讀寫效率。"

msgid "需设备已连接并授权 USB 调试；部分厂商 ROM 限制 fstrim，失败属正常。"
msgstr "需設備已連接並授權 USB 調試；部分廠商 ROM 限制 fstrim，失敗屬正常。"

msgid "开启自适应电池与后台限制"
msgstr "開啓自適應電池與後臺限制"

msgid "用系统自带的「自适应电池」限制后台耗电应用，提升续航与流畅度（无需 adb）。"
msgstr "用系統自帶的「自適應電池」限制後臺耗電應用，提升續航與流暢度（無需 adb）。"

msgid "纯系统设置，无数据风险；可随时改回。"
msgstr "純系統設置，無數據風險；可隨時改回。"

msgid "存储分析与大文件清理"
msgstr "存儲分析與大文件清理"

msgid "进入系统存储分析，定位「其他/大文件」并清理云端已备份的本地副本。"
msgstr "進入系統存儲分析，定位「其他/大文件」並清理雲端已備份的本地副本。"

msgid "建议先确认已开启云备份，再删本地副本，避免数据丢失。"
msgstr "建議先確認已開啓雲備份，再刪本地副本，避免數據丟失。"

msgid "未使用应用休眠与权限回收"
msgstr "未使用應用休眠與權限回收"

msgid "对长期未使用的应用启用休眠（撤销权限、停止后台、释放空间），提升续航与隐私。"
msgstr "對長期未使用的應用啓用休眠（撤銷權限、停止後臺、釋放空間），提升續航與隱私。"

msgid "勿对闹钟/无障碍/设备管理器类应用休眠，否则可能失效。"
msgstr "勿對鬧鐘/無障礙/設備管理器類應用休眠，否則可能失效。"

msgid "Android 10 及以下无此官方能力，改用「限制后台活动」或厂商的清理工具。"
msgstr "Android 10 及以下無此官方能力，改用「限制後臺活動」或廠商的清理工具。"

msgid "设置路径：设置 → 应用 → 未使用的应用 → 休眠；Android 12+ 原生支持。"
msgstr "設置路徑：設置 → 應用 → 未使用的應用 → 休眠；Android 12+ 原生支持。"

msgid "休眠会撤销已授予权限并停止后台，重新打开时恢复。"
msgstr "休眠會撤銷已授予權限並停止後臺，重新打開時恢復。"

msgid "关闭窗口动画（settings put global）"
msgstr "關閉窗口動畫（settings put global）"

msgid "用官方 settings put 把窗口/过渡/Animator 动画缩放设为 0，界面更跟手、省一点合成开销；可随时改回 1 恢复。"
msgstr "用官方 settings put 把窗口/過渡/Animator 動畫縮放設爲 0，界面更跟手、省一點合成開銷；可隨時改回 1 恢復。"

msgid "个别依赖过渡动画反馈的 App 可能略显生硬；属可恢复体验项，非系统改动。"
msgstr "個別依賴過渡動畫反饋的 App 可能略顯生硬；屬可恢復體驗項，非系統改動。"

msgid "只读核对：settings get global window_animation_scale；动画关掉不影响任何功能。"
msgstr "只讀覈對：settings get global window_animation_scale；動畫關掉不影響任何功能。"

msgid "释放全部应用缓存（pm trim-caches）"
msgstr "釋放全部應用緩存（pm trim-caches）"

msgid "用官方 pm trim-caches 释放已装应用的可丢弃缓存，回收空间而不删账号数据。"
msgstr "用官方 pm trim-caches 釋放已裝應用的可丟棄緩存，回收空間而不刪賬號數據。"

msgid "只清缓存、不删数据；大数值=尽量多清，等价于设置里逐 App 清缓存的可批量化版本。"
msgstr "只清緩存、不刪數據；大數值=儘量多清，等價於設置裏逐 App 清緩存的可批量化版本。"

msgid "只读核对：pm list packages -3（看第三方应用数）。设置→存储能看到释放量。"
msgstr "只讀覈對：pm list packages -3（看第三方應用數）。設置→存儲能看到釋放量。"

msgid "开启 Wi-Fi（svc wifi enable）"
msgstr "開啓 Wi-Fi（svc wifi enable）"

msgid "用官方 svc wifi enable 确保 Wi-Fi 开启，便于同步与更新；只开不关。"
msgstr "用官方 svc wifi enable 確保 Wi-Fi 開啓，便於同步與更新；只開不關。"

msgid "本工具只往安全方向写——绝不替用户 disable 网络（那是减功能、可能误伤同步/支付）。"
msgstr "本工具只往安全方向寫——絕不替用戶 disable 網絡（那是減功能、可能誤傷同步/支付）。"

msgid "只读核对：settings get global wifi_on。需要关无线请在设置里自行操作。"
msgstr "只讀覈對：settings get global wifi_on。需要關無線請在設置裏自行操作。"

msgid "清零电量统计（dumpsys batterystats --reset）"
msgstr "清零電量統計（dumpsys batterystats --reset）"

msgid "用官方 dumpsys batterystats --reset 清零电量统计，便于重新开始测量续航表现。"
msgstr "用官方 dumpsys batterystats --reset 清零電量統計，便於重新開始測量續航表現。"

msgid "只是计数器归零，不是清电池校准；想重测续航请在清零后正常使用一段时间再看。"
msgstr "只是計數器歸零，不是清電池校準；想重測續航請在清零後正常使用一段時間再看。"

msgid "只读核对：dumpsys batterystats（看当前统计）。统计清零不影响运行、不删文件。"
msgstr "只讀覈對：dumpsys batterystats（看當前統計）。統計清零不影響運行、不刪文件。"

msgid "清空日志缓冲（logcat -c）"
msgstr "清空日誌緩衝（logcat -c）"

msgid "用官方 logcat -c 清空内存环形日志缓冲，排障前清场用；只清日志、不碰文件。"
msgstr "用官方 logcat -c 清空內存環形日誌緩衝，排障前清場用；只清日誌、不碰文件。"

msgid "只清日志缓冲，不删 /data 下的任何日志文件，不影响 App 运行。"
msgstr "只清日誌緩衝，不刪 /data 下的任何日誌文件，不影響 App 運行。"

msgid "只读核对：logcat -d -t 40（看当前日志）。缓冲是内存环形，清了会重新产生。"
msgstr "只讀覈對：logcat -d -t 40（看當前日誌）。緩衝是內存環形，清了會重新產生。"

msgid "回收后台内存（am kill-all）"
msgstr "回收後臺內存（am kill-all）"

msgid "用官方 am kill-all 杀掉所有后台进程，等价于一次内存回收；前台 App 不受影响。"
msgstr "用官方 am kill-all 殺掉所有後臺進程，等價於一次內存回收；前臺 App 不受影響。"

msgid "只对后台进程生效；勿对正在前台、或带设备管理员/无障碍/闹钟角色的应用强停——可能触发拉起或短暂失效。"
msgstr "只對後臺進程生效；勿對正在前臺、或帶設備管理員/無障礙/鬧鐘角色的應用強停——可能觸發拉起或短暫失效。"

msgid "只读核对：dumpsys meminfo（看内存占用）。后台进程被杀后再次打开会自动重启。"
msgstr "只讀覈對：dumpsys meminfo（看內存佔用）。後臺進程被殺後再次打開會自動重啓。"

msgid "清零网络流量统计（dumpsys netstats --reset）"
msgstr "清零網絡流量統計（dumpsys netstats --reset）"

msgid "用官方 dumpsys netstats --reset 清零网络流量统计计数器，便于重新计量。"
msgstr "用官方 dumpsys netstats --reset 清零網絡流量統計計數器，便於重新計量。"

msgid "只是统计归零，不切断任何连接、不改计费本身。"
msgstr "只是統計歸零，不切斷任何連接、不改計費本身。"

msgid "只读核对：dumpsys netstats（看当前统计）。清计数不影响连接与真实计费记录。"
msgstr "只讀覈對：dumpsys netstats（看當前統計）。清計數不影響連接與真實計費記錄。"

msgid "恢复默认显示（wm size reset / wm density reset）"
msgstr "恢復默認顯示（wm size reset / wm density reset）"

msgid "用官方 wm reset 把显示尺寸与 DPI 恢复为设备物理默认，修复误设导致的界面不可点。"
msgstr "用官方 wm reset 把顯示尺寸與 DPI 恢復爲設備物理默認，修復誤設導致的界面不可點。"

msgid "本工具只 reset 回默认、绝不自定义设具体 WxH/DPI——设错有「界面不可点、需恢复出厂」风险。"
msgstr "本工具只 reset 回默認、絕不自定義設具體 WxH/DPI——設錯有「界面不可點、需恢復出廠」風險。"

msgid "只读核对：wm size / wm density（看当前显示参数）。reset 是修复性操作，不丢数据。"
msgstr "只讀覈對：wm size / wm density（看當前顯示參數）。reset 是修復性操作，不丟數據。"

msgid "适老化无障碍体检总报告（只读）"
msgstr "適老化無障礙體檢總報告（只讀）"

msgid "一次性读取字体缩放、显示无障碍、读屏服务、减弱动画、护眼五类适老化开关的当前状态，给出可读结论。"
msgstr "一次性讀取字體縮放、顯示無障礙、讀屏服務、減弱動畫、護眼五類適老化開關的當前狀態，給出可讀結論。"

msgid "本工具不改设置——开启 TalkBack 会改变触控手势，须由本人或当面确认后进行。"
msgstr "本工具不改設置——開啓 TalkBack 會改變觸控手勢，須由本人或當面確認後進行。"

msgid "需 adb + 设备已开启 USB 调试并授权；未连设备时降级为文档指引。"
msgstr "需 adb + 設備已開啓 USB 調試並授權；未連設備時降級爲文檔指引。"

msgid "只读：只 settings get，不代为开启任何无障碍服务。"
msgstr "只讀：只 settings get，不代爲開啓任何無障礙服務。"

msgid "适老化：字体缩放与字重核对（只读）"
msgstr "適老化：字體縮放與字重覈對（只讀）"

msgid "读 font_scale（字体缩放，API 1 起）与 font_weight_adjustment（字重，API 28+），判断字号是否够大。"
msgstr "讀 font_scale（字體縮放，API 1 起）與 font_weight_adjustment（字重，API 28+），判斷字號是否夠大。"

msgid "字号过大会挤版式、反而难用；建议 1.15–1.5 之间取稳。"
msgstr "字號過大會擠版式、反而難用；建議 1.15–1.5 之間取穩。"

msgid "判断口径：<1.0 未放大偏小；1.15–1.3 已放大；≥1.3 已属大字体档。"
msgstr "判斷口徑：<1.0 未放大偏小；1.15–1.3 已放大；≥1.3 已屬大字體檔。"

msgid "字重探针（font_weight_adjustment）在 Android 9+ 才有，低版本自动跳过。"
msgstr "字重探針（font_weight_adjustment）在 Android 9+ 纔有，低版本自動跳過。"

msgid "适老化：放大镜 / 色彩校正 / 高对比度（只读，按版本门控）"
msgstr "適老化：放大鏡 / 色彩校正 / 高對比度（只讀，按版本門控）"

msgid "读放大镜、色彩校正（色盲色弱）、高对比度文本、深色模式四类视觉辅助开关，低版本明说无此开关。"
msgstr "讀放大鏡、色彩校正（色盲色弱）、高對比度文本、深色模式四類視覺輔助開關，低版本明說無此開關。"

msgid "色彩校正会改变全屏配色，看视频/修图时需临时关回。"
msgstr "色彩校正會改變全屏配色，看視頻/修圖時需臨時關回。"

msgid "Android 8/9 无高对比度与深色模式开关，改用「亮度拉满 + 减少深色背景应用」等效替代。"
msgstr "Android 8/9 無高對比度與深色模式開關，改用「亮度拉滿 + 減少深色背景應用」等效替代。"

msgid "放大镜在 Android 4.2+ 即有，是老设备上最实用的低视力辅助。"
msgstr "放大鏡在 Android 4.2+ 即有，是老設備上最實用的低視力輔助。"

msgid "适老化：读屏服务（TalkBack）状态核对（只读）"
msgstr "適老化：讀屏服務（TalkBack）狀態覈對（只讀）"

msgid "读无障碍总开关与已启用服务列表，判断 TalkBack 是否已就绪。"
msgstr "讀無障礙總開關與已啓用服務列表，判斷 TalkBack 是否已就緒。"

msgid "TalkBack 开启后单指点=朗读、双指点=返回，务必当面教一次再放手。"
msgstr "TalkBack 開啓後單指點=朗讀、雙指點=返回，務必當面教一次再放手。"

msgid "本工具只读状态，绝不代为开启。"
msgstr "本工具只讀狀態，絕不代爲開啓。"

msgid "读屏是视力障碍用户的核心依赖；已启用列表会显示服务 component 名。"
msgstr "讀屏是視力障礙用戶的核心依賴；已啓用列表會顯示服務 component 名。"

msgid "开启路径：设置 → 辅助功能 → TalkBack。"
msgstr "開啓路徑：設置 → 輔助功能 → TalkBack。"

msgid "适老化：移除动画 + 保留触感反馈（只读核对）"
msgstr "適老化：移除動畫 + 保留觸感反饋（只讀覈對）"

msgid "读窗口/过渡/Animator 动画缩放与触感、提示音开关，核对「防眩晕」与「非视觉确认」是否到位。"
msgstr "讀窗口/過渡/Animator 動畫縮放與觸感、提示音開關，覈對「防眩暈」與「非視覺確認」是否到位。"

msgid "本工具只报状态不改设置；改动画是「移除动画」开关，属用户偏好。"
msgstr "本工具只報狀態不改設置；改動畫是「移除動畫」開關，屬用戶偏好。"

msgid "动画降到 0 可显著降低前庭敏感老人的眩晕与迷向感。"
msgstr "動畫降到 0 可顯著降低前庭敏感老人的眩暈與迷向感。"

msgid "触感与提示音建议至少留触感开——操作是否生效能「摸到」，不必盯屏确认。"
msgstr "觸感與提示音建議至少留觸感開——操作是否生效能「摸到」，不必盯屏確認。"

msgid "适老化：亮度 / 息屏 / 护眼夜览核对（只读）"
msgstr "適老化：亮度 / 息屏 / 護眼夜覽覈對（只讀）"

msgid "读屏幕亮度、自动息屏超时与护眼夜览状态，结合老花与白内障的视觉需求给判断。"
msgstr "讀屏幕亮度、自動息屏超時與護眼夜覽狀態，結合老花與白內障的視覺需求給判斷。"

msgid "仅报告状态，不代替长辈做决定。"
msgstr "僅報告狀態，不代替長輩做決定。"

msgid "老花与白内障用户普遍需要更高亮度；自动亮度忽明忽暗反而更累。"
msgstr "老花與白內障用戶普遍需要更高亮度；自動亮度忽明忽暗反而更累。"

msgid "息屏调长可减少反复点亮，但更耗电——建议与本人确认。"
msgstr "息屏調長可減少反覆點亮，但更耗電——建議與本人確認。"

msgid "API 28 以下无夜览开关，多在厂商显示设置里。"
msgstr "API 28 以下無夜覽開關，多在廠商顯示設置裏。"

msgid "适老化设置指引（纯文字，无需 adb）"
msgstr "適老化設置指引（純文字，無需 adb）"

msgid "不连设备也能给出的适老化调整清单，可直接照着念给长辈逐条设置。"
msgstr "不連設備也能給出的適老化調整清單，可直接照着念給長輩逐條設置。"

msgid "替长辈改设置前先问一句：他们愿不愿意换熟悉的操作方式。"
msgstr "替長輩改設置前先問一句：他們願不願意換熟悉的操作方式。"

msgid "本任务为纯文字指引，不执行任何命令、无数据风险。"
msgstr "本任務爲純文字指引，不執行任何命令、無數據風險。"

msgid "专门用于「PC 没连安卓设备」或「想让子女远程照着念」的场景。"
msgstr "專門用於「PC 沒連安卓設備」或「想讓子女遠程照着念」的場景。"

msgid "Android 8 向下兼容口径总览（只读）"
msgstr "Android 8 向下兼容口徑總覽（只讀）"

msgid "列出各 Android 接口的最低 API 与本机可用性，回答「这台老安卓还能不能被管」。"
msgstr "列出各 Android 接口的最低 API 與本機可用性，回答「這臺老安卓還能不能被管」。"

msgid "部分厂商 ROM 裁剪了 settings 键，即便 API 达标也可能读不到值——此时会明说「未暴露该键」。"
msgstr "部分廠商 ROM 裁剪了 settings 鍵，即便 API 達標也可能讀不到值——此時會明說「未暴露該鍵」。"

msgid "本工具承诺下探到 Android 8.0（API 26）；低于此值的适老化项给系统设置路径指引。"
msgstr "本工具承諾下探到 Android 8.0（API 26）；低於此值的適老化項給系統設置路徑指引。"

msgid "会显式标出「本机 API < 所需 API」的项，避免在老设备上给出必然失败的命令。"
msgstr "會顯式標出「本機 API < 所需 API」的項，避免在老設備上給出必然失敗的命令。"

msgid "卸载未使用的 App（保留数据）"
msgstr "卸載未使用的 App（保留數據）"

msgid "设置中开启「卸载未使用的 App」，或手动卸载大体积 App。"
msgstr "設置中開啓「卸載未使用的 App」，或手動卸載大體積 App。"

msgid "卸载仅删程序本身，文档数据保留，重装即可恢复。"
msgstr "卸載僅刪程序本身，文檔數據保留，重裝即可恢復。"

msgid "清理 Safari 与浏览器缓存"
msgstr "清理 Safari 與瀏覽器緩存"

msgid "清除 Safari 历史与网站数据（不含 iCloud 钥匙串）。"
msgstr "清除 Safari 歷史與網站數據（不含 iCloud 鑰匙串）。"

msgid "会退出已登录网站的会话，需重新登录。"
msgstr "會退出已登錄網站的會話，需重新登錄。"

msgid "清理信息与大附件"
msgstr "清理信息與大附件"

msgid "删除「设置 → 通用 → iPhone 存储 → 信息」中的大附件。"
msgstr "刪除「設置 → 通用 → iPhone 存儲 → 信息」中的大附件。"

msgid "iCloud 照片开启时，删除会同步到云端，谨慎操作。"
msgstr "iCloud 照片開啓時，刪除會同步到雲端，謹慎操作。"

msgid "释放内存（重启）"
msgstr "釋放內存（重啓）"

msgid "iOS 无等效「清理内存」开关，重启是最有效方式。"
msgstr "iOS 無等效「清理內存」開關，重啓是最有效方式。"

msgid "iOS 自动管理内存，无需第三方「内存清理」App（多数无效且耗电）。"
msgstr "iOS 自動管理內存，無需第三方「內存清理」App（多數無效且耗電）。"

msgid "越狱风险提示"
msgstr "越獄風險提示"

msgid "不推荐越狱来「深度清理」。"
msgstr "不推薦越獄來「深度清理」。"

msgid "越狱会失去官方安全更新与保修，并显著降低安全性；App Store 外的「清理大师」类工具多无效或含广告/隐私风险。"
msgstr "越獄會失去官方安全更新與保修，並顯著降低安全性；App Store 外的「清理大師」類工具多無效或含廣告/隱私風險。"

msgid "保持系统为最新正式版（iOS 26 及以上）即可获得最佳性能与安全。"
msgstr "保持系統爲最新正式版（iOS 26 及以上）即可獲得最佳性能與安全。"

msgid "读取设备信息（libimobiledevice 接口）"
msgstr "讀取設備信息（libimobiledevice 接口）"

msgid "用 libimobiledevice 的 ideviceinfo 读取型号/系统版本（不触碰隐私字段）。"
msgstr "用 libimobiledevice 的 ideviceinfo 讀取型號/系統版本（不觸碰隱私字段）。"

msgid "需设备已信任本机且装有 libimobiledevice；未装/未连接时自动降级为手动指引。"
msgstr "需設備已信任本機且裝有 libimobiledevice；未裝/未連接時自動降級爲手動指引。"

msgid "照片「优化 iPhone 存储」"
msgstr "照片「優化 iPhone 存儲」"

msgid "开启「优化 iPhone 存储」，仅保留缩略图，原图留存 iCloud，释放本地空间。"
msgstr "開啓「優化 iPhone 存儲」，僅保留縮略圖，原圖留存 iCloud，釋放本地空間。"

msgid "需已登录 iCloud 且开启照片同步；原图在云端可随时下载。"
msgstr "需已登錄 iCloud 且開啓照片同步；原圖在雲端可隨時下載。"

msgid "关闭不必要的后台 App 刷新"
msgstr "關閉不必要的後臺 App 刷新"

msgid "关闭非必要 App 的后台刷新，省电省流量、减少后台占用。"
msgstr "關閉非必要 App 的後臺刷新，省電省流量、減少後臺佔用。"

msgid "即时通讯类建议保留，避免收不到消息。"
msgstr "即時通訊類建議保留，避免收不到消息。"

msgid "iPhone 存储分析与清理"
msgstr "iPhone 存儲分析與清理"

msgid "进入「iPhone 存储」等待系统分析后，清理「文稿与数据」中可精简项。"
msgstr "進入「iPhone 存儲」等待系統分析後，清理「文稿與數據」中可精簡項。"

msgid "「卸载 App」只删程序、保留数据，比重删更安全。"
msgstr "「卸載 App」只刪程序、保留數據，比重刪更安全。"

msgid "关闭分析与个性化广告跟踪"
msgstr "關閉分析與個性化廣告跟蹤"

msgid "关闭 iOS 的分析共享与个性化广告跟踪，减少行为数据上传。"
msgstr "關閉 iOS 的分析共享與個性化廣告跟蹤，減少行爲數據上傳。"

msgid "不影响应用核心功能，仅个性化广告相关性下降。"
msgstr "不影響應用核心功能，僅個性化廣告相關性下降。"

msgid "iOS 14.5+ 起 App 跟踪需显式授权（ATT 框架）。"
msgstr "iOS 14.5+ 起 App 跟蹤需顯式授權（ATT 框架）。"

msgid "整机备份到本地（优化前置）"
msgstr "整機備份到本地（優化前置）"

msgid "用 idevicebackup2 把设备备份导出到 ./ios_backup，单向、不写回设备。"
msgstr "用 idevicebackup2 把設備備份導出到 ./ios_backup，單向、不寫回設備。"

msgid "备份写入本机目录，需要足够磁盘空间；首次为全量、后续增量。"
msgstr "備份寫入本機目錄，需要足夠磁盤空間；首次爲全量、後續增量。"

msgid "备份是所有 iOS 优化的安全前置；与「恢复」方向相反，绝不 restore。"
msgstr "備份是所有 iOS 優化的安全前置；與「恢復」方向相反，絕不 restore。"

msgid "归档未使用用户 App（保留数据）"
msgstr "歸檔未使用用戶 App（保留數據）"

msgid "用 ideviceinstaller -a 归档用户 App，打成可恢复包，而非卸载删数据。"
msgstr "用 ideviceinstaller -a 歸檔用戶 App，打成可恢復包，而非卸載刪數據。"

msgid "仅归档用户 App（IsUserApplication=User），系统 App 自动跳过。"
msgstr "僅歸檔用戶 App（IsUserApplication=User），系統 App 自動跳過。"

msgid "归档 = 导出可恢复包，重装即可复原；与「卸载」（-U，删数据）方向相反。"
msgstr "歸檔 = 導出可恢復包，重裝即可復原；與「卸載」（-U，刪數據）方向相反。"

msgid "清理崩溃/诊断报告（仅日志）"
msgstr "清理崩潰/診斷報告（僅日誌）"

msgid "用 idevicecrashreport -e 拷贝到本地后删除设备端崩溃报告，纯日志、可逆。"
msgstr "用 idevicecrashreport -e 拷貝到本地後刪除設備端崩潰報告，純日誌、可逆。"

msgid "与 Android 的 logcat -c 同属「只清日志」的安全方向。"
msgstr "與 Android 的 logcat -c 同屬「只清日誌」的安全方向。"

msgid "崩溃报告是诊断日志，删除后系统会重新生成，无用户数据损失。"
msgstr "崩潰報告是診斷日誌，刪除後系統會重新生成，無用戶數據損失。"

msgid "同步设备时间为主机时间"
msgstr "同步設備時間爲主機時間"

msgid "用 idevicedate -s 把设备时钟同步为当前主机时间（可逆）。"
msgstr "用 idevicedate -s 把設備時鐘同步爲當前主機時間（可逆）。"

msgid "时间错位会导致证书/同步异常；同步为主机时间是安全方向。"
msgstr "時間錯位會導致證書/同步異常；同步爲主機時間是安全方向。"

msgid "清除模拟定位"
msgstr "清除模擬定位"

msgid "用 idevicesetlocation clear 清除开发者模拟定位，恢复真实 GPS（可逆）。"
msgstr "用 idevicesetlocation clear 清除開發者模擬定位，恢復真實 GPS（可逆）。"

msgid "仅清除调试用的模拟坐标，不影响真实定位权限。"
msgstr "僅清除調試用的模擬座標，不影響真實定位權限。"

msgid "归一化设备名"
msgstr "歸一化設備名"

msgid "用 idevicename 把设备名设为 Optimized-iOS（设置中可随时改回，可逆）。"
msgstr "用 idevicename 把設備名設爲 Optimized-iOS（設置中可隨時改回，可逆）。"

msgid "仅改显示名，不触碰任何数据；设置 → 通用 → 关于本机可改回。"
msgstr "僅改顯示名，不觸碰任何數據；設置 → 通用 → 關於本機可改回。"

msgid "优雅重启释放内存"
msgstr "優雅重啓釋放內存"

msgid "用 idevicediagnostics restart 发送优雅重启，释放内存、无数据丢失。"
msgstr "用 idevicediagnostics restart 發送優雅重啓，釋放內存、無數據丟失。"

msgid "medium 风险：执行会重启设备，需 --yes 确认；进行中操作请先保存。"
msgstr "medium 風險：執行會重啓設備，需 --yes 確認；進行中操作請先保存。"

msgid "等效手动重启；会打断当前会话，但无数据损失——属安全方向。"
msgstr "等效手動重啓；會打斷當前會話，但無數據損失——屬安全方向。"

msgid "挂载开发者磁盘镜像（启用开发者服务）"
msgstr "掛載開發者磁盤鏡像（啓用開發者服務）"

msgid "用 ideviceimagemounter 挂载匹配版本的 DeveloperDiskImage，启用 Instruments 等。"
msgstr "用 ideviceimagemounter 掛載匹配版本的 DeveloperDiskImage，啓用 Instruments 等。"

msgid "需本机存在与系统版本匹配的 DeveloperDiskImage；不联网下载。"
msgstr "需本機存在與系統版本匹配的 DeveloperDiskImage；不聯網下載。"

msgid "挂载可逆（可卸载），不修改用户数据；缺镜像时自动降级为文档指引。"
msgstr "掛載可逆（可卸載），不修改用戶數據；缺鏡像時自動降級爲文檔指引。"

msgid "OpenWrt 探测与板型/固件识别（只读）"
msgstr "OpenWrt 探測與板型/固件識別（只讀）"

msgid "读取 /etc/openwrt_release、/etc/os-release、/tmp/sysinfo/{board_name,model}，识别设备型号、固件版本、目标平台与架构。纯只读。"
msgstr "讀取 /etc/openwrt_release、/etc/os-release、/tmp/sysinfo/{board_name,model}，識別設備型號、固件版本、目標平臺與架構。純只讀。"

msgid "刷机（sysupgrade）为写操作，本工具不自动执行，仅给文档指引。"
msgstr "刷機（sysupgrade）爲寫操作，本工具不自動執行，僅給文檔指引。"

msgid "board_name / model 给出硬件型号；DISTRIB_RELEASE/TARGET/ARCH 给出固件与架构。"
msgstr "board_name / model 給出硬件型號；DISTRIB_RELEASE/TARGET/ARCH 給出固件與架構。"

msgid "非 OpenWrt 环境会降级为指引（说明需在路由器上运行）。"
msgstr "非 OpenWrt 環境會降級爲指引（說明需在路由器上運行）。"

msgid "UCI 配置只读审计（/etc/config/*，不打印 secret 明文）"
msgstr "UCI 配置只讀審計（/etc/config/*，不打印 secret 明文）"

msgid "解析 /etc/config/*（network/system/wireless/firewall/dhcp…），列出每文件节数、接口、桥接与含敏感配置项的存在性；敏感值绝不回显。"
msgstr "解析 /etc/config/*（network/system/wireless/firewall/dhcp…），列出每文件節數、接口、橋接與含敏感配置項的存在性；敏感值絕不回顯。"

msgid "写配置用 `uci set` + `uci commit`，本工具不自动执行任何 uci set。"
msgstr "寫配置用 `uci set` + `uci commit`，本工具不自動執行任何 uci set。"

msgid "可选 `uci show` 检视；无 uci 命令时回退文件解析。"
msgstr "可選 `uci show` 檢視；無 uci 命令時回退文件解析。"

msgid "含 key/password/secret/psk 等配置项仅报告「存在」，不打印值。"
msgstr "含 key/password/secret/psk 等配置項僅報告「存在」，不打印值。"

msgid "已装软件包只读盘点（opkg/apk 自适应）"
msgstr "已裝軟件包只讀盤點（opkg/apk 自適應）"

msgid "盘点 OpenWrt 已装软件包：24.10 用 apk（/usr/lib/apk/db/installed），更早用 opkg（/usr/lib/opkg/status）；命令不可用则解析状态文件。"
msgstr "盤點 OpenWrt 已裝軟件包：24.10 用 apk（/usr/lib/apk/db/installed），更早用 opkg（/usr/lib/opkg/status）；命令不可用則解析狀態文件。"

msgid "`opkg install` / `apk add` 为写操作，本工具不自动执行。"
msgstr "`opkg install` / `apk add` 爲寫操作，本工具不自動執行。"

msgid "23.05 及更早：opkg；24.10 起默认：apk。"
msgstr "23.05 及更早：opkg；24.10 起默認：apk。"

msgid "安装/升级为写操作，仅给指引。"
msgstr "安裝/升級爲寫操作，僅給指引。"

msgid "网络接口只读报告（netifd / ubus / UCI network）"
msgstr "網絡接口只讀報告（netifd / ubus / UCI network）"

msgid "解析 /etc/config/network 列出接口/桥接/VLAN；可选 `ubus call network.interface dump`读取运行时状态。纯只读。"
msgstr "解析 /etc/config/network 列出接口/橋接/VLAN；可選 `ubus call network.interface dump`讀取運行時狀態。純只讀。"

msgid "改接口为写操作（uci set + commit 或 ubus 写方法），本工具不自动执行。"
msgstr "改接口爲寫操作（uci set + commit 或 ubus 寫方法），本工具不自動執行。"

msgid "接口/桥接/VLAN 来自 UCI；运行时状态来自 ubus（只读方法）。"
msgstr "接口/橋接/VLAN 來自 UCI；運行時狀態來自 ubus（只讀方法）。"

msgid "OpenWrt 构建系统参考（ImageBuilder/SDK/feeds，仅文档）"
msgstr "OpenWrt 構建系統參考（ImageBuilder/SDK/feeds，僅文檔）"

msgid "列出定制固件的三种路径：ImageBuilder（最快，基于预编译根文件挑包）、SDK（交叉编译软件包）、完整 menuconfig 编译。均为写操作，仅给文档指引。"
msgstr "列出定製固件的三種路徑：ImageBuilder（最快，基於預編譯根文件挑包）、SDK（交叉編譯軟件包）、完整 menuconfig 編譯。均爲寫操作，僅給文檔指引。"

msgid "`make image` / SDK make / 完整编译 / sysupgrade 均为写操作，本工具不调用。"
msgstr "`make image` / SDK make / 完整編譯 / sysupgrade 均爲寫操作，本工具不調用。"

msgid "ImageBuilder 最快；SDK 用于编译单包；完整编译最灵活最慢。"
msgstr "ImageBuilder 最快；SDK 用於編譯單包；完整編譯最靈活最慢。"

msgid "防火墙只读报告（/etc/config/firewall，zone/转发/规则）"
msgstr "防火牆只讀報告（/etc/config/firewall，zone/轉發/規則）"

msgid "解析 /etc/config/firewall，列出区域(zone)、转发(forwarding)、规则(rule)、重定向(redirect)数量与各区域网络归属、NAT(masq)、input/output 策略；运行时实现（firewall4/nftables 或 firewall3/iptables）只读检视。纯只读。"
msgstr "解析 /etc/config/firewall，列出區域(zone)、轉發(forwarding)、規則(rule)、重定向(redirect)數量與各區域網絡歸屬、NAT(masq)、input/output 策略；運行時實現（firewall4/nftables 或 firewall3/iptables）只讀檢視。純只讀。"

msgid "改防火墙规则为写操作（uci set + commit + reload），本工具不自动执行。"
msgstr "改防火牆規則爲寫操作（uci set + commit + reload），本工具不自動執行。"

msgid "zone/forwarding/rule/redirect 来自 UCI；运行时状态只读检视。"
msgstr "zone/forwarding/rule/redirect 來自 UCI；運行時狀態只讀檢視。"

msgid "无线只读报告（/etc/config/wireless，不回显密码）"
msgstr "無線只讀報告（/etc/config/wireless，不回顯密碼）"

msgid "解析 /etc/config/wireless，列出无线电(wifi-device)频段/信道/禁用状态与无线接口(wifi-iface)的设备/模式/加密方式。含密码的接口仅标记存在性，绝不回显密钥明文。纯只读。"
msgstr "解析 /etc/config/wireless，列出無線電(wifi-device)頻段/信道/禁用狀態與無線接口(wifi-iface)的設備/模式/加密方式。含密碼的接口僅標記存在性，絕不回顯密鑰明文。純只讀。"

msgid "改无线为写操作（uci set + commit + wifi reload），本工具不自动执行。"
msgstr "改無線爲寫操作（uci set + commit + wifi reload），本工具不自動執行。"

msgid "无线密码(encryption key)仅提示「含密码」，不打印明文。"
msgstr "無線密碼(encryption key)僅提示「含密碼」，不打印明文。"

msgid "DHCP/DNS 只读报告（/etc/config/dhcp，dnsmasq/odhcpd）"
msgstr "DHCP/DNS 只讀報告（/etc/config/dhcp，dnsmasq/odhcpd）"

msgid "解析 /etc/config/dhcp，列出 dnsmasq 实例（端口/上游DNS/域）、各接口 DHCP 地址池(start/limit)与静态租约(host)条目数量。纯只读。"
msgstr "解析 /etc/config/dhcp，列出 dnsmasq 實例（端口/上游DNS/域）、各接口 DHCP 地址池(start/limit)與靜態租約(host)條目數量。純只讀。"

msgid "改 DHCP/DNS 为写操作（uci set + commit + dnsmasq restart），本工具不自动执行。"
msgstr "改 DHCP/DNS 爲寫操作（uci set + commit + dnsmasq restart），本工具不自動執行。"

msgid "静态租约仅统计条目数，不逐条展开敏感字段。"
msgstr "靜態租約僅統計條目數，不逐條展開敏感字段。"

msgid "存储只读报告（/etc/config/fstab + df，不 resize/格式化）"
msgstr "存儲只讀報告（/etc/config/fstab + df，不 resize/格式化）"

msgid "解析 /etc/config/fstab 列出挂载点（fstype/enabled），并用只读 `df -h` 展示容量；识别 overlay（叠加根）是否存在。纯只读，不 resize/格式化。"
msgstr "解析 /etc/config/fstab 列出掛載點（fstype/enabled），並用只讀 `df -h` 展示容量；識別 overlay（疊加根）是否存在。純只讀，不 resize/格式化。"

msgid "resize/格式化/清理 overlay 为写操作，本工具不自动执行。"
msgstr "resize/格式化/清理 overlay 爲寫操作，本工具不自動執行。"

msgid "overlay 为固件叠加层；容量不足时清理/扩容是写操作。"
msgstr "overlay 爲固件疊加層；容量不足時清理/擴容是寫操作。"

msgid "sysupgrade 固件刷写指引（高危·opt-in·只给命令，不执行）"
msgstr "sysupgrade 固件刷寫指引（高危·opt-in·只給命令，不執行）"

msgid "**只读预检**当前板型(board_name/model)与固件(DISTRIB_RELEASE/TARGET)，给出 sysupgrade 备份(backup)与刷写命令的**文本指引**。本工具只读预检、绝不执行 sysupgrade——刷机为高危写操作，须同型号固件 + 先备份。"
msgstr "**只讀預檢**當前板型(board_name/model)與固件(DISTRIB_RELEASE/TARGET)，給出 sysupgrade 備份(backup)與刷寫命令的**文本指引**。本工具只讀預檢、絕不執行 sysupgrade——刷機爲高危寫操作，須同型號固件 + 先備份。"

msgid "sysupgrade 重写固件分区，型号/固件不匹配可致设备变砖；本工具绝不执行刷写。"
msgstr "sysupgrade 重寫固件分區，型號/固件不匹配可致設備變磚；本工具絕不執行刷寫。"

msgid "命令仅作文本展示，需你自行确认后手动执行。"
msgstr "命令僅作文本展示，需你自行確認後手動執行。"

msgid "默认关闭（opt_in）：需 --opt-in 且确认后才出现，避免误触高危刷机指引。"
msgstr "默認關閉（opt_in）：需 --opt-in 且確認後纔出現，避免誤觸高危刷機指引。"

msgid "先 sysupgrade -b 备份配置，再刷写；固件必须与同型号匹配。"
msgstr "先 sysupgrade -b 備份配置，再刷寫；固件必須與同型號匹配。"

msgid "包管理写操作指引（高危·opt-in·install/upgrade/remove 只给命令）"
msgstr "包管理寫操作指引（高危·opt-in·install/upgrade/remove 只給命令）"

msgid "**只读预检**识别包管理器(opkg/apk)，给出 update/install/upgrade/remove 的**命令文本指引**。本工具绝不执行包安装/卸载（写操作）。"
msgstr "**只讀預檢**識別包管理器(opkg/apk)，給出 update/install/upgrade/remove 的**命令文本指引**。本工具絕不執行包安裝/卸載（寫操作）。"

msgid "opkg install / apk add/del 为写操作，本工具绝不执行；命令仅作文本展示。"
msgstr "opkg install / apk add/del 爲寫操作，本工具絕不執行；命令僅作文本展示。"

msgid "23.05 及更早 opkg；24.10 起默认 apk。卸载/升级牵动依赖，务必先只读确认。"
msgstr "23.05 及更早 opkg；24.10 起默認 apk。卸載/升級牽動依賴，務必先只讀確認。"

msgid "UCI 配置写操作指引（高危·opt-in·uci set/commit 只给命令）"
msgstr "UCI 配置寫操作指引（高危·opt-in·uci set/commit 只給命令）"

msgid "**只读预检**列出 /etc/config 配置包，给出 uci show/changes(只读) 与 uci set/commit/revert 的**命令文本指引**，并强调先备份、先看 changes。本工具绝不执行任何 uci set/commit。"
msgstr "**只讀預檢**列出 /etc/config 配置包，給出 uci show/changes(只讀) 與 uci set/commit/revert 的**命令文本指引**，並強調先備份、先看 changes。本工具絕不執行任何 uci set/commit。"

msgid "uci set/commit 为写操作，本工具绝不执行；命令仅作文本展示。"
msgstr "uci set/commit 爲寫操作，本工具絕不執行；命令僅作文本展示。"

msgid "改前 uci export 备份、写前 uci changes 预览、uci revert 可回滚未提交变更。"
msgstr "改前 uci export 備份、寫前 uci changes 預覽、uci revert 可回滾未提交變更。"

msgid "服务启停/重载指引（高危·opt-in·restart/reload 只给命令）"
msgstr "服務啓停/重載指引（高危·opt-in·restart/reload 只給命令）"

msgid "**只读预检**列举 /etc/init.d 可管理服务，给出 status(只读) 与 restart/reload/enable 的**命令文本指引**。本工具绝不执行服务启停（写操作）。"
msgstr "**只讀預檢**列舉 /etc/init.d 可管理服務，給出 status(只讀) 與 restart/reload/enable 的**命令文本指引**。本工具絕不執行服務啓停（寫操作）。"

msgid "/etc/init.d/<svc> restart/reload 为写操作，本工具绝不执行；命令仅作文本展示。"
msgstr "/etc/init.d/<svc> restart/reload 爲寫操作，本工具絕不執行；命令僅作文本展示。"

msgid "重启网络/防火墙类服务会短暂断网；远程操作请确保有回带/带外通道。"
msgstr "重啓網絡/防火牆類服務會短暫斷網；遠程操作請確保有迴帶/帶外通道。"

msgid "无障碍环境报告（ORCA / AT-SPI2）"
msgstr "無障礙環境報告（ORCA / AT-SPI2）"

msgid "只读探测屏幕阅读器（ORCA）、AT-SPI2 辅助技术总线、读屏器自启动开关与语音后端，输出屏幕阅读器友好的纯文本报告。"
msgstr "只讀探測屏幕閱讀器（ORCA）、AT-SPI2 輔助技術總線、讀屏器自啓動開關與語音後端，輸出屏幕閱讀器友好的純文本報告。"

msgid "缺少 orca / dbus / gsettings 时逐项降级提示，不影响其他任务。"
msgstr "缺少 orca / dbus / gsettings 時逐項降級提示，不影響其他任務。"

msgid "协议：AT-SPI2 构建在 D-Bus 之上（辅助技术总线 org.a11y.Bus），ORCA 通过 libatspi / pyatspi2 访问应用程序的无障碍树。"
msgstr "協議：AT-SPI2 構建在 D-Bus 之上（輔助技術總線 org.a11y.Bus），ORCA 通過 libatspi / pyatspi2 訪問應用程序的無障礙樹。"

msgid "报告已去除框线等装饰字符，便于屏幕阅读器连续朗读。"
msgstr "報告已去除框線等裝飾字符，便於屏幕閱讀器連續朗讀。"

msgid "AT-SPI2 辅助技术总线自检"
msgstr "AT-SPI2 輔助技術總線自檢"

msgid "探测 org.a11y.Bus 是否响应（dbus-send / gdbus 调 Registry.GetRegisteredEvents），判断读屏器能否收到应用的无障碍事件。"
msgstr "探測 org.a11y.Bus 是否響應（dbus-send / gdbus 調 Registry.GetRegisteredEvents），判斷讀屏器能否收到應用的無障礙事件。"

msgid "纯 SSH / 无图形会话环境一般不可用，属正常现象。"
msgstr "純 SSH / 無圖形會話環境一般不可用，屬正常現象。"

msgid "接口：org.a11y.atspi.Registry（对象路径 /org/a11y/atspi/registry）。"
msgstr "接口：org.a11y.atspi.Registry（對象路徑 /org/a11y/atspi/registry）。"

msgid "未响应通常是 at-spi-bus-launcher 未启动或处于非图形会话（SSH/TTY）。"
msgstr "未響應通常是 at-spi-bus-launcher 未啓動或處於非圖形會話（SSH/TTY）。"

msgid "ORCA 屏幕阅读器状态"
msgstr "ORCA 屏幕閱讀器狀態"

msgid "读取 ORCA 版本与「是否随会话自动启动」开关（gsettings screen-reader-enabled）。"
msgstr "讀取 ORCA 版本與「是否隨會話自動啓動」開關（gsettings screen-reader-enabled）。"

msgid "开关：org.gnome.desktop.a11y.applications screen-reader-enabled。"
msgstr "開關：org.gnome.desktop.a11y.applications screen-reader-enabled。"

msgid "未安装 ORCA 时提示可用包管理器安装（gnome-orca / orca）。"
msgstr "未安裝 ORCA 時提示可用包管理器安裝（gnome-orca / orca）。"

msgid "启用屏幕阅读器自启动（ORCA）"
msgstr "啓用屏幕閱讀器自啓動（ORCA）"

msgid "把 GNOME 的 screen-reader-enabled 置为 true，使 ORCA 随会话自动启动。"
msgstr "把 GNOME 的 screen-reader-enabled 置爲 true，使 ORCA 隨會話自動啓動。"

msgid "仅在 GNOME/兼容桌面生效；KDE 等桌面请用其自带无障碍设置。"
msgstr "僅在 GNOME/兼容桌面生效；KDE 等桌面請用其自帶無障礙設置。"

msgid "回退：gsettings set org.gnome.desktop.a11y.applications screen-reader-enabled false"
msgstr "回退：gsettings set org.gnome.desktop.a11y.applications screen-reader-enabled false"

msgid "启动/重启 ORCA：orca --replace；设置：orca --setup。"
msgstr "啓動/重啓 ORCA：orca --replace；設置：orca --setup。"

msgid "配置目录：~/.local/share/orca（首次运行后生成）。"
msgstr "配置目錄：~/.local/share/orca（首次運行後生成）。"

msgid "启用 AT-SPI 辅助技术接口（toolkit-accessibility）"
msgstr "啓用 AT-SPI 輔助技術接口（toolkit-accessibility）"

msgid "开启 GNOME 的 toolkit-accessibility，让 GTK/Qt 应用向 AT-SPI2 总线暴露无障碍树。"
msgstr "開啓 GNOME 的 toolkit-accessibility，讓 GTK/Qt 應用向 AT-SPI2 總線暴露無障礙樹。"

msgid "开启后应用会额外暴露无障碍接口，资源占用略有增加（通常可忽略）。"
msgstr "開啓後應用會額外暴露無障礙接口，資源佔用略有增加（通常可忽略）。"

msgid "该开关是 AT-SPI2 生效的前提之一：应用需向 org.a11y.Bus 注册无障碍对象。"
msgstr "該開關是 AT-SPI2 生效的前提之一：應用需向 org.a11y.Bus 註冊無障礙對象。"

msgid "回退：gsettings set org.gnome.desktop.interface toolkit-accessibility false"
msgstr "回退：gsettings set org.gnome.desktop.interface toolkit-accessibility false"

msgid "Windows 讲述人（Narrator）入口"
msgstr "Windows 講述人（Narrator）入口"

msgid "给出 Windows 讲述人的开关与快捷键指引（对应 Linux ORCA 的读屏能力）。"
msgstr "給出 Windows 講述人的開關與快捷鍵指引（對應 Linux ORCA 的讀屏能力）。"

msgid "Windows 的无障碍接口为 UI Automation（UIA）与 MSAA，与 Linux AT-SPI2 属同类机制。"
msgstr "Windows 的無障礙接口爲 UI Automation（UIA）與 MSAA，與 Linux AT-SPI2 屬同類機制。"

msgid "标准参考：GB/T 37668（国标）/ WCAG 2.2（国际）/ Section 508（地区）。"
msgstr "標準參考：GB/T 37668（國標）/ WCAG 2.2（國際）/ Section 508（地區）。"

msgid "macOS VoiceOver 入口"
msgstr "macOS VoiceOver 入口"

msgid "给出 macOS VoiceOver 的开关与快捷键指引（对应 Linux ORCA 的读屏能力）。"
msgstr "給出 macOS VoiceOver 的開關與快捷鍵指引（對應 Linux ORCA 的讀屏能力）。"

msgid "macOS 的无障碍接口为 NSAccessibility（AX API），与 Linux AT-SPI2 属同类机制。"
msgstr "macOS 的無障礙接口爲 NSAccessibility（AX API），與 Linux AT-SPI2 屬同類機制。"

msgid "多系统无障碍适配报告（Windows/macOS/Linux/Android/iOS/鸿蒙）"
msgstr "多系統無障礙適配報告（Windows/macOS/Linux/Android/iOS/鴻蒙）"

msgid "按各系统各自的协议与接口只读探测屏幕阅读器状态：Windows 讲述人（UI Automation/MSAA）、macOS VoiceOver（NSAccessibility AX）、Linux ORCA（AT-SPI2/D-Bus）、Android TalkBack（AccessibilityService/adb settings secure）、iOS VoiceOver（设备端）、鸿蒙屏幕朗读（AccessibilityExtensionAbility/hdc）。"
msgstr "按各系統各自的協議與接口只讀探測屏幕閱讀器狀態：Windows 講述人（UI Automation/MSAA）、macOS VoiceOver（NSAccessibility AX）、Linux ORCA（AT-SPI2/D-Bus）、Android TalkBack（AccessibilityService/adb settings secure）、iOS VoiceOver（設備端）、鴻蒙屏幕朗讀（AccessibilityExtensionAbility/hdc）。"

msgid "iOS 与鸿蒙不允许主机直接开启读屏器，本任务只给设备端指引。"
msgstr "iOS 與鴻蒙不允許主機直接開啓讀屏器，本任務只給設備端指引。"

msgid "适配原则：每个系统用**它自己**的原生无障碍接口，不做跨系统猜测；非当前平台一律降级为「请在目标系统操作」的指引，不报错。"
msgstr "適配原則：每個系統用**它自己**的原生無障礙接口，不做跨系統猜測；非當前平臺一律降級爲「請在目標系統操作」的指引，不報錯。"

msgid "Windows: HKCU\\Software\\Microsoft\\Narrator + Win+Ctrl+Enter；macOS: com.apple.universalaccess 域 + Cmd+F5；Linux: org.a11y.Bus + gsettings screen-reader-enabled；Android: adb shell settings get secure accessibility_enabled；iOS/鸿蒙: 只能在设备端设置中开启。"
msgstr "Windows: HKCU\\Software\\Microsoft\\Narrator + Win+Ctrl+Enter；macOS: com.apple.universalaccess 域 + Cmd+F5；Linux: org.a11y.Bus + gsettings screen-reader-enabled；Android: adb shell settings get secure accessibility_enabled；iOS/鴻蒙: 只能在設備端設置中開啓。"

msgid "多系统无障碍权威文档（协议与接口出处）"
msgstr "多系統無障礙權威文檔（協議與接口出處）"

msgid "列出各系统无障碍的权威文档与对应协议/接口：AT-SPI2、UI Automation、NSAccessibility、AccessibilityService、AccessibilityExtensionAbility，并给出 WCAG 2.2 / ISO 9241-171 / GB/T 37668 等标准出处。"
msgstr "列出各系統無障礙的權威文檔與對應協議/接口：AT-SPI2、UI Automation、NSAccessibility、AccessibilityService、AccessibilityExtensionAbility，並給出 WCAG 2.2 / ISO 9241-171 / GB/T 37668 等標準出處。"

msgid "文档来源：GNOME docs、Microsoft Learn、Apple Developer、Android Developers、华为开发者文档、W3C、ISO、SAC。"
msgstr "文檔來源：GNOME docs、Microsoft Learn、Apple Developer、Android Developers、華爲開發者文檔、W3C、ISO、SAC。"

msgid "启用 Windows 讲述人（UI Automation 通道）"
msgstr "啓用 Windows 講述人（UI Automation 通道）"

msgid "给出 Windows 讲述人的启用命令与设置入口（对应 Linux ORCA 自启动开关）。"
msgstr "給出 Windows 講述人的啓用命令與設置入口（對應 Linux ORCA 自啓動開關）。"

msgid "Windows 上改注册表有风险，本任务只给 GUI 与命令行入口，不写注册表。"
msgstr "Windows 上改註冊表有風險，本任務只給 GUI 與命令行入口，不寫註冊表。"

msgid "接口：UI Automation（UIA）/ MSAA；应用需实现 IUIAutomation 提供者的属性与控件模式。"
msgstr "接口：UI Automation（UIA）/ MSAA；應用需實現 IUIAutomation 提供者的屬性與控件模式。"

msgid "注册表仅作**只读**探测（HKCU\\Software\\Microsoft\\Narrator），不主动改写。"
msgstr "註冊表僅作**只讀**探測（HKCU\\Software\\Microsoft\\Narrator），不主動改寫。"

msgid "启用 macOS VoiceOver（NSAccessibility 通道）"
msgstr "啓用 macOS VoiceOver（NSAccessibility 通道）"

msgid "给出 macOS VoiceOver 的启用快捷键与设置入口（对应 Linux ORCA 自启动开关）。"
msgstr "給出 macOS VoiceOver 的啓用快捷鍵與設置入口（對應 Linux ORCA 自啓動開關）。"

msgid "不写 defaults（避免破坏用户偏好），启用请在系统设置中操作。"
msgstr "不寫 defaults（避免破壞用戶偏好），啓用請在系統設置中操作。"

msgid "接口：NSAccessibility（AX API），AXUIElement 暴露 AXRole/AXTitle/AXValue 等属性。"
msgstr "接口：NSAccessibility（AX API），AXUIElement 暴露 AXRole/AXTitle/AXValue 等屬性。"

msgid "Android TalkBack 状态与启用指引（adb 只读）"
msgstr "Android TalkBack 狀態與啓用指引（adb 只讀）"

msgid "只读查询 Android 无障碍服务开关状态，并给出 TalkBack 启用指引。"
msgstr "只讀查詢 Android 無障礙服務開關狀態，並給出 TalkBack 啓用指引。"

msgid "需要设备已授权 USB 调试；未连接设备时降级为指引。"
msgstr "需要設備已授權 USB 調試；未連接設備時降級爲指引。"

msgid "只读：adb shell settings get secure accessibility_enabled / enabled_accessibility_services。"
msgstr "只讀：adb shell settings get secure accessibility_enabled / enabled_accessibility_services。"

msgid "启用：设置 → 无障碍 → TalkBack；用 adb settings put secure 属变更，默认不做。"
msgstr "啓用：設置 → 無障礙 → TalkBack；用 adb settings put secure 屬變更，默認不做。"

msgid "鸿蒙屏幕朗读（AccessibilityExtensionAbility）指引"
msgstr "鴻蒙屏幕朗讀（AccessibilityExtensionAbility）指引"

msgid "给出鸿蒙系统「屏幕朗读」的启用入口与无障碍扩展能力说明。"
msgstr "給出鴻蒙系統「屏幕朗讀」的啓用入口與無障礙擴展能力說明。"

msgid "同 iOS，主机不允许直接开启读屏器，只给指引。"
msgstr "同 iOS，主機不允許直接開啓讀屏器，只給指引。"

msgid "接口：HarmonyOS Accessibility（AccessibilityExtensionAbility）；主机侧可用 hdc shell 做只读查询。"
msgstr "接口：HarmonyOS Accessibility（AccessibilityExtensionAbility）；主機側可用 hdc shell 做只讀查詢。"

msgid "无障碍标准对照（国标/国际/地区）"
msgstr "無障礙標準對照（國標/國際/地區）"

msgid "列出无障碍分类的三层标准出处，并按受众（国内/对外/按地区）给出引用优先级。"
msgstr "列出無障礙分類的三層標準出處，並按受衆（國內/對外/按地區）給出引用優先級。"

msgid "引用策略：国内优先国家平台/国家标准；给外国人用改用国际标准；个别场景按所在国家/地区标准执行。"
msgstr "引用策略：國內優先國家平臺/國家標準；給外國人用改用國際標準；個別場景按所在國家/地區標準執行。"

msgid "查找家目录大文件（Python）"
msgstr "查找家目錄大文件（Python）"

msgid "用 Python 标准库列出 $HOME 下体积最大的 20 个文件，辅助定位可清理项。"
msgstr "用 Python 標準庫列出 $HOME 下體積最大的 20 個文件，輔助定位可清理項。"

msgid "只读分析，不删除任何文件；据此手动判断是否可清理。"
msgstr "只讀分析，不刪除任何文件；據此手動判斷是否可清理。"

msgid "查找重复文件（Ruby）"
msgstr "查找重複文件（Ruby）"

msgid "用 Ruby 标准库按大小初筛潜在重复文件，辅助清理冗余副本。"
msgstr "用 Ruby 標準庫按大小初篩潛在重複文件，輔助清理冗餘副本。"

msgid "仅按大小初筛，不哈希比对；真正删除前请人工确认。"
msgstr "僅按大小初篩，不哈希比對；真正刪除前請人工確認。"

msgid "清理 Go 模块缓存"
msgstr "清理 Go 模塊緩存"

msgid "用 go 自带的 `go clean -modcache` 清理已下载的模块缓存。"
msgstr "用 go 自帶的 `go clean -modcache` 清理已下載的模塊緩存。"

msgid "可重下载；不影响源码与构建产物。"
msgstr "可重下載；不影響源碼與構建產物。"

msgid "清理 Go 构建缓存（GOCACHE）"
msgstr "清理 Go 構建緩存（GOCACHE）"

msgid "用 `go clean -cache` 清理构建缓存（GOCACHE），释放编译中间产物占用的空间。"
msgstr "用 `go clean -cache` 清理構建緩存（GOCACHE），釋放編譯中間產物佔用的空間。"

msgid "CI/离线环境清理后若无法重新编译需留意；本地一般无影响。"
msgstr "CI/離線環境清理後若無法重新編譯需留意；本地一般無影響。"

msgid "构建缓存可重建：清理后首次编译会重新生成，耗时略增。"
msgstr "構建緩存可重建：清理後首次編譯會重新生成，耗時略增。"

msgid "不影响模块缓存（GOMODCACHE）与源码；两者独立，可分别清理。"
msgstr "不影響模塊緩存（GOMODCACHE）與源碼；兩者獨立，可分別清理。"

msgid "Go 工程预构建校验（go build）"
msgstr "Go 工程預構建校驗（go build）"

msgid "在当前 Go 工程执行 `go build ./...`，预编译并校验可构建性，同时把构建结果写入缓存以加速后续编译。"
msgstr "在當前 Go 工程執行 `go build ./...`，預編譯並校驗可構建性，同時把構建結果寫入緩存以加速後續編譯。"

msgid "构建失败通常是代码/依赖问题，属正常反馈，不会修改源码。"
msgstr "構建失敗通常是代碼/依賴問題，屬正常反饋，不會修改源碼。"

msgid "有 go.mod 时才执行；无则跳过，不报错。"
msgstr "有 go.mod 時才執行；無則跳過，不報錯。"

msgid "构建产物写入 GOCACHE，可让后续 `go build` / `go test` 显著加快。"
msgstr "構建產物寫入 GOCACHE，可讓後續 `go build` / `go test` 顯著加快。"

msgid "交叉编译可加 GOOS/GOARCH（如 GOOS=windows GOARCH=amd64 go build ./...）。"
msgstr "交叉編譯可加 GOOS/GOARCH（如 GOOS=windows GOARCH=amd64 go build ./...）。"

msgid "整理 Go 依赖（go mod tidy）"
msgstr "整理 Go 依賴（go mod tidy）"

msgid "执行 `go mod tidy` 移除未使用依赖、补齐缺失依赖，保持 go.mod / go.sum 干净。"
msgstr "執行 `go mod tidy` 移除未使用依賴、補齊缺失依賴，保持 go.mod / go.sum 乾淨。"

msgid "需联网解析模块；离线环境会失败。执行前请确认依赖变更可回退。"
msgstr "需聯網解析模塊；離線環境會失敗。執行前請確認依賴變更可回退。"

msgid "会重写 go.mod 与 go.sum，属「结构性」改动，故风险定为 medium。"
msgstr "會重寫 go.mod 與 go.sum，屬「結構性」改動，故風險定爲 medium。"

msgid "建议先提交/备份 go.mod、go.sum，再执行以便对比回退。"
msgstr "建議先提交/備份 go.mod、go.sum，再執行以便對比回退。"

msgid "校验/清理 Node 缓存"
msgstr "校驗/清理 Node 緩存"

msgid "用 npm 的 `npm cache verify` 整理 Node 依赖缓存（需 npm）。"
msgstr "用 npm 的 `npm cache verify` 整理 Node 依賴緩存（需 npm）。"

msgid "仅整理校验缓存，不删依赖；无 npm 时自动跳过。"
msgstr "僅整理校驗緩存，不刪依賴；無 npm 時自動跳過。"

msgid "汇总大日志文件（Perl）"
msgstr "彙總大日誌文件（Perl）"

msgid "用 Perl 扫描 /var/log 与家目录日志，列出体积偏大的日志。"
msgstr "用 Perl 掃描 /var/log 與家目錄日誌，列出體積偏大的日誌。"

msgid "只读列出；压缩/轮转日志请结合系统 logrotate。"
msgstr "只讀列出；壓縮/輪轉日誌請結合系統 logrotate。"

msgid "环境报告（Lua）"
msgstr "環境報告（Lua）"

msgid "用 Lua 输出基础环境信息，演示「有 Lua 才启用」的自动显隐。"
msgstr "用 Lua 輸出基礎環境信息，演示「有 Lua 才啓用」的自動顯隱。"

msgid "仅展示信息，无副作用。"
msgstr "僅展示信息，無副作用。"

msgid "清理 Rust 构建缓存（cargo）"
msgstr "清理 Rust 構建緩存（cargo）"

msgid "用 cargo 自带的 `cargo clean` 清理当前工程 target，必要时清理全局 registry 缓存。"
msgstr "用 cargo 自帶的 `cargo clean` 清理當前工程 target，必要時清理全局 registry 緩存。"

msgid "清理 registry 缓存后下次构建需重新下载依赖，首次略慢。"
msgstr "清理 registry 緩存後下次構建需重新下載依賴，首次略慢。"

msgid "可重编译；不影响源码与 Cargo.lock。"
msgstr "可重編譯；不影響源碼與 Cargo.lock。"

msgid "全局缓存 ~/.cargo/registry、~/.cargo/git 体积较大，可用 `cargo clean`（配合 `--target-dir` 或手动清 registry）释放，但会触发重新下载。"
msgstr "全局緩存 ~/.cargo/registry、~/.cargo/git 體積較大，可用 `cargo clean`（配合 `--target-dir` 或手動清 registry）釋放，但會觸發重新下載。"

msgid "清理 Java 构建缓存（Gradle/Maven）"
msgstr "清理 Java 構建緩存（Gradle/Maven）"

msgid "清理 Gradle 与 Maven 的本地依赖/构建缓存（可从仓库重新拉取，不删源码）。"
msgstr "清理 Gradle 與 Maven 的本地依賴/構建緩存（可從倉庫重新拉取，不刪源碼）。"

msgid "清理后首次构建需联网重新下载依赖，耗时增加。"
msgstr "清理後首次構建需聯網重新下載依賴，耗時增加。"

msgid "Gradle/Maven 缓存均为可重建的下载产物，清理后下次构建会自动重新解析与下载。"
msgstr "Gradle/Maven 緩存均爲可重建的下載產物，清理後下次構建會自動重新解析與下載。"

msgid "不影响项目源码与构建脚本。"
msgstr "不影響項目源碼與構建腳本。"

msgid "清理 .NET NuGet 缓存"
msgstr "清理 .NET NuGet 緩存"

msgid "用 dotnet CLI 清理 NuGet 全局缓存（http-cache / global-packages / temp）。"
msgstr "用 dotnet CLI 清理 NuGet 全局緩存（http-cache / global-packages / temp）。"

msgid "清理后首次还原需重新下载包，耗时增加。"
msgstr "清理後首次還原需重新下載包，耗時增加。"

msgid "NuGet 缓存可重新还原；不影响项目源码与 .csproj 引用。"
msgstr "NuGet 緩存可重新還原；不影響項目源碼與 .csproj 引用。"

msgid "清理 PHP Composer 缓存"
msgstr "清理 PHP Composer 緩存"

msgid "清理 Composer 的包缓存目录（可重新下载，不影响 vendor 与源码）。"
msgstr "清理 Composer 的包緩存目錄（可重新下載，不影響 vendor 與源碼）。"

msgid "清理后首次安装需重新下载依赖，耗时增加。"
msgstr "清理後首次安裝需重新下載依賴，耗時增加。"

msgid "Composer 缓存可重建；不影响项目 vendor 与 composer.lock。"
msgstr "Composer 緩存可重建；不影響項目 vendor 與 composer.lock。"

msgid "清理 RubyGems 旧版本包"
msgstr "清理 RubyGems 舊版本包"

msgid "用 `gem cleanup` 移除已安装 gem 的旧版本，只保留最新版。"
msgstr "用 `gem cleanup` 移除已安裝 gem 的舊版本，只保留最新版。"

msgid "个别项目锁定旧版本时需重新 `bundle install`。"
msgstr "個別項目鎖定舊版本時需重新 `bundle install`。"

msgid "只清理同一 gem 的历史版本，不影响当前依赖可解析性。"
msgstr "只清理同一 gem 的歷史版本，不影響當前依賴可解析性。"

msgid "磁盘 S.M.A.R.T. 健康自检"
msgstr "磁盤 S.M.A.R.T. 健康自檢"

msgid "按 T13/ATA8-ACS 标准读取磁盘 SMART 健康，预警坏道/重映射扇区。"
msgstr "按 T13/ATA8-ACS 標準讀取磁盤 SMART 健康，預警壞道/重映射扇區。"

msgid "未安装 smartmontools 时无此能力；安装后即可启用，本工具不强求。"
msgstr "未安裝 smartmontools 時無此能力；安裝後即可啓用，本工具不強求。"

msgid "参考标准：INCITS T13 ATA8-ACS；重映射扇区/待映射扇区升高即应备份换盘。"
msgstr "參考標準：INCITS T13 ATA8-ACS；重映射扇區/待映射扇區升高即應備份換盤。"

msgid "ACPI 电源状态优化"
msgstr "ACPI 電源狀態優化"

msgid "按 UEFI Forum ACPI 规范核对可用睡眠态，给出节能建议。"
msgstr "按 UEFI Forum ACPI 規範覈對可用睡眠態，給出節能建議。"

msgid "修改 CPU/设备电源态可能影响唤醒延迟，服务器/虚拟机谨慎。"
msgstr "修改 CPU/設備電源態可能影響喚醒延遲，服務器/虛擬機謹慎。"

msgid "参考标准：ACPI Specification（UEFI Forum）；笔记本用 S3/S4 节能，服务器慎用深度睡眠。"
msgstr "參考標準：ACPI Specification（UEFI Forum）；筆記本用 S3/S4 節能，服務器慎用深度睡眠。"

msgid "SSD TRIM 维护"
msgstr "SSD TRIM 維護"

msgid "按 ATA TRIM（DATA SET MANAGEMENT）定期释放无效块，维持 SSD 性能。"
msgstr "按 ATA TRIM（DATA SET MANAGEMENT）定期釋放無效塊，維持 SSD 性能。"

msgid "未安装 util-linux（fstrim）时无此能力。"
msgstr "未安裝 util-linux（fstrim）時無此能力。"

msgid "参考标准：INCITS T13 ATA/ATAPI Command Set；已启用连续 TRIM 的文件系统可不定时跑。"
msgstr "參考標準：INCITS T13 ATA/ATAPI Command Set；已啓用連續 TRIM 的文件系統可不定時跑。"

msgid "PCI/USB 设备清单（按标准类代码）"
msgstr "PCI/USB 設備清單（按標準類代碼）"

msgid "按 PCI-SIG / USB-IF 类代码列出设备，辅助排查驱动缺失。"
msgstr "按 PCI-SIG / USB-IF 類代碼列出設備，輔助排查驅動缺失。"

msgid "未装 lspci/lsusb 时仅给指引。"
msgstr "未裝 lspci/lsusb 時僅給指引。"

msgid "参考标准：PCI-SIG PCIe Base Spec / USB-IF Device Class Definitions。"
msgstr "參考標準：PCI-SIG PCIe Base Spec / USB-IF Device Class Definitions。"

msgid "CPU 信息报告"
msgstr "CPU 信息報告"

msgid "读取 CPU 型号/核心数（跨平台：sysctl / /proc/cpuinfo），供调优前确认硬件。"
msgstr "讀取 CPU 型號/核心數（跨平臺：sysctl / /proc/cpuinfo），供調優前確認硬件。"

msgid "CPU 频率调节参考 P-state/C-state（ACPI）；修改前确认硬件与散热。"
msgstr "CPU 頻率調節參考 P-state/C-state（ACPI）；修改前確認硬件與散熱。"

msgid "CPU 频率调节策略核对（CPUFreq）"
msgstr "CPU 頻率調節策略覈對（CPUFreq）"

msgid "按内核文档 admin-guide/pm/cpufreq.rst 核对当前调频 governor（schedutil/powersave/performance/ondemand），给出功耗/性能取舍建议。"
msgstr "按內核文檔 admin-guide/pm/cpufreq.rst 覈對當前調頻 governor（schedutil/powersave/performance/ondemand），給出功耗/性能取捨建議。"

msgid "改 governor 影响功耗与响应；笔记本用 schedutil/powersave 节能，高负载服务器用 performance。"
msgstr "改 governor 影響功耗與響應；筆記本用 schedutil/powersave 節能，高負載服務器用 performance。"

msgid "参考内核文档 cpufreq.rst：schedutil/powersave 偏节能，performance 偏性能，ondemand/conservative 为经典采样策略。"
msgstr "參考內核文檔 cpufreq.rst：schedutil/powersave 偏節能，performance 偏性能，ondemand/conservative 爲經典採樣策略。"

msgid "改 governor：echo schedutil > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor（需 root，且不同发行版持久化方式不同）。"
msgstr "改 governor：echo schedutil > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor（需 root，且不同發行版持久化方式不同）。"

msgid "CPU 空闲状态核对（cpuidle）"
msgstr "CPU 空閒狀態覈對（cpuidle）"

msgid "按内核文档 admin-guide/pm/cpuidle.rst 核对可用 C-state，给出节能/唤醒延迟权衡建议。"
msgstr "按內核文檔 admin-guide/pm/cpuidle.rst 覈對可用 C-state，給出節能/喚醒延遲權衡建議。"

msgid "服务器/低延迟负载可限制最深 C-state，但会牺牲节能。"
msgstr "服務器/低延遲負載可限制最深 C-state，但會犧牲節能。"

msgid "参考内核文档 cpuidle.rst：越深 C-state 越省电，但唤醒延迟越大。限制最深 C-state 需内核/固件支持。"
msgstr "參考內核文檔 cpuidle.rst：越深 C-state 越省電，但喚醒延遲越大。限制最深 C-state 需內核/固件支持。"

msgid "Intel P-State 调速器核对"
msgstr "Intel P-State 調速器覈對"

msgid "按内核文档 admin-guide/pm/intel_pstate.rst 核对 intel_pstate 状态（active/passive），建议配合 schedutil。"
msgstr "按內核文檔 admin-guide/pm/intel_pstate.rst 覈對 intel_pstate 狀態（active/passive），建議配合 schedutil。"

msgid "仅 Intel 平台有此接口；AMD 请改用 amd_pstate（amd-pstate.rst）。"
msgstr "僅 Intel 平臺有此接口；AMD 請改用 amd_pstate（amd-pstate.rst）。"

msgid "现代 Intel CPU 建议保留 intel_pstate（active），配合 schedutil 最稳；可经 max_perf_pct/min_perf_pct 限制性能窗口。"
msgstr "現代 Intel CPU 建議保留 intel_pstate（active），配合 schedutil 最穩；可經 max_perf_pct/min_perf_pct 限制性能窗口。"

msgid "温控与降频核对（thermal sysfs）"
msgstr "溫控與降頻覈對（thermal sysfs）"

msgid "按内核文档 admin-guide/thermal/sysfs-api.rst 读取热区温度与策略，预警过热降频。"
msgstr "按內核文檔 admin-guide/thermal/sysfs-api.rst 讀取熱區溫度與策略，預警過熱降頻。"

msgid "温度阈值由固件/内核定义，软件层面无法长期压制过热，属硬件维护范畴。"
msgstr "溫度閾值由固件/內核定義，軟件層面無法長期壓制過熱，屬硬件維護範疇。"

msgid "过热降频会拖慢系统；软件仅能核对热区与阈值，硬件层面需清灰/换硅脂/改善风道。"
msgstr "過熱降頻會拖慢系統；軟件僅能覈對熱區與閾值，硬件層面需清灰/換硅脂/改善風道。"

msgid "透明大页（THP）策略核对"
msgstr "透明大頁（THP）策略覈對"

msgid "按内核文档 admin-guide/mm/transhuge.rst 核对 transparent_hugepage 状态（always/madvise/never），给出内存/延迟权衡。"
msgstr "按內核文檔 admin-guide/mm/transhuge.rst 覈對 transparent_hugepage 狀態（always/madvise/never），給出內存/延遲權衡。"

msgid "改 THP 状态需 root；never 可消除抖动但增加 TLB 压力。"
msgstr "改 THP 狀態需 root；never 可消除抖動但增加 TLB 壓力。"

msgid "THP 对大内存/数据库有收益，但对延迟敏感负载可能引入 compaction 抖动；用 madvise 更稳妥。"
msgstr "THP 對大內存/數據庫有收益，但對延遲敏感負載可能引入 compaction 抖動；用 madvise 更穩妥。"

msgid "zswap 压缩交换缓存核对"
msgstr "zswap 壓縮交換緩存覈對"

msgid "按内核文档 mm/zswap.rst 核对 zswap 是否启用，给出换页压力下的内存扩展建议。"
msgstr "按內核文檔 mm/zswap.rst 覈對 zswap 是否啓用，給出換頁壓力下的內存擴展建議。"

msgid "低端机或已大量 swap 时收益明显，但会增加一点 CPU 占用；可调 max_pool_percent 控制内存占用。"
msgstr "低端機或已大量 swap 時收益明顯，但會增加一點 CPU 佔用；可調 max_pool_percent 控制內存佔用。"

msgid "zswap 以 CPU 换内存：换页前先压缩存入内存池，超限或失败再落入后端 swap。"
msgstr "zswap 以 CPU 換內存：換頁前先壓縮存入內存池，超限或失敗再落入後端 swap。"

msgid "zram 内存压缩块设备核对"
msgstr "zram 內存壓縮塊設備覈對"

msgid "按内核文档 admin-guide/blockdev/zram.rst 核对 zram 设备，建议以压缩内存块替代磁盘 swap。"
msgstr "按內核文檔 admin-guide/blockdev/zram.rst 覈對 zram 設備，建議以壓縮內存塊替代磁盤 swap。"

msgid "配置 zram 需 root；disksize 过大可能挤占可用内存。"
msgstr "配置 zram 需 root；disksize 過大可能擠佔可用內存。"

msgid "把 /dev/zram<N> 用作 swap 比磁盘 swap 快得多；注意设置合理 disksize 并监控压缩率。"
msgstr "把 /dev/zram<N> 用作 swap 比磁盤 swap 快得多；注意設置合理 disksize 並監控壓縮率。"

msgid "I/O 调度器核对（BFQ/mq-deadline）"
msgstr "I/O 調度器覈對（BFQ/mq-deadline）"

msgid "按内核文档 block/ 核对根盘队列调度器，SSD 建议 none/mq-deadline，机械盘建议 bfq。"
msgstr "按內核文檔 block/ 覈對根盤隊列調度器，SSD 建議 none/mq-deadline，機械盤建議 bfq。"

msgid "改调度器需重挂或写入 /sys；部分发行版默认已合理，谨慎改动。"
msgstr "改調度器需重掛或寫入 /sys；部分發行版默認已合理，謹慎改動。"

msgid "SSD/NVMe 用 none 或 mq-deadline；机械盘用 bfq 更顺滑；数据库盘改调度器前先评估延迟。"
msgstr "SSD/NVMe 用 none 或 mq-deadline；機械盤用 bfq 更順滑；數據庫盤改調度器前先評估延遲。"

msgid "NVMe 固态盘核对（队列/TRIM）"
msgstr "NVMe 固態盤覈對（隊列/TRIM）"

msgid "按内核文档 nvme/index.rst 核对 NVMe 设备与多队列，结合 TRIM 维持性能。"
msgstr "按內核文檔 nvme/index.rst 覈對 NVMe 設備與多隊列，結合 TRIM 維持性能。"

msgid "fstrim 需 util-linux；未装时仅 report。"
msgstr "fstrim 需 util-linux；未裝時僅 report。"

msgid "NVMe 多队列默认可用，无需手工调 nr_requests；定期 fstrim 维持性能与寿命。"
msgstr "NVMe 多隊列默認可用，無需手工調 nr_requests；定期 fstrim 維持性能與壽命。"

msgid "x86 能效偏好（EPB）核对"
msgstr "x86 能效偏好（EPB）覈對"

msgid "按内核 intel_pstate 文档核对 energy_perf_bias，给出性能/能效偏好建议（x86 专属）。"
msgstr "按內核 intel_pstate 文檔覈對 energy_perf_bias，給出性能/能效偏好建議（x86 專屬）。"

msgid "改 EPB 需特权；仅 x86 Intel/AMD 支持，ARM/龙芯等无此接口（自动隐藏）。"
msgstr "改 EPB 需特權；僅 x86 Intel/AMD 支持，ARM/龍芯等無此接口（自動隱藏）。"

msgid "energy_perf_bias 0=性能优先、15=能效优先、6=平衡；可经 x86_energy_perf_policy 或 sysfs 设置。"
msgstr "energy_perf_bias 0=性能優先、15=能效優先、6=平衡；可經 x86_energy_perf_policy 或 sysfs 設置。"

msgid "NUMA 自动平衡核对"
msgstr "NUMA 自動平衡覈對"

msgid "按内核文档 admin-guide/mm/numa_memory_policy.rst 核对 numa_balancing，给出多路内存延迟优化建议。"
msgstr "按內核文檔 admin-guide/mm/numa_memory_policy.rst 覈對 numa_balancing，給出多路內存延遲優化建議。"

msgid "多路服务器开启收益明显；单路/桌面误开反而有跨节点开销。"
msgstr "多路服務器開啓收益明顯；單路/桌面誤開反而有跨節點開銷。"

msgid "NUMA 平衡对单路/桌面收益有限，多路服务器才明显；误开可能引入跨节点开销。"
msgstr "NUMA 平衡對單路/桌面收益有限，多路服務器才明顯；誤開可能引入跨節點開銷。"

msgid "硬件看门狗心跳核对"
msgstr "硬件看門狗心跳覈對"

msgid "按内核文档 watchdog/watchdog-api.rst 核对看门狗设备，确认守护进程保活，避免假死无重启。"
msgstr "按內核文檔 watchdog/watchdog-api.rst 覈對看門狗設備，確認守護進程保活，避免假死無重啓。"

msgid "误关守护进程会导致周期性硬重启。"
msgstr "誤關守護進程會導致週期性硬重啓。"

msgid "关键服务器应启用看门狗并配守护进程（如 watchdog/systemd）定期喂狗；超时则硬重启。"
msgstr "關鍵服務器應啓用看門狗並配守護進程（如 watchdog/systemd）定期餵狗；超時則硬重啓。"

msgid "交换倾向 vm.swappiness 核对"
msgstr "交換傾向 vm.swappiness 覈對"

msgid "按内核文档 admin-guide/sysctl/vm.rst 核对 swappiness，给出内存压力下换页激进度建议。"
msgstr "按內核文檔 admin-guide/sysctl/vm.rst 覈對 swappiness，給出內存壓力下換頁激進度建議。"

msgid "内存极端紧张时过低 swappiness 易触发 OOM。"
msgstr "內存極端緊張時過低 swappiness 易觸發 OOM。"

msgid "0=尽量不换页、100=激进换页；桌面/服务器可适当降低以减少换页抖动。"
msgstr "0=儘量不換頁、100=激進換頁；桌面/服務器可適當降低以減少換頁抖動。"

msgid "能耗感知调度（EAS）核对"
msgstr "能耗感知調度（EAS）覈對"

msgid "按内核文档 scheduler/sched-energy.rst 核对 sched_energy_aware，给出移动/笔记本节能调度建议。"
msgstr "按內核文檔 scheduler/sched-energy.rst 覈對 sched_energy_aware，給出移動/筆記本節能調度建議。"

msgid "仅异构/能效敏感平台意义大；同构桌面影响不大。"
msgstr "僅異構/能效敏感平臺意義大；同構桌面影響不大。"

msgid "异构大小核（big.LITTLE / 混合架构）开启 EAS 收益最大；需 Energy Model 与 schedutil 配合。"
msgstr "異構大小核（big.LITTLE / 混合架構）開啓 EAS 收益最大；需 Energy Model 與 schedutil 配合。"

msgid "启用 IPv6 隐私扩展（临时地址）"
msgstr "啓用 IPv6 隱私擴展（臨時地址）"

msgid "为出站连接使用临时、轮换的 IPv6 地址，降低跨站点追踪（RFC 4941）。"
msgstr "爲出站連接使用臨時、輪換的 IPv6 地址，降低跨站點追蹤（RFC 4941）。"

msgid "某些严格按 IP 做审计/白名单的服务可能受影响；需确认后再开。"
msgstr "某些嚴格按 IP 做審計/白名單的服務可能受影響；需確認後再開。"

msgid "参考：IETF RFC 4941。仅影响地址生成策略，不改变连通性。"
msgstr "參考：IETF RFC 4941。僅影響地址生成策略，不改變連通性。"

msgid "启用/禁用 IPv6"
msgstr "啓用/禁用 IPv6"

msgid "按 RFC 8200 启用或禁用 IPv6 栈（默认启用；仅在确需禁用时选择）。"
msgstr "按 RFC 8200 啓用或禁用 IPv6 棧（默認啓用；僅在確需禁用時選擇）。"

msgid "禁用 IPv6 可能导致仅 IPv6 可达的服务不可访问。"
msgstr "禁用 IPv6 可能導致僅 IPv6 可達的服務不可訪問。"

msgid "参考：IETF RFC 8200。现代网络建议保持启用。"
msgstr "參考：IETF RFC 8200。現代網絡建議保持啓用。"

msgid "启用 ECN 显式拥塞通知"
msgstr "啓用 ECN 顯式擁塞通知"

msgid "在 IP 报头标记拥塞，避免丢包即降速（RFC 3168）。"
msgstr "在 IP 報頭標記擁塞，避免丟包即降速（RFC 3168）。"

msgid "个别老旧设备对 ECN 处理异常，遇问题可关回。"
msgstr "個別老舊設備對 ECN 處理異常，遇問題可關回。"

msgid "参考：IETF RFC 3168。高延迟/拥塞链路可提升吞吐。"
msgstr "參考：IETF RFC 3168。高延遲/擁塞鏈路可提升吞吐。"

msgid "改用 BBR 拥塞控制"
msgstr "改用 BBR 擁塞控制"

msgid "改用基于带宽-延迟乘积的 BBR，长肥管道下比 Cubic 更高效（IETF/CCRG）。"
msgstr "改用基於帶寬-延遲乘積的 BBR，長肥管道下比 Cubic 更高效（IETF/CCRG）。"

msgid "与部分中间设备/限速策略不兼容时请回退 Cubic。"
msgstr "與部分中間設備/限速策略不兼容時請回退 Cubic。"

msgid "参考：IETF CCRG BBR / RFC 9002 思路。需内核支持 tcp_bbr 模块。"
msgstr "參考：IETF CCRG BBR / RFC 9002 思路。需內核支持 tcp_bbr 模塊。"

msgid "启用路径 MTU 发现"
msgstr "啓用路徑 MTU 發現"

msgid "动态发现路径 MTU，避免分片、提升吞吐（RFC 1191）。"
msgstr "動態發現路徑 MTU，避免分片、提升吞吐（RFC 1191）。"

msgid "参考：IETF RFC 1191。"
msgstr "參考：IETF RFC 1191。"

msgid "Wi-Fi 节能模式"
msgstr "Wi-Fi 節能模式"

msgid "空闲时让无线网卡进入节能模式（IEEE 802.11）。"
msgstr "空閒時讓無線網卡進入節能模式（IEEE 802.11）。"

msgid "实时音视频/游戏场景建议关闭以减少抖动。"
msgstr "實時音視頻/遊戲場景建議關閉以減少抖動。"

msgid "参考：IEEE 802.11 Power Save。笔记本可省电，增延迟。"
msgstr "參考：IEEE 802.11 Power Save。筆記本可省電，增延遲。"

msgid "DNS-over-TLS（DoT）"
msgstr "DNS-over-TLS（DoT）"

msgid "在 TLS 上传输 DNS 防窃听/篡改（RFC 7858）；需在解析器侧启用。"
msgstr "在 TLS 上傳輸 DNS 防竊聽/篡改（RFC 7858）；需在解析器側啓用。"

msgid "参考：IETF RFC 7858。属指引项，不改变本机配置。"
msgstr "參考：IETF RFC 7858。屬指引項，不改變本機配置。"

msgid "DNS-over-HTTPS（DoH）"
msgstr "DNS-over-HTTPS（DoH）"

msgid "在 HTTPS 上传输 DNS 规避劫持（RFC 8484）；需在解析器/浏览器侧启用。"
msgstr "在 HTTPS 上傳輸 DNS 規避劫持（RFC 8484）；需在解析器/瀏覽器側啓用。"

msgid "参考：IETF RFC 8484。属指引项。"
msgstr "參考：IETF RFC 8484。屬指引項。"

msgid "QoS / DSCP 业务分级（ITU-T Y.1541）"
msgstr "QoS / DSCP 業務分級（ITU-T Y.1541）"

msgid "按 ITU-T Y.1541 的性能目标用 DSCP 标记区分业务（路由器侧生效）。"
msgstr "按 ITU-T Y.1541 的性能目標用 DSCP 標記區分業務（路由器側生效）。"

msgid "误标记 DSCP 可能被上游运营商丢弃，企业网需与运维确认。"
msgstr "誤標記 DSCP 可能被上游運營商丟棄，企業網需與運維確認。"

msgid "参考：ITU-T Y.1541。主机侧强行标记通常需 eBPF/tc，风险较高，默认仅指引。"
msgstr "參考：ITU-T Y.1541。主機側強行標記通常需 eBPF/tc，風險較高，默認僅指引。"

msgid "ADSL 链路参数（ITU-T G.992）"
msgstr "ADSL 鏈路參數（ITU-T G.992）"

msgid "ADSL 物理层由 DSLAM 与调制解调器协商（ITU-T G.992）；本机仅说明。"
msgstr "ADSL 物理層由 DSLAM 與調制解調器協商（ITU-T G.992）；本機僅說明。"

msgid "参考：ITU-T G.992（G.dmt/G.lite）。属指引项。"
msgstr "參考：ITU-T G.992（G.dmt/G.lite）。屬指引項。"

msgid "语音编码 G.711（ITU-T）"
msgstr "語音編碼 G.711（ITU-T）"

msgid "传统 VoIP/PSTN 互通的 PCM 语音编码（ITU-T G.711）；本机仅说明。"
msgstr "傳統 VoIP/PSTN 互通的 PCM 語音編碼（ITU-T G.711）；本機僅說明。"

msgid "参考：ITU-T G.711。属指引项。"
msgstr "參考：ITU-T G.711。屬指引項。"

msgid "开启网卡卸载（GRO/GSO/TSO，ethtool -K）"
msgstr "開啓網卡卸載（GRO/GSO/TSO，ethtool -K）"

msgid "让网卡/驱动做大部分分段与校验和卸载，显著降低 CPU、提升吞吐（ethtool -K）。转发设备切勿开 LRO。"
msgstr "讓網卡/驅動做大部分分段與校驗和卸載，顯著降低 CPU、提升吞吐（ethtool -K）。轉發設備切勿開 LRO。"

msgid "转发/路由场景不要开 LRO（LRO 不重算校验和，跨网段会出错）；终端/服务器保留 GRO/TSO/GSO。"
msgstr "轉發/路由場景不要開 LRO（LRO 不重算校驗和，跨網段會出錯）；終端/服務器保留 GRO/TSO/GSO。"

msgid "参考：ethtool(8) / kernel ethtool-netlink.rst。仅作用于本机主接口的卸载开关。"
msgstr "參考：ethtool(8) / kernel ethtool-netlink.rst。僅作用於本機主接口的卸載開關。"

msgid "调网卡中断聚合（ethtool -C）"
msgstr "調網卡中斷聚合（ethtool -C）"

msgid "适当提高中断聚合窗口，降低每秒中断数、省 CPU（ethtool -C rx-usecs/tx-usecs）。"
msgstr "適當提高中斷聚合窗口，降低每秒中斷數、省 CPU（ethtool -C rx-usecs/tx-usecs）。"

msgid "窗口过大可能增加接收延迟，需按业务权衡后再调。"
msgstr "窗口過大可能增加接收延遲，需按業務權衡後再調。"

msgid "参考：ethtool(8)。高吞吐场景可加大窗口；实时性敏感场景要保守。"
msgstr "參考：ethtool(8)。高吞吐場景可加大窗口；實時性敏感場景要保守。"

msgid "单队列网卡开启 RPS（sysfs rps_cpus）"
msgstr "單隊列網卡開啓 RPS（sysfs rps_cpus）"

msgid "单队列网卡把收包软中断散到多 CPU（rps_cpus 写 CPU 掩码），补多核短板（scaling.rst）。"
msgstr "單隊列網卡把收包軟中斷散到多 CPU（rps_cpus 寫 CPU 掩碼），補多核短板（scaling.rst）。"

msgid "掩码写错（含离线 CPU）可能不生效或降性能，函数已自动读取 /sys 在线 CPU 拓扑。"
msgstr "掩碼寫錯（含離線 CPU）可能不生效或降性能，函數已自動讀取 /sys 在線 CPU 拓撲。"

msgid "参考：scaling.rst。多队列网卡优先靠驱动 RSS，无需 RPS。"
msgstr "參考：scaling.rst。多隊列網卡優先靠驅動 RSS，無需 RPS。"

msgid "发送侧开启 XPS（sysfs xps_cpus）"
msgstr "發送側開啓 XPS（sysfs xps_cpus）"

msgid "按 CPU 选 TX 队列，减少发送锁竞争（tx-*/xps_cpus 写 CPU 掩码，scaling.rst）。"
msgstr "按 CPU 選 TX 隊列，減少發送鎖競爭（tx-*/xps_cpus 寫 CPU 掩碼，scaling.rst）。"

msgid "掩码写错可能不生效，函数已自动读取在线 CPU 拓扑。"
msgstr "掩碼寫錯可能不生效，函數已自動讀取在線 CPU 拓撲。"

msgid "参考：scaling.rst。与 RPS 互补，发送路径优化。"
msgstr "參考：scaling.rst。與 RPS 互補，發送路徑優化。"

msgid "出口挂 fq_codel 抗缓冲膨胀（tc qdisc）"
msgstr "出口掛 fq_codel 抗緩衝膨脹（tc qdisc）"

msgid "用 fq_codel 主动管理出口队列，缓解 bufferbloat（上传占满时延迟暴涨），降延迟不牺牲吞吐（tc qdisc）。"
msgstr "用 fq_codel 主動管理出口隊列，緩解 bufferbloat（上傳佔滿時延遲暴漲），降延遲不犧牲吞吐（tc qdisc）。"

msgid "勿用 tc qdisc del 误删正在使用的根 qdisc（会瞬间断该设备出口）；本任务用 replace 安全覆盖。"
msgstr "勿用 tc qdisc del 誤刪正在使用的根 qdisc（會瞬間斷該設備出口）；本任務用 replace 安全覆蓋。"

msgid "参考：RFC 8290 / bufferbloat.net。只读诊断用 tc qdisc show。"
msgstr "參考：RFC 8290 / bufferbloat.net。只讀診斷用 tc qdisc show。"

msgid "调高连接跟踪表上限（nf_conntrack_max）"
msgstr "調高連接跟蹤表上限（nf_conntrack_max）"

msgid "高并发短连接/NAT 网关下，count 逼近 max 会丢新连接；调高上限避免（sysctl nf_conntrack_max）。"
msgstr "高併發短連接/NAT 網關下，count 逼近 max 會丟新連接；調高上限避免（sysctl nf_conntrack_max）。"

msgid "勿用 conntrack -F 清空正在用的连接表（会切断所有已建立连接）。"
msgstr "勿用 conntrack -F 清空正在用的連接表（會切斷所有已建立連接）。"

msgid "参考：nf_conntrack 文档。默认 262144；也可缩短 established 超时让空闲连接更快过期。"
msgstr "參考：nf_conntrack 文檔。默認 262144；也可縮短 established 超時讓空閒連接更快過期。"

msgid "调高 NAPI 收包 backlog（netdev_max_backlog）"
msgstr "調高 NAPI 收包 backlog（netdev_max_backlog）"

msgid "调高 NAPI 收包软中断 backlog 上限，高包率场景减少丢包（sysctl netdev_max_backlog）。"
msgstr "調高 NAPI 收包軟中斷 backlog 上限，高包率場景減少丟包（sysctl netdev_max_backlog）。"

msgid "过高会多用内存，按实际负载调整。"
msgstr "過高會多用內存，按實際負載調整。"

msgid "参考：ip-sysctl.rst。默认 5000。"
msgstr "參考：ip-sysctl.rst。默認 5000。"

msgid "XDP/eBPF 数据面加速（指引，高危）"
msgstr "XDP/eBPF 數據面加速（指引，高危）"

msgid "XDP 在驱动收包最早点处理（DDoS 过滤/负载均衡），tc clsact 在 ingress/egress 挂 BPF。加载属高级写操作。"
msgstr "XDP 在驅動收包最早點處理（DDoS 過濾/負載均衡），tc clsact 在 ingress/egress 掛 BPF。加載屬高級寫操作。"

msgid "切勿 detach/删除不认识的 eBPF 程序（会断网或丢观测）；只在自有机器、明确意图下做。"
msgstr "切勿 detach/刪除不認識的 eBPF 程序（會斷網或丟觀測）；只在自有機器、明確意圖下做。"

msgid "参考：bpftool 只读检视 prog/map/net list。已加载程序常被 Cilium/监控/防火墙依赖。"
msgstr "參考：bpftool 只讀檢視 prog/map/net list。已加載程序常被 Cilium/監控/防火牆依賴。"

msgid "网卡 IRQ 亲和（smp_affinity，指引）"
msgstr "網卡 IRQ 親和（smp_affinity，指引）"

msgid "把网卡收包中断绑到特定 CPU（/proc/irq/<n>/smp_affinity），配合 RPS 减少跨核抖动。"
msgstr "把網卡收包中斷綁到特定 CPU（/proc/irq/<n>/smp_affinity），配合 RPS 減少跨核抖動。"

msgid "绑错 CPU 可能反而降性能；多队列网卡优先用驱动 RSS+irqbalance。"
msgstr "綁錯 CPU 可能反而降性能；多隊列網卡優先用驅動 RSS+irqbalance。"

msgid "参考：irq-affinity.rst。通常配合 RPS/XPS 一起调。"
msgstr "參考：irq-affinity.rst。通常配合 RPS/XPS 一起調。"

msgid "开启 RFS 流亲和（rps_flow_cnt，指引）"
msgstr "開啓 RFS 流親和（rps_flow_cnt，指引）"

msgid "按套接字 CPU 亲和把同一流导向同一 CPU（rps_sock_flow_entries + 每队列 rps_flow_cnt），降低缓存 miss。"
msgstr "按套接字 CPU 親和把同一流導向同一 CPU（rps_sock_flow_entries + 每隊列 rps_flow_cnt），降低緩存 miss。"

msgid "流表过小不生效、过大占内存；按连接数规模设置。"
msgstr "流表過小不生效、過大佔內存；按連接數規模設置。"

msgid "参考：scaling.rst。RFS 在 RPS 基础上进一步优化，需先开 RPS。"
msgstr "參考：scaling.rst。RFS 在 RPS 基礎上進一步優化，需先開 RPS。"

msgid "导入多种网络链接协议（注册表 + 本机能力）"
msgstr "導入多種網絡鏈接協議（註冊表 + 本機能力）"

msgid "按各协议自身的规范登记链接层/传输层协议（TCP、UDP、蓝牙 RFCOMM、串口 UART、BLE 低功耗蓝牙、802.15.4），并只读探测本机是否具备对应能力。"
msgstr "按各協議自身的規範登記鏈接層/傳輸層協議（TCP、UDP、藍牙 RFCOMM、串口 UART、BLE 低功耗藍牙、802.15.4），並只讀探測本機是否具備對應能力。"

msgid "探测只判断接口可用性，不代表已配对/已授权设备。"
msgstr "探測只判斷接口可用性，不代表已配對/已授權設備。"

msgid "注册表：TCP(RFC 9293)、UDP(RFC 768)、RFCOMM(蓝牙串口模拟)、串口(UART/RS-232)、BLE(GATT)、802.15.4(低速率无线个域网，如 Zigbee/Thread 底层)。"
msgstr "註冊表：TCP(RFC 9293)、UDP(RFC 768)、RFCOMM(藍牙串口模擬)、串口(UART/RS-232)、BLE(GATT)、802.15.4(低速率無線個域網，如 Zigbee/Thread 底層)。"

msgid "每项自带官方组织与文档出处，能力探测只读，非本机具备的协议优雅降级为「未探测到」。"
msgstr "每項自帶官方組織與文檔出處，能力探測只讀，非本機具備的協議優雅降級爲「未探測到」。"

msgid "启用本地自组网（多设备自通信 + 人机交互）"
msgstr "啓用本地自組網（多設備自通信 + 人機交互）"

msgid "启用网络后让多于 1 台设备自己通信：UDP 广播发现邻居 + TCP 可靠命令通道；命令通道只有 info/ping/probe/msg 四个只读安全命令，**绝不执行对端发来的任意命令**。"
msgstr "啓用網絡後讓多於 1 臺設備自己通信：UDP 廣播發現鄰居 + TCP 可靠命令通道；命令通道只有 info/ping/probe/msg 四個只讀安全命令，**絕不執行對端發來的任意命令**。"

msgid "需在可信局域网内启用；跨公网暴露需自行做访问控制。"
msgstr "需在可信局域網內啓用；跨公網暴露需自行做訪問控制。"

msgid "发现：UDP 受限广播信标；可靠通道：TCP；命令白名单：info/ping/probe/msg。"
msgstr "發現：UDP 受限廣播信標；可靠通道：TCP；命令白名單：info/ping/probe/msg。"

msgid "人机交互：msg 通道仅回显并记录到会话收件箱，不触发任何写操作。"
msgstr "人機交互：msg 通道僅回顯並記錄到會話收件箱，不觸發任何寫操作。"

msgid "握手自带 share 字段：宣告愿共享的算力（CPU/GPU/NPU/TPU/内存/网络）与永不共享的数据（个人数据/关键资产）。"
msgstr "握手自帶 share 字段：宣告願共享的算力（CPU/GPU/NPU/TPU/內存/網絡）與永不共享的數據（個人數據/關鍵資產）。"

msgid "发现本网段内的其他设备（只读）"
msgstr "發現本網段內的其他設備（只讀）"

msgid "广播发现本网段内同样启用自组网的设备，列出名称/地址/版本/链接能力。"
msgstr "廣播發現本網段內同樣啓用自組網的設備，列出名稱/地址/版本/鏈接能力。"

msgid "只在本地网段发信标，不向外网发送数据。"
msgstr "只在本地網段發信標，不向外網發送數據。"

msgid "设备间人机交互消息（msg 通道）"
msgstr "設備間人機交互消息（msg 通道）"

msgid "通过 mesh 的消息通道与已发现设备互发文本（人机交互）；仅回显与记录到会话收件箱，不执行、不落盘。"
msgstr "通過 mesh 的消息通道與已發現設備互發文本（人機交互）；僅回顯與記錄到會話收件箱，不執行、不落盤。"

msgid "消息通道属于只读安全白名单内的命令；对端任何非白名单命令一律被忽略。"
msgstr "消息通道屬於只讀安全白名單內的命令；對端任何非白名單命令一律被忽略。"

msgid "按网络维度的隐私验证（两项以上个人信息）"
msgstr "按網絡維度的隱私驗證（兩項以上個人信息）"

msgid "不同网络用「个人输入的两个以上信息」作验证（如姓名+身份证号，或邮箱+手机号）；**原始信息不作保存**，只存随机 salt + PBKDF2 派生令牌 + 字段标签；下次启动重新输入同样信息即可重新连接。"
msgstr "不同網絡用「個人輸入的兩個以上信息」作驗證（如姓名+身份證號，或郵箱+手機號）；**原始信息不作保存**，只存隨機 salt + PBKDF2 派生令牌 + 字段標籤；下次啓動重新輸入同樣信息即可重新連接。"

msgid "验证信息一经设定不可找回（因为未保存原始值），忘记需重新设置。"
msgstr "驗證信息一經設定不可找回（因爲未保存原始值），忘記需重新設置。"

msgid "派生：token = PBKDF2-HMAC-SHA256(salt, 归一化字段)；不同网络用不同 salt，同名同 ID 在两个网络派生结果不同（防跨网关联）。"
msgstr "派生：token = PBKDF2-HMAC-SHA256(salt, 歸一化字段)；不同網絡用不同 salt，同名同 ID 在兩個網絡派生結果不同（防跨網關聯）。"

msgid "落盘只含 salt + 令牌 + 字段标签，原始姓名/证件号/邮箱/手机号一律不落盘。"
msgstr "落盤只含 salt + 令牌 + 字段標籤，原始姓名/證件號/郵箱/手機號一律不落盤。"

msgid "重连：重新输入同样两项信息，重派生后常量时间比对，一致即重连。"
msgstr "重連：重新輸入同樣兩項信息，重派生後常量時間比對，一致即重連。"

msgid "跨设备认定同一人：identity_fingerprint(字段, 网络, 共享口令) 确定性派生，不知道原始信息与口令者无法伪造。"
msgstr "跨設備認定同一人：identity_fingerprint(字段, 網絡, 共享口令) 確定性派生，不知道原始信息與口令者無法僞造。"

msgid "同人登录的多设备资源共享（算力共享，数据不共享）"
msgstr "同人登錄的多設備資源共享（算力共享，數據不共享）"

msgid "同一人登录的多台设备共享硬件资源：CPU、内存、GPU、NPU、TPU、网络出口；**个人数据与关键资产数据（凭据、密钥、钱包、通讯录、文档等）一律不共享**，以防他人盗用你的网络互联互通能力。"
msgstr "同一人登錄的多臺設備共享硬件資源：CPU、內存、GPU、NPU、TPU、網絡出口；**個人數據與關鍵資產數據（憑據、密鑰、錢包、通訊錄、文檔等）一律不共享**，以防他人盜用你的網絡互聯互通能力。"

msgid "授权前请确认对方确为本人设备；发现异常授权可随时撤销（revoke）。"
msgstr "授權前請確認對方確爲本人設備；發現異常授權可隨時撤銷（revoke）。"

msgid "可共享：cpu / memory / gpu / npu / tpu / network（只有算力与网络）。"
msgstr "可共享：cpu / memory / gpu / npu / tpu / network（只有算力與網絡）。"

msgid "永不共享：personal_data / contacts / credentials / crypto_keys / asset_data / biometric / storage_content。"
msgstr "永不共享：personal_data / contacts / credentials / crypto_keys / asset_data / biometric / storage_content。"

msgid "认定同一人：netauth 跨设备身份指纹一致才授权；他人指纹一律拒绝并记审计。只落盘指纹与授权种类，绝不落盘个人信息。"
msgstr "認定同一人：netauth 跨設備身份指紋一致才授權；他人指紋一律拒絕並記審計。只落盤指紋與授權種類，絕不落盤個人信息。"

msgid "清理编译产物（unpackage/dist、build）"
msgstr "清理編譯產物（unpackage/dist、build）"

msgid "uni-app 发行（发行到 App/H5/小程序）后产生的编译输出目录，删除不影响源码。"
msgstr "uni-app 發行（發行到 App/H5/小程序）後產生的編譯輸出目錄，刪除不影響源碼。"

msgid "删除后需重新点击「发行」或「运行」才会重新生成；CI 环境可安全清理以节省空间。"
msgstr "刪除後需重新點擊「發行」或「運行」纔會重新生成；CI 環境可安全清理以節省空間。"

msgid "工程目录约定见 API 清单的 fs 组（unpackage/ dist/ build/）。"
msgstr "工程目錄約定見 API 清單的 fs 組（unpackage/ dist/ build/）。"

msgid "清理构建缓存（node_modules/.cache、.vite）"
msgstr "清理構建緩存（node_modules/.cache、.vite）"

msgid "Vite / webpack 的构建缓存，删除后首次构建稍慢，可安全重建。"
msgstr "Vite / webpack 的構建緩存，刪除後首次構建稍慢，可安全重建。"

msgid "属于开发机缓存，不影响已发布的包；大规模项目可显著释放空间。"
msgstr "屬於開發機緩存，不影響已發佈的包；大規模項目可顯著釋放空間。"

msgid "校验/清理依赖缓存（npm / pnpm / yarn）"
msgstr "校驗/清理依賴緩存（npm / pnpm / yarn）"

msgid "uni-app 工程依赖（vue、@dcloudio 等）下载的本地缓存，可校验瘦身。"
msgstr "uni-app 工程依賴（vue、@dcloudio 等）下載的本地緩存，可校驗瘦身。"

msgid "无 npm/pnpm 时自动跳过——不强求安装任何包管理器。"
msgstr "無 npm/pnpm 時自動跳過——不強求安裝任何包管理器。"

msgid "`pnpm store prune` 会删除未被任何项目引用的包；`npm cache verify` 仅整理校验。"
msgstr "`pnpm store prune` 會刪除未被任何項目引用的包；`npm cache verify` 僅整理校驗。"

msgid "清理 HBuilderX 编辑器缓存与日志"
msgstr "清理 HBuilderX 編輯器緩存與日誌"

msgid "HBuilderX 的插件缓存、运行日志会随时间增长，影响启动与构建速度。"
msgstr "HBuilderX 的插件緩存、運行日誌會隨時間增長，影響啓動與構建速度。"

msgid "请先关闭 HBuilderX 再清理，避免正在写入的文件被删导致配置丢失。"
msgstr "請先關閉 HBuilderX 再清理，避免正在寫入的文件被刪導致配置丟失。"

msgid "若使用 CLI（如 @dcloudio/uvm）而非 HBuilderX，可跳过本项。"
msgstr "若使用 CLI（如 @dcloudio/uvm）而非 HBuilderX，可跳過本項。"

msgid "清理端上 storage（uni.clearStorageSync）"
msgstr "清理端上 storage（uni.clearStorageSync）"

msgid "App / 小程序 / H5 端上的本地存储（含登录态、表单草稿、缓存数据）。"
msgstr "App / 小程序 / H5 端上的本地存儲（含登錄態、表單草稿、緩存數據）。"

msgid "清空 storage 会一并清掉登录态与本地草稿，务必让用户知情并确认后再执行。"
msgstr "清空 storage 會一併清掉登錄態與本地草稿，務必讓用戶知情並確認後再執行。"

msgid "各端容量上限不同：微信小程序约 10MB，App 端受系统配额限制。"
msgstr "各端容量上限不同：微信小程序約 10MB，App 端受系統配額限制。"

msgid "推荐做法：先用 uni.getStorageInfoSync() 展示已用/上限，再由用户点「清理」。"
msgstr "推薦做法：先用 uni.getStorageInfoSync() 展示已用/上限，再由用戶點「清理」。"

msgid "API 参考：data/uniapp_api.json 的 storage 组（W3C Web Storage）。"
msgstr "API 參考：data/uniapp_api.json 的 storage 組（W3C Web Storage）。"

msgid "清理 H5 端 localStorage / CacheStorage"
msgstr "清理 H5 端 localStorage / CacheStorage"

msgid "H5 端落在浏览器/内核的存储：localStorage、sessionStorage、Service Worker 缓存。"
msgstr "H5 端落在瀏覽器/內核的存儲：localStorage、sessionStorage、Service Worker 緩存。"

msgid "若启用了 Service Worker 离线缓存，清理后首次访问需重新联网加载。"
msgstr "若啓用了 Service Worker 離線緩存，清理後首次訪問需重新聯網加載。"

msgid "API 参考：W3C Web Storage / Service Worker（CacheStorage）。"
msgstr "API 參考：W3C Web Storage / Service Worker（CacheStorage）。"

msgid "依赖与体积报告（辅助定位可瘦身项）"
msgstr "依賴與體積報告（輔助定位可瘦身項）"

msgid "uni-app 包体积直接影响 App 安装体积与小程序主包限制，先量化再优化。"
msgstr "uni-app 包體積直接影響 App 安裝體積與小程序主包限制，先量化再優化。"

msgid "小程序主包/分包有体积限制（如微信小程序主包 2MB），建议把大资源放分包或 CDN。"
msgstr "小程序主包/分包有體積限制（如微信小程序主包 2MB），建議把大資源放分包或 CDN。"

msgid "本任务只读分析，不删除任何文件，可放心执行。"
msgstr "本任務只讀分析，不刪除任何文件，可放心執行。"

msgid "分包与路由级懒加载（跨端优化指引）"
msgstr "分包與路由級懶加載（跨端優化指引）"

msgid "通过 pages.json 分包（subPackages）与组件按需引入，降低首屏/主包体积，提升各端启动速度。"
msgstr "通過 pages.json 分包（subPackages）與組件按需引入，降低首屏/主包體積，提升各端啓動速度。"

msgid "API 参考：data/uniapp_api.json 的 fs 组（unpackage/dist 可清理）与 system 组。"
msgstr "API 參考：data/uniapp_api.json 的 fs 組（unpackage/dist 可清理）與 system 組。"

msgid "属工程侧优化指引，不影响已发布包；实施后代重新构建生效。"
msgstr "屬工程側優化指引，不影響已發佈包；實施後代重新構建生效。"

msgid "静态图片压缩与 WebP 化"
msgstr "靜態圖片壓縮與 WebP 化"

msgid "压缩工程内静态图片并转 WebP，降低包体与首屏加载体积。"
msgstr "壓縮工程內靜態圖片並轉 WebP，降低包體與首屏加載體積。"

msgid "转换前保留原图备份，避免透明通道/动画帧丢失。"
msgstr "轉換前保留原圖備份，避免透明通道/動畫幀丟失。"

msgid "小程序端需确认 webp 支持版本；不支持时退回压缩后的 png/jpg。"
msgstr "小程序端需確認 webp 支持版本；不支持時退回壓縮後的 png/jpg。"

msgid "图片体积通常是 H5 首屏的最大占比，压缩收益明显。"
msgstr "圖片體積通常是 H5 首屏的最大佔比，壓縮收益明顯。"

msgid "系统文本编码 UTF-8 检查"
msgstr "系統文本編碼 UTF-8 檢查"

msgid "按 Unicode 18.0.0 / ISO/IEC 10646 建议核对系统默认文本编码是否为 UTF-8，避免跨平台文本与字体元数据乱码。"
msgstr "按 Unicode 18.0.0 / ISO/IEC 10646 建議覈對系統默認文本編碼是否爲 UTF-8，避免跨平臺文本與字體元數據亂碼。"

msgid "仅检查并报告，不修改编码设置；改区域/语言环境需用户手动并评估影响。"
msgstr "僅檢查並報告，不修改編碼設置；改區域/語言環境需用戶手動並評估影響。"

msgid "参考标准：The Unicode Standard 18.0.0（最新稳定版）/ ISO/IEC 10646；建议系统区域与文件系统默认 UTF-8。"
msgstr "參考標準：The Unicode Standard 18.0.0（最新穩定版）/ ISO/IEC 10646；建議系統區域與文件系統默認 UTF-8。"

msgid "长期支持（LTS）：以运行时锁定的 Unicode 版本（ICU / .NET / Python unicodedata）为准，不强制追新。"
msgstr "長期支持（LTS）：以運行時鎖定的 Unicode 版本（ICU / .NET / Python unicodedata）爲準，不強制追新。"

msgid "前瞻编码：声明 UTF-128 模式时落盘规范化为 UTF-8，保持对既有 UTF-8 文件的向下兼容（见 data/fonts_standards.json 的 utf128）。"
msgstr "前瞻編碼：聲明 UTF-128 模式時落盤規範化爲 UTF-8，保持對既有 UTF-8 文件的向下兼容（見 data/fonts_standards.json 的 utf128）。"

msgid "字体冗余检查（疑似重复字体）"
msgstr "字體冗餘檢查（疑似重複字體）"

msgid "按字体标准类（OpenType/TrueType/WOFF）列出已安装字体，标记同名/同族冗余，供精简。"
msgstr "按字體標準類（OpenType/TrueType/WOFF）列出已安裝字體，標記同名/同族冗餘，供精簡。"

msgid "未安装 fontconfig 时无此能力；安装后即可启用，本工具不强求。"
msgstr "未安裝 fontconfig 時無此能力；安裝後即可啓用，本工具不強求。"

msgid "参考格式：OpenType（ISO/IEC 14496-22）/ TrueType（Apple）/ W3C WOFF。"
msgstr "參考格式：OpenType（ISO/IEC 14496-22）/ TrueType（Apple）/ W3C WOFF。"

msgid "冗余字体多来自多份同名拷贝；精简可加快字体枚举与程序启动。"
msgstr "冗餘字體多來自多份同名拷貝；精簡可加快字體枚舉與程序啓動。"

msgid "字体缓存重建"
msgstr "字體緩存重建"

msgid "字体显示异常（缺字/乱码/回退错误）时，按字体引擎规范重建字体缓存（fontconfig / macOS atsutil / Windows FontCache）。"
msgstr "字體顯示異常（缺字/亂碼/回退錯誤）時，按字體引擎規範重建字體緩存（fontconfig / macOS atsutil / Windows FontCache）。"

msgid "macOS 重建后需注销/重启才完全生效；Windows 会重启 FontCache 服务（字体短暂切换）。"
msgstr "macOS 重建後需註銷/重啓才完全生效；Windows 會重啓 FontCache 服務（字體短暫切換）。"

msgid "执行前请确认无正在进行的排版/打印任务；需 --apply 且中高风险 --yes 确认。"
msgstr "執行前請確認無正在進行的排版/打印任務；需 --apply 且中高風險 --yes 確認。"

msgid "参考格式：OpenType（ISO/IEC 14496-22）；缓存损坏会导致字体回退异常，重建可修复。"
msgstr "參考格式：OpenType（ISO/IEC 14496-22）；緩存損壞會導致字體回退異常，重建可修復。"

msgid "Windows 已安装字体清点"
msgstr "Windows 已安裝字體清點"

msgid "清点 Windows 已安装字体数量（参考字体/字符标准），作为优化与冗余判断起点。"
msgstr "清點 Windows 已安裝字體數量（參考字體/字符標準），作爲優化與冗餘判斷起點。"

msgid "仅清点数量，不删除任何字体（删系统字体可能影响 UI 显示）。"
msgstr "僅清點數量，不刪除任何字體（刪系統字體可能影響 UI 顯示）。"

msgid "参考标准：OpenType/TrueType（Windows 字体引擎）；字体清单存于 %windir%\\Fonts 与注册表 Fonts 键。"
msgstr "參考標準：OpenType/TrueType（Windows 字體引擎）；字體清單存於 %windir%\\Fonts 與註冊表 Fonts 鍵。"

msgid "启用网络字体（@font-face 拉取 WOFF2）"
msgstr "啓用網絡字體（@font-face 拉取 WOFF2）"

msgid "开启网络协议后，可在页面/应用中以 @font-face 按需拉取 WOFF2 网络字体（W3C WOFF 2.0 + RFC 9110 缓存语义）；字体文本编码保持 UTF-8 兼容。"
msgstr "開啓網絡協議後，可在頁面/應用中以 @font-face 按需拉取 WOFF2 網絡字體（W3C WOFF 2.0 + RFC 9110 緩存語義）；字體文本編碼保持 UTF-8 兼容。"

msgid "网络字体经外部拉取，受网络与隐私策略影响；自定义字体请自托管或选用可信来源。"
msgstr "網絡字體經外部拉取，受網絡與隱私策略影響；自定義字體請自託管或選用可信來源。"

msgid "默认关闭（opt_in=True）；须 --opt-in 选择 + --yes 确认后才会纳入，不乱启用。"
msgstr "默認關閉（opt_in=True）；須 --opt-in 選擇 + --yes 確認後纔會納入，不亂啓用。"

msgid "依赖：需先开启网络协议开关（toggles / --opt-in），否则本项不出现。"
msgstr "依賴：需先開啓網絡協議開關（toggles / --opt-in），否則本項不出現。"

msgid "参考：W3C WOFF 2.0（2018）/ RFC 9110（HTTP 缓存与条件请求）。"
msgstr "參考：W3C WOFF 2.0（2018）/ RFC 9110（HTTP 緩存與條件請求）。"

msgid "网络字体文本编码保持 UTF-8 兼容；声明 UTF-128 模式时亦向下兼容 UTF-8。"
msgstr "網絡字體文本編碼保持 UTF-8 兼容；聲明 UTF-128 模式時亦向下兼容 UTF-8。"

msgid "文本 Unicode 规范化检查（UAX #15）"
msgstr "文本 Unicode 規範化檢查（UAX #15）"

msgid "按 UAX #15 检查系统文本配置是否为 NFC 规范化形态，便于等价比较与去重；与 UTF-8 / UTF-128 编码策略配合，保证跨平台文本一致。"
msgstr "按 UAX #15 檢查系統文本配置是否爲 NFC 規範化形態，便於等價比較與去重；與 UTF-8 / UTF-128 編碼策略配合，保證跨平臺文本一致。"

msgid "仅检查并报告，不修改文件；如需规范化请用 unicodedata.normalize 处理，注意等价语义。"
msgstr "僅檢查並報告，不修改文件；如需規範化請用 unicodedata.normalize 處理，注意等價語義。"

msgid "参考：Unicode 规范化（UAX #15）：NFC/NFD/NFKC/NFKD；系统文本建议统一为 NFC。"
msgstr "參考：Unicode 規範化（UAX #15）：NFC/NFD/NFKC/NFKD；系統文本建議統一爲 NFC。"

msgid "与编码策略配合：UTF-8（推荐）/ UTF-128（向下兼容 UTF-8）均依赖一致的码位规范化。"
msgstr "與編碼策略配合：UTF-8（推薦）/ UTF-128（向下兼容 UTF-8）均依賴一致的碼位規範化。"

msgid "用户缓存目录清点（跨平台）"
msgstr "用戶緩存目錄清點（跨平臺）"

msgid "按 XDG Base Directory / Windows LocalAppData 规范列出当前用户缓存目录与体积，辅助定位可清理项（不删除）。"
msgstr "按 XDG Base Directory / Windows LocalAppData 規範列出當前用戶緩存目錄與體積，輔助定位可清理項（不刪除）。"

msgid "不在 analyze 模式删除任何文件；清理请用对应平台任务并评估影响。"
msgstr "不在 analyze 模式刪除任何文件；清理請用對應平臺任務並評估影響。"

msgid "参考规范：XDG Base Directory（~/.cache）/ Windows 用户库（LOCALAPPDATA）。"
msgstr "參考規範：XDG Base Directory（~/.cache）/ Windows 用戶庫（LOCALAPPDATA）。"

msgid "仅清点，不删除；真正清理请用各平台对应的缓存清理任务（如 linux_user_cache）。"
msgstr "僅清點，不刪除；真正清理請用各平臺對應的緩存清理任務（如 linux_user_cache）。"

msgid "临时目录清点（跨平台）"
msgstr "臨時目錄清點（跨平臺）"

msgid "列出系统/用户临时目录（POSIX /tmp、Windows %TEMP%）体积，仅分析不清理。"
msgstr "列出系統/用戶臨時目錄（POSIX /tmp、Windows %TEMP%）體積，僅分析不清理。"

msgid "多数系统临时目录重启即清；analyze 仅列举遗留旧文件。"
msgstr "多數系統臨時目錄重啓即清；analyze 僅列舉遺留舊文件。"

msgid "参考规范：各平台临时目录约定（POSIX /tmp、Windows Temp）。"
msgstr "參考規範：各平臺臨時目錄約定（POSIX /tmp、Windows Temp）。"

msgid "家目录最大子目录报告（辅助瘦身）"
msgstr "家目錄最大子目錄報告（輔助瘦身）"

msgid "用 Python 标准库列出家目录下体积最大的若干子目录，辅助定位可瘦身项（只读）。"
msgstr "用 Python 標準庫列出家目錄下體積最大的若干子目錄，輔助定位可瘦身項（只讀）。"

msgid "纯标准库 os.walk 递归统计；不删除任何文件，可安全执行。"
msgstr "純標準庫 os.walk 遞歸統計；不刪除任何文件，可安全執行。"

msgid "刷新 DNS 解析器缓存（指引）"
msgstr "刷新 DNS 解析器緩存（指引）"

msgid "给出刷新本地 DNS 缓存的命令（systemd-resolved / nscd / mDNSResponder / Windows），排查 DNS 污染或解析陈旧时可用。"
msgstr "給出刷新本地 DNS 緩存的命令（systemd-resolved / nscd / mDNSResponder / Windows），排查 DNS 污染或解析陳舊時可用。"

msgid "刷新 DNS 缓存后已解析的域名需重新查询，属正常行为。"
msgstr "刷新 DNS 緩存後已解析的域名需重新查詢，屬正常行爲。"

msgid "属优化类指引：解析器缓存（glibc nss / systemd-resolved）刷新可加速新解析生效。"
msgstr "屬優化類指引：解析器緩存（glibc nss / systemd-resolved）刷新可加速新解析生效。"

msgid "需 --apply 且 --yes 才会执行对应命令；部分环境需管理员权限。"
msgstr "需 --apply 且 --yes 纔會執行對應命令；部分環境需管理員權限。"

msgid "架构/指令集探测报告"
msgstr "架構/指令集探測報告"

msgid "探测当前 CPU 架构（龙芯 LoongArch / MIPS / RISC-V / x86 / ARM …），给出对应标准出处与建议。"
msgstr "探測當前 CPU 架構（龍芯 LoongArch / MIPS / RISC-V / x86 / ARM …），給出對應標準出處與建議。"

msgid "探测接口：uname -m / /proc/cpuinfo / sysctl hw.machine / %PROCESSOR_ARCHITECTURE%。"
msgstr "探測接口：uname -m / /proc/cpuinfo / sysctl hw.machine / %PROCESSOR_ARCHITECTURE%。"

msgid "未收录的架构会提示可在 data/arch.json 补充，不会报错。"
msgstr "未收錄的架構會提示可在 data/arch.json 補充，不會報錯。"

msgid "龙芯 LoongArch 专项报告与调优指引"
msgstr "龍芯 LoongArch 專項報告與調優指引"

msgid "识别龙芯平台（LoongArch 或早期 Godson/MIPS 授权机型），报告向量/虚拟化/二进制翻译扩展并给出工具链与调优建议。"
msgstr "識別龍芯平臺（LoongArch 或早期 Godson/MIPS 授權機型），報告向量/虛擬化/二進制翻譯擴展並給出工具鏈與調優建議。"

msgid "二进制翻译（LBT）运行非原生程序有性能损耗，生产环境建议原生编译。"
msgstr "二進制翻譯（LBT）運行非原生程序有性能損耗，生產環境建議原生編譯。"

msgid "LoongArch 是国产自主指令集（2021 年随 3A5000 发布），由 MIPS 授权演进而来。"
msgstr "LoongArch 是國產自主指令集（2021 年隨 3A5000 發佈），由 MIPS 授權演進而來。"

msgid "扩展含义：LSX/LASX 向量、LVZ 虚拟化、LBT 二进制翻译（可跑 x86/ARM 程序但有损耗）。"
msgstr "擴展含義：LSX/LASX 向量、LVZ 虛擬化、LBT 二進制翻譯（可跑 x86/ARM 程序但有損耗）。"

msgid "优先取龙芯/系统厂商提供的源与原生包；交叉工具链为 loongarch64-linux-gnu-*。"
msgstr "優先取龍芯/系統廠商提供的源與原生包；交叉工具鏈爲 loongarch64-linux-gnu-*。"

msgid "MIPS 架构专项报告（含龙芯早期授权机型）"
msgstr "MIPS 架構專項報告（含龍芯早期授權機型）"

msgid "识别 MIPS 平台，报告位数、端序与 ABI，并区分是否为龙芯早期 Godson 机型。"
msgstr "識別 MIPS 平臺，報告位數、端序與 ABI，並區分是否爲龍芯早期 Godson 機型。"

msgid "MIPS 常见于路由器/嵌入式设备与龙芯早期机型；大端 mips 与小端 mipsel ABI 不通用。"
msgstr "MIPS 常見於路由器/嵌入式設備與龍芯早期機型；大端 mips 與小端 mipsel ABI 不通用。"

msgid "装包须与端序匹配，混用会直接报格式错误。"
msgstr "裝包須與端序匹配，混用會直接報格式錯誤。"

msgid "RISC-V 开源架构专项报告"
msgstr "RISC-V 開源架構專項報告"

msgid "识别 RISC-V 平台，读取 isa 扩展字符串并引用 RVA20/22/23 profiles 规范。"
msgstr "識別 RISC-V 平臺，讀取 isa 擴展字符串並引用 RVA20/22/23 profiles 規範。"

msgid "RISC-V 为开源、免授权费指令集；常用编译参数 -march=rv64gc -mabi=lp64d。"
msgstr "RISC-V 爲開源、免授權費指令集；常用編譯參數 -march=rv64gc -mabi=lp64d。"

msgid "不同扩展组合（如缺 V 向量）影响软件可用性，装包前先核对 isa 字符串。"
msgstr "不同擴展組合（如缺 V 向量）影響軟件可用性，裝包前先覈對 isa 字符串。"

msgid "开源硬件认证与许可核对（OSHWA / CERN OHL）"
msgstr "開源硬件認證與許可覈對（OSHWA / CERN OHL）"

msgid "列出开源硬件的定义、认证（OSHWA UID）与许可（CERN OHL v2 / DIN SPEC 3105），供复用硬件设计前核对。"
msgstr "列出開源硬件的定義、認證（OSHWA UID）與許可（CERN OHL v2 / DIN SPEC 3105），供複用硬件設計前核對。"

msgid "开源硬件 = 设计文件（原理图/PCB/HDL/机械图纸）在开放许可下发布。"
msgstr "開源硬件 = 設計文件（原理圖/PCB/HDL/機械圖紙）在開放許可下發布。"

msgid "企业复用需留意 copyleft 义务：CERN OHL 衍生设计同样需开放。"
msgstr "企業複用需留意 copyleft 義務：CERN OHL 衍生設計同樣需開放。"

msgid "交叉工具链与构建目标提示"
msgstr "交叉工具鏈與構建目標提示"

msgid "按当前架构给出交叉工具链三元组与 Go 的 GOARCH 映射，便于交叉编译。"
msgstr "按當前架構給出交叉工具鏈三元組與 Go 的 GOARCH 映射，便於交叉編譯。"

msgid "GOARCH 映射：龙芯 loong64、MIPS mips64le/mipsle、RISC-V riscv64、OpenPOWER ppc64le、x86 amd64、ARM arm64。"
msgstr "GOARCH 映射：龍芯 loong64、MIPS mips64le/mipsle、RISC-V riscv64、OpenPOWER ppc64le、x86 amd64、ARM arm64。"

msgid "按当前架构交叉构建 Go（GOARCH 映射）"
msgstr "按當前架構交叉構建 Go（GOARCH 映射）"

msgid "按探测到的架构设置 GOARCH 执行 `go build ./...`，覆盖龙芯(loong64)/MIPS(mips64le)/RISC-V(riscv64) 等非 x86 目标。"
msgstr "按探測到的架構設置 GOARCH 執行 `go build ./...`，覆蓋龍芯(loong64)/MIPS(mips64le)/RISC-V(riscv64) 等非 x86 目標。"

msgid "交叉构建不产生可运行于本机的二进制（除非架构一致）；仅做构建校验。"
msgstr "交叉構建不產生可運行於本機的二進制（除非架構一致）；僅做構建校驗。"

msgid "未识别架构时回退默认目标，不报错。"
msgstr "未識別架構時回退默認目標，不報錯。"

msgid "龙芯（loong64）需 Go 1.19+；MIPS 上 Go 官方支持 mips64le/mipsle。"
msgstr "龍芯（loong64）需 Go 1.19+；MIPS 上 Go 官方支持 mips64le/mipsle。"

msgid "龙芯平台优化指引（原生优先 / 翻译层取舍）"
msgstr "龍芯平臺優化指引（原生優先 / 翻譯層取捨）"

msgid "龙芯平台的优化要点：优先原生包、源选择、编译参数与二进制翻译（LBT）取舍。"
msgstr "龍芯平臺的優化要點：優先原生包、源選擇、編譯參數與二進制翻譯（LBT）取捨。"

msgid "全部为核对型指引，不自动修改系统。"
msgstr "全部爲覈對型指引，不自動修改系統。"

msgid "MIPS / 嵌入式资源受限优化指引"
msgstr "MIPS / 嵌入式資源受限優化指引"

msgid "MIPS 路由器与嵌入式设备常见资源受限场景的优化要点：优先清缓存日志、关无用服务、避免重包。"
msgstr "MIPS 路由器與嵌入式設備常見資源受限場景的優化要點：優先清緩存日誌、關無用服務、避免重包。"

msgid "压缩格式可读性核对（tar/zip/gz/xz/bz2/7z/rar/zstd）"
msgstr "壓縮格式可讀性覈對（tar/zip/gz/xz/bz2/7z/rar/zstd）"

msgid "只读探测本机可读哪些压缩格式：核心格式走标准库永远可用，7z/rar/zstd 缺库时明确标「跳过」，不强求安装。"
msgstr "只讀探測本機可讀哪些壓縮格式：核心格式走標準庫永遠可用，7z/rar/zstd 缺庫時明確標「跳過」，不強求安裝。"

msgid "只读任务：仅探测，不解压、不读取任何文件内容。"
msgstr "只讀任務：僅探測，不解壓、不讀取任何文件內容。"

msgid "核心格式（tar/tar.gz/tar.xz/tar.bz2/zip/gz/xz/bz2）用标准库，零依赖总可用。"
msgstr "核心格式（tar/tar.gz/tar.xz/tar.bz2/zip/gz/xz/bz2）用標準庫，零依賴總可用。"

msgid "7z 需 py7zr、rar 需 rarfile 且另需 unrar/unar/bsdtar 后端、zstd 需 zstandard；缺哪个就明确跳过哪个，绝不假装支持。"
msgstr "7z 需 py7zr、rar 需 rarfile 且另需 unrar/unar/bsdtar 後端、zstd 需 zstandard；缺哪個就明確跳過哪個，絕不假裝支持。"

msgid "压缩空间分析（找出还能压出多少空间，只读）"
msgstr "壓縮空間分析（找出還能壓出多少空間，只讀）"

msgid "只读扫描目录，按「还值不值得再压」分类统计，对体积最大的可压缩文件实测 LZMA 压缩率并估算可回收空间；同时流式读取最大的几个压缩包内部条目（不解压、不驻留内存）。"
msgstr "只讀掃描目錄，按「還值不值得再壓」分類統計，對體積最大的可壓縮文件實測 LZMA 壓縮率並估算可回收空間；同時流式讀取最大的幾個壓縮包內部條目（不解壓、不駐留內存）。"

msgid "只读任务：不压缩、不解压、不删除任何文件。"
msgstr "只讀任務：不壓縮、不解壓、不刪除任何文件。"

msgid "采样估算有误差（文件前后段内容差异大时尤甚），仅用于判断「哪些值得先压」。"
msgstr "採樣估算有誤差（文件前後段內容差異大時尤甚），僅用於判斷「哪些值得先壓」。"

msgid "分类口径：归档/已压缩（zip、7z、rar…）与图片音视频/PDF（已编码）**再压几乎无收益**，报告会标「别白压」，只压文本/日志/结构化数据这类真正有收益的。"
msgstr "分類口徑：歸檔/已壓縮（zip、7z、rar…）與圖片音視頻/PDF（已編碼）**再壓幾乎無收益**，報告會標「別白壓」，只壓文本/日誌/結構化數據這類真正有收益的。"

msgid "压缩率只对前 1 MiB 采样实测（LZMA，接近 7z 的 LZMA2）后按比例推算，属估算而非精确值——目的是排序优先级，不是给出承诺数字。"
msgstr "壓縮率只對前 1 MiB 採樣實測（LZMA，接近 7z 的 LZMA2）後按比例推算，屬估算而非精確值——目的是排序優先級，不是給出承諾數字。"

msgid "省内存的三处关键实现：扫目录用 heapq 只留体积 Top N（内存恒定）；压测只读前 1 MiB 而不是整个文件；读包内部只过 header / 分块读统计。"
msgstr "省內存的三處關鍵實現：掃目錄用 heapq 只留體積 Top N（內存恆定）；壓測只讀前 1 MiB 而不是整個文件；讀包內部只過 header / 分塊讀統計。"

msgid "扫描带文件数上限（2 万）与时间预算（20 秒），达上限会标注「非全量」，避免拖慢机器。"
msgstr "掃描帶文件數上限（2 萬）與時間預算（20 秒），達上限會標註「非全量」，避免拖慢機器。"

msgid "归档命令指引（tar / 7z，只给命令不代劳）"
msgstr "歸檔命令指引（tar / 7z，只給命令不代勞）"

msgid "给出常见归档场景的命令文本与选型建议：兼容性优先用 tar，压缩率优先用 7z。本任务只输出指引，绝不自动执行任何压缩动作。"
msgstr "給出常見歸檔場景的命令文本與選型建議：兼容性優先用 tar，壓縮率優先用 7z。本任務只輸出指引，絕不自動執行任何壓縮動作。"

msgid "指引类任务：只打印命令文本，不自动执行——是否归档、归档哪些，由你决定。"
msgstr "指引類任務：只打印命令文本，不自動執行——是否歸檔、歸檔哪些，由你決定。"

msgid "压缩大目录会占用 CPU 与 IO；高压缩级别（-mx=9 / -19）耗时会明显变长。"
msgstr "壓縮大目錄會佔用 CPU 與 IO；高壓縮級別（-mx=9 / -19）耗時會明顯變長。"

msgid "选型：要「谁都能解开」用 tar.gz；要「压到最小」用 7z -mx=9；要「压得快又不太差」用 zstd（-19 兼顾，压缩/解压都远快于 LZMA）。"
msgstr "選型：要「誰都能解開」用 tar.gz；要「壓到最小」用 7z -mx=9；要「壓得快又不太差」用 zstd（-19 兼顧，壓縮/解壓都遠快於 LZMA）。"

msgid "已经压过的（zip/7z/rar/mp4/png/pdf/office）别再压一遍：收益接近 0，纯浪费 CPU 与时间。"
msgstr "已經壓過的（zip/7z/rar/mp4/png/pdf/office）別再壓一遍：收益接近 0，純浪費 CPU 與時間。"

msgid "归档前确认目标目录不再变动；归档后**先校验再删原件**（如 tar -tf 列一遍、7z t 测试）。"
msgstr "歸檔前確認目標目錄不再變動；歸檔後**先校驗再刪原件**（如 tar -tf 列一遍、7z t 測試）。"

msgid "清理 GNOME 私有缓存"
msgstr "清理 GNOME 私有緩存"

msgid "清理 GNOME 软件中心 / gdm / dconf 等私有缓存（~/.cache 下），回收空间。"
msgstr "清理 GNOME 軟件中心 / gdm / dconf 等私有緩存（~/.cache 下），回收空間。"

msgid "仅删 ~/.cache 下内容；切勿删除 ~/.config（含全部 GNOME 设置）。"
msgstr "僅刪 ~/.cache 下內容；切勿刪除 ~/.config（含全部 GNOME 設置）。"

msgid "参考 GNOME dconf 文档：缓存位于 ~/.cache，删除不影响设置（设置存于 ~/.config/dconf/user）。"
msgstr "參考 GNOME dconf 文檔：緩存位於 ~/.cache，刪除不影響設置（設置存於 ~/.config/dconf/user）。"

msgid "下次启动对应组件会重建缓存。"
msgstr "下次啓動對應組件會重建緩存。"

msgid "清理 KDE Plasma 私有缓存"
msgstr "清理 KDE Plasma 私有緩存"

msgid "清理 KDE plasmashell / krunner / ksycoca 等私有缓存（~/.cache 下）。"
msgstr "清理 KDE plasmashell / krunner / ksycoca 等私有緩存（~/.cache 下）。"

msgid "仅删 ~/.cache 下内容；删除 ~/.config 的 .rc 会丢失 KDE 应用设置。"
msgstr "僅刪 ~/.cache 下內容；刪除 ~/.config 的 .rc 會丟失 KDE 應用設置。"

msgid "参考 KDE KConfig 文档：缓存位于 ~/.cache；设置存于 ~/.config/*.rc（勿删）。"
msgstr "參考 KDE KConfig 文檔：緩存位於 ~/.cache；設置存於 ~/.config/*.rc（勿刪）。"

msgid "清理后可 `kbuildsycoca5` 重建服务/菜单缓存。"
msgstr "清理後可 `kbuildsycoca5` 重建服務/菜單緩存。"

msgid "清理 XFCE 私有缓存"
msgstr "清理 XFCE 私有緩存"

msgid "清理 XFCE Thunar / xfce4 等私有缓存（~/.cache 下），轻量桌面清理收益直接。"
msgstr "清理 XFCE Thunar / xfce4 等私有緩存（~/.cache 下），輕量桌面清理收益直接。"

msgid "仅删 ~/.cache 下内容；xfconf 配置存于 ~/.config/xfce4，误删会丢失面板/窗口设置。"
msgstr "僅刪 ~/.cache 下內容；xfconf 配置存於 ~/.config/xfce4，誤刪會丟失面板/窗口設置。"

msgid "参考 XFCE xfconf 文档：缓存与配置散落 ~/.cache 与 ~/.config/xfce4；设置走 xfconf。"
msgstr "參考 XFCE xfconf 文檔：緩存與配置散落 ~/.cache 與 ~/.config/xfce4；設置走 xfconf。"

msgid "清理最近文档记录（隐私）"
msgstr "清理最近文檔記錄（隱私）"

msgid "删除最近文档列表（~/.local/share/recently-used.xbel），去除使用痕迹。"
msgstr "刪除最近文檔列表（~/.local/share/recently-used.xbel），去除使用痕跡。"

msgid "删除后文件管理器/应用的「最近」列表清空，属隐私清理，非删除真实文件。"
msgstr "刪除後文件管理器/應用的「最近」列表清空，屬隱私清理，非刪除真實文件。"

msgid "参考 freedesktop.org 规范：recently-used.xbel 跨桌面共享最近文档，删除即去痕迹，不影响文件本身。"
msgstr "參考 freedesktop.org 規範：recently-used.xbel 跨桌面共享最近文檔，刪除即去痕跡，不影響文件本身。"

msgid "清理失效的桌面启动项"
msgstr "清理失效的桌面啓動項"

msgid "检查 ~/.local/share/applications 下 .desktop 启动项是否指向已缺失的可执行文件。"
msgstr "檢查 ~/.local/share/applications 下 .desktop 啓動項是否指向已缺失的可執行文件。"

msgid "本任务不直接删除 .desktop；确认失效后再手动移除对应文件。"
msgstr "本任務不直接刪除 .desktop；確認失效後再手動移除對應文件。"

msgid "参考桌面项规范：.desktop 的 Exec= 指向程序；程序已卸载则该启动项失效。本任务仅列出，删除需手动确认。"
msgstr "參考桌面項規範：.desktop 的 Exec= 指向程序；程序已卸載則該啓動項失效。本任務僅列出，刪除需手動確認。"

msgid "重置 GNOME 用户设置（dconf）"
msgstr "重置 GNOME 用戶設置（dconf）"

msgid "将 GNOME dconf 用户键清空回到默认（可选：全清或仅某 Schema）。高影响，需确认。"
msgstr "將 GNOME dconf 用戶鍵清空回到默認（可選：全清或僅某 Schema）。高影響，需確認。"

msgid "高危：会清空全部 GNOME 个性化设置（壁纸/字体/快捷键/扩展），执行前务必确认；建议先备份 dconf dump。"
msgstr "高危：會清空全部 GNOME 個性化設置（壁紙/字體/快捷鍵/擴展），執行前務必確認；建議先備份 dconf dump。"

msgid "参考 GNOME dconf 文档：dconf 以二进制库 ~/.config/dconf/user 存设置；reset -f / 清空全部用户键。"
msgstr "參考 GNOME dconf 文檔：dconf 以二進制庫 ~/.config/dconf/user 存設置；reset -f / 清空全部用戶鍵。"

msgid "仅影响当前用户，不影响系统级默认值。"
msgstr "僅影響當前用戶，不影響系統級默認值。"

msgid "重建 KDE 服务/菜单缓存"
msgstr "重建 KDE 服務/菜單緩存"

msgid "用 kbuildsycoca5 重建 KDE 服务(Sycoca)缓存，修复菜单/关联异常（只读重建，不改设置）。"
msgstr "用 kbuildsycoca5 重建 KDE 服務(Sycoca)緩存，修復菜單/關聯異常（只讀重建，不改設置）。"

msgid "无 KDE 环境时自动跳过——不强求安装。"
msgstr "無 KDE 環境時自動跳過——不強求安裝。"

msgid "参考 KDE KConfig 文档：Sycoca 缓存影响菜单/文件关联；重建不改变用户设置，仅刷新索引。"
msgstr "參考 KDE KConfig 文檔：Sycoca 緩存影響菜單/文件關聯；重建不改變用戶設置，僅刷新索引。"

msgid "XFCE 配置核对（xfconf）"
msgstr "XFCE 配置覈對（xfconf）"

msgid "用 xfconf-query 列出 XFCE 配置通道，供维护前确认窗口管理器/面板设置。"
msgstr "用 xfconf-query 列出 XFCE 配置通道，供維護前確認窗口管理器/面板設置。"

msgid "无 XFCE 环境或未装 xfconf-query 时自动降级为说明。"
msgstr "無 XFCE 環境或未裝 xfconf-query 時自動降級爲說明。"

msgid "参考 XFCE xfconf 文档：xfconf 以通道/属性模型存设置；`xfconf-query -c xfwm4 -l` 可看窗口管理器键。"
msgstr "參考 XFCE xfconf 文檔：xfconf 以通道/屬性模型存設置；`xfconf-query -c xfwm4 -l` 可看窗口管理器鍵。"

msgid "桌面主题/字体规范核对（freedesktop）"
msgstr "桌面主題/字體規範覈對（freedesktop）"

msgid "按 freedesktop 图标主题规范与 GNOME/KDE HIG 核对当前主题/字体设置是否规范一致。"
msgstr "按 freedesktop 圖標主題規範與 GNOME/KDE HIG 覈對當前主題/字體設置是否規範一致。"

msgid "仅核对/读取设置，不改主题；修改主题请走桌面环境自身设置界面。"
msgstr "僅覈對/讀取設置，不改主題；修改主題請走桌面環境自身設置界面。"

msgid "参考 freedesktop 图标主题规范：主题须含 index.theme 并在 XDG_DATA_DIRS 下；不一致会导致图标缺失。"
msgstr "參考 freedesktop 圖標主題規範：主題須含 index.theme 並在 XDG_DATA_DIRS 下；不一致會導致圖標缺失。"

msgid "桌面缓存可回收量只读核对（对比报告）"
msgstr "桌面緩存可回收量只讀覈對（對比報告）"

msgid "估算 GNOME/KDE/XFCE 私有缓存与 XDG 通用缓存（缩略图/着色器/mozilla 等）的可回收空间，生成清理前对比报告。只读，不删除任何文件。"
msgstr "估算 GNOME/KDE/XFCE 私有緩存與 XDG 通用緩存（縮略圖/着色器/mozilla 等）的可回收空間，生成清理前對比報告。只讀，不刪除任何文件。"

msgid "纯只读：绝不删除文件，也不修改任何设置；报告仅用于清理前决策。"
msgstr "純只讀：絕不刪除文件，也不修改任何設置；報告僅用於清理前決策。"

msgid "参考 XDG 缓存规范：~/.cache 下为可重建临时数据；本任务只估算可回收量并生成对比报告，真正回收请执行 desktop_gnome_cache / desktop_kde_cache / desktop_xfce_cache（需 --apply）。"
msgstr "參考 XDG 緩存規範：~/.cache 下爲可重建臨時數據；本任務只估算可回收量並生成對比報告，真正回收請執行 desktop_gnome_cache / desktop_kde_cache / desktop_xfce_cache（需 --apply）。"

msgid "配合 `desktop --report <path>` 可导出 Markdown/JSON 对比报告。"
msgstr "配合 `desktop --report <path>` 可導出 Markdown/JSON 對比報告。"

msgid "回收 systemd 日志（journalctl --vacuum）"
msgstr "回收 systemd 日誌（journalctl --vacuum）"

msgid "用 journalctl --vacuum-time 按官方接口回收 systemd journal 日志，避免直接删 /var/log/journal。"
msgstr "用 journalctl --vacuum-time 按官方接口回收 systemd journal 日誌，避免直接刪 /var/log/journal。"

msgid "会删除 7 天前的日志（审计/排障记录），确认无需保留再执行；如需留档请先 journalctl -o export 导出。"
msgstr "會刪除 7 天前的日誌（審計/排障記錄），確認無需保留再執行；如需留檔請先 journalctl -o export 導出。"

msgid "参考 systemd-journald.service(8)：journal 以二进制字段化存储，回收须走 journalctl --vacuum-size/--vacuum-time，直接删文件会破坏索引与轮转状态。"
msgstr "參考 systemd-journald.service(8)：journal 以二進制字段化存儲，回收須走 journalctl --vacuum-size/--vacuum-time，直接刪文件會破壞索引與輪轉狀態。"

msgid "持久化需 /var/log/journal 存在（Storage=persistent）；否则日志仅在内存 /run/log/journal。"
msgstr "持久化需 /var/log/journal 存在（Storage=persistent）；否則日誌僅在內存 /run/log/journal。"

msgid "启动耗时分析（systemd-analyze blame / critical-chain）"
msgstr "啓動耗時分析（systemd-analyze blame / critical-chain）"

msgid "用 systemd-analyze 找出启动最慢的单元与关键链，为开机优化提供官方依据。"
msgstr "用 systemd-analyze 找出啓動最慢的單元與關鍵鏈，爲開機優化提供官方依據。"

msgid "禁用系统关键单元（如 dbus / systemd-udevd）会导致系统不可用；仅对明确可省的第三方服务操作。"
msgstr "禁用系統關鍵單元（如 dbus / systemd-udevd）會導致系統不可用；僅對明確可省的第三方服務操作。"

msgid "参考 systemd-analyze(1)：blame 按单元耗时降序，critical-chain 显示启动关键路径；两者都是只读分析，不改任何单元。"
msgstr "參考 systemd-analyze(1)：blame 按單元耗時降序，critical-chain 顯示啓動關鍵路徑；兩者都是隻讀分析，不改任何單元。"

msgid "定位到慢单元后可 `systemctl disable <unit>` 或 `systemctl mask <unit>`（需确认影响）。"
msgstr "定位到慢單元后可 `systemctl disable <unit>` 或 `systemctl mask <unit>`（需確認影響）。"

msgid "失败单元核对（systemctl --failed）"
msgstr "失敗單元覈對（systemctl --failed）"

msgid "列出启动失败的 systemd 单元，便于定位反复重启/退化的服务。"
msgstr "列出啓動失敗的 systemd 單元，便於定位反覆重啓/退化的服務。"

msgid "仅读取状态，不重启/不重置失败单元（重置需 systemctl reset-failed，本任务不执行）。"
msgstr "僅讀取狀態，不重啓/不重置失敗單元（重置需 systemctl reset-failed，本任務不執行）。"

msgid "参考 systemctl(1)：--failed 仅列出进入 failed 状态的单元（不修改任何东西）；配合 `systemctl status <unit>` 看具体错误。"
msgstr "參考 systemctl(1)：--failed 僅列出進入 failed 狀態的單元（不修改任何東西）；配合 `systemctl status <unit>` 看具體錯誤。"

msgid "单元状态经 org.freedesktop.systemd1 的 Unit 对象暴露，程序化核对同理。"
msgstr "單元狀態經 org.freedesktop.systemd1 的 Unit 對象暴露，程序化覈對同理。"

msgid "D-Bus 总线服务自省（busctl，按 D-Bus 规范）"
msgstr "D-Bus 總線服務自省（busctl，按 D-Bus 規範）"

msgid "按 D-Bus Specification 列出系统总线的服务名，核对哪些服务在总线上注册。"
msgstr "按 D-Bus Specification 列出系統總線的服務名，覈對哪些服務在總線上註冊。"

msgid "D-Bus 只做进程间通信，不产生可清理的垃圾；本任务仅核对，不调用任何变更方法。"
msgstr "D-Bus 只做進程間通信，不產生可清理的垃圾；本任務僅覈對，不調用任何變更方法。"

msgid "参考 D-Bus Specification：服务以「总线名 + 对象路径 + 接口」三元组寻址；busctl list 即按规范枚举总线名。"
msgstr "參考 D-Bus Specification：服務以「總線名 + 對象路徑 + 接口」三元組尋址；busctl list 即按規範枚舉總線名。"

msgid "自省某服务: `busctl introspect <name> <path>`；会话总线用 `busctl --user list`。"
msgstr "自省某服務: `busctl introspect <name> <path>`；會話總線用 `busctl --user list`。"

msgid "NetworkManager 连接与状态核对（nmcli）"
msgstr "NetworkManager 連接與狀態覈對（nmcli）"

msgid "用 nmcli 核对 NetworkManager 全局状态与活动连接，确认网络由 NM 官方接口管理。"
msgstr "用 nmcli 覈對 NetworkManager 全局狀態與活動連接，確認網絡由 NM 官方接口管理。"

msgid "仅只读核对，不改连接/DNS；改 DNS 后端请改 NetworkManager.conf 的 [main].dns，勿手改 /etc/resolv.conf。"
msgstr "僅只讀覈對，不改連接/DNS；改 DNS 後端請改 NetworkManager.conf 的 [main].dns，勿手改 /etc/resolv.conf。"

msgid "参考 nmcli(1) 与 org.freedesktop.NetworkManager：nmcli 是官方 CLI，其每一项都映射到 D-Bus 属性，故核对结果与程序化查询一致。"
msgstr "參考 nmcli(1) 與 org.freedesktop.NetworkManager：nmcli 是官方 CLI，其每一項都映射到 D-Bus 屬性，故覈對結果與程序化查詢一致。"

msgid "连接配置以 keyfile 存于 /etc/NetworkManager/system-connections（格式见 nm-settings(5)）。"
msgstr "連接配置以 keyfile 存於 /etc/NetworkManager/system-connections（格式見 nm-settings(5)）。"

msgid "PipeWire 音视频节点图核对（pw-cli）"
msgstr "PipeWire 音視頻節點圖覈對（pw-cli）"

msgid "按 PipeWire 协议列出节点图，核对音频/视频链路与采样率，定位无声/卡顿根因。"
msgstr "按 PipeWire 協議列出節點圖，覈對音頻/視頻鏈路與採樣率，定位無聲/卡頓根因。"

msgid "仅读取节点图，不重载守护进程、不改默认设备（设默认设备需 pw-metadata，属用户选择）。"
msgstr "僅讀取節點圖，不重載守護進程、不改默認設備（設默認設備需 pw-metadata，屬用戶選擇）。"

msgid "参考 docs.pipewire.org：PipeWire 把设备抽象为节点(node)、经端口(port)链接成图；pw-cli ls / pw-top 即按协议展示该图。"
msgstr "參考 docs.pipewire.org：PipeWire 把設備抽象爲節點(node)、經端口(port)鏈接成圖；pw-cli ls / pw-top 即按協議展示該圖。"

msgid "采样率/量子缓冲在 pipewire.conf 或 wireplumber 策略中调整；未装 pw-cli 时降级为套接字探测。"
msgstr "採樣率/量子緩衝在 pipewire.conf 或 wireplumber 策略中調整；未裝 pw-cli 時降級爲套接字探測。"

msgid "蓝牙适配器与配对设备核对（BlueZ）"
msgstr "藍牙適配器與配對設備覈對（BlueZ）"

msgid "按 org.bluez 列出蓝牙适配器与已配对设备，便于停用无用蓝牙省电或排查连接问题。"
msgstr "按 org.bluez 列出藍牙適配器與已配對設備，便於停用無用藍牙省電或排查連接問題。"

msgid "仅读取设备列表；清 /var/lib/bluetooth 会丢失全部配对密钥，本任务绝不执行。"
msgstr "僅讀取設備列表；清 /var/lib/bluetooth 會丟失全部配對密鑰，本任務絕不執行。"

msgid "参考 bluetoothd(8)：BlueZ 经 org.bluez 暴露 Adapter1/Device1；bluetoothctl 是官方 CLI。"
msgstr "參考 bluetoothd(8)：BlueZ 經 org.bluez 暴露 Adapter1/Device1；bluetoothctl 是官方 CLI。"

msgid "不需要蓝牙时可 `systemctl stop/disable bluetooth.service` 省电（走 systemd 单元管理）。"
msgstr "不需要藍牙時可 `systemctl stop/disable bluetooth.service` 省電（走 systemd 單元管理）。"

msgid "udev 自定义规则核对（udevadm）"
msgstr "udev 自定義規則覈對（udevadm）"

msgid "核对 /etc/udev/rules.d 下的自定义规则数量，并按 udev(7) 提示只读调试接口。"
msgstr "覈對 /etc/udev/rules.d 下的自定義規則數量，並按 udev(7) 提示只讀調試接口。"

msgid "仅统计与提示，不修改/不重载规则；误写规则会导致网卡重命名或设备无权限，改前先备份。"
msgstr "僅統計與提示，不修改/不重載規則；誤寫規則會導致網卡重命名或設備無權限，改前先備份。"

msgid "参考 udev(7)：规则以匹配键(MATCH)筛选设备、赋值键(ASSIGN)命名/设权限；udevadm info 可只读查看设备属性。"
msgstr "參考 udev(7)：規則以匹配鍵(MATCH)篩選設備、賦值鍵(ASSIGN)命名/設權限；udevadm info 可只讀查看設備屬性。"

msgid "新增/修改规则后需 `udevadm control --reload && udevadm trigger` 生效。"
msgstr "新增/修改規則後需 `udevadm control --reload && udevadm trigger` 生效。"

msgid "polkit 授权 action 审计（pkaction）"
msgstr "polkit 授權 action 審計（pkaction）"

msgid "列出已注册的 polkit action 与默认授权，核对是否存在过度宽松的提权策略。"
msgstr "列出已註冊的 polkit action 與默認授權，覈對是否存在過度寬鬆的提權策略。"

msgid "仅审计不改策略；收紧授权请新增 /etc/polkit-1/rules.d/*.rules，勿改发行版自带 .policy（升级会被覆盖）。"
msgstr "僅審計不改策略；收緊授權請新增 /etc/polkit-1/rules.d/*.rules，勿改發行版自帶 .policy（升級會被覆蓋）。"

msgid "参考 polkit(8)：action 由服务注册于 /usr/share/polkit-1/actions/*.policy，管理员可用 /etc/polkit-1/rules.d/*.rules 覆盖判定。"
msgstr "參考 polkit(8)：action 由服務註冊於 /usr/share/polkit-1/actions/*.policy，管理員可用 /etc/polkit-1/rules.d/*.rules 覆蓋判定。"

msgid "判定经 org.freedesktop.PolicyKit1 的 CheckAuthorization 完成，本任务只枚举不调用。"
msgstr "判定經 org.freedesktop.PolicyKit1 的 CheckAuthorization 完成，本任務只枚舉不調用。"

msgid "Wayland 会话与合成器协议核对"
msgstr "Wayland 會話與合成器協議覈對"

msgid "判定当前是否为 Wayland 会话，并按 wayland.xml / xdg-shell 提示核对合成器支持的协议。"
msgstr "判定當前是否爲 Wayland 會話，並按 wayland.xml / xdg-shell 提示覈對合成器支持的協議。"

msgid "仅读取环境变量与协议列表，不改显示会话；缺失扩展协议属合成器支持范围，非配置问题。"
msgstr "僅讀取環境變量與協議列表，不改顯示會話；缺失擴展協議屬合成器支持範圍，非配置問題。"

msgid "参考 Wayland 协议规范：核心协议 wayland.xml 定义 surface/seat 等全局接口，窗口行为由 xdg-shell 等扩展协议标准化。"
msgstr "參考 Wayland 協議規範：核心協議 wayland.xml 定義 surface/seat 等全局接口，窗口行爲由 xdg-shell 等擴展協議標準化。"

msgid "`wayland-info` 可列出合成器实际支持的全部全局接口（需安装）；X11 应用经 XWayland 兼容。"
msgstr "`wayland-info` 可列出合成器實際支持的全部全局接口（需安裝）；X11 應用經 XWayland 兼容。"

msgid "鸿蒙设备连接核对（hdc list targets）"
msgstr "鴻蒙設備連接覈對（hdc list targets）"

msgid "用 hdc 官方接口核对已连接的鸿蒙设备，作为后续设备侧操作的前提。"
msgstr "用 hdc 官方接口覈對已連接的鴻蒙設備，作爲後續設備側操作的前提。"

msgid "仅读取设备列表，不安装/不卸载应用；未装 hdc 时自动降级为指引。"
msgstr "僅讀取設備列表，不安裝/不卸載應用；未裝 hdc 時自動降級爲指引。"

msgid "参考 hdc（HarmonyOS Device Connector）文档：hdc 为 client-server-daemon 三端架构，支持 Windows/Linux/macOS。"
msgstr "參考 hdc（HarmonyOS Device Connector）文檔：hdc 爲 client-server-daemon 三端架構，支持 Windows/Linux/macOS。"

msgid "hdc 与 adb 命令不通用（adb devices → hdc list targets），勿混用两套工具。"
msgstr "hdc 與 adb 命令不通用（adb devices → hdc list targets），勿混用兩套工具。"

msgid "鸿蒙设备信息核对（型号 / 版本 / 存储）"
msgstr "鴻蒙設備信息覈對（型號 / 版本 / 存儲）"

msgid "经 hdc 官方接口读取设备型号、系统/API 版本与 /data 存储占用，作为优化前基线。"
msgstr "經 hdc 官方接口讀取設備型號、系統/API 版本與 /data 存儲佔用，作爲優化前基線。"

msgid "仅读取，不改任何设备参数；无设备或未装 hdc 时降级为指引。"
msgstr "僅讀取，不改任何設備參數；無設備或未裝 hdc 時降級爲指引。"

msgid "参考 hdc 文档：设备侧参数经 `hdc shell param get <name>` 只读查询；型号 const.product.model、API 版本 const.ohos.apiversion。"
msgstr "參考 hdc 文檔：設備側參數經 `hdc shell param get <name>` 只讀查詢；型號 const.product.model、API 版本 const.ohos.apiversion。"

msgid "存储占用用 `hdc shell df -h /data`；与 Android 的 getprop 不同，勿混用。"
msgstr "存儲佔用用 `hdc shell df -h /data`；與 Android 的 getprop 不同，勿混用。"

msgid "鸿蒙已安装应用核对（bm dump -a）"
msgstr "鴻蒙已安裝應用覈對（bm dump -a）"

msgid "用 Bundle Manager 列出设备已安装应用，便于核对冗余应用与空间占用。"
msgstr "用 Bundle Manager 列出設備已安裝應用，便於覈對冗餘應用與空間佔用。"

msgid "仅只读列出；部分系统版本需授权否则 bm dump 无返回，此时降级为指引。"
msgstr "僅只讀列出；部分系統版本需授權否則 bm dump 無返回，此時降級爲指引。"

msgid "参考应用包文档：鸿蒙以 Bundle Manager（bm）管理已安装 HAP；`bm dump -a` 可列出全部 bundleName。"
msgstr "參考應用包文檔：鴻蒙以 Bundle Manager（bm）管理已安裝 HAP；`bm dump -a` 可列出全部 bundleName。"

msgid "列出的应用仅供核对，卸载需走 `bm uninstall` 或系统设置（本任务不执行）。"
msgstr "列出的應用僅供覈對，卸載需走 `bm uninstall` 或系統設置（本任務不執行）。"

msgid "HiLog 日志核对（域 / 标签 / 级别）"
msgstr "HiLog 日誌覈對（域 / 標籤 / 級別）"

msgid "按 HiLog 三维协议核对设备日志；只读，且明确不做删除（鸿蒙无官方 vacuum 接口）。"
msgstr "按 HiLog 三維協議覈對設備日誌；只讀，且明確不做刪除（鴻蒙無官方 vacuum 接口）。"

msgid "鸿蒙未提供类似 journalctl --vacuum 的官方回收接口（日志由系统按配额轮转），直接删 /data/log/hilog 会破坏轮转——本任务只读，绝不删除。"
msgstr "鴻蒙未提供類似 journalctl --vacuum 的官方回收接口（日誌由系統按配額輪轉），直接刪 /data/log/hilog 會破壞輪轉——本任務只讀，絕不刪除。"

msgid "参考 HiLog 文档：级别 D/I/W/E/F、域（应用层常用 0xD000）、标签 tag；排障用 `hdc shell hilog -L E`（只看 Error 及以上）或 `-T <tag>` 过滤。"
msgstr "參考 HiLog 文檔：級別 D/I/W/E/F、域（應用層常用 0xD000）、標籤 tag；排障用 `hdc shell hilog -L E`（只看 Error 及以上）或 `-T <tag>` 過濾。"

msgid "设备持久日志为编码后的 gz 二进制，直接解压看不到明文，须用 hilogtool 解析。"
msgstr "設備持久日誌爲編碼後的 gz 二進制，直接解壓看不到明文，須用 hilogtool 解析。"

msgid "Stage 应用模型核对（UIAbility / module.json5）"
msgstr "Stage 應用模型覈對（UIAbility / module.json5）"

msgid "核对鸿蒙工程的 Stage 模型配置（AppScope / module.json5），确认组件声明规范。"
msgstr "覈對鴻蒙工程的 Stage 模型配置（AppScope / module.json5），確認組件聲明規範。"

msgid "仅读取工程配置；勿在 UIAbility 之外自管进程（系统按 Stage 模型统一调度）。"
msgstr "僅讀取工程配置；勿在 UIAbility 之外自管進程（系統按 Stage 模型統一調度）。"

msgid "参考 Stage 模型文档：一个 HAP 对应一个 AbilityStage 进程容器；UIAbility 承载界面、ExtensionAbility 承载无界面扩展，声明于 module.json5。"
msgstr "參考 Stage 模型文檔：一個 HAP 對應一個 AbilityStage 進程容器；UIAbility 承載界面、ExtensionAbility 承載無界面擴展，聲明於 module.json5。"

msgid "组件间经 Want（显式/隐式）调度；生命周期走官方 UIAbility 接口。"
msgstr "組件間經 Want（顯式/隱式）調度；生命週期走官方 UIAbility 接口。"

msgid "系统能力核对（SysCap / canIUse）"
msgstr "系統能力覈對（SysCap / canIUse）"

msgid "核对 SysCap 能力声明，并提示用 canIUse() 做运行期判定，避免低能力设备崩溃。"
msgstr "覈對 SysCap 能力聲明，並提示用 canIUse() 做運行期判定，避免低能力設備崩潰。"

msgid "仅核对声明与提示，不改工程配置；能力声明过宽会导致应用商店分发范围受限。"
msgstr "僅覈對聲明與提示，不改工程配置；能力聲明過寬會導致應用商店分發範圍受限。"

msgid "参考 SystemCapability 文档：构建期在 syscap.json / module.json5 声明依赖能力，运行期用 canIUse() 判定后再调用 @ohos.* API。"
msgstr "參考 SystemCapability 文檔：構建期在 syscap.json / module.json5 聲明依賴能力，運行期用 canIUse() 判定後再調用 @ohos.* API。"

msgid "低能力设备（如穿戴）上缺失能力要能优雅降级，而不是 try/catch 兜底。"
msgstr "低能力設備（如穿戴）上缺失能力要能優雅降級，而不是 try/catch 兜底。"

msgid "应用包与构建产物占用核对（HAP / Hvigor）"
msgstr "應用包與構建產物佔用覈對（HAP / Hvigor）"

msgid "估算鸿蒙工程可重建生成目录（build / .hvigor / oh_modules）的占用，生成清理前依据。"
msgstr "估算鴻蒙工程可重建生成目錄（build / .hvigor / oh_modules）的佔用，生成清理前依據。"

msgid "仅估算占用，不删除任何文件；真正回收请用 harmony_package_cache（需 --apply）。"
msgstr "僅估算佔用，不刪除任何文件；真正回收請用 harmony_package_cache（需 --apply）。"

msgid "参考应用包文档：HAP 为部署单元，HSP/HAR 复用代码；三方库由 ohpm 管理、产物由 Hvigor 构建，生成目录均可重建。"
msgstr "參考應用包文檔：HAP 爲部署單元，HSP/HAR 複用代碼；三方庫由 ohpm 管理、產物由 Hvigor 構建，生成目錄均可重建。"

msgid "清理鸿蒙工程构建产物（可重建生成目录）"
msgstr "清理鴻蒙工程構建產物（可重建生成目錄）"

msgid "清理鸿蒙工程下可重建的生成目录（build/、.hvigor/、.preview/），回收磁盘空间。"
msgstr "清理鴻蒙工程下可重建的生成目錄（build/、.hvigor/、.preview/），回收磁盤空間。"

msgid "切勿删除 AppScope/app.json5、module.json5 与签名文件（p12/cer/p7b）——删了无法打包发布。删除前建议先提交版本库。"
msgstr "切勿刪除 AppScope/app.json5、module.json5 與簽名文件（p12/cer/p7b）——刪了無法打包發佈。刪除前建議先提交版本庫。"

msgid "参考 ohpm / Hvigor 文档：build、.hvigor、.preview 均为构建生成目录，删除后重新构建即可恢复。"
msgstr "參考 ohpm / Hvigor 文檔：build、.hvigor、.preview 均爲構建生成目錄，刪除後重新構建即可恢復。"

msgid "需在鸿蒙工程根目录执行；oh_modules 由 ohpm 管理，本任务保留不删。"
msgstr "需在鴻蒙工程根目錄執行；oh_modules 由 ohpm 管理，本任務保留不刪。"

msgid "IPC/RPC 与分布式软总线核对"
msgstr "IPC/RPC 與分佈式軟總線覈對"

msgid "核对鸿蒙 IPC/RPC（@ohos.rpc）与分布式软总线的能力与前提（设备需先组网认证）。"
msgstr "覈對鴻蒙 IPC/RPC（@ohos.rpc）與分佈式軟總線的能力與前提（設備需先組網認證）。"

msgid "仅核对能力；未装 hdc 或未连设备时降级为指引，不做任何设备侧变更。"
msgstr "僅覈對能力；未裝 hdc 或未連設備時降級爲指引，不做任何設備側變更。"

msgid "参考 @ohos.rpc 文档：MessageSequence / RemoteObject 提供统一 IPC/RPC；跨设备还需 @ohos.distributedDeviceManager 完成发现与认证组网。"
msgstr "參考 @ohos.rpc 文檔：MessageSequence / RemoteObject 提供統一 IPC/RPC；跨設備還需 @ohos.distributedDeviceManager 完成發現與認證組網。"

msgid "分布式调用耗电与延迟高于本地 IPC，非必要不要高频跨设备 RPC。"
msgstr "分佈式調用耗電與延遲高於本地 IPC，非必要不要高頻跨設備 RPC。"

msgid "uni-app 鸿蒙端核对（Harmony Next / vue3）"
msgstr "uni-app 鴻蒙端覈對（Harmony Next / vue3）"

msgid "按 uni-app 鸿蒙文档核对工程：HBuilderX 4.27+ 支持、仅 vue3、条件编译隔离差异。"
msgstr "按 uni-app 鴻蒙文檔覈對工程：HBuilderX 4.27+ 支持、僅 vue3、條件編譯隔離差異。"

msgid "仅核对工程，不改配置/不发起编译；不要假设鸿蒙端 API 与 Android/iOS 端一致，差异请用条件编译隔离。"
msgstr "僅覈對工程，不改配置/不發起編譯；不要假設鴻蒙端 API 與 Android/iOS 端一致，差異請用條件編譯隔離。"

msgid "参考 uni-app 鸿蒙篇（uniapp.dcloud.net.cn/tutorial/harmony/）：自 HBuilderX 4.27 起支持 Harmony Next 平台 App 开发，**仅支持 vue3 项目**，vue2 需先迁移（migration-to-vue3）。"
msgstr "參考 uni-app 鴻蒙篇（uniapp.dcloud.net.cn/tutorial/harmony/）：自 HBuilderX 4.27 起支持 Harmony Next 平臺 App 開發，**僅支持 vue3 項目**，vue2 需先遷移（migration-to-vue3）。"

msgid "调用鸿蒙原生 API 与嵌入原生组件见官方对应章节；uni.* 内置模块在鸿蒙端的支持度以「内置模块说明」为准。"
msgstr "調用鴻蒙原生 API 與嵌入原生組件見官方對應章節；uni.* 內置模塊在鴻蒙端的支持度以「內置模塊說明」爲準。"

msgid "跨端映射核对（uni.* → 各端原生 API）"
msgstr "跨端映射覈對（uni.* → 各端原生 API）"

msgid "核对 manifest 中已启用的小程序端，及各端条件编译覆盖情况，避免运行时猜平台。"
msgstr "覈對 manifest 中已啓用的小程序端，及各端條件編譯覆蓋情況，避免運行時猜平臺。"

msgid "仅核对工程配置与源码宏使用统计，不改任何文件。"
msgstr "僅覈對工程配置與源碼宏使用統計，不改任何文件。"

msgid "参考 uni-app 跨平台文档：uni.* 统一 API 会映射到各端原生 API（uni.request → wx/my/swan/tt/qq/ks.request）。"
msgstr "參考 uni-app 跨平臺文檔：uni.* 統一 API 會映射到各端原生 API（uni.request → wx/my/swan/tt/qq/ks.request）。"

msgid "无法抹平的差异一律用 #ifdef MP-WEIXIN 等条件编译隔离，不要运行时猜平台。"
msgstr "無法抹平的差異一律用 #ifdef MP-WEIXIN 等條件編譯隔離，不要運行時猜平臺。"

msgid "跨端静态检查（直调某端 API 未加条件编译保护）"
msgstr "跨端靜態檢查（直調某端 API 未加條件編譯保護）"

msgid "静态扫描源码，找出直接调用某端原生 API（如 wx.request）却未用该端条件编译（#ifdef MP-WEIXIN）保护的位置——这类代码发行到别的端会直接报错。"
msgstr "靜態掃描源碼，找出直接調用某端原生 API（如 wx.request）卻未用該端條件編譯（#ifdef MP-WEIXIN）保護的位置——這類代碼發行到別的端會直接報錯。"

msgid "纯静态扫描（不执行代码），可能有少量误报/漏报；结果供核对参考，本任务绝不修改任何源码文件。"
msgstr "純靜態掃描（不執行代碼），可能有少量誤報/漏報；結果供覈對參考，本任務絕不修改任何源碼文件。"

msgid "参考 uni-app 跨平台文档：uni.* 统一 API 会映射到各端原生 API，因此业务代码应优先用 uni.request 而非 wx.request。"
msgstr "參考 uni-app 跨平臺文檔：uni.* 統一 API 會映射到各端原生 API，因此業務代碼應優先用 uni.request 而非 wx.request。"

msgid "确需调用某端独有 API 时，必须用该端条件编译包裹（wx.* → #ifdef MP-WEIXIN，my.* → #ifdef MP-ALIPAY，依此类推）。"
msgstr "確需調用某端獨有 API 時，必須用該端條件編譯包裹（wx.* → #ifdef MP-WEIXIN，my.* → #ifdef MP-ALIPAY，依此類推）。"

msgid "微信小程序端核对（wx.* / 双线程）"
msgstr "微信小程序端覈對（wx.* / 雙線程）"

msgid "核对微信端 mp-weixin 配置、产物与条件编译；按 wx.* 规范核对缓存与登录要点。"
msgstr "覈對微信端 mp-weixin 配置、產物與條件編譯；按 wx.* 規範覈對緩存與登錄要點。"

msgid "仅只读核对；微信端需 appid 与服务器域名配置，发行前在 manifest 的 mp-weixin 节点核对。"
msgstr "僅只讀覈對；微信端需 appid 與服務器域名配置，發行前在 manifest 的 mp-weixin 節點核對。"

msgid "参考微信小程序文档：双线程架构（逻辑层 AppService + 视图层 WebView 经 Native 通信）；缓存 wx.getStorage/setStorage 有单 key 与总配额限制。"
msgstr "參考微信小程序文檔：雙線程架構（邏輯層 AppService + 視圖層 WebView 經 Native 通信）；緩存 wx.getStorage/setStorage 有單 key 與總配額限制。"

msgid "登录以 wx.login 换 code 交服务端，勿在前端保存敏感凭据。"
msgstr "登錄以 wx.login 換 code 交服務端，勿在前端保存敏感憑據。"

msgid "支付宝小程序端核对（my.* / 白名单）"
msgstr "支付寶小程序端覈對（my.* / 白名單）"

msgid "核对支付宝端 mp-alipay 配置与产物，按 my.* 规范提醒域名白名单与授权要点。"
msgstr "覈對支付寶端 mp-alipay 配置與產物，按 my.* 規範提醒域名白名單與授權要點。"

msgid "仅只读核对；支付宝端对支付/会员类能力有额外资质要求。"
msgstr "僅只讀覈對；支付寶端對支付/會員類能力有額外資質要求。"

msgid "参考支付宝小程序文档：网络请求域名必须加入白名单，否则真机必失败；授权用 my.getAuthCode 而非自行实现登录态。"
msgstr "參考支付寶小程序文檔：網絡請求域名必須加入白名單，否則真機必失敗；授權用 my.getAuthCode 而非自行實現登錄態。"

msgid "缓存接口（my.getStorage/setStorage）为异步回调风格，注意 success/fail 处理。"
msgstr "緩存接口（my.getStorage/setStorage）爲異步回調風格，注意 success/fail 處理。"

msgid "百度智能小程序端核对（swan.*）"
msgstr "百度智能小程序端覈對（swan.*）"

msgid "核对百度端 mp-baidu 配置与产物，按 swan.* 规范隔离差异。"
msgstr "覈對百度端 mp-baidu 配置與產物，按 swan.* 規範隔離差異。"

msgid "仅只读核对；涉及搜索/AI 能力的接口需按百度开放平台规范申请。"
msgstr "僅只讀覈對；涉及搜索/AI 能力的接口需按百度開放平臺規範申請。"

msgid "参考百度智能小程序文档：能力经 swan.* 暴露（swan.request / swan.getStorage / swan.login）。"
msgstr "參考百度智能小程序文檔：能力經 swan.* 暴露（swan.request / swan.getStorage / swan.login）。"

msgid "百度端偏重搜索与 AI 能力接入；与微信同名不同前缀，勿直接沿用 wx.* 写法。"
msgstr "百度端偏重搜索與 AI 能力接入；與微信同名不同前綴，勿直接沿用 wx.* 寫法。"

msgid "抖音小程序端核对（tt.*）"
msgstr "抖音小程序端覈對（tt.*）"

msgid "核对抖音端 mp-toutiao 配置与产物，按 tt.* 规范隔离差异。"
msgstr "覈對抖音端 mp-toutiao 配置與產物，按 tt.* 規範隔離差異。"

msgid "仅只读核对；内容发布相关接口审核较严，按官方审核规范准备资质。"
msgstr "僅只讀覈對；內容發佈相關接口審覈較嚴，按官方審覈規範準備資質。"

msgid "参考抖音小程序文档：能力经 tt.* 暴露（tt.request / tt.getStorage / tt.login）。"
msgstr "參考抖音小程序文檔：能力經 tt.* 暴露（tt.request / tt.getStorage / tt.login）。"

msgid "注意：抖音端在 uni-app 中的平台节点为 mp-toutiao，条件编译宏为 MP-TOUTIAO。"
msgstr "注意：抖音端在 uni-app 中的平臺節點爲 mp-toutiao，條件編譯宏爲 MP-TOUTIAO。"

msgid "QQ 小程序端核对（qq.*）"
msgstr "QQ 小程序端覈對（qq.*）"

msgid "核对 QQ 端 mp-qq 配置与产物；QQ 端与微信同源度高，但仍需条件编译隔离差异。"
msgstr "覈對 QQ 端 mp-qq 配置與產物；QQ 端與微信同源度高，但仍需條件編譯隔離差異。"

msgid "仅只读核对；勿因同源度高就省掉条件编译。"
msgstr "僅只讀覈對；勿因同源度高就省掉條件編譯。"

msgid "参考 QQ 小程序文档：能力经 qq.* 暴露，架构与微信小程序高度同源。"
msgstr "參考 QQ 小程序文檔：能力經 qq.* 暴露，架構與微信小程序高度同源。"

msgid "差异主要在社交关系链与部分开放能力上，需按 QQ 开放平台规范申请权限。"
msgstr "差異主要在社交關係鏈與部分開放能力上，需按 QQ 開放平臺規範申請權限。"

msgid "快手小程序端核对（ks.*）"
msgstr "快手小程序端覈對（ks.*）"

msgid "核对快手端 mp-kuaishou 配置与产物，按 ks.* 规范隔离差异。"
msgstr "覈對快手端 mp-kuaishou 配置與產物，按 ks.* 規範隔離差異。"

msgid "仅只读核对；勿复用其他端的权限判断逻辑。"
msgstr "僅只讀覈對；勿複用其他端的權限判斷邏輯。"

msgid "参考快手小程序文档：能力经 ks.* 暴露（ks.request / ks.getStorage / ks.login）。"
msgstr "參考快手小程序文檔：能力經 ks.* 暴露（ks.request / ks.getStorage / ks.login）。"

msgid "形态与字节/微信系相近，但自有内容生态与审核规范。"
msgstr "形態與字節/微信系相近，但自有內容生態與審覈規範。"

msgid "清理各小程序端构建产物（可重建）"
msgstr "清理各小程序端構建產物（可重建）"

msgid "清理 unpackage/dist 与 dist 下各 mp-* 端构建产物，回收空间（重新发行即可恢复）。"
msgstr "清理 unpackage/dist 與 dist 下各 mp-* 端構建產物，回收空間（重新發行即可恢復）。"

msgid "切勿删除 src/、manifest.json、pages.json 与 node_modules——前者丢失无法恢复，后者需重新安装。删除前建议先提交版本库。"
msgstr "切勿刪除 src/、manifest.json、pages.json 與 node_modules——前者丟失無法恢復，後者需重新安裝。刪除前建議先提交版本庫。"

msgid "参考 uni-app 发行文档：mp-* 产物由发行操作生成，删除后重新发行即可恢复。"
msgstr "參考 uni-app 發行文檔：mp-* 產物由發行操作生成，刪除後重新發行即可恢復。"

msgid "需在 uni-app 工程根目录执行。"
msgstr "需在 uni-app 工程根目錄執行。"

msgid "清 APT 下载的 .deb 缓存（apt-get clean）"
msgstr "清 APT 下載的 .deb 緩存（apt-get clean）"

msgid "用官方接口清空 /var/cache/apt/archives 下已下载的 .deb——重装时会重新下载，不影响已装包。"
msgstr "用官方接口清空 /var/cache/apt/archives 下已下載的 .deb——重裝時會重新下載，不影響已裝包。"

msgid "清缓存后若处于离线环境，重装同名包将无法从本地缓存取用，需要联网重新下载。"
msgstr "清緩存後若處於離線環境，重裝同名包將無法從本地緩存取用，需要聯網重新下載。"

msgid "参考 apt-get(8)：clean 只清 /var/cache/apt/archives 与 partial 下的 .deb，不影响 /var/lib/dpkg/status 中的已装包记录；autoclean 只清无法再下载到的旧版本。"
msgstr "參考 apt-get(8)：clean 只清 /var/cache/apt/archives 與 partial 下的 .deb，不影響 /var/lib/dpkg/status 中的已裝包記錄；autoclean 只清無法再下載到的舊版本。"

msgid "缓存来自 Packages 索引（RFC822 段落式）解析后的下载，重新 apt-get install 会再次获取。"
msgstr "緩存來自 Packages 索引（RFC822 段落式）解析後的下載，重新 apt-get install 會再次獲取。"

msgid "移除不再被依赖的包（apt-get autoremove）"
msgstr "移除不再被依賴的包（apt-get autoremove）"

msgid "按 APT 的 auto 标记移除「当初作为依赖装进来、现已无人依赖」的包（含旧内核的对应模块包）。"
msgstr "按 APT 的 auto 標記移除「當初作爲依賴裝進來、現已無人依賴」的包（含舊內核的對應模塊包）。"

msgid "会真实删除软件包：若某包是你手动用但被标成 auto，会被一并移除；执行前务必看 dry-run 列表，必要时先 apt-mark manual 固定。"
msgstr "會真實刪除軟件包：若某包是你手動用但被標成 auto，會被一併移除；執行前務必看 dry-run 列表，必要時先 apt-mark manual 固定。"

msgid "参考 apt-mark(8)：包被标记为 auto（自动安装）还是 manual（手动安装）决定了 autoremove 是否移除它；误删可用 `apt-mark manual <pkg>` 提前保住。"
msgstr "參考 apt-mark(8)：包被標記爲 auto（自動安裝）還是 manual（手動安裝）決定了 autoremove 是否移除它；誤刪可用 `apt-mark manual <pkg>` 提前保住。"

msgid "旧内核镜像多由 autoremove 处理（/boot 塞满的典型解法）；保留当前运行内核。"
msgstr "舊內核鏡像多由 autoremove 處理（/boot 塞滿的典型解法）；保留當前運行內核。"

msgid "清 DNF / YUM 仓库缓存（dnf clean all）"
msgstr "清 DNF / YUM 倉庫緩存（dnf clean all）"

msgid "清空 /var/cache/dnf（或 /var/cache/yum）中的仓库元数据与已下载 rpm，官方 clean 接口。"
msgstr "清空 /var/cache/dnf（或 /var/cache/yum）中的倉庫元數據與已下載 rpm，官方 clean 接口。"

msgid "清后首次 dnf 操作需重新下载元数据（约几十 MB，取决于启用仓库数量）；离线环境慎用。"
msgstr "清後首次 dnf 操作需重新下載元數據（約幾十 MB，取決於啓用倉庫數量）；離線環境慎用。"

msgid "参考 dnf(8)：clean all 清的是仓库元数据（repomd.xml / primary.xml 等）与下载的 rpm，不触碰 rpmdb（/usr/lib/sysimage/rpm）中的已装包记录。"
msgstr "參考 dnf(8)：clean all 清的是倉庫元數據（repomd.xml / primary.xml 等）與下載的 rpm，不觸碰 rpmdb（/usr/lib/sysimage/rpm）中的已裝包記錄。"

msgid "长期不想缓存可在 /etc/dnf/dnf.conf 设 keepcache=False（见 dnf.conf(5)）。"
msgstr "長期不想緩存可在 /etc/dnf/dnf.conf 設 keepcache=False（見 dnf.conf(5)）。"

msgid "清 apk 包缓存（apk cache clean）"
msgstr "清 apk 包緩存（apk cache clean）"

msgid "用 Alpine 官方接口清理 /etc/apk/cache（或 /var/cache/apk）下的 .apk 与索引缓存。"
msgstr "用 Alpine 官方接口清理 /etc/apk/cache（或 /var/cache/apk）下的 .apk 與索引緩存。"

msgid "清缓存后离线重装同名包需重新下载；容器构建层内清理才真正减小镜像体积。"
msgstr "清緩存後離線重裝同名包需重新下載；容器構建層內清理才真正減小鏡像體積。"

msgid "参考 apk(8)：cache clean 清的是索引（APKINDEX.tar.gz）与已下载 .apk，不动 /lib/apk/db/installed 中的已装包记录。"
msgstr "參考 apk(8)：cache clean 清的是索引（APKINDEX.tar.gz）與已下載 .apk，不動 /lib/apk/db/installed 中的已裝包記錄。"

msgid "构建镜像时用 `apk add --no-cache` 可让缓存不落盘，是 Alpine 镜像瘦身的标准做法。"
msgstr "構建鏡像時用 `apk add --no-cache` 可讓緩存不落盤，是 Alpine 鏡像瘦身的標準做法。"

msgid "按保留版本清理 pacman 缓存（paccache -rk2）"
msgstr "按保留版本清理 pacman 緩存（paccache -rk2）"

msgid "用 pacman-contrib 的 paccache 保留最近 2 个版本、清理更旧的包缓存，优于 -Scc 全清。"
msgstr "用 pacman-contrib 的 paccache 保留最近 2 個版本、清理更舊的包緩存，優於 -Scc 全清。"

msgid "若确实要腾出全部空间可用 pacman -Scc，但之后无法离线降级到旧版本；本任务默认只保留 2 版。"
msgstr "若確實要騰出全部空間可用 pacman -Scc，但之後無法離線降級到舊版本；本任務默認只保留 2 版。"

msgid "参考 paccache(8)：-r 清理已安装包的旧版本缓存，-k2 表示每个包保留最近 2 个版本，比 `pacman -Scc`（清空全部缓存）稳健——留着旧版才能离线降级。"
msgstr "參考 paccache(8)：-r 清理已安裝包的舊版本緩存，-k2 表示每個包保留最近 2 個版本，比 `pacman -Scc`（清空全部緩存）穩健——留着舊版才能離線降級。"

msgid "pacman 包为 .pkg.tar.zst（zstd 压缩 tar，含 .PKGINFO），缓存目录 /var/cache/pacman/pkg。"
msgstr "pacman 包爲 .pkg.tar.zst（zstd 壓縮 tar，含 .PKGINFO），緩存目錄 /var/cache/pacman/pkg。"

msgid "清 Homebrew 下载缓存（brew cleanup）"
msgstr "清 Homebrew 下載緩存（brew cleanup）"

msgid "按 Homebrew 保留策略回收 formula/cask 的旧版本下载缓存，默认不动已装包的当前版本。"
msgstr "按 Homebrew 保留策略回收 formula/cask 的舊版本下載緩存，默認不動已裝包的當前版本。"

msgid "`brew cleanup --prune=0` 会清空全部缓存（含未安装包），后续安装需重新下载；本任务只用默认行为，不使用 --prune。"
msgstr "`brew cleanup --prune=0` 會清空全部緩存（含未安裝包），後續安裝需重新下載；本任務只用默認行爲，不使用 --prune。"

msgid "参考 brew(1) Manpage：cleanup 默认删除已安装 formula 的旧版本下载缓存；`--prune=<days>` 连未安装/更旧的缓存一并清，属更激进选项，先用 `-n` 干跑确认。"
msgstr "參考 brew(1) Manpage：cleanup 默認刪除已安裝 formula 的舊版本下載緩存；`--prune=<days>` 連未安裝/更舊的緩存一併清，屬更激進選項，先用 `-n` 幹跑確認。"

msgid "Formula/Cask 用 Ruby DSL 声明（url / sha256 / depends_on），预编译产物是 bottle。"
msgstr "Formula/Cask 用 Ruby DSL 聲明（url / sha256 / depends_on），預編譯產物是 bottle。"

msgid "清 winget 下载缓存（%LOCALAPPDATA%\\Temp\\WinGet）"
msgstr "清 winget 下載緩存（%LOCALAPPDATA%\\Temp\\WinGet）"

msgid "删除 Windows Package Manager 的临时下载缓存；winget 再次安装时会重新下载。"
msgstr "刪除 Windows Package Manager 的臨時下載緩存；winget 再次安裝時會重新下載。"

msgid "不要手动删除或改动 WinGet\\Packages 下的安装目录（卸载应走 winget uninstall，否则注册表 UninstallString 与实际文件不一致）。"
msgstr "不要手動刪除或改動 WinGet\\Packages 下的安裝目錄（卸載應走 winget uninstall，否則註冊表 UninstallString 與實際文件不一致）。"

msgid "参考 WinGet 文档：下载缓存落在 %LOCALAPPDATA%\\Temp\\WinGet，属临时目录，删除后重新安装会再次拉取，不影响 %LOCALAPPDATA%\\Microsoft\\WinGet\\Packages 下已装内容。"
msgstr "參考 WinGet 文檔：下載緩存落在 %LOCALAPPDATA%\\Temp\\WinGet，屬臨時目錄，刪除後重新安裝會再次拉取，不影響 %LOCALAPPDATA%\\Microsoft\\WinGet\\Packages 下已裝內容。"

msgid "winget 以 YAML 清单（version / installer / locale，schema v1.x）描述包，源为 REST 接口。"
msgstr "winget 以 YAML 清單（version / installer / locale，schema v1.x）描述包，源爲 REST 接口。"

msgid "清 pip 下载缓存（pip cache purge）"
msgstr "清 pip 下載緩存（pip cache purge）"

msgid "用 PyPA 官方的 pip cache 接口回收 wheel 与 HTTP 响应缓存，不影响任何已安装的包。"
msgstr "用 PyPA 官方的 pip cache 接口回收 wheel 與 HTTP 響應緩存，不影響任何已安裝的包。"

msgid "清缓存后离线安装同名包会失败（需重新下载）；CI 环境建议直接 --no-cache-dir。"
msgstr "清緩存後離線安裝同名包會失敗（需重新下載）；CI 環境建議直接 --no-cache-dir。"

msgid "参考 pip cache 文档：purge 只清缓存目录（Linux ~/.cache/pip、macOS ~/Library/Caches/pip、Windows %LOCALAPPDATA%\\pip\\cache），已装包在 site-packages，完全不受影响。"
msgstr "參考 pip cache 文檔：purge 只清緩存目錄（Linux ~/.cache/pip、macOS ~/Library/Caches/pip、Windows %LOCALAPPDATA%\\pip\\cache），已裝包在 site-packages，完全不受影響。"

msgid "缓存内容按 PEP 427 wheel 与 HTTP 响应分层；想长期不缓存可安装时加 --no-cache-dir。"
msgstr "緩存內容按 PEP 427 wheel 與 HTTP 響應分層；想長期不緩存可安裝時加 --no-cache-dir。"

msgid "校验并回收 npm 缓存（npm cache verify）"
msgstr "校驗並回收 npm 緩存（npm cache verify）"

msgid "按官方推荐用 verify 校验 _cacache 内容寻址缓存，回收损坏与过期条目（非破坏性）。"
msgstr "按官方推薦用 verify 校驗 _cacache 內容尋址緩存，回收損壞與過期條目（非破壞性）。"

msgid "本任务不用 `npm cache clean --force`——那会全清缓存，令后续每次安装都重新下载；verify 只删无效内容。"
msgstr "本任務不用 `npm cache clean --force`——那會全清緩存，令後續每次安裝都重新下載；verify 只刪無效內容。"

msgid "参考 npm-cache 文档：verify 会遍历 _cacache（index-v5 索引 + content-v2 内容，按 sha512 完整性哈希寻址），回收损坏与过期条目并输出统计；官方明确把 `npm cache clean --force` 标注为破坏性操作。"
msgstr "參考 npm-cache 文檔：verify 會遍歷 _cacache（index-v5 索引 + content-v2 內容，按 sha512 完整性哈希尋址），回收損壞與過期條目並輸出統計；官方明確把 `npm cache clean --force` 標註爲破壞性操作。"

msgid "npm 元数据来自 Registry HTTP API 的 JSON packument，lockfileVersion 决定锁定语义。"
msgstr "npm 元數據來自 Registry HTTP API 的 JSON packument，lockfileVersion 決定鎖定語義。"

msgid "清 Flatpak 无引用的 runtime（flatpak uninstall --unused）"
msgstr "清 Flatpak 無引用的 runtime（flatpak uninstall --unused）"

msgid "移除不再被任何应用引用的 Flatpak runtime 与扩展（OSTree 仓库中无 ref 指向者）。"
msgstr "移除不再被任何應用引用的 Flatpak runtime 與擴展（OSTree 倉庫中無 ref 指向者）。"

msgid "若之后要装回依赖该 runtime 的应用，需要重新下载；删应用数据请用 --delete-data（本任务不使用，避免误删用户数据）。"
msgstr "若之後要裝回依賴該 runtime 的應用，需要重新下載；刪應用數據請用 --delete-data（本任務不使用，避免誤刪用戶數據）。"

msgid "参考 flatpak(1) / flatpak-uninstall(1)：--unused 指「没有任何已安装应用引用的runtime / extension」；应用本体不会被动到。"
msgstr "參考 flatpak(1) / flatpak-uninstall(1)：--unused 指「沒有任何已安裝應用引用的runtime / extension」；應用本體不會被動到。"

msgid "Flatpak 用 OSTree 仓库（refs + commit objects）去重共享，删除 runtime 可能释放数百 MB。"
msgstr "Flatpak 用 OSTree 倉庫（refs + commit objects）去重共享，刪除 runtime 可能釋放數百 MB。"

msgid "将 snap 保留版本数降为 2（refresh.retain）"
msgstr "將 snap 保留版本數降爲 2（refresh.retain）"

msgid "设置 snapd 的 refresh.retain=2，减少每个 snap 保留的历史版本（默认 3），只改配置不删包。"
msgstr "設置 snapd 的 refresh.retain=2，減少每個 snap 保留的歷史版本（默認 3），只改配置不刪包。"

msgid "本任务只改配置、不删任何现存版本；存量旧版本需自行确认后按 revision 删除。"
msgstr "本任務只改配置、不刪任何現存版本；存量舊版本需自行確認後按 revision 刪除。"

msgid "参考 snapcraft.io 文档：snapd 默认每个 snap 保留 3 个版本（含当前），refresh.retain 调整的是「刷新时保留的旧版本数」；snapd 经 Unix socket /run/snapd.socket 暴露 /v2/snaps 等 REST 端点。"
msgstr "參考 snapcraft.io 文檔：snapd 默認每個 snap 保留 3 個版本（含當前），refresh.retain 調整的是「刷新時保留的舊版本數」；snapd 經 Unix socket /run/snapd.socket 暴露 /v2/snaps 等 REST 端點。"

msgid "snap 是 squashfs 只读镜像，历史版本常是 /var/lib/snapd 变大的主因。"
msgstr "snap 是 squashfs 只讀鏡像，歷史版本常是 /var/lib/snapd 變大的主因。"

msgid "孤儿/未引用包核对（各包管理器自身接口，只读）"
msgstr "孤兒/未引用包覈對（各包管理器自身接口，只讀）"

msgid "按各发行版自身的查询接口找出孤儿包：pacman -Qdt、dnf repoquery --unneeded、apt-get -s autoremove。"
msgstr "按各發行版自身的查詢接口找出孤兒包：pacman -Qdt、dnf repoquery --unneeded、apt-get -s autoremove。"

msgid "不同发行版结果不可互相套用；删除孤儿包前请逐个确认，尤其是驱动与内核相关包。"
msgstr "不同發行版結果不可互相套用；刪除孤兒包前請逐個確認，尤其是驅動與內核相關包。"

msgid "「孤儿包」的判定完全取决于各包管理器自己的记账：APT 看 auto/manual 标记（apt-mark(8)）、pacman 看是否被依赖（-Qdt）、DNF 看 repoquery --unneeded——不存在统一定义，因此这里逐个按其自身接口核对。"
msgstr "「孤兒包」的判定完全取決於各包管理器自己的記賬：APT 看 auto/manual 標記（apt-mark(8)）、pacman 看是否被依賴（-Qdt）、DNF 看 repoquery --unneeded——不存在統一定義，因此這裏逐個按其自身接口覈對。"

msgid "只读核对，不删除任何包；确认后再用对应发行版的官方删除命令。"
msgstr "只讀覈對，不刪除任何包；確認後再用對應發行版的官方刪除命令。"

msgid "清 Docker 悬空镜像（docker image prune -f）"
msgstr "清 Docker 懸空鏡像（docker image prune -f）"

msgid "删除「无标签且不被任何容器引用」的悬空镜像——典型由构建失败遗留，删了不影响任何运行中的容器。"
msgstr "刪除「無標籤且不被任何容器引用」的懸空鏡像——典型由構建失敗遺留，刪了不影響任何運行中的容器。"

msgid "无数据破坏性（悬空镜像本就不被引用）；离线环境重构建需重新拉取。"
msgstr "無數據破壞性（懸空鏡像本就不被引用）；離線環境重構建需重新拉取。"

msgid "参考 docker image prune：默认只删 dangling（无仓库:标签且未被引用）的镜像；加 -a 才删「无容器引用」的所有未使用镜像。"
msgstr "參考 docker image prune：默認只刪 dangling（無倉庫:標籤且未被引用）的鏡像；加 -a 才刪「無容器引用」的所有未使用鏡像。"

msgid "悬空层按 digest 共享，只删引用计数归零的层，不影响其他镜像。"
msgstr "懸空層按 digest 共享，只刪引用計數歸零的層，不影響其他鏡像。"

msgid "清 Docker 已停止容器（docker container prune -f）"
msgstr "清 Docker 已停止容器（docker container prune -f）"

msgid "删除所有已退出（Exited）状态的容器。容器只读层可重建，但容器内未提交到镜像的改动会丢失。"
msgstr "刪除所有已退出（Exited）狀態的容器。容器只讀層可重建，但容器內未提交到鏡像的改動會丟失。"

msgid "会真实删除容器元数据与可写层：运行 docker rm 前确认其中无未保存改动。"
msgstr "會真實刪除容器元數據與可寫層：運行 docker rm 前確認其中無未保存改動。"

msgid "参考 docker container prune：只针对 status=exited/created 的容器；运行中的容器不受影响。"
msgstr "參考 docker container prune：只針對 status=exited/created 的容器；運行中的容器不受影響。"

msgid "若容器是用作临时调试（未 commit），其中改动随之消失——先 docker commit 再清。"
msgstr "若容器是用作臨時調試（未 commit），其中改動隨之消失——先 docker commit 再清。"

msgid "清 Docker 未用卷（docker volume prune -f）"
msgstr "清 Docker 未用卷（docker volume prune -f）"

msgid "删除没有任何容器（含已停止）引用的卷。卷常存数据库/持久化数据，删了可能永久丢失。"
msgstr "刪除沒有任何容器（含已停止）引用的卷。卷常存數據庫/持久化數據，刪了可能永久丟失。"

msgid "高风险数据丢失：生产数据库卷务必先备份或 `docker run --rm -v <vol> busybox tar` 导出后再清。"
msgstr "高風險數據丟失：生產數據庫卷務必先備份或 `docker run --rm -v <vol> busybox tar` 導出後再清。"

msgid "参考 docker volume prune：默认保留仍被任意容器（哪怕已停止）引用的卷；-f 才删真正孤儿卷。"
msgstr "參考 docker volume prune：默認保留仍被任意容器（哪怕已停止）引用的卷；-f 才刪真正孤兒卷。"

msgid "匿名卷（未命名）最易被清；命名卷请先 docker volume inspect 确认内容。"
msgstr "匿名卷（未命名）最易被清；命名卷請先 docker volume inspect 確認內容。"

msgid "清 Docker BuildKit 构建缓存（docker builder prune -f）"
msgstr "清 Docker BuildKit 構建緩存（docker builder prune -f）"

msgid "回收 /var/lib/docker/buildkit 下内容寻址的构建缓存——随构建次数累积极易膨胀，且不影响已构建镜像。"
msgstr "回收 /var/lib/docker/buildkit 下內容尋址的構建緩存——隨構建次數累積極易膨脹，且不影響已構建鏡像。"

msgid "清后首次构建变慢（需重算缓存）；不影响运行中的容器。"
msgstr "清後首次構建變慢（需重算緩存）；不影響運行中的容器。"

msgid "参考 docker builder prune：缓存按 diffID 内容寻址，清了下次构建重新计算，不影响已 push/pull 的镜像。"
msgstr "參考 docker builder prune：緩存按 diffID 內容尋址，清了下次構建重新計算，不影響已 push/pull 的鏡像。"

msgid "加 -a 清更彻底（含仍可能被引用的中间层）；--filter until=24h 可按时间保留。"
msgstr "加 -a 清更徹底（含仍可能被引用的中間層）；--filter until=24h 可按時間保留。"

msgid "Docker 系统级组合清理（docker system prune -a -f）"
msgstr "Docker 系統級組合清理（docker system prune -a -f）"

msgid "组合清理：悬空镜像 + 已停止容器 + 未用网络 +（加 -a）所有未使用镜像。一举回收但面较大，需谨慎。"
msgstr "組合清理：懸空鏡像 + 已停止容器 + 未用網絡 +（加 -a）所有未使用鏡像。一舉回收但面較大，需謹慎。"

msgid "面最大：会删你本地所有「当前没在跑」的镜像，下次构建/运行需重新拉取。"
msgstr "面最大：會刪你本地所有「當前沒在跑」的鏡像，下次構建/運行需重新拉取。"

msgid "参考 docker system prune：-a 会删所有未容器引用的镜像（不只是悬空），加 --volumes 才连未用卷一起清（默认不删卷，防误删数据）。"
msgstr "參考 docker system prune：-a 會刪所有未容器引用的鏡像（不只是懸空），加 --volumes 才連未用卷一起清（默認不刪卷，防誤刪數據）。"

msgid "比逐项 prune 省事，但 -a 会让你下次拉镜像重新下载——CI 机常用，个人开发机慎用 -a。"
msgstr "比逐項 prune 省事，但 -a 會讓你下次拉鏡像重新下載——CI 機常用，個人開發機慎用 -a。"

msgid "清 Podman 未使用镜像（podman image prune -a -f）"
msgstr "清 Podman 未使用鏡像（podman image prune -a -f）"

msgid "删除无容器引用的镜像（含有标签但未使用的）。Podman 无 daemon，rootless 下清的是用户命名空间存储。"
msgstr "刪除無容器引用的鏡像（含有標籤但未使用的）。Podman 無 daemon，rootless 下清的是用戶命名空間存儲。"

msgid "rootless 时注意用运行容器的同一用户执行，否则权限不匹配会漏清或报错。"
msgstr "rootless 時注意用運行容器的同一用戶執行，否則權限不匹配會漏清或報錯。"

msgid "参考 podman image prune：与 docker 同语义；rootless 模式数据在 ~/.local/share/containers/storage，需用对应用户执行。"
msgstr "參考 podman image prune：與 docker 同語義；rootless 模式數據在 ~/.local/share/containers/storage，需用對應用戶執行。"

msgid "不加 -a 只删悬空；加 -a 删所有无容器引用的镜像。"
msgstr "不加 -a 只刪懸空；加 -a 刪所有無容器引用的鏡像。"

msgid "清 Podman 未用卷（podman volume prune -f）"
msgstr "清 Podman 未用卷（podman volume prune -f）"

msgid "删除无容器引用的 Podman 卷；rootless 下清的是用户命名空间内的卷，数据可能永久丢失。"
msgstr "刪除無容器引用的 Podman 卷；rootless 下清的是用戶命名空間內的卷，數據可能永久丟失。"

msgid "数据丢失风险同 docker volume prune；生产卷先备份。"
msgstr "數據丟失風險同 docker volume prune；生產卷先備份。"

msgid "参考 podman volume prune：只删无容器（含停止）引用的卷；命名卷先 podman volume inspect 确认内容。"
msgstr "參考 podman volume prune：只刪無容器（含停止）引用的卷；命名卷先 podman volume inspect 確認內容。"

msgid "rootless 卷路径在 ~/.local/share/containers/storage/volumes。"
msgstr "rootless 卷路徑在 ~/.local/share/containers/storage/volumes。"

msgid "Podman 系统级组合清理（podman system prune -a -f）"
msgstr "Podman 系統級組合清理（podman system prune -a -f）"

msgid "组合清理：未使用镜像 + 已停止容器 + 未用卷 + 网络。无 daemon 架构，清理与 docker 同语义但命令名不同。"
msgstr "組合清理：未使用鏡像 + 已停止容器 + 未用卷 + 網絡。無 daemon 架構，清理與 docker 同語義但命令名不同。"

msgid "面大：会删本地所有未运行镜像与其卷；CI 常用，个人机慎用 -a/-f。"
msgstr "面大：會刪本地所有未運行鏡像與其卷；CI 常用，個人機慎用 -a/-f。"

msgid "参考 podman system prune：等价于逐项 image/container/volume prune 的组合；rootless 务必用运行容器的同一用户执行。"
msgstr "參考 podman system prune：等價於逐項 image/container/volume prune 的組合；rootless 務必用運行容器的同一用戶執行。"

msgid "Podman 兼容 docker CLI 语义，但 podman.sock 默认也支持 docker API 客户端。"
msgstr "Podman 兼容 docker CLI 語義，但 podman.sock 默認也支持 docker API 客戶端。"

msgid "回收 containerd 孤儿 blob（nerdctl system prune / ctr prune）"
msgstr "回收 containerd 孤兒 blob（nerdctl system prune / ctr prune）"

msgid "containerd 无 docker 那套 system prune；借助 nerdctl 组合回收，或直接对 content store 回收无 lease 引用的孤儿 blob。"
msgstr "containerd 無 docker 那套 system prune；藉助 nerdctl 組合回收，或直接對 content store 回收無 lease 引用的孤兒 blob。"

msgid "直接删 /var/lib/containerd/io.containerd.content.v1.content 下文件会破坏内容寻址，导致镜像 digest 校验失败——务必走 GC 接口。"
msgstr "直接刪 /var/lib/containerd/io.containerd.content.v1.content 下文件會破壞內容尋址，導致鏡像 digest 校驗失敗——務必走 GC 接口。"

msgid "参考 containerd 架构：content store 按 digest 存 blob，snapshotter 管可写层；「孤儿」指不再被任何 lease（镜像/容器引用）指向的 blob。"
msgstr "參考 containerd 架構：content store 按 digest 存 blob，snapshotter 管可寫層；「孤兒」指不再被任何 lease（鏡像/容器引用）指向的 blob。"

msgid "ctr content prune / ctr snapshots prune 只删无 lease 引用的孤儿，比直接 rm 目录安全。"
msgstr "ctr content prune / ctr snapshots prune 只刪無 lease 引用的孤兒，比直接 rm 目錄安全。"

msgid "清 Docker Buildx 缓存（docker buildx prune -a -f）"
msgstr "清 Docker Buildx 緩存（docker buildx prune -a -f）"

msgid "回收 buildx 多驱动（docker-container/kubernetes/remote）下的构建缓存；与 builder prune 同源但覆盖 buildx 专属缓存。"
msgstr "回收 buildx 多驅動（docker-container/kubernetes/remote）下的構建緩存；與 builder prune 同源但覆蓋 buildx 專屬緩存。"

msgid "清后首次 buildx 构建变慢；不影响运行中的容器。"
msgstr "清後首次 buildx 構建變慢；不影響運行中的容器。"

msgid "参考 docker buildx prune：覆盖 buildx 各驱动缓存；--filter until=24h 按时间保留，-a 清更彻底。"
msgstr "參考 docker buildx prune：覆蓋 buildx 各驅動緩存；--filter until=24h 按時間保留，-a 清更徹底。"

msgid "与 docker builder prune 同属 BuildKit，但分属不同缓存命名空间。"
msgstr "與 docker builder prune 同屬 BuildKit，但分屬不同緩存命名空間。"

msgid "回收 LXC/LXD 未使用镜像与孤儿卷"
msgstr "回收 LXC/LXD 未使用鏡像與孤兒卷"

msgid "LXC 是系统容器（每容器独立可写层/存储池卷），不作镜像分层共享；清理须按 LXD 各自存储后端接口，而非删目录。"
msgstr "LXC 是系統容器（每容器獨立可寫層/存儲池卷），不作鏡像分層共享；清理須按 LXD 各自存儲後端接口，而非刪目錄。"

msgid "系统容器可能存有重要状态；删前确认容器/镜像确属废弃，且存储池无需缩容。"
msgstr "系統容器可能存有重要狀態；刪前確認容器/鏡像確屬廢棄，且存儲池無需縮容。"

msgid "参考 LXD 存储：卷是存储池（ZFS/Btrfs/LVM/dir）内对象，删除须走 lxc storage volume rm，直接删 /var/lib/lxd 会破坏池元数据。"
msgstr "參考 LXD 存儲：卷是存儲池（ZFS/Btrfs/LVM/dir）內對象，刪除須走 lxc storage volume rm，直接刪 /var/lib/lxd 會破壞池元數據。"

msgid "停止容器用 lxc delete（默认保留可写层 12 天，可加 --force 立即删）。"
msgstr "停止容器用 lxc delete（默認保留可寫層 12 天，可加 --force 立即刪）。"

msgid "OCI 规范核对（镜像分层与 digest 内容寻址）"
msgstr "OCI 規範覈對（鏡像分層與 digest 內容尋址）"

msgid "只读核对 OCI 工具能力与规范要点：所有运行时镜像分层、digest、diff_id 都遵循 Image Spec，删共享层须看引用计数。"
msgstr "只讀覈對 OCI 工具能力與規範要點：所有運行時鏡像分層、digest、diff_id 都遵循 Image Spec，刪共享層須看引用計數。"

msgid "只读任务：仅核对接口能力，不做任何修改。"
msgstr "只讀任務：僅覈對接口能力，不做任何修改。"

msgid "参考 OCI image-spec：manifest 指向 config 与各 layer，descriptor 用 digest 内容寻址，同一层被多镜像共享。"
msgstr "參考 OCI image-spec：manifest 指向 config 與各 layer，descriptor 用 digest 內容尋址，同一層被多鏡像共享。"

msgid "清理共享层依赖各运行时 GC，不要按文件名手动删层（误删会让其他镜像失效）。"
msgstr "清理共享層依賴各運行時 GC，不要按文件名手動刪層（誤刪會讓其他鏡像失效）。"

msgid "容器运行时磁盘占用总览（各运行时 system df）"
msgstr "容器運行時磁盤佔用總覽（各運行時 system df）"

msgid "只读汇总本机各容器运行时（Docker/Podman/containerd/BuildKit/LXC/CRI）的可用性与磁盘占用，定位空间杀手。"
msgstr "只讀彙總本機各容器運行時（Docker/Podman/containerd/BuildKit/LXC/CRI）的可用性與磁盤佔用，定位空間殺手。"

msgid "只读任务：仅汇总，不修改系统。"
msgstr "只讀任務：僅彙總，不修改系統。"

msgid "各运行时的磁盘占用口径不同：docker/podman system df 四项（镜像/容器/卷/构建缓存），containerd 靠 nerdctl/ctr，LXC 靠 lxc image list。"
msgstr "各運行時的磁盤佔用口徑不同：docker/podman system df 四項（鏡像/容器/卷/構建緩存），containerd 靠 nerdctl/ctr，LXC 靠 lxc image list。"

msgid "定位到具体运行时后，再用对应的 prune 接口回收，而非直接删数据目录。"
msgstr "定位到具體運行時後，再用對應的 prune 接口回收，而非直接刪數據目錄。"

msgid "ext4 挂载点与一致性核对（e2fsck -fn 只读 + e4defrag 建议）"
msgstr "ext4 掛載點與一致性覈對（e2fsck -fn 只讀 + e4defrag 建議）"

msgid "只读列出本机 ext4 挂载点与用量，给出 e2fsck -fn（只读校验，不修复）与 e4defrag（仅 extent 文件）的整理建议。"
msgstr "只讀列出本機 ext4 掛載點與用量，給出 e2fsck -fn（只讀校驗，不修復）與 e4defrag（僅 extent 文件）的整理建議。"

msgid "只读任务：仅核对，不修改系统。"
msgstr "只讀任務：僅覈對，不修改系統。"

msgid "参考 ext4 文档：e2fsck -fn 仅检查不修复（-f 强制，-n 假定 no 不写）；e4defrag 只对 extent 文件有效，目录或已连续文件无意义。"
msgstr "參考 ext4 文檔：e2fsck -fn 僅檢查不修復（-f 強制，-n 假定 no 不寫）；e4defrag 只對 extent 文件有效，目錄或已連續文件無意義。"

msgid "Btrfs 用量与未用 chunk 核对（btrfs filesystem df）"
msgstr "Btrfs 用量與未用 chunk 覈對（btrfs filesystem df）"

msgid "只读列出本机 Btrfs 挂载点的 data/metadata/unallocated 占比，定位未回收 chunk 与旧快照空间杀手。"
msgstr "只讀列出本機 Btrfs 掛載點的 data/metadata/unallocated 佔比，定位未回收 chunk 與舊快照空間殺手。"

msgid "参考 Btrfs 文档：空间杀手是未回收的 chunk（balance）与未清的旧快照/子卷；btrfs filesystem df 看已用占比，unallocated 为可回收空间。"
msgstr "參考 Btrfs 文檔：空間殺手是未回收的 chunk（balance）與未清的舊快照/子卷；btrfs filesystem df 看已用佔比，unallocated 爲可回收空間。"

msgid "XFS 挂载点与碎片率核对（xfs_db -r -c frag 只读）"
msgstr "XFS 掛載點與碎片率覈對（xfs_db -r -c frag 只讀）"

msgid "只读列出本机 XFS 挂载点，用 xfs_db -r -c frag 计算碎片率（-r 只读，禁止写挂载设备）。"
msgstr "只讀列出本機 XFS 掛載點，用 xfs_db -r -c frag 計算碎片率（-r 只讀，禁止寫掛載設備）。"

msgid "参考 XFS 文档：碎片主要来自大量小文件随机写；xfs_db -r -c frag 只读算碎片率，务必带 -r 否则可能写挂载设备。"
msgstr "參考 XFS 文檔：碎片主要來自大量小文件隨機寫；xfs_db -r -c frag 只讀算碎片率，務必帶 -r 否則可能寫掛載設備。"

msgid "ZFS 存储池健康与容量核对（zpool list / zfs list）"
msgstr "ZFS 存儲池健康與容量覈對（zpool list / zfs list）"

msgid "只读列出本机 ZFS 存储池健康/容量与数据集占用，定位快照累积与未释放数据集。"
msgstr "只讀列出本機 ZFS 存儲池健康/容量與數據集佔用，定位快照累積與未釋放數據集。"

msgid "参考 OpenZFS 文档：空间靠快照引用计数管理；zpool list 看健康(cap)，zfs list 看 used/available。"
msgstr "參考 OpenZFS 文檔：空間靠快照引用計數管理；zpool list 看健康(cap)，zfs list 看 used/available。"

msgid "LVM 逻辑卷与精简池占比核对（pvs/vgs/lvs）"
msgstr "LVM 邏輯卷與精簡池佔比覈對（pvs/vgs/lvs）"

msgid "只读列出本机 LVM 逻辑卷与精简池(thin-pool) 已用占比，定位超额置备与未释放 LV。"
msgstr "只讀列出本機 LVM 邏輯卷與精簡池(thin-pool) 已用佔比，定位超額置備與未釋放 LV。"

msgid "参考 LVM 文档：精简池(thin-pool) 超额置备后元数据满是常见空间杀手；data_percent 即已用占比。"
msgstr "參考 LVM 文檔：精簡池(thin-pool) 超額置備後元數據滿是常見空間殺手；data_percent 即已用佔比。"

msgid "磁盘类型与 TRIM 支持核对（lsblk ROTA + discard_max_bytes）"
msgstr "磁盤類型與 TRIM 支持覈對（lsblk ROTA + discard_max_bytes）"

msgid "只读判断每块磁盘是 SSD/NVMe 还是 HDD，以及是否支持 discard（TRIM/UNMAP），给出 fstrim 回收建议。"
msgstr "只讀判斷每塊磁盤是 SSD/NVMe 還是 HDD，以及是否支持 discard（TRIM/UNMAP），給出 fstrim 回收建議。"

msgid "只读任务：仅核对，不修改系统（不发 FITRIM，不跑 blkdiscard）。"
msgstr "只讀任務：僅覈對，不修改系統（不發 FITRIM，不跑 blkdiscard）。"

msgid "参考 fstrim 文档：SSD/NVMe 靠 TRIM 回收空闲页；/sys/block/<dev>/queue/discard_max_bytes > 0 表示设备支持 discard。"
msgstr "參考 fstrim 文檔：SSD/NVMe 靠 TRIM 回收空閒頁；/sys/block/<dev>/queue/discard_max_bytes > 0 表示設備支持 discard。"

msgid "磁盘健康核对（smartctl -H，只读不跑自检）"
msgstr "磁盤健康覈對（smartctl -H，只讀不跑自檢）"

msgid "只读读取每块磁盘 SMART 整体健康(PASSED/FAILED) 与重映射/待映射扇区原始值，预警坏盘。"
msgstr "只讀讀取每塊磁盤 SMART 整體健康(PASSED/FAILED) 與重映射/待映射扇區原始值，預警壞盤。"

msgid "只读任务：仅核对，不修改系统（不跑 -t 自检）。"
msgstr "只讀任務：僅覈對，不修改系統（不跑 -t 自檢）。"

msgid "参考 smartctl 文档：05 Reallocated / 197 CurrentPending / 198 OfflineUncorrectable 增长预示坏道；NVMe 看可用备件下降。"
msgstr "參考 smartctl 文檔：05 Reallocated / 197 CurrentPending / 198 OfflineUncorrectable 增長預示壞道；NVMe 看可用備件下降。"

msgid "交换空间用量核对（swapon --show / /proc/swaps）"
msgstr "交換空間用量覈對（swapon --show / /proc/swaps）"

msgid "只读列出本机已启用交换空间的大小与已用量，判断是否需要重建碎片 swap。"
msgstr "只讀列出本機已啓用交換空間的大小與已用量，判斷是否需要重建碎片 swap。"

msgid "参考 swapon 文档：长期运行的 swap 可能碎片；重建须先 swapoff 再 mkswap 再 swapon。"
msgstr "參考 swapon 文檔：長期運行的 swap 可能碎片；重建須先 swapoff 再 mkswap 再 swapon。"

msgid "ext4 在线碎片整理（e4defrag 首个 ext4 挂载点）"
msgstr "ext4 在線碎片整理（e4defrag 首個 ext4 掛載點）"

msgid "对首个 ext4 挂载点跑 e4defrag——仅整理 extent 文件，目录或已连续文件无效果，安全低风险。"
msgstr "對首個 ext4 掛載點跑 e4defrag——僅整理 extent 文件，目錄或已連續文件無效果，安全低風險。"

msgid "仅整理 extent 文件，不影响数据；大目录可能耗时但不破坏。"
msgstr "僅整理 extent 文件，不影響數據；大目錄可能耗時但不破壞。"

msgid "参考 ext4 文档：e4defrag 只对 extent 文件有效；挂载点用 findmnt 取首个 ext4。"
msgstr "參考 ext4 文檔：e4defrag 只對 extent 文件有效；掛載點用 findmnt 取首個 ext4。"

msgid "XFS 在线碎片整理（xfs_fsr 全部已挂载）"
msgstr "XFS 在線碎片整理（xfs_fsr 全部已掛載）"

msgid "xfs_fsr 整理所有已挂载 XFS 文件系统的真实碎片文件；会重写 extent，对极少碎片文件无意义且耗 IO，需 --yes。"
msgstr "xfs_fsr 整理所有已掛載 XFS 文件系統的真實碎片文件；會重寫 extent，對極少碎片文件無意義且耗 IO，需 --yes。"

msgid "会重写 extent 增加 IO；运行前确认无关键写入在进行（需 --apply 且 --yes）。"
msgstr "會重寫 extent 增加 IO；運行前確認無關鍵寫入在進行（需 --apply 且 --yes）。"

msgid "参考 XFS 文档：xfs_fsr 仅对真实碎片文件有效；无参整理全部已挂载 XFS。"
msgstr "參考 XFS 文檔：xfs_fsr 僅對真實碎片文件有效；無參整理全部已掛載 XFS。"

msgid "Btrfs 回收未用 chunk（btrfs balance -dusage/-musage 20）"
msgstr "Btrfs 回收未用 chunk（btrfs balance -dusage/-musage 20）"

msgid "对首个 Btrfs 挂载点跑 balance，仅搬动已用<20% 的 chunk 以回收未分配空间——控制幅度避免全量重写。"
msgstr "對首個 Btrfs 掛載點跑 balance，僅搬動已用<20% 的 chunk 以回收未分配空間——控制幅度避免全量重寫。"

msgid "balance 会重写数据增加 IO 与写放大；运行期间勿中断（需 --apply 且 --yes）。"
msgstr "balance 會重寫數據增加 IO 與寫放大；運行期間勿中斷（需 --apply 且 --yes）。"

msgid "参考 Btrfs 文档：裸 btrfs balance 全量重写极重 IO；-dusage/-musage=20 只搬动已用<20% 的 chunk，回收空间同时控制幅度。"
msgstr "參考 Btrfs 文檔：裸 btrfs balance 全量重寫極重 IO；-dusage/-musage=20 只搬動已用<20% 的 chunk，回收空間同時控制幅度。"

msgid "Btrfs 后台校验（btrfs scrub start）"
msgstr "Btrfs 後臺校驗（btrfs scrub start）"

msgid "对首个 Btrfs 挂载点启动 scrub——后台按 checksum 校验并修复副本，只读验证不丢数据。"
msgstr "對首個 Btrfs 掛載點啓動 scrub——後臺按 checksum 校驗並修復副本，只讀驗證不丟數據。"

msgid "仅校验修复，不修改用户数据；大文件系统耗时但不阻断读写。"
msgstr "僅校驗修復，不修改用戶數據；大文件系統耗時但不阻斷讀寫。"

msgid "参考 Btrfs 文档：scrub 按每数据块 checksum 校验，副本可自修复；后台运行，可用 btrfs scrub status 查看进度。"
msgstr "參考 Btrfs 文檔：scrub 按每數據塊 checksum 校驗，副本可自修復；後臺運行，可用 btrfs scrub status 查看進度。"

msgid "ZFS SSD 池回收空闲块（zpool trim 全部池）"
msgstr "ZFS SSD 池回收空閒塊（zpool trim 全部池）"

msgid "对所有 ZFS 存储池发 TRIM，回收 SSD 后备盘上被释放但设备仍占用的空闲块。"
msgstr "對所有 ZFS 存儲池發 TRIM，回收 SSD 後備盤上被釋放但設備仍佔用的空閒塊。"

msgid "trim 为后台异步，不影响数据；HDD 池无需 trim。"
msgstr "trim 爲後臺異步，不影響數據；HDD 池無需 trim。"

msgid "参考 OpenZFS 文档：zpool trim 对 SSD 后备盘发 TRIM；也可用 zpool set autotrim=on 让其自动回收。"
msgstr "參考 OpenZFS 文檔：zpool trim 對 SSD 後備盤發 TRIM；也可用 zpool set autotrim=on 讓其自動回收。"

msgid "SSD/精简置备未用块回收（fstrim -av）"
msgstr "SSD/精簡置備未用塊回收（fstrim -av）"

msgid "对所有支持 discard 的挂载点发 FITRIM，让 SSD 控制器回收空闲页、让 thin 存储释放后端空间。"
msgstr "對所有支持 discard 的掛載點發 FITRIM，讓 SSD 控制器回收空閒頁、讓 thin 存儲釋放後端空間。"

msgid "切勿用 blkdiscard 做常规回收——整盘立即丢弃，不可恢复。"
msgstr "切勿用 blkdiscard 做常規回收——整盤立即丟棄，不可恢復。"

msgid "参考 fstrim 文档：fstrim 对挂载文件系统发 FITRIM，不破坏数据；频率过高伤低质 SSD 寿命，一周一次足够。"
msgstr "參考 fstrim 文檔：fstrim 對掛載文件系統發 FITRIM，不破壞數據；頻率過高傷低質 SSD 壽命，一週一次足夠。"

msgid "重建碎片交换空间（swapoff + mkswap + swapon）"
msgstr "重建碎片交換空間（swapoff + mkswap + swapon）"

msgid "对所有已启用交换区：先 swapoff（须剩余内存足够）、mkswap 重建签名、再 swapon 重新启用——全程交换暂停，整理碎片。"
msgstr "對所有已啓用交換區：先 swapoff（須剩餘內存足夠）、mkswap 重建簽名、再 swapon 重新啓用——全程交換暫停，整理碎片。"

msgid "swapoff 期间无交换空间，内存不足会 OOM；确保物理内存够用再执行（需 --apply 且 --yes）。"
msgstr "swapoff 期間無交換空間，內存不足會 OOM；確保物理內存夠用再執行（需 --apply 且 --yes）。"

msgid "参考 swapon 文档：重建须先 swapoff（剩余内存须足够，否则 OOM）；Btrfs 上的 swap 文件须 mkswap --file（自动 nocow）。"
msgstr "參考 swapon 文檔：重建須先 swapoff（剩餘內存須足夠，否則 OOM）；Btrfs 上的 swap 文件須 mkswap --file（自動 nocow）。"

msgid "导入第三方网络互联互通方案（合并到共享资源，只读引用）"
msgstr "導入第三方網絡互聯互通方案（合併到共享資源，只讀引用）"

msgid "把 p2wlan/dae/gfw-pac/v2rayN 作为「同人设备网络互联互通」的可选方案只读登记；本工具不打包其二进制，用户自行按许可证与平台安装。"
msgstr "把 p2wlan/dae/gfw-pac/v2rayN 作爲「同人設備網絡互聯互通」的可選方案只讀登記；本工具不打包其二進制，用戶自行按許可證與平臺安裝。"

msgid "这些仓库为第三方项目，各自许可证见仓库 licenses/ 文件夹与引用的许可证全文链接。"
msgstr "這些倉庫爲第三方項目，各自許可證見倉庫 licenses/ 文件夾與引用的許可證全文鏈接。"

msgid "p2wlan：P2P 虚拟局域网（NAT 穿透/房间组网/Relay），补强本地自组网。"
msgstr "p2wlan：P2P 虛擬局域網（NAT 穿透/房間組網/Relay），補強本地自組網。"

msgid "dae：eBPF 透明代理（Linux），用于本人设备出网分流。"
msgstr "dae：eBPF 透明代理（Linux），用於本人設備出網分流。"

msgid "gfw-pac：PAC 直连/代理域名分流规则（仅规则，不传流量）。"
msgstr "gfw-pac：PAC 直連/代理域名分流規則（僅規則，不傳流量）。"

msgid "v2rayN：Xray/sing-box GUI 客户端。"
msgstr "v2rayN：Xray/sing-box GUI 客戶端。"

msgid "三者均汇入「net_reshare 同人资源共享」模型：只用于本人授权网络。"
msgstr "三者均匯入「net_reshare 同人資源共享」模型：只用於本人授權網絡。"

msgid "网络互联互通的 CDN / P2P 开关（可选）"
msgstr "網絡互聯互通的 CDN / P2P 開關（可選）"

msgid "为网络互联互通提供两套开关语义：CDN 开关（走 HTTP/FTP 镜像源多连接分片）、P2P 开关（走 BitTorrent/Metalink 多源）。仅用于本人有权获取/分享的资源的。"
msgstr "爲網絡互聯互通提供兩套開關語義：CDN 開關（走 HTTP/FTP 鏡像源多連接分片）、P2P 開關（走 BitTorrent/Metalink 多源）。僅用於本人有權獲取/分享的資源的。"

msgid "P2P 开关仅用于合法资源；不用于转发他人流量、不蹭用他人网络出口。"
msgstr "P2P 開關僅用於合法資源；不用於轉發他人流量、不蹭用他人網絡出口。"

msgid "CDN 开关：aria2c --max-connection-per-server=N --split=N <镜像URL>。"
msgstr "CDN 開關：aria2c --max-connection-per-server=N --split=N <鏡像URL>。"

msgid "P2P 开关：aria2c <*.torrent|.metalink>，关闭用 --bt-enabled=false。"
msgstr "P2P 開關：aria2c <*.torrent|.metalink>，關閉用 --bt-enabled=false。"

msgid "硬件优化：DLSS5 一键安装/调优/还原（由用户选择）"
msgstr "硬件優化：DLSS5 一鍵安裝/調優/還原（由用戶選擇）"

msgid "把 DLSS5-Swapper 作为「GPU 硬件优化（由用户选择）」的可选工具登记；它改写游戏内超分 DLL，需用户逐游戏确认，且自动备份原文件便于还原。"
msgstr "把 DLSS5-Swapper 作爲「GPU 硬件優化（由用戶選擇）」的可選工具登記；它改寫遊戲內超分 DLL，需用戶逐遊戲確認，且自動備份原文件便於還原。"

msgid "会修改游戏目录内的 DLL；仅在本人设备、本人拥有的游戏上操作；本工具不打包其二进制。"
msgstr "會修改遊戲目錄內的 DLL；僅在本人設備、本人擁有的遊戲上操作；本工具不打包其二進制。"

msgid "支持 DLSS5、RenoDX、DLSS5-Feeder（无 DLSS 游戏注入）、OptiScaler 与多通道路由。"
msgstr "支持 DLSS5、RenoDX、DLSS5-Feeder（無 DLSS 遊戲注入）、OptiScaler 與多通道路由。"

msgid "覆盖 DirectX 8/9/11/12、Vulkan、OpenGL、DirectDraw 与模拟器；游戏内 F8 覆盖层。"
msgstr "覆蓋 DirectX 8/9/11/12、Vulkan、OpenGL、DirectDraw 與模擬器；遊戲內 F8 覆蓋層。"

msgid "操作前自动备份，风险由用户自负。"
msgstr "操作前自動備份，風險由用戶自負。"

msgid "引入开源下载软件 aria2（CDN / P2P 开关，可选）"
msgstr "引入開源下載軟件 aria2（CDN / P2P 開關，可選）"

msgid "把 aria2 作为「开源下载软件」的可选实现登记，提供 CDN（HTTP/FTP 镜像源）与 P2P（BitTorrent/Metalink）两套开关；本工具不打包其二进制。"
msgstr "把 aria2 作爲「開源下載軟件」的可選實現登記，提供 CDN（HTTP/FTP 鏡像源）與 P2P（BitTorrent/Metalink）兩套開關；本工具不打包其二進制。"

msgid "GPL-2.0；若与专有代码静态链接须注意传染性；仅下载本人有权获取的资源的。"
msgstr "GPL-2.0；若與專有代碼靜態鏈接須注意傳染性；僅下載本人有權獲取的資源的。"

msgid "aria2 支持 HTTP/HTTPS、FTP/SFTP、BitTorrent、Metalink，可多连接加速。"
msgstr "aria2 支持 HTTP/HTTPS、FTP/SFTP、BitTorrent、Metalink，可多連接加速。"

msgid "CDN 开关 = 启用 HTTP/FTP 镜像源；P2P 开关 = 启用 BT/Metalink 多源。"
msgstr "CDN 開關 = 啓用 HTTP/FTP 鏡像源；P2P 開關 = 啓用 BT/Metalink 多源。"

msgid "同人资源共享安全护栏（默认，必读）"
msgstr "同人資源共享安全護欄（默認，必讀）"

msgid "重声安全护栏：同一人登录的多设备可共享硬件资源（CPU/GPU/NPU/TPU/内存/网络），但个人数据与关键资产数据（凭据/密钥/钱包/通讯录/文档）一律不共享，且**绝不盗用他人网络互联互通能力**（不蹭他人房间/代理出口、不转发他人流量）。"
msgstr "重聲安全護欄：同一人登錄的多設備可共享硬件資源（CPU/GPU/NPU/TPU/內存/網絡），但個人數據與關鍵資產數據（憑據/密鑰/錢包/通訊錄/文檔）一律不共享，且**絕不盜用他人網絡互聯互通能力**（不蹭他人房間/代理出口、不轉發他人流量）。"

msgid "任何以「共享」之名要求提供密码/密钥/证件原件的，均为盗用风险，应拒绝。"
msgstr "任何以「共享」之名要求提供密碼/密鑰/證件原件的，均爲盜用風險，應拒絕。"

msgid "共享对象：本人登录的、经身份指纹（netauth）确认的多台设备。"
msgstr "共享對象：本人登錄的、經身份指紋（netauth）確認的多臺設備。"

msgid "可共享：cpu/memory/gpu/npu/tpu/network。"
msgstr "可共享：cpu/memory/gpu/npu/tpu/network。"

msgid "永不共享：personal_data/contacts/credentials/crypto_keys/asset_data/biometric/storage_content。"
msgstr "永不共享：personal_data/contacts/credentials/crypto_keys/asset_data/biometric/storage_content。"

msgid "第三方网络互联工具（p2wlan/dae/v2rayN 等）只用于本人**授权**网络。"
msgstr "第三方網絡互聯工具（p2wlan/dae/v2rayN 等）只用於本人**授權**網絡。"

msgid "插件支持：已注册的安全只读插件清单（只读）"
msgstr "插件支持：已註冊的安全只讀插件清單（只讀）"

msgid "展示「插件支持」：当前已注册的安全只读插件（内置 openwrt / interop 聚合，以及用户通过 $SYSWEEPER_PLUGINS_DIR 或仓库 plugins/ 目录 drop-in 的清单）。插件 native 入口仅限 NATIVE_ALLOWLIST 白名单内的只读函数，绝不执行任意代码。"
msgstr "展示「插件支持」：當前已註冊的安全只讀插件（內置 openwrt / interop 聚合，以及用戶通過 $SYSWEEPER_PLUGINS_DIR 或倉庫 plugins/ 目錄 drop-in 的清單）。插件 native 入口僅限 NATIVE_ALLOWLIST 白名單內的只讀函數，絕不執行任意代碼。"

msgid "插件不能执行任意代码：其 native 入口只能是 sysweeper.native 下已审读的零参只读函数；"
msgstr "插件不能執行任意代碼：其 native 入口只能是 sysweeper.native 下已審讀的零參只讀函數；"

msgid "含任意命令/路径/shell 元字符或非白名单函数的清单会被直接拒绝（防注入）。"
msgstr "含任意命令/路徑/shell 元字符或非白名單函數的清單會被直接拒絕（防注入）。"

msgid "内置插件：openwrt（路由器系统只读接口）、interop（第三方网络互联引用聚合）。"
msgstr "內置插件：openwrt（路由器系統只讀接口）、interop（第三方網絡互聯引用聚合）。"

msgid "用户插件：把一枚 *.json 清单放到 $SYSWEEPER_PLUGINS_DIR 或仓库 plugins/ 目录即被自动发现；"
msgstr "用戶插件：把一枚 *.json 清單放到 $SYSWEEPER_PLUGINS_DIR 或倉庫 plugins/ 目錄即被自動發現；"

msgid "清单须通过 plugin_validate：id 合法、native 入口全部在只读白名单内，否则拒绝注册。"
msgstr "清單須通過 plugin_validate：id 合法、native 入口全部在只讀白名單內，否則拒絕註冊。"

msgid "OpenJDK 运行时总览（java -version / JAVA_HOME，只读）"
msgstr "OpenJDK 運行時總覽（java -version / JAVA_HOME，只讀）"

msgid "读 java 版本、javac 是否可用、JAVA_HOME 与运行架构，确认当前用的是哪个 JDK。"
msgstr "讀 java 版本、javac 是否可用、JAVA_HOME 與運行架構，確認當前用的是哪個 JDK。"

msgid "输出含 java.home 等本机路径，属预期（本机自检），不外传。"
msgstr "輸出含 java.home 等本機路徑，屬預期（本機自檢），不外傳。"

msgid "多版本并存时用 JAVA_HOME 或 PATH 顺序决定实际生效的 JDK。"
msgstr "多版本並存時用 JAVA_HOME 或 PATH 順序決定實際生效的 JDK。"

msgid "本工具不安装 JDK、不改 JAVA_HOME、不动 PATH。"
msgstr "本工具不安裝 JDK、不改 JAVA_HOME、不動 PATH。"

msgid "JVM 系统属性体检（白名单键，口令类不回显）"
msgstr "JVM 系統屬性體檢（白名單鍵，口令類不回顯）"

msgid "读 -XshowSettings:properties 的白名单键；疑似口令/令牌的键只报「存在」不打印值。"
msgstr "讀 -XshowSettings:properties 的白名單鍵；疑似口令/令牌的鍵只報「存在」不打印值。"

msgid "这是隐私体检项：它证明「我们不打印敏感值」，不要反过来用去 dump 全部属性。"
msgstr "這是隱私體檢項：它證明「我們不打印敏感值」，不要反過來用去 dump 全部屬性。"

msgid "为什么不全量输出：属性表里混有 http.proxyPassword、令牌、带凭据 URL，整段 dump 会造成敏感信息落盘。"
msgstr "爲什麼不全量輸出：屬性表裏混有 http.proxyPassword、令牌、帶憑據 URL，整段 dump 會造成敏感信息落盤。"

msgid "白名单机制与 OpenWrt 层的敏感键处理同一条底线。"
msgstr "白名單機制與 OpenWrt 層的敏感鍵處理同一條底線。"

msgid "JPMS 模块系统体检（java --list-modules，只读）"
msgstr "JPMS 模塊系統體檢（java --list-modules，只讀）"

msgid "列出 JPMS 模块清单与顶层分类统计，判断模块层是否完整、java.se 根模块是否在位。"
msgstr "列出 JPMS 模塊清單與頂層分類統計，判斷模塊層是否完整、java.se 根模塊是否在位。"

msgid "模块清单本身不敏感，但会暴露用了哪些框架（可作资产测绘参考，请勿外传）。"
msgstr "模塊清單本身不敏感，但會暴露用了哪些框架（可作資產測繪參考，請勿外傳）。"

msgid "JDK 8 无 JPMS，会明确降级为「此版本无模块系统」而非报错。"
msgstr "JDK 8 無 JPMS，會明確降級爲「此版本無模塊系統」而非報錯。"

msgid "排查 NoClassDefFoundError / IllegalAccessError 时先看模块层。"
msgstr "排查 NoClassDefFoundError / IllegalAccessError 時先看模塊層。"

msgid "用 jlink 裁剪运行时镜像是写操作，本工具只给指引。"
msgstr "用 jlink 裁剪運行時鏡像是寫操作，本工具只給指引。"

msgid "垃圾收集器体检（PrintFlagsFinal，只读不改）"
msgstr "垃圾收集器體檢（PrintFlagsFinal，只讀不改）"

msgid "读各 Use*GC 标志的最终生效值，报告当前实际选中的收集器。"
msgstr "讀各 Use*GC 標誌的最終生效值，報告當前實際選中的收集器。"

msgid "本工具只报告，不替你选 GC——换 GC 是架构决策，应以官方调优指南与压测为准。"
msgstr "本工具只報告，不替你選 GC——換 GC 是架構決策，應以官方調優指南與壓測爲準。"

msgid "PrintFlagsFinal 是只打印不修改的诊断开关，JVM 执行完即退出。"
msgstr "PrintFlagsFinal 是隻打印不修改的診斷開關，JVM 執行完即退出。"

msgid "JDK 9+ 默认 G1；JDK 8 默认 Parallel GC。"
msgstr "JDK 9+ 默認 G1；JDK 8 默認 Parallel GC。"

msgid "JIT 分层编译体检（启动慢的根因定位，只读）"
msgstr "JIT 分層編譯體檢（啓動慢的根因定位，只讀）"

msgid "读 TieredCompilation / CompileThreshold / 内联上限等标志，解释「刚启动慢、跑一会就快」。"
msgstr "讀 TieredCompilation / CompileThreshold / 內聯上限等標誌，解釋「剛啓動慢、跑一會就快」。"

msgid "只看当前默认值，无法反映你实际启动脚本里带的 -XX 参数（那些不在 JVM 标志里）。"
msgstr "只看當前默認值，無法反映你實際啓動腳本里帶的 -XX 參數（那些不在 JVM 標誌裏）。"

msgid "分层编译关闭时只有解释器 + C2，冷启动明显更慢——这是最常见的「启动慢」原因。"
msgstr "分層編譯關閉時只有解釋器 + C2，冷啓動明顯更慢——這是最常見的「啓動慢」原因。"

msgid "MaxInlineSize / FreqInlineSize 影响热点方法内联，是吞吐/体积的权衡点。"
msgstr "MaxInlineSize / FreqInlineSize 影響熱點方法內聯，是吞吐/體積的權衡點。"

msgid "OpenJDK 诊断工具面与本机 JVM 进程（只读）"
msgstr "OpenJDK 診斷工具面與本機 JVM 進程（只讀）"

msgid "列出 jcmd/jps/jstack/jmap/jstat/jfr 是否在 PATH，并用 jps/jcmd -l 列本机 JVM 进程。"
msgstr "列出 jcmd/jps/jstack/jmap/jstat/jfr 是否在 PATH，並用 jps/jcmd -l 列本機 JVM 進程。"

msgid "jmap -histo:live 会触发 full GC、jfr start 持续写盘——均属高开销，本工具禁跑。"
msgstr "jmap -histo:live 會觸發 full GC、jfr start 持續寫盤——均屬高開銷，本工具禁跑。"

msgid "进程列表会暴露命令行参数（可能含口令），属本机自检，勿外传。"
msgstr "進程列表會暴露命令行參數（可能含口令），屬本機自檢，勿外傳。"

msgid "jstack/jmap/jfr 虽有副作用，本工具**不执行**，只报告可用性。"
msgstr "jstack/jmap/jfr 雖有副作用，本工具**不執行**，只報告可用性。"

msgid "「有没有东西在偷偷跑 JVM」是内存占用的常见排查起点。"
msgstr "「有沒有東西在偷偷跑 JVM」是內存佔用的常見排查起點。"

msgid "JFR 飞行记录器能力核对（只查不录制）"
msgstr "JFR 飛行記錄器能力覈對（只查不錄製）"

msgid "核对当前 JDK 是否具备 JFR、jfr 工具是否在 PATH，并给出录制用法的指引文本。"
msgstr "覈對當前 JDK 是否具備 JFR、jfr 工具是否在 PATH，並給出錄製用法的指引文本。"

msgid "录制会持续写盘并可能带来轻微停顿，属诊断期短时操作，不是常驻项。"
msgstr "錄製會持續寫盤並可能帶來輕微停頓，屬診斷期短時操作，不是常駐項。"

msgid "用法指引：jcmd <pid> JFR.start name=x duration=60s filename=a.jfr，随后 jfr print a.jfr 查看——**本工具只给文本，不代跑**。"
msgstr "用法指引：jcmd <pid> JFR.start name=x duration=60s filename=a.jfr，隨後 jfr print a.jfr 查看——**本工具只給文本，不代跑**。"

msgid "JFR 是 JDK 自带的低开销剖析器，已取代大部分传统的 jstack 抓取流程。"
msgstr "JFR 是 JDK 自帶的低開銷剖析器，已取代大部分傳統的 jstack 抓取流程。"

msgid "Java 构建缓存体积统计（Gradle / Maven，只读）"
msgstr "Java 構建緩存體積統計（Gradle / Maven，只讀）"

msgid "统计 ~/.gradle/caches 与 ~/.m2/repository 体积，只报数不删任何文件。"
msgstr "統計 ~/.gradle/caches 與 ~/.m2/repository 體積，只報數不刪任何文件。"

msgid "本工具只统计，**不删任何缓存**——Maven 仓库里可能有你自己 install 的 SNAPSHOT 构件。"
msgstr "本工具只統計，**不刪任何緩存**——Maven 倉庫裏可能有你自己 install 的 SNAPSHOT 構件。"

msgid "统计体积以便判断「值不值得清」，清理动作请自行决定。"
msgstr "統計體積以便判斷「值不值得清」，清理動作請自行決定。"

msgid "Gradle 缓存可安全重建（下次构建重新下载），Maven 本地仓库同理但可能含未发布的 SNAPSHOT。"
msgstr "Gradle 緩存可安全重建（下次構建重新下載），Maven 本地倉庫同理但可能含未發佈的 SNAPSHOT。"

msgid "JVM 调优：只给指引不代改（高危动作清单）"
msgstr "JVM 調優：只給指引不代改（高危動作清單）"

msgid "列出那些「会真改 JVM 行为」的高危动作及其官方依据，本工具一律只给文本。"
msgstr "列出那些「會真改 JVM 行爲」的高危動作及其官方依據，本工具一律只給文本。"

msgid "任何 JVM 参数调整都应先在预发环境验证并观察 GC 日志。"
msgstr "任何 JVM 參數調整都應先在預發環境驗證並觀察 GC 日誌。"

msgid "本任务的 action 是 manual 文本——它把「不该自动做的事」明确写出来。"
msgstr "本任務的 action 是 manual 文本——它把「不該自動做的事」明確寫出來。"

msgid "已加载内核模块盘点（/proc/modules，只读）"
msgstr "已加載內核模塊盤點（/proc/modules，只讀）"

msgid "读 /proc/modules：已加载可加载模块清单、内存合计、引用计数非 0 的模块。"
msgstr "讀 /proc/modules：已加載可加載模塊清單、內存合計、引用計數非 0 的模塊。"

msgid "**卸载内核模块是 root 级高危操作**，用错一个可致网络/存储不可用甚至不可开机。本工具只给判断依据与官方指引，绝不代为卸载。"
msgstr "**卸載內核模塊是 root 級高危操作**，用錯一個可致網絡/存儲不可用甚至不可開機。本工具只給判斷依據與官方指引，絕不代爲卸載。"

msgid "refcnt 非 0 = 模块仍被引用，卸载必然失败——这是「rmmod 报模块在用」的根因。"
msgstr "refcnt 非 0 = 模塊仍被引用，卸載必然失敗——這是「rmmod 報模塊在用」的根因。"

msgid "内建模块（builtin）不出现在 /proc/modules，而在 /sys/module 下且 initstate=builtin。"
msgstr "內建模塊（builtin）不出現在 /proc/modules，而在 /sys/module 下且 initstate=builtin。"

msgid "模块 sysfs 全景（builtin vs 可加载，只读）"
msgstr "模塊 sysfs 全景（builtin vs 可加載，只讀）"

msgid "遍历 /sys/module，统计内建/可加载模块数与暴露参数节点数量。"
msgstr "遍歷 /sys/module，統計內建/可加載模塊數與暴露參數節點數量。"

msgid "写 /sys/module/*/parameters/* 等于运行期改内核行为——本工具**只读**。"
msgstr "寫 /sys/module/*/parameters/* 等於運行期改內核行爲——本工具**只讀**。"

msgid "「暴露了 parameters 的模块数」= 可调内核行为的入口数量，是判断驱动可调性的量化指标。"
msgstr "「暴露了 parameters 的模塊數」= 可調內核行爲的入口數量，是判斷驅動可調性的量化指標。"

msgid "关键模块参数当前值（只读 sysfs）"
msgstr "關鍵模塊參數當前值（只讀 sysfs）"

msgid "只读列出拥塞控制、intel_powerclamp、nf_conntrack 等模块参数的当前值。"
msgstr "只讀列出擁塞控制、intel_powerclamp、nf_conntrack 等模塊參數的當前值。"

msgid "**写这些节点=运行期改内核**（如改 rmem_max、改内存回收行为），属高危操作，本工具只读且不给自动修复。"
msgstr "**寫這些節點=運行期改內核**（如改 rmem_max、改內存回收行爲），屬高危操作，本工具只讀且不給自動修復。"

msgid "完整参数清单用只读命令：ls /sys/module/*/parameters/。"
msgstr "完整參數清單用只讀命令：ls /sys/module/*/parameters/。"

msgid "调参前务必看 kernel.org 对应 Documentation 确认语义与取值域。"
msgstr "調參前務必看 kernel.org 對應 Documentation 確認語義與取值域。"

msgid "模块元数据与许可证分布（modinfo，只读）"
msgstr "模塊元數據與許可證分佈（modinfo，只讀）"

msgid "用 modinfo 汇总已加载模块的 license 字段分布，辅助判断 taint 来源。"
msgstr "用 modinfo 彙總已加載模塊的 license 字段分佈，輔助判斷 taint 來源。"

msgid "未安装 kmod 工具包时会明确降级，不报错。"
msgstr "未安裝 kmod 工具包時會明確降級，不報錯。"

msgid "加载「专有」或「GPL 不兼容」许可证的模块会让内核被标记 tainted，之后内核会把责任推给该模块、不再报它的 bug。"
msgstr "加載「專有」或「GPL 不兼容」許可證的模塊會讓內核被標記 tainted，之後內核會把責任推給該模塊、不再報它的 bug。"

msgid "查单模块：modinfo <name>；查固件需求：modinfo -F firmware <name>。"
msgstr "查單模塊：modinfo <name>；查固件需求：modinfo -F firmware <name>。"

msgid "内核固件库盘点（/lib/firmware，只读统计）"
msgstr "內核固件庫盤點（/lib/firmware，只讀統計）"

msgid "统计固件库目录的顶层分类、文件数与体积，辅助定位「设备功能静默失效」类问题。"
msgstr "統計固件庫目錄的頂層分類、文件數與體積，輔助定位「設備功能靜默失效」類問題。"

msgid "**绝不从非官方渠道替换固件**——错配的固件会让硬件直接不可用。"
msgstr "**絕不從非官方渠道替換固件**——錯配的固件會讓硬件直接不可用。"

msgid "本工具只统计体积与分类，不删不换。"
msgstr "本工具只統計體積與分類，不刪不換。"

msgid "固件缺失的表现是「设备功能静默失效」（不报错、不崩），排查网卡/显卡/打印机/无线不工作时第一件事就是看固件在不在。"
msgstr "固件缺失的表現是「設備功能靜默失效」（不報錯、不崩），排查網卡/顯卡/打印機/無線不工作時第一件事就是看固件在不在。"

msgid "只读自查某模块需要哪些固件：modinfo -F firmware <mod>。"
msgstr "只讀自查某模塊需要哪些固件：modinfo -F firmware <mod>。"

msgid "已加载固件标识核对（/sys/class/firmware，只读）"
msgstr "已加載固件標識覈對（/sys/class/firmware，只讀）"

msgid "读 firmware_class 已注册的设备与实际加载到的固件标识，确认驱动走的是哪份固件。"
msgstr "讀 firmware_class 已註冊的設備與實際加載到的固件標識，確認驅動走的是哪份固件。"

msgid "固件标识可能含内网设备序列号等环境信息，属本机自检，勿外传。"
msgstr "固件標識可能含內網設備序列號等環境信息，屬本機自檢，勿外傳。"

msgid "纯 CPU 计算节点上通常没有条目（无设备走固件流程），属正常。"
msgstr "純 CPU 計算節點上通常沒有條目（無設備走固件流程），屬正常。"

msgid "eBPF 能力体检（BTF / bpffs / 非特权开关，只读）"
msgstr "eBPF 能力體檢（BTF / bpffs / 非特權開關，只讀）"

msgid "核对内核 BTF 是否可用、bpffs 是否挂载、非特权 BPF 开关状态与可挂 kprobe 函数数量。"
msgstr "覈對內核 BTF 是否可用、bpffs 是否掛載、非特權 BPF 開關狀態與可掛 kprobe 函數數量。"

msgid "**不 attach、不 load 任何 BPF 程序**——加载需 CAP_BPF/CAP_SYS_ADMIN，挂错程序可能拖垮内核路径。"
msgstr "**不 attach、不 load 任何 BPF 程序**——加載需 CAP_BPF/CAP_SYS_ADMIN，掛錯程序可能拖垮內核路徑。"

msgid "有 BTF → BPF CO 可用：同一份 .o 能跨内核版本加载（libbpf 按 BTF 重定位）。"
msgstr "有 BTF → BPF CO 可用：同一份 .o 能跨內核版本加載（libbpf 按 BTF 重定位）。"

msgid "unprivileged_bpf_disabled=1 是较安全的基线（防非特权注入内核态程序）。"
msgstr "unprivileged_bpf_disabled=1 是較安全的基線（防非特權注入內核態程序）。"

msgid "eBPF 是现代 Linux 事实上的「内核级可编程插件」：Cilium/bpftrace/systemd 单元都建在它上面。"
msgstr "eBPF 是現代 Linux 事實上的「內核級可編程插件」：Cilium/bpftrace/systemd 單元都建在它上面。"

msgid "内核模块/加载相关 sysctl（taint / modules_disabled，只读）"
msgstr "內核模塊/加載相關 sysctl（taint / modules_disabled，只讀）"

msgid "读 tainted、modules_disabled、unprivileged_bpf_disabled、kptr_restrict 等关键开关。"
msgstr "讀 tainted、modules_disabled、unprivileged_bpf_disabled、kptr_restrict 等關鍵開關。"

msgid "**写这些 sysctl 会真改系统行为**（如清 taint、禁止加载模块），本工具只读。"
msgstr "**寫這些 sysctl 會真改系統行爲**（如清 taint、禁止加載模塊），本工具只讀。"

msgid "tainted 非空 = 内核被标记「不再为其报 bug」，通常因为加载了专有模块等。"
msgstr "tainted 非空 = 內核被標記「不再爲其報 bug」，通常因爲加載了專有模塊等。"

msgid "modules_disabled=1 表示已禁止再加载新模块（加固状态）。"
msgstr "modules_disabled=1 表示已禁止再加載新模塊（加固狀態）。"

msgid "kptr_restrict=1 限制 /proc 里的内核地址暴露（较安全）。"
msgstr "kptr_restrict=1 限制 /proc 裏的內核地址暴露（較安全）。"

msgid "modprobe 黑名单/加载策略（只读）"
msgstr "modprobe 黑名單/加載策略（只讀）"

msgid "只读列出 /etc/modprobe.d 与内核命令行里的 blacklist / install 指令。"
msgstr "只讀列出 /etc/modprobe.d 與內核命令行裏的 blacklist / install 指令。"

msgid "**不写 /etc/modprobe.d**——改加载策略是 root 级改动，配错会导致开不了无线网卡，只能从救援模式改回。"
msgstr "**不寫 /etc/modprobe.d**——改加載策略是 root 級改動，配錯會導致開不了無線網卡，只能從救援模式改回。"

msgid "黑名单本质是 modprobe 侧拒绝加载，**不是内核级硬禁止**——用 insmod 仍可能绕过。"
msgstr "黑名單本質是 modprobe 側拒絕加載，**不是內核級硬禁止**——用 insmod 仍可能繞過。"

msgid "批量黑名单第三方驱动（部分开源网卡驱动）省电效果因机型而异。"
msgstr "批量黑名單第三方驅動（部分開源網卡驅動）省電效果因機型而異。"

msgid "电源状态与温区（/sys/power、/sys/class/thermal，只读）"
msgstr "電源狀態與溫區（/sys/power、/sys/class/thermal，只讀）"

msgid "读睡眠态支持、mem_sleep 策略与各温区当前温度。"
msgstr "讀睡眠態支持、mem_sleep 策略與各溫區當前溫度。"

msgid "**写 /sys/power/state 会让机器真的睡下去**（数据风险），本工具绝不执行。"
msgstr "**寫 /sys/power/state 會讓機器真的睡下去**（數據風險），本工具絕不執行。"

msgid "调温控策略（写 trip_point）属 root 级改动，同样只给指引。"
msgstr "調溫控策略（寫 trip_point）屬 root 級改動，同樣只給指引。"

msgid "mem_sleep=auto 由系统自行选 suspend/hibernate；deep=进 hibernate。"
msgstr "mem_sleep=auto 由系統自行選 suspend/hibernate；deep=進 hibernate。"

msgid "温区由 thermal framework 统一导出；容器/虚拟机中可能被屏蔽。"
msgstr "溫區由 thermal framework 統一導出；容器/虛擬機中可能被屏蔽。"

msgid "内核模块卸载/固件更换：只给指引的高危清单"
msgstr "內核模塊卸載/固件更換：只給指引的高危清單"

msgid "把「卸载模块、换固件、锁 BPF、改加载策略」等高危动作与前置检查写成指引文本。"
msgstr "把「卸載模塊、換固件、鎖 BPF、改加載策略」等高危動作與前置檢查寫成指引文本。"

msgid "卸载关键模块（存储/网络/输入子系统）可能直接导致系统不可用甚至不可开机。"
msgstr "卸載關鍵模塊（存儲/網絡/輸入子系統）可能直接導致系統不可用甚至不可開機。"

msgid "本任务是 manual 文本：把高危动作的前置条件讲清楚，而不是替用户按下按钮。"
msgstr "本任務是 manual 文本：把高危動作的前置條件講清楚，而不是替用戶按下按鈕。"

msgid "清理垃圾"
msgstr "清理垃圾"

msgid "性能优化"
msgstr "性能優化"

msgid "隐私清理"
msgstr "隱私清理"

msgid "系统维护"
msgstr "系統維護"

msgid "网络/协议优化"
msgstr "網絡/協議優化"

msgid "字体/字符标准"
msgstr "字體/字符標準"

msgid "无障碍辅助"
msgstr "無障礙輔助"

msgid "架构/指令集标准"
msgstr "架構/指令集標準"

msgid "硬件优化"
msgstr "硬件優化"

msgid "定位与距离综合（先网络+基站，有导航再共同综合）"
msgstr "定位與距離綜合（先網絡+基站，有導航再共同綜合）"

msgid "只读探测本机定位源，按「网络 + 基站为首选基线，检测到导航定位则共同综合」的口径解算位置，并给出两源偏差与是否存疑。"
msgstr "只讀探測本機定位源，按「網絡 + 基站爲首選基線，檢測到導航定位則共同綜合」的口徑解算位置，並給出兩源偏差與是否存疑。"

msgid "只读任务：只用 nmcli / mmcli / adb shell dumpsys location 这类只读命令探测。"
msgstr "只讀任務：只用 nmcli / mmcli / adb shell dumpsys location 這類只讀命令探測。"

msgid "Android 需 adb 且设备授权调试；坐标是系统最后已知位置（last location），非实时。"
msgstr "Android 需 adb 且設備授權調試；座標是系統最後已知位置（last location），非實時。"

msgid "首选基线为什么要先用网络 + 基站：室内、地铁、隧道、省电模式下常常没有导航信号，而网络与基站几乎总在——先用它，保证任何情况下都有一个可用的位置与距离。"
msgstr "首選基線爲什麼要先用網絡 + 基站：室內、地鐵、隧道、省電模式下常常沒有導航信號，而網絡與基站幾乎總在——先用它，保證任何情況下都有一個可用的位置與距離。"

msgid "共同综合怎么算：按精度倒数平方加权（精度越高话语权越大），并给基线留 5% 最低话语权；导航主导但不独占，一次 GNSS 跳变不至于把位置甩飞。"
msgstr "共同綜合怎麼算：按精度倒數平方加權（精度越高話語權越大），並給基線留 5% 最低話語權；導航主導但不獨佔，一次 GNSS 跳變不至於把位置甩飛。"

msgid "两源偏差超过 2 km 标「存疑」，两套结果都摆出来，不替你判定哪个对。"
msgstr "兩源偏差超過 2 km 標「存疑」，兩套結果都擺出來，不替你判定哪個對。"

msgid "Linux 上若没有 ModemManager/GeoClue 或没有基站经纬度库，就**拿不到坐标**——这时明确报「未取到」，绝不凭 IP 编造一个位置出来。"
msgstr "Linux 上若沒有 ModemManager/GeoClue 或沒有基站經緯度庫，就**拿不到座標**——這時明確報「未取到」，絕不憑 IP 編造一個位置出來。"

msgid "预警评估（距你多远 / 是否在影响范围内，只评估不报警）"
msgstr "預警評估（距你多遠 / 是否在影響範圍內，只評估不報警）"

msgid "对已登记的预警逐条评估：距你多远、是否落在影响半径内、粗估多久到达边界，按由近到远排序。只评估，不自动报警。"
msgstr "對已登記的預警逐條評估：距你多遠、是否落在影響半徑內、粗估多久到達邊界，按由近到遠排序。只評估，不自動報警。"

msgid "只读任务：只评估，不自动报警、不拨号、不发短信。"
msgstr "只讀任務：只評估，不自動報警、不撥號、不發短信。"

msgid "预警需你手动登记或自己配置订阅源后拉取；默认**不联网**。"
msgstr "預警需你手動登記或自己配置訂閱源後拉取；默認**不聯網**。"

msgid "字段对齐 CAP 1.2：event / severity / urgency / certainty / area / effective / expires / instruction；四色预警只作显示映射，不改变判定逻辑。"
msgstr "字段對齊 CAP 1.2：event / severity / urgency / certainty / area / effective / expires / instruction；四色預警只作顯示映射，不改變判定邏輯。"

msgid "粗估到达时间按事件类型的典型传播速度算（地震 P 波约 6 km/s、台风移速约 8 m/s），**只是量级参考，不是预报**，报告里会写明这句。"
msgstr "粗估到達時間按事件類型的典型傳播速度算（地震 P 波約 6 km/s、颱風移速約 8 m/s），**只是量級參考，不是預報**，報告裏會寫明這句。"

msgid "位置精度本身就是上千米（纯基站时），距离值同量级误差——报告会把精度一起打出来，避免你把 14.2 km 当成 14.2 km 精确值。"
msgstr "位置精度本身就是上千米（純基站時），距離值同量級誤差——報告會把精度一起打出來，避免你把 14.2 km 當成 14.2 km 精確值。"

msgid "没有预警就是没有预警：本层不会凭空生成，也不会把「未取到数据」包装成「安全」。"
msgstr "沒有預警就是沒有預警：本層不會憑空生成，也不會把「未取到數據」包裝成「安全」。"

msgid "应急呼救文本生成（只生成，绝不自动发送）"
msgstr "應急呼救文本生成（只生成，絕不自動發送）"

msgid "把当前位置、情况、最近避险点、已通知的人组装成一段呼救文本，由你自己选择发送通道。本任务**绝不自动发送任何内容**。"
msgstr "把當前位置、情況、最近避險點、已通知的人組裝成一段呼救文本，由你自己選擇發送通道。本任務**絕不自動發送任何內容**。"

msgid "断网时只有局域网通道可用；手机信号基站拥塞时短信可能延迟。"
msgstr "斷網時只有局域網通道可用；手機信號基站擁塞時短信可能延遲。"

msgid "呼救文本里的联系人只是你本地填写的名字，本工具不读取通讯录。"
msgstr "呼救文本里的聯繫人只是你本地填寫的名字，本工具不讀取通訊錄。"

msgid "红线：不自动报警、不拨号、不发短信、不自动发送任何内容。文本给你，通道你选。"
msgstr "紅線：不自動報警、不撥號、不發短信、不自動發送任何內容。文本給你，通道你選。"

msgid "位置精度会一并写进文本（例如 ±72 m），让收到的人知道这个坐标有多准——报一个±1.5 km 的坐标却不说明精度，是害人不是救人。"
msgstr "位置精度會一併寫進文本（例如 ±72 m），讓收到的人知道這個座標有多準——報一個±1.5 km 的座標卻不說明精度，是害人不是救人。"

msgid "定位不可用时会明确写「未能确定」，并提示说明周边标志物，绝不瞎填坐标。"
msgstr "定位不可用時會明確寫「未能確定」，並提示說明周邊標誌物，絕不瞎填座標。"

msgid "应急准备度核对（避险点距离排序 + 物资清单）"
msgstr "應急準備度覈對（避險點距離排序 + 物資清單）"

msgid "按到你的距离给避险点排序（近的先走），并核对 10 项基础应急物资的备齐情况。"
msgstr "按到你的距離給避險點排序（近的先走），並覈對 10 項基礎應急物資的備齊情況。"

msgid "只读任务：只排序与核对，不替代官方疏散指引。"
msgstr "只讀任務：只排序與覈對，不替代官方疏散指引。"

msgid "直线距离 ≠ 步行距离，山区/水网地区差异可能很大。"
msgstr "直線距離 ≠ 步行距離，山區/水網地區差異可能很大。"

msgid "避险点要你自己填（家庭/社区/单位的实际集合点）——工具不知道你那儿哪儿能躲，凭空列一批「附近避难所」是在造假。"
msgstr "避險點要你自己填（家庭/社區/單位的實際集合點）——工具不知道你那兒哪兒能躲，憑空列一批「附近避難所」是在造假。"

msgid "物资清单按「3 天自救」基线：水每人每天 3 升、即食食品 3 天量、手电+备用电池、急救包、口哨、充电宝、收音机（断网还能听官方广播）、证件复印件与少量现金。"
msgstr "物資清單按「3 天自救」基線：水每人每天 3 升、即食食品 3 天量、手電+備用電池、急救包、口哨、充電寶、收音機（斷網還能聽官方廣播）、證件複印件與少量現金。"

msgid "排序只按直线距离，不考虑路况、桥梁是否通行——实际撤离以官方指引为准。"
msgstr "排序只按直線距離，不考慮路況、橋樑是否通行——實際撤離以官方指引爲準。"

msgid "预警应急手动开关（逐项开/关，持久化记住）"
msgstr "預警應急手動開關（逐項開/關，持久化記住）"

msgid "列出全部手动开关并说明每一项关掉后会怎样：定位、首选基站网络、与导航共同综合、预警评估、联网订阅（默认关）、呼救文本、避险点、物资核对。"
msgstr "列出全部手動開關並說明每一項關掉後會怎樣：定位、首選基站網絡、與導航共同綜合、預警評估、聯網訂閱（默認關）、呼救文本、避險點、物資覈對。"

msgid "指引类动作：只给改法文本，不代你改——开关状态由你决定。"
msgstr "指引類動作：只給改法文本，不代你改——開關狀態由你決定。"

msgid "关掉定位后，所有距离类评估会退化为「无法计算」，这是预期行为不是故障。"
msgstr "關掉定位後，所有距離類評估會退化爲「無法計算」，這是預期行爲不是故障。"

msgid "开关只存布尔值与坐标数字，落在 XDG ~/.config/sysweeper/emergency.json，**不存命令、不存代码**；文件损坏就回退默认，绝不拖垮界面。"
msgstr "開關只存布爾值與座標數字，落在 XDG ~/.config/sysweeper/emergency.json，**不存命令、不存代碼**；文件損壞就回退默認，絕不拖垮界面。"

msgid "联网订阅默认关闭：不主动联网是默认值，开了也只拉你自己填的 http(s) 地址。"
msgstr "聯網訂閱默認關閉：不主動聯網是默認值，開了也只拉你自己填的 http(s) 地址。"

msgid "关掉 locate_enabled 后只认手动录入的坐标——给「不想被探测位置」的人留的出口。"
msgstr "關掉 locate_enabled 後只認手動錄入的座標——給「不想被探測位置」的人留的出口。"

msgid "关掉 sos_enabled / shelter_enabled / kit_enabled 后对应功能直接返回关闭提示，不做「关了还偷偷跑」这种事。"
msgstr "關掉 sos_enabled / shelter_enabled / kit_enabled 後對應功能直接返回關閉提示，不做「關了還偷偷跑」這種事。"

msgid "十进制(可读): %s  (0x%s)"
msgstr "十進制(可讀): %s  (0x%s)"

msgid "十进制（人类可读·默认）: %s"
msgstr "十進制（人類可讀·默認）: %s"

msgid "位串 :"
msgstr "位串 :"

msgid "波形 :"
msgstr "波形 :"

msgid "说明 :"
msgstr "說明 :"

msgid "标记 :"
msgstr "標記 :"

msgid "第 %d 轮合并：%s"
msgstr "第 %d 輪合併：%s"

msgid "%-2d %-10s %-14s 覆盖 m(%s)%s"
msgstr "%-2d %-10s %-14s 覆蓋 m(%s)%s"

msgid "第 %d 轮：%s"
msgstr "第 %d 輪：%s"

msgid "原子性    : LOCK — 该指令在多核下原子执行"
msgstr "原子性    : LOCK — 該指令在多核下原子執行"

msgid "· 说明：核心格式走标准库，永远可用；7z/rar/zstd 缺库时明确跳过，不强求安装。"
msgstr "· 說明：核心格式走標準庫，永遠可用；7z/rar/zstd 缺庫時明確跳過，不強求安裝。"

msgid "· 按「还值不值得再压」分类："
msgstr "· 按「還值不值得再壓」分類："

msgid "· 体积最大的可压缩文件（采样前 1 MiB 实测 LZMA 压缩率）："
msgstr "· 體積最大的可壓縮文件（採樣前 1 MiB 實測 LZMA 壓縮率）："

msgid "· 大压缩包内部条目（流式读取，不解压、不驻留内存）："
msgstr "· 大壓縮包內部條目（流式讀取，不解壓、不駐留內存）："

msgid "· 归档建议（只会打印命令，不自动执行）："
msgstr "· 歸檔建議（只會打印命令，不自動執行）："

msgid "- 纯文本/日志：tar czf 归档.tar.gz <目录>   （标准库可用，兼容性最好）"
msgstr "- 純文本/日誌：tar czf 歸檔.tar.gz <目錄>   （標準庫可用，兼容性最好）"

msgid "- 追求高压缩率：7z a -t7z -mx=9 归档.7z <目录>   （需装 7z 或 py7zr）"
msgstr "- 追求高壓縮率：7z a -t7z -mx=9 歸檔.7z <目錄>   （需裝 7z 或 py7zr）"

msgid "- 已压过的（zip/7z/rar/mp4/png/pdf）别再压：收益接近 0，白费 CPU。"
msgstr "- 已壓過的（zip/7z/rar/mp4/png/pdf）別再壓：收益接近 0，白費 CPU。"

msgid "· 本报告只读：未压缩、未解压、未删除任何文件。"
msgstr "· 本報告只讀：未壓縮、未解壓、未刪除任何文件。"

msgid "· 已扫文件 %d 个，合计 %s%s"
msgstr "· 已掃文件 %d 個，合計 %s%s"

msgid "- 未发现值得压缩的大文件（多数已是已压缩/已编码格式）"
msgstr "- 未發現值得壓縮的大文件（多數已是已壓縮/已編碼格式）"

msgid "- 未发现归档/压缩包"
msgstr "- 未發現歸檔/壓縮包"

msgid "· 仅这 %d 个文件归档，预计可回收约 %s"
msgstr "· 僅這 %d 個文件歸檔，預計可回收約 %s"

msgid "Extremely severe / 红色"
msgstr "Extremely severe / 紅色"

msgid "Severe / 橙色"
msgstr "Severe / 橙色"

msgid "Moderate / 黄色"
msgstr "Moderate / 黃色"

msgid "Minor / 蓝色"
msgstr "Minor / 藍色"

msgid "Unknown / 未定级"
msgstr "Unknown / 未定級"

msgid "地震 P 波"
msgstr "地震 P 波"

msgid "地震 S 波"
msgstr "地震 S 波"

msgid "台风移动"
msgstr "颱風移動"

msgid "洪水推进"
msgstr "洪水推進"

msgid "火势蔓延"
msgstr "火勢蔓延"

msgid "该类事件"
msgstr "該類事件"

msgid "饮用水（每人每天 3 升，至少 3 天量）"
msgstr "飲用水（每人每天 3 升，至少 3 天量）"

msgid "即食食品（压缩饼干、罐头，3 天量）"
msgstr "即食食品（壓縮餅乾、罐頭，3 天量）"

msgid "手电筒 + 备用电池（或手摇发电）"
msgstr "手電筒 + 備用電池（或手搖發電）"

msgid "急救包（纱布、止血带、常用药、处方药）"
msgstr "急救包（紗布、止血帶、常用藥、處方藥）"

msgid "口哨（呼救比喊叫省力且传得远）"
msgstr "口哨（呼救比喊叫省力且傳得遠）"

msgid "充电宝（满电，配短线）"
msgstr "充電寶（滿電，配短線）"

msgid "收音机（接收官方广播，网络断了还能听）"
msgstr "收音機（接收官方廣播，網絡斷了還能聽）"

msgid "重要证件复印件 + 少量现金（断电时扫码付不了）"
msgstr "重要證件複印件 + 少量現金（斷電時掃碼付不了）"

msgid "口罩 / 防尘巾（火灾与地震扬尘）"
msgstr "口罩 / 防塵巾（火災與地震揚塵）"

msgid "救生哨、手套、结实的鞋"
msgstr "救生哨、手套、結實的鞋"

msgid "启用定位（关掉后只用手动录入的坐标，不探测本机）"
msgstr "啓用定位（關掉後只用手動錄入的座標，不探測本機）"

msgid "以网络 + 基站定位为首选基线（本层核心口径）"
msgstr "以網絡 + 基站定位爲首選基線（本層核心口徑）"

msgid "检测到导航定位时，与首选基线共同综合"
msgstr "檢測到導航定位時，與首選基線共同綜合"

msgid "启用预警评估（只评估，不自动报警）"
msgstr "啓用預警評估（只評估，不自動報警）"

msgid "联网订阅预警源（默认关闭；开启后只拉你自己填的 URL）"
msgstr "聯網訂閱預警源（默認關閉；開啓後只拉你自己填的 URL）"

msgid "启用应急呼救文本生成（只生成文本，绝不自动发送）"
msgstr "啓用應急呼救文本生成（只生成文本，絕不自動發送）"

msgid "启用避险点距离排序"
msgstr "啓用避險點距離排序"

msgid "启用应急物资清单核对"
msgstr "啓用應急物資清單核對"

msgid "手动录入"
msgstr "手動錄入"

msgid "缺少位置或事件中心点，无法计算距离（只显示事件本身）"
msgstr "缺少位置或事件中心點，無法計算距離（只顯示事件本身）"

msgid "应急呼救文本已关闭（手动开关 sos_enabled=关）"
msgstr "應急呼救文本已關閉（手動開關 sos_enabled=關）"

msgid "【应急呼救】"
msgstr "【應急呼救】"

